            "name": "Investigate by URL"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic ([{PolicyScope}]);\nlet Resource_list = dynamic ([{ResourceId}]);\nunion isfuzzy=true\n    (\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | where column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list)\n    | extend\n        RuleId          = column_ifexists(\"ruleId_s\", \"\"),\n        Action          = tostring(column_ifexists(\"action_s\", \"\")),\n        RuleSetType     = column_ifexists(\"ruleSetType_s\", \"\"),\n        RuleSetVersion  = column_ifexists(\"ruleSetVersion_s\", \"\"),\n        RuleGroup       = column_ifexists(\"ruleGroup_s\", \"\"),\n        PolicyScopeName = column_ifexists(\"policyScopeName_s\", \"\"),\n        PolicyScope     = column_ifexists(\"policyScope_s\", \"\"),\n        TransactionId   = tostring(column_ifexists(\"transactionId_g\", \"\"))\n    | project\n        TimeGenerated,\n        TransactionId,\n        ResourceId,\n        RuleId,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleGroup,\n        PolicyScopeName,\n        PolicyScope\n    ),\n    (\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where _ResourceId in~ (Resource_list)\n    | where PolicyScopeName in (Policy_list)\n    | extend\n        ResourceId      = _ResourceId,\n        RuleGroup       = case(\n            tostring(column_ifexists(\"RuleSetType\", \"\")) == \"Custom\", \"Custom Rules\",\n            tostring(column_ifexists(\"RuleSetType\", \"\")) contains \"BotManager\" or tostring(column_ifexists(\"RuleId\", \"\")) matches regex @\"^(Bot)?(100|200|300)[1-9]00$\",\n                case(tostring(column_ifexists(\"RuleId\", \"\")) matches regex @\"^(Bot)?100\", \"BadBots\", tostring(column_ifexists(\"RuleId\", \"\")) matches regex @\"^(Bot)?200\", \"GoodBots\", \"UnknownBots\"),\n            tostring(column_ifexists(\"RuleId\", \"\")) startswith \"99001\", \"MS-ThreatIntel-CVEs\",\n            tostring(column_ifexists(\"RuleId\", \"\")) startswith \"99005\", \"MS-ThreatIntel-WebShells\",\n            tostring(column_ifexists(\"RuleId\", \"\")) startswith \"99030\", \"MS-ThreatIntel-AppSec\",\n            tostring(column_ifexists(\"RuleId\", \"\")) startswith \"99031\", \"MS-ThreatIntel-SQLI\",\n            tostring(column_ifexists(\"RuleId\", \"\")) startswith \"99032\", \"MS-ThreatIntel-XSS\",\n            tostring(column_ifexists(\"RuleId\", \"\")) in (\"200002\", \"200003\", \"200004\"), \"General\",\n            isnotempty(tostring(column_ifexists(\"FileDetails\", \"\"))), replace_string(tostring(column_ifexists(\"FileDetails\", \"\")), \".conf\", \"\"),\n            \"Unknown\"\n        ),\n        PolicyScopeName = PolicyScopeName,\n        PolicyScope     = PolicyScope,\n        TransactionId   = tostring(TransactionId)\n    | project\n        TimeGenerated,\n        TransactionId,\n        ResourceId,\n        RuleId,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleGroup,\n        PolicyScopeName,\n        PolicyScope\n    )\n| extend ResourceId = tolower(tostring(ResourceId))\n| summarize Count = dcount(strcat(TransactionId, \"|\", tostring(TimeGenerated)), 4)\n    by\n    RuleId,\n    Action,\n    RuleSetType,\n    RuleSetVersion,\n    RuleGroup,\n    ResourceId,\n    PolicyScopeName,\n    PolicyScope\n| join kind=leftouter (\n    union isfuzzy=true\n        (\n        AzureDiagnostics\n        | where Category == \"ApplicationGatewayFirewallLog\"\n        | where TimeGenerated {detectionTime}\n        | where ResourceId in~ (Resource_list)\n        | where column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list)\n        | extend RuleId = column_ifexists(\"ruleId_s\", \"\"), TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n        | project TimeGenerated, RuleId, TransactionId\n        ),\n        (\n        AGWFirewallLogs\n        | where TimeGenerated {detectionTime}\n        | where _ResourceId in~ (Resource_list)\n        | where PolicyScopeName in (Policy_list)\n        | project TimeGenerated, RuleId, TransactionId = tostring(TransactionId)\n        )\n    | summarize by TimeGenerated, RuleId, TransactionId\n    | make-series\n        Trend = count()\n        on TimeGenerated\n        from {detectionTime:start}\n        to {detectionTime:end}\n        step {detectionTime:grain}\n        by RuleId\n    )\n    on RuleId\n| extend RuleSet_V = strcat(RuleSetType, \" \", RuleSetVersion), RuleDisplayId = case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId)\n| extend Resource = extract(@\"([^/]+)$\", 1, tostring(ResourceId))\n| project-reorder\n    Count,\n    RuleDisplayId,\n    RuleId,\n    Action,\n    RuleSet_V,\n    RuleGroup,\n    Resource,\n    PolicyScopeName,\n    PolicyScope,\n    Trend\n| order by Count desc",
                    "size": 0,
