            "version": "KqlParameterItem/1.0",
            "name": "SelectedRule",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "639db96a-4717-43b3-b86b-c5ae5bbd9ce3",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedTrackingID",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "c1b589e6-11f0-426b-b298-708585c1a9ae",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedClientIP",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "version": "KqlParameterItem/1.0",
            "type": 1,
            "isHiddenWhenLocked": true,
            "crossComponentResources": [
              "{Associations}"
            ],
            "timeContextFromParameter": "detectionTime",
            "queryType": 0,
            "resourceType": "microsoft.network/applicationgateways",
            "id": "77723f9c-13a6-464a-bc29-983b788da9d1",
            "name": "PolicyActivityNotice",
            "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\n// Notice: \"yes\" when this WAF policy processed no requests, but other WAF policies on the same resources did\nunion isfuzzy=true\n    (AzureDiagnostics\n     | where Category == \"ApplicationGatewayFirewallLog\"\n     | where TimeGenerated {detectionTime}\n     | project P = tostring(column_ifexists(\"policyId_s\", \"\"))),\n    (AGWFirewallLogs\n     | where TimeGenerated {detectionTime}\n     | project P = tostring(column_ifexists(\"PolicyId\", \"\")))\n| summarize Total = count(), ThisPolicy = countif(PolicyMatch(P))\n| project Value = iff(array_length(SelectedPolicies) > 0 and Total > 0 and ThisPolicy == 0, \"yes\", \"no\")"
          },
          {
            "version": "KqlParameterItem/1.0",
            "type": 1,
            "isHiddenWhenLocked": true,
            "crossComponentResources": [
              "{Associations}"
            ],
            "timeContextFromParameter": "detectionTime",
            "queryType": 0,
            "resourceType": "microsoft.network/applicationgateways",
            "id": "08f091eb-7fb0-46b8-958e-f3c232db3dc1",
            "name": "OtherPolicyNames",
            "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\n// Names of the other WAF policies that processed requests on the same resources\nunion isfuzzy=true\n    (AzureDiagnostics\n     | where Category == \"ApplicationGatewayFirewallLog\"\n     | where TimeGenerated {detectionTime}\n     | project P = tostring(column_ifexists(\"policyId_s\", \"\"))),\n    (AGWFirewallLogs\n     | where TimeGenerated {detectionTime}\n     | project P = tostring(column_ifexists(\"PolicyId\", \"\")))\n| where isnotempty(P) and not(PolicyMatch(P))\n| extend Name = extract(@\"(?i)applicationgatewaywebapplicationfirewallpolicies[/_](.+)$\", 1, P)\n| where isnotempty(Name)\n| summarize Records = count() by Name\n| top 5 by Records desc\n| summarize Names = strcat_array(make_list(Name), \", \")"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "customWidth": "50",
      "name": "parameters - 0"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "tabs",
        "tabStyle": "bigger",
        "links": [
          {
            "id": "05c90325-2ea4-477f-8556-691b3853a564",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "Monitor",
            "subTarget": "monitor-tab",
            "preText": "WAF Monitor",
            "style": "link"
          },
          {
            "id": "e259bad1-8100-4ab6-b5f9-dc0cef1c4047",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "Investigate",
            "subTarget": "investigate-tab",
            "preText": "WAF Investigate",
            "style": "link"
          }
        ]
      },
      "name": "links - 1",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "**This WAF policy didn't process any requests in the selected time range.** WAF activity on the associated Application Gateways was processed by other WAF policies: **{OtherPolicyNames}**.\n\nThis can happen when a WAF policy is associated with a listener or a route path: that policy processes the requests that reach it, instead of the gateway's policy. To see this activity, open WAF Insights from that policy.",
        "style": "info"
      },
      "conditionalVisibility": {
        "parameterName": "PolicyActivityNotice",
        "comparison": "isEqualTo",
        "value": "yes"
      },
      "name": "text - policy activity notice"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nunion isfuzzy=true\n(\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where PolicyMatch(tostring(column_ifexists(\"policyId_s\", \"\")))\n    | extend\n        ResourceId = tolower(tostring(ResourceId)),\n        policyScopeName = tostring(column_ifexists(\"policyScopeName_s\", \"Unknown\")),\n        policyScope = tostring(column_ifexists(\"policyScope_s\", column_ifexists(\"PolicyScope_s\", \"Unknown\"))),\n        RawAction = tostring(column_ifexists(\"action_s\", \"\")),\n        TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n),\n(\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where PolicyMatch(tostring(column_ifexists(\"PolicyId\", \"\")))\n    | extend\n        ResourceId = tolower(tostring(_ResourceId)),\n        policyScopeName = tostring(column_ifexists(\"PolicyScopeName\", \"Unknown\")),\n        policyScope = tostring(column_ifexists(\"PolicyScope\", \"Unknown\")),\n        RawAction = tostring(column_ifexists(\"Action\", \"\")),\n        TransactionId = tostring(TransactionId)\n)\n| extend policyScopeName=iff(isempty(trim(\" \", policyScopeName)), \"Unknown\", policyScopeName), policyScope=iff(isempty(trim(\" \", policyScope)), \"Unknown\", policyScope)\n// Count each request once, by its final WAF outcome (same logic as Requests by WAF Outcome)\n| where isnotempty(TransactionId)\n| extend Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by ResourceId, policyScope, policyScopeName, TransactionId\n| extend Outcome=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\")\n| extend Resource = extract(@\"([^/]+)$\", 1, ResourceId)\n| summarize Requests=count(), Blocked=countif(Outcome==\"Blocked\"), JSChallenge=countif(Outcome==\"JSChallenge\"), CAPTCHA=countif(Outcome==\"CAPTCHA\"), Allowed=countif(Outcome==\"Allowed\"), Logged=countif(Outcome==\"Logged\") by ResourceId, Resource, policyScope, policyScopeName\n| project Resource, policyScope, policyScopeName, Requests, Blocked, JSChallenge, CAPTCHA, Allowed, Logged, ResourceId\n| order by Requests desc",
              "size": 1,
              "title": "Select the scope of the WAF policy",
              "timeContextFromParameter": "detectionTime",
              "showRefreshButton": true,
              "exportMultipleValues": true,
              "exportedParameters": [
                {
                  "fieldName": "policyScopeName",
                  "parameterName": "PolicyScope",
                  "parameterType": 1
                },
                {
                  "fieldName": "ResourceId",
                  "parameterName": "ResourceId",
                  "parameterType": 1
                }
              ],
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "queryType": 0,
              "resourceType": "microsoft.network/applicationgateways",
              "crossComponentResources": [
                "{Associations}"
              ],
              "visualization": "table",
              "showExpandCollapseGrid": true,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Requests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "Blocked",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "JSChallenge",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "CAPTCHA",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Allowed",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Logged",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  }
                ],
                "rowLimit": 500,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Resource",
                    "label": "App Gateway"
                  },
                  {
                    "columnId": "policyScope",
                    "label": "Scope Type"
                  },
                  {
                    "columnId": "policyScopeName",
                    "label": "Scope Name"
                  },
                  {
                    "columnId": "Requests",
                    "label": "Requests"
                  }
                ]
              },
              "sortBy": []
            },
            "name": "query-app-gateway-resources"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [
                {
                  "id": "14e61d36-d59a-405d-8363-ac1aa8a2f491",
                  "cellValue": "SelectedTabPage",
                  "linkTarget": "parameter",
                  "linkLabel": "Investigate by Rule",
                  "subTarget": "investigate-by-rule",
                  "preText": "Investigate by Rule",
                  "style": "link"
                },
                {
                  "id": "93464fc4-d183-4d74-9e06-111c6de081a9",
                  "cellValue": "SelectedTabPage",
                  "linkTarget": "parameter",
                  "linkLabel": "Investigate by URL",
                  "subTarget": "investigate-by-url",
                  "preText": "Investigate ",
                  "style": "link"
                }
              ]
            },
            "name": "TabNavigation"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic ([{PolicyScope}]);\nlet Resource_list = dynamic ([{ResourceId}]);\n\nunion isfuzzy=true\n(\n    // -------- AzureDiagnostics (AD) --------\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | where column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list)\n    | extend Hostname = column_ifexists(\"hostname_s\", \"\"), TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n),\n(\n    // -------- AGWFirewallLogs (RS) --------\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where _ResourceId in~ (Resource_list)\n    | where PolicyScopeName in (Policy_list)\n    | extend Hostname = Hostname, TransactionId = tostring(TransactionId)\n)\n| extend Hostname = iif(isnull(Hostname) or isempty(Hostname), \"NA\", tostring(Hostname))\n| extend splittedhost = split(Hostname, ':')\n| extend\n    hostname_s_noport = iif(\n        isnull(splittedhost[0]) or isempty(splittedhost[0]),\n        \"NA\",\n        tostring(splittedhost[0])\n    ),\n    port = tostring(splittedhost[1])\n| summarize\n    total = dcount(TransactionId, 4),\n    listports = make_set(port)\n  by hostname_s_noport\n| extend hostname_s_noport = iif(isempty(hostname_s_noport), \"NA\", hostname_s_noport)\n| project hostname_s_noport, total\n| order by total desc",
                    "size": 0,
                    "title": "Impacted Hosts",
                    "noDataMessage": "The query returned no results. Please select a scope from the table above.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportFieldName": "hostname_s_noport",
                    "exportParameterName": "HostName",
                    "queryType": 0,
                    "resourceType": "microsoft.network/applicationgateways",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "hostname_s_noport",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "100%"
                          }
                        },
                        {
                          "columnMatch": "hostname_s",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "100%"
                          }
                        }
                      ],
                      "sortBy": [
                        {
                          "itemKey": "hostname_s_noport",
                          "sortOrder": 1
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "hostname_s_noport",
                          "label": "Host (w/o port)"
                        },
                        {
                          "columnId": "total",
                          "label": "Total"
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "hostname_s_noport",
                        "sortOrder": 1
                      }
                    ]
                  },
                  "customWidth": "30",
                  "name": "Hostnames with entries in Firewall Log"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic ([{PolicyScope}]);\nlet Resource_list = dynamic ([{ResourceId}]);\n\n// ---------- Firewall logs (AD + RS) ----------\nunion isfuzzy=true\n(\n    // --- AzureDiagnostics ---\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | where column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list)\n    | extend Hostname = iif(isnull(column_ifexists(\"hostname_s\", \"\")) or isempty(column_ifexists(\"hostname_s\", \"\")), \"NA\", tostring(column_ifexists(\"hostname_s\", \"\")))\n    | where Hostname contains '{HostName}'\n    | project TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n),\n(\n    // --- AGWFirewallLogs (RS) ---\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where _ResourceId in~ (Resource_list)\n    | where PolicyScopeName in (Policy_list)\n    | extend Hostname = iif(isnull(Hostname) or isempty(Hostname), \"NA\", tostring(Hostname))\n    | where Hostname contains '{HostName}'\n    | project TransactionId = TransactionId\n)\n| distinct TransactionId\n| join kind=inner\n(\n    // ---------- Access logs (AD + RS) ----------\n    union isfuzzy=true\n    (\n        // --- AzureDiagnostics ---\n        AzureDiagnostics\n        | where Category == \"ApplicationGatewayAccessLog\"\n        | where TimeGenerated {detectionTime}\n        | where ResourceId in~ (Resource_list)\n        | extend httpStatus = tostring(column_ifexists(\"httpStatus_d\", real(null)))\n        | project\n            ResourceId    = tostring(ResourceId),\n            TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\")),\n            requestUri    = column_ifexists(\"requestUri_s\", \"\"),\n            httpMethod    = column_ifexists(\"httpMethod_s\", \"\"),\n            originalUri   = column_ifexists(\"originalRequestUriWithArgs_s\", \"\"),\n            httpStatus\n    ),\n    (\n        // --- AGWAccessLogs (RS) ---\n        AGWAccessLogs\n        | where TimeGenerated {detectionTime}\n        | where _ResourceId in~ (Resource_list)\n        | extend httpStatus = tostring(HttpStatus)\n        | project\n            ResourceId    = tostring(_ResourceId),\n            TransactionId = TransactionId,\n            requestUri    = RequestUri,\n            httpMethod    = HttpMethod,\n            originalUri   = OriginalRequestUriWithArgs,\n            httpStatus\n    )\n    | summarize take_any(*) by TransactionId\n)\non TransactionId\n| extend\n    access_log = strcat(\n        \"union isfuzzy=true (AzureDiagnostics | where Category == \\\"ApplicationGatewayAccessLog\\\" | where TimeGenerated {detectionTime} | where transactionId_g == \\\"\",\n        TransactionId,\n        \"\\\"), (AGWAccessLogs | where TimeGenerated {detectionTime} | where TransactionId == \\\"\",\n        TransactionId,\n        \"\\\")\"\n    ),\n    firewall_log = strcat(\n        \"union isfuzzy=true (AzureDiagnostics | where Category == \\\"ApplicationGatewayFirewallLog\\\" | where TimeGenerated {detectionTime} | where transactionId_g == \\\"\",\n        TransactionId,\n        \"\\\"), (AGWFirewallLogs | where TimeGenerated {detectionTime} | where TransactionId == \\\"\",\n        TransactionId,\n        \"\\\")\"\n    )\n| project\n    ResourceId,\n    requestUri,\n    originalUri,\n    httpMethod,\n    httpStatus,\n    TransactionId,\n    access_log,\n    firewall_log",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "URL Impacted for Selected Scope",
                    "noDataMessage": "The query returned no results. Please select a Host.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "requestUri",
                        "parameterName": "RequestUri"
                      },
                      {
                        "fieldName": "originalUri",
                        "parameterName": "RequestUriWithArgs",
                        "parameterType": 1
