                    "sortBy": []
                  },
                  "customWidth": "70",
                  "name": "Paths which have triggered firewall rules"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "union isfuzzy=true\n(\n    // -------- AzureDiagnostics (AD) --------\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where tostring(column_ifexists(\"transactionId_g\", \"\")) == '{TransactionId}'\n    | extend\n        Action          = tostring(column_ifexists(\"action_s\", \"\")),\n        RuleSetType     = column_ifexists(\"ruleSetType_s\", \"\"),\n        RuleSetVersion  = column_ifexists(\"ruleSetVersion_s\", \"\"),\n        RuleId          = column_ifexists(\"ruleId_s\", \"\"),\n        RuleGroup       = iff(tostring(column_ifexists(\"ruleSetType_s\", \"\")) == \"Custom\", \"Custom Rules\", tostring(column_ifexists(\"ruleGroup_s\", \"\"))),\n        Hostname        = column_ifexists(\"hostname_s\", \"\"),\n        RequestUri      = column_ifexists(\"requestUri_s\", \"\"),\n        DetailsMessage  = column_ifexists(\"details_message_s\", \"\"),\n        DetailsData     = column_ifexists(\"details_data_s\", \"\"),\n        DetailsFile     = column_ifexists(\"details_file_s\", \"\"),\n        DetailsLine     = column_ifexists(\"details_line_s\", \"\"),\n        TransactionId   = tostring(column_ifexists(\"transactionId_g\", \"\")),\n        MessageText     = Message\n    | project\n        TimeGenerated,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleId,\n        RuleGroup,\n        MessageText,\n        DetailsMessage,\n        DetailsData,\n        Hostname,\n        RequestUri,\n        DetailsFile,\n        DetailsLine,\n        TransactionId\n),\n(\n    // -------- AGWFirewallLogs (RS) --------\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where TransactionId == '{TransactionId}'\n    | extend\n        Action          = tostring(column_ifexists(\"Action\", \"\")),\n        RuleSetType     = RuleSetType,\n        RuleSetVersion  = RuleSetVersion,\n        RuleId          = RuleId,\n        RuleGroup       = case(tostring(RuleSetType)==\"Custom\",\"Custom Rules\",tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(Bot)?(100|200|300)[1-9]00$\",case(tostring(RuleId) matches regex @\"^(Bot)?100\",\"BadBots\",tostring(RuleId) matches regex @\"^(Bot)?200\",\"GoodBots\",\"UnknownBots\"),tostring(RuleId) startswith \"99001\",\"MS-ThreatIntel-CVEs\",tostring(RuleId) startswith \"99005\",\"MS-ThreatIntel-WebShells\",tostring(RuleId) startswith \"99030\",\"MS-ThreatIntel-AppSec\",tostring(RuleId) startswith \"99031\",\"MS-ThreatIntel-SQLI\",tostring(RuleId) startswith \"99032\",\"MS-ThreatIntel-XSS\",tostring(RuleId) in (\"200002\",\"200003\",\"200004\"),\"General\",isnotempty(tostring(FileDetails)),replace_string(tostring(FileDetails),\".conf\",\"\"),\"Unknown\"),\n        Hostname        = Hostname,\n        RequestUri      = RequestUri,\n        DetailsMessage  = DetailedMessage,\n        DetailsData     = DetailedData,\n        DetailsFile     = \"\",\n        DetailsLine     = \"\",\n        TransactionId   = TransactionId,\n        MessageText     = Message\n    | project\n        TimeGenerated,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleId,\n        RuleGroup,\n        MessageText,\n        DetailsMessage,\n        DetailsData,\n        Hostname,\n        RequestUri,\n        DetailsFile,\n        DetailsLine,\n        TransactionId\n)\n| extend\n    Id = new_guid(),\n    RuleSet_V = strcat(RuleSetType, \" \", RuleSetVersion),\n    RuleId = case(tostring(RuleId) matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, tostring(RuleId))), tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", tostring(RuleId)), tostring(RuleId))\n| project\n    Action,\n    RuleSet_V,\n    RuleGroup,\n    RuleId,\n    MessageText,\n    DetailsMessage,\n    DetailsData,\n    TimeGenerated\n| distinct *\n| order by TimeGenerated asc",
                    "size": 0,
                    "title": "Rules Triggered for Selected Request",
                    "noDataMessage": "The query returned no results. Please select a Transaction ID.",
                    "timeContextFromParameter": "detectionTime",
                    "exportedParameters": [
                      {
                        "fieldName": "transactionId_g",
                        "parameterName": "TransactionId"
                      },
                      {
                        "fieldName": "MessageText",
                        "parameterName": "message",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsMessage",
