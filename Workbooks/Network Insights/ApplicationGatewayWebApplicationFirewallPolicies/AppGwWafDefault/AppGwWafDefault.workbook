                        {
                          "columnMatch": "encodedRequestUri",
                          "formatter": 5
                        }
                      ],
                      "rowLimit": 1000,
                      "filter": true,
                      "hierarchySettings": {
                        "treeType": 1,
                        "groupBy": [
                          "requestUri_s1"
                        ],
                        "expandTopLevel": true,
                        "finalBy": "requestUri_s"
                      },
                      "sortBy": [
                        {
                          "itemKey": "$gen_count_$gen_group_0",
                          "sortOrder": 1
