                          "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet WafLogs = union isfuzzy=true\n(AzureDiagnostics | where OperationName == \"ApplicationGatewayFirewall\" or Category == \"ApplicationGatewayFirewallLog\" | where TimeGenerated {detectionTime} | where PolicyMatch(tostring(column_ifexists(\"policyId_s\", \"\"))) | extend RawAction=tostring(column_ifexists(\"action_s\", \"\")) | extend TrackingID=tostring(column_ifexists(\"transactionId_g\", \"\")),RuleId=tostring(column_ifexists(\"ruleId_s\", \"\")),RuleSetType=tostring(column_ifexists(\"ruleSetType_s\", \"\")),RuleSetVersion=tostring(column_ifexists(\"ruleSetVersion_s\", \"\")),RuleGroup=iff(tostring(column_ifexists(\"ruleSetType_s\", \"\"))==\"Custom\",\"Custom Rules\",tostring(column_ifexis