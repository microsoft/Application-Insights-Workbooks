                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic ([{PolicyScope}]);\nlet Resource_list = dynamic ([{ResourceId}]);\n\nunion isfuzzy=true\n(\n    // -------- AzureDiagnostics (AD) --------\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | where column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list)\n    | where column_ifexists(\"ruleId_s\", \"\") == '{RuleId}'\n    | where column_ifexists(\"ruleSetVersion_s\", \"\") == '{RuleSetVersion}'\n    | where tostring(column_ifexists(\"action_s\", \"\")) == '{selectedAction}'\n    | extend\n        RuleId   = column_ifexists(\"ruleId_s\", \"\"),\n        Hostname = column_ifexists(\"hostname_s\", \"\")\n    | project TimeGenerated, RuleId, Hostname, TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n),\n(\n    // -------- AGWFirewallLogs (RS) --------\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where _ResourceId in~ (Resource_list)\n    | where PolicyScopeName in (Policy_list)\n    | where RuleId == '{RuleId}'\n    | where RuleSetVersion == '{RuleSetVersion}'\n    | where tostring(column_ifexists(\"Action\", \"\")) == '{selectedAction}'\n    | extend\n        RuleId   = RuleId,\n        Hostname = Hostname\n    | project TimeGenerated, RuleId, Hostname, TransactionId = tostring(TransactionId)\n)\n| extend splittedhost = split(Hostname, ':')\n| extend\n    hostname_s_noport = iif(\n        isnull(splittedhost[0]) or isempty(splittedhost[0]),\n        \"NA\",\n        tostring(splittedhost[0])\n    ),\n    port = tostring(splittedhost[1])\n| summarize\n    total = dcount(TransactionId, 4),\n    listports = make_set(port)\n  by hostname_s_noport, RuleId\n| extend hostname_s_noport = iif(isempty(hostname_s_noport), \"NA\", hostname_s_noport)\n| project hostname_s_noport, total\n| order by total desc",
                    "size": 0,
                    "title": "Impacted Hosts ",
                    "noDataMessage": "The query returned no results. Please select a Rule from the table above.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "hostname_s",
                        "parameterName": "HostName",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "hostname_s_noport",
                        "parameterName": "HostNameNoPort",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.network/applicationgateways",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "sortBy": [
                        {
                          "itemKey": "hostname_s_noport",
                          "sortOrder": 1
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "hostname_s_noport",
                          "label": "Host (w/o port)"
                        },
                        {
                          "columnId": "total",
                          "label": "Total"
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "hostname_s_noport",
                        "sortOrder": 1
                      }
                    ]
                  },
                  "customWidth": "30",
                  "showPin": true,
                  "name": "Affected Hosts"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic ([{PolicyScope}]);\nlet Resource_list = dynamic ([{ResourceId}]);\n\n// ---- Firewall transactions (AD + RS) ----\nunion isfuzzy=true\n(\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where tostring(column_ifexists(\"action_s\", \"\")) == '{selectedAction}'\n    | where ResourceId in~ (Resource_list) and column_ifexists(\"policyScopeName_s\", \"\") in (Policy_list) and column_ifexists(\"ruleId_s\", \"\") == '{RuleId}'\n    | extend Hostname = iif(isnull(column_ifexists(\"hostname_s\", \"\")) or isempty(column_ifexists(\"hostname_s\", \"\")), \"NA\", tostring(column_ifexists(\"hostname_s\", \"\")))\n    | where Hostname contains '{HostNameNoPort}'\n    | project TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\"))\n),\n(\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where tostring(column_ifexists(\"Action\", \"\")) == '{selectedAction}'\n    | where _ResourceId in~ (Resource_list) and PolicyScopeName in (Policy_list) and RuleId == '{RuleId}'\n    | extend Hostname = iif(isnull(Hostname) or isempty(Hostname), \"NA\", tostring(Hostname))\n    | where Hostname contains '{HostNameNoPort}'\n    | project TransactionId = TransactionId\n)\n| distinct TransactionId\n| join kind=inner\n(\n    // ---- Access logs (AD + RS) ----\n    union isfuzzy=true\n    (\n        AzureDiagnostics\n        | where Category == \"ApplicationGatewayAccessLog\"\n        | where TimeGenerated {detectionTime}\n        | where ResourceId in~ (Resource_list)\n        | project\n            TransactionId = tostring(column_ifexists(\"transactionId_g\", \"\")),\n            ResourceId = ResourceId,\n            host_s1 = column_ifexists(\"host_s\", \"\"),\n            requestUri_s1 = column_ifexists(\"requestUri_s\", \"\"),\n            httpMethod_s1 = column_ifexists(\"httpMethod_s\", \"\"),\n            originalRequestUriWithArgs_s1 = column_ifexists(\"originalRequestUriWithArgs_s\", \"\")\n    ),\n    (\n        AGWAccessLogs\n        | where TimeGenerated {detectionTime}\n        | where _ResourceId in~ (Resource_list)\n        | project\n            TransactionId = TransactionId,\n            ResourceId = _ResourceId,\n            host_s1 = Host,\n            requestUri_s1 = RequestUri,\n            httpMethod_s1 = HttpMethod,\n            originalRequestUriWithArgs_s1 = OriginalRequestUriWithArgs\n    )\n    | summarize take_any(*) by TransactionId\n)\non TransactionId\n| extend\n    access_log = strcat(\n        \"union isfuzzy=true (AzureDiagnostics | where Category == \\\"ApplicationGatewayAccessLog\\\" | where TimeGenerated {detectionTime} | where transactionId_g == \\\"\",\n        TransactionId,\n        \"\\\"), (AGWAccessLogs | where TimeGenerated {detectionTime} | where TransactionId == \\\"\",\n        TransactionId,\n        \"\\\")\"\n    ),\n    firewall_log = strcat(\n        \"union isfuzzy=true (AzureDiagnostics | where Category == \\\"ApplicationGatewayFirewallLog\\\" | where TimeGenerated {detectionTime} | where transactionId_g == \\\"\",\n        TransactionId,\n        \"\\\"), (AGWFirewallLogs | where TimeGenerated {detectionTime} | where TransactionId == \\\"\",\n        TransactionId,\n        \"\\\")\"\n    )\n| project\n    ResourceId,\n    host_s1,\n    requestUri_s1,\n    httpMethod_s1,\n    originalRequestUriWithArgs_s1,\n    transactionId_g = TransactionId,\n    access_log,\n    firewall_log\n| order by\n    host_s1,\n    requestUri_s1,\n    httpMethod_s1,\n    originalRequestUriWithArgs_s1,\n    tostring(column_ifexists(\"transactionId_g\", \"\"))\n| extend id = new_guid()",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rule-Impacted URLs for Selected Host ",
                    "noDataMessage": "The query returned no results. Please select a Host from the table on the left..",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "httpMethod_s1",
                        "parameterName": "Method",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "originalRequestUriWithArgs_s1",
                        "parameterName": "FullUri",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "requestUri_s1",
                        "parameterName": "RequestUri",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "transactionId_g",
                        "parameterName": "TransactionId",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.network/applicationgateways",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "showExpandCollapseGrid": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "host_s1",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "requestUri_s",
