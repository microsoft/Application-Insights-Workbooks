                                "label": "Requests"
                              },
                              {
                                "columnId": "RuleMatches",
                                "label": "Rule Matches"
                              }
                            ]
                          },
                          "chartSettings": {
                            "showLegend": true
                          }
                        },
                        "customWidth": "30",
                        "name": "query - 7"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet WafLogs = union isfuzzy=true\n(AzureDiagnostics | where OperationName == \"ApplicationGatewayFirewall\" or Category == \"ApplicationGatewayFirewallLog\" | where TimeGenerated {detectionTime} | where PolicyMatch(tostring(column_ifexists(\"policyId_s\", \"\"))) | extend RawAction=tostring(column_ifexists(\"action_s\", \"\")) | extend TrackingID=tostring(column_ifexists(\"transactionId_g\", \"\")),RuleId=tostring(column_ifexists(\"ruleId_s\", \"\")),RuleSetType=tostring(column_ifexists(\"ruleSetType_s\", \"\")),RuleSetVersion=tostring(column_ifexists(\"ruleSetVersion_s\", \"\")),RuleGroup=iff(tostring(column_ifexists(\"ruleSetType_s\", \"\"))==\"Custom\",\"Custom Rules\",tostring(column_ifexists(\"ruleGroup_s\", \"\"))),Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction),ClientIP=tostring(coalesce(column_ifexists(\"clientIp_s\", \"\"),column_ifexists(\"clientIP_s\", \"\"))),RequestUri=tostring(column_ifexists(\"requestUri_s\", \"\")),RuleDescription=tostring(Message),Details=tostring(column_ifexists(\"details_message_s\", \"\")),MatchedData=tostring(column_ifexists(\"details_data_s\", \"\")),Hostname=tostring(column_ifexists(\"hostname_s\", \"\")),LogSchema=\"AzureDiagnostics\" | extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema),\n(AGWFirewallLogs | where TimeGenerated {detectionTime} | where PolicyMatch(tostring(column_ifexists(\"PolicyId\", \"\"))) | extend RawAction=tostring(Action) | extend TrackingID=tostring(TransactionId),RuleId=tostring(RuleId),RuleSetType=tostring(RuleSetType),RuleSetVersion=tostring(RuleSetVersion),RuleGroup=case(tostring(RuleSetType)==\"Custom\",\"Custom Rules\",tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(Bot)?(100|200|300)[1-9]00$\",case(tostring(RuleId) matches regex @\"^(Bot)?100\",\"BadBots\",tostring(RuleId) matches regex @\"^(Bot)?200\",\"GoodBots\",\"UnknownBots\"),tostring(RuleId) startswith \"99001\",\"MS-ThreatIntel-CVEs\",tostring(RuleId) startswith \"99005\",\"MS-ThreatIntel-WebShells\",tostring(RuleId) startswith \"99030\",\"MS-ThreatIntel-AppSec\",tostring(RuleId) startswith \"99031\",\"MS-ThreatIntel-SQLI\",tostring(RuleId) startswith \"99032\",\"MS-ThreatIntel-XSS\",tostring(RuleId) in (\"200002\",\"200003\",\"200004\"),\"General\",isnotempty(tostring(FileDetails)),replace_string(tostring(FileDetails),\".conf\",\"\"),\"Unknown\"),Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction),ClientIP=tostring(ClientIp),RequestUri=tostring(RequestUri),RuleDescription=tostring(Message),Details=tostring(DetailedMessage),MatchedData=tostring(DetailedData),Hostname=tostring(Hostname),LogSchema=\"ResourceSpecific\" | extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema)\n// Collapse records that were collected by both diagnostic settings modes during a migration\n| summarize arg_max(LogSchema, *) by TrackingID, RuleId, Action, TimeGenerated, Details, MatchedData;\nlet RequestOutcomes = WafLogs\n| where isnotempty(TrackingID)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by TrackingID\n| extend FinalAction=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\")\n| project TrackingID,FinalAction;\nlet FilteredWafLogs = union isfuzzy=true\n(WafLogs | where isempty('{SelectedAction}')),\n(WafLogs\n | where isnotempty('{SelectedAction}')\n | join kind=inner RequestOutcomes on TrackingID\n | where '{SelectedAction}' contains FinalAction\n | project-away TrackingID1,FinalAction)\n| where isempty('{SelectedRuleSet}') or '{SelectedRuleSet}' contains iff(RuleSetType == \"Custom\",\"Custom Rules\",strcat(RuleSetType,\" \",RuleSetVersion))\n| where isempty('{SelectedRuleGroup}') or '{SelectedRuleGroup}' contains RuleGroup;\nFilteredWafLogs\n| where isempty('{RequestURI}') or RequestUri == '{RequestURI}'\n| where isempty('{SelectedRule}') or '{SelectedRule}' contains RuleDisplayId\n| where isempty('{SelectedClientIP}') or '{SelectedClientIP}' contains ClientIP\n| project TimeGenerated,TrackingID,RuleId=RuleDisplayId,Action,RawAction,RequestUri,ClientIP,RuleDescription,Details,MatchedData,LogSchema\n| order by TimeGenerated desc",
                          "size": 0,
                          "title": "Requests for Selected Rule and Source IP",
                          "noDataMessage": "No data found –try to expand the detection time range to include more events",
                          "timeContextFromParameter": "detectionTime",
                          "showRefreshButton": true,
                          "showExportToExcel": true,
                          "queryType": 0,
                          "resourceType": "microsoft.network/applicationgateways",
                          "crossComponentResources": [
                            "{Associations}"
                          ],
                          "visualization": "table",
                          "gridSettings": {
                            "formatters": [
                              {
                                "columnMatch": "InstandUri",
                                "formatter": 5
                              },
                              {
                                "columnMatch": "RuleSetType",
                                "formatter": 5
                              },
                              {
                                "columnMatch": "File_Details",
                                "formatter": 5
                              },
                              {
                                "columnMatch": "Data_Details",
                                "formatter": 5
                              },
                              {
                                "columnMatch": "Category",
                                "formatter": 5
                              }
                            ],
                            "filter": true,
                            "labelSettings": [
                              {
                                "columnId": "TimeGenerated",
                                "label": "Time Generated"
                              },
                              {
                                "columnId": "RequestUri",
                                "label": "Request URI"
                              },
                              {
                                "columnId": "ClientIP",
                                "label": "Client IP"
                              },
                              {
                                "columnId": "RuleId",
                                "label": "Rule ID"
                              },
                              {
                                "columnId": "Action",
                                "label": "WAF Outcome Category"
                              },
                              {
                                "columnId": "RawAction",
                                "label": "Action (as logged)"
                              }
                            ]
                          }
                        },
                        "customWidth": "70",
                        "showPin": true,
                        "name": "query - 123"
                      }
                    ],
                    "exportParameters": true
                  },
                  "name": "filtered"
                }
              ],
              "exportParameters": true
            },
            "conditionalVisibility": {
              "parameterName": "MonitorSelectedTab",
              "comparison": "isEqualTo",
              "value": "WAFLogsTab"
            },
            "name": "WAF Logs"
          },
          {
            "type": 12,
            "content": {
