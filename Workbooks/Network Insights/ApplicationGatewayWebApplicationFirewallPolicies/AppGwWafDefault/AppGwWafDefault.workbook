                  "customWidth": "70",
                  "name": "affected urls"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "union isfuzzy=true\n(\n    // -------- AzureDiagnostics (AD) --------\n    AzureDiagnostics\n    | where Category == \"ApplicationGatewayFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where tostring(column_ifexists(\"transactionId_g\", \"\")) == '{TransactionId}'\n    | extend\n        Action          = tostring(column_ifexists(\"action_s\", \"\")),\n        RuleSetType     = column_ifexists(\"ruleSetType_s\", \"\"),\n        RuleSetVersion  = column_ifexists(\"ruleSetVersion_s\", \"\"),\n        RuleId          = column_ifexists(\"ruleId_s\", \"\"),\n        RuleGroup       = iff(tostring(column_ifexists(\"ruleSetType_s\", \"\")) == \"Custom\", \"Custom Rules\", tostring(column_ifexists(\"ruleGroup_s\", \"\"))),\n        Hostname        = column_ifexists(\"hostname_s\", \"\"),\n        RequestUri      = column_ifexists(\"requestUri_s\", \"\"),\n        DetailsMessage  = column_ifexists(\"details_message_s\", \"\"),\n        DetailsData     = column_ifexists(\"details_data_s\", \"\"),\n        DetailsFile     = column_ifexists(\"details_file_s\", \"\"),\n        DetailsLine     = column_ifexists(\"details_line_s\", \"\"),\n        TransactionId   = tostring(column_ifexists(\"transactionId_g\", \"\")),\n        MessageText     = Message\n    | project\n        TimeGenerated,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleId,\n        RuleGroup,\n        MessageText,\n        DetailsMessage,\n        DetailsData,\n        Hostname,\n        RequestUri,\n        DetailsFile,\n        DetailsLine,\n        TransactionId\n),\n(\n    // -------- AGWFirewallLogs (RS) --------\n    AGWFirewallLogs\n    | where TimeGenerated {detectionTime}\n    | where TransactionId == '{TransactionId}'\n    | extend\n        Action          = tostring(column_ifexists(\"Action\", \"\")),\n        RuleSetType     = RuleSetType,\n        RuleSetVersion  = RuleSetVersion,\n        RuleId          = RuleId,\n        RuleGroup       = case(tostring(RuleSetType)==\"Custom\",\"Custom Rules\",tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(Bot)?(100|200|300)[1-9]00$\",case(tostring(RuleId) matches regex @\"^(Bot)?100\",\"BadBots\",tostring(RuleId) matches regex @\"^(Bot)?200\",\"GoodBots\",\"UnknownBots\"),tostring(RuleId) startswith \"99001\",\"MS-ThreatIntel-CVEs\",tostring(RuleId) startswith \"99005\",\"MS-ThreatIntel-WebShells\",tostring(RuleId) startswith \"99030\",\"MS-ThreatIntel-AppSec\",tostring(RuleId) startswith \"99031\",\"MS-ThreatIntel-SQLI\",tostring(RuleId) startswith \"99032\",\"MS-ThreatIntel-XSS\",tostring(RuleId) in (\"200002\",\"200003\",\"200004\"),\"General\",isnotempty(tostring(FileDetails)),replace_string(tostring(FileDetails),\".conf\",\"\"),\"Unknown\"),\n        Hostname        = Hostname,\n        RequestUri      = RequestUri,\n        DetailsMessage  = DetailedMessage,\n        DetailsData     = DetailedData,\n        DetailsFile     = \"\",\n        DetailsLine     = \"\",\n        TransactionId   = TransactionId,\n        MessageText     = Message\n    | project\n        TimeGenerated,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleId,\n        RuleGroup,\n        MessageText,\n        DetailsMessage,\n        DetailsData,\n        Hostname,\n        RequestUri,\n        DetailsFile,\n        DetailsLine,\n        TransactionId\n)\n| extend\n    Id = new_guid(),\n    RuleSet_V = strcat(RuleSetType, \" \", RuleSetVersion),\n    RuleId = case(tostring(RuleId) matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, tostring(RuleId))), tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", tostring(RuleId)), tostring(RuleId))\n| project\n    Action,\n    RuleSet_V,\n    RuleGroup,\n    RuleId,\n    MessageText,\n    DetailsMessage,\n    DetailsData,\n    TimeGenerated\n| distinct *\n| order by TimeGenerated asc",
                    "size": 0,
                    "title": "Rules Triggered for Selected Request ",
                    "noDataMessage": "The query returned no results. Please select a Tramsaction Id.",
                    "timeContextFromParameter": "detectionTime",
                    "exportedParameters": [
                      {
                        "fieldName": "transactionId_g",
                        "parameterName": "TransactionId",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "MessageText",
                        "parameterName": "message",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsMessage",
                        "parameterName": "details",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsData",
                        "parameterName": "matcheddata",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.network/applicationgateways",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Action",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Matched",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Blocked",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "CAPTCHA",
                                "representation": "more",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "success",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "RuleId",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "{RuleId}",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "Url",
                          "formatter": 5,
                          "formatOptions": {
                            "linkTarget": "Url",
                            "linkLabel": "Go to Core Rule Set Project GitHub for this rule"
                          }
                        },
                        {
                          "columnMatch": "statusFromAction",
                          "formatter": 1,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal"
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "RuleSet_V",
                          "label": "Ruleset Version"
                        },
                        {
                          "columnId": "RuleId",
                          "label": "Rule ID"
                        },
                        {
                          "columnId": "MessageText",
                          "label": "Description"
                        },
                        {
                          "columnId": "DetailsMessage",
                          "label": "Details"
                        },
                        {
                          "columnId": "DetailsData",
                          "label": "Matched Data"
                        },
                        {
                          "columnId": "TimeGenerated",
                          "label": "Time Generated"
                        },
                        {
                          "columnId": "Action",
                          "label": "Action (as logged)"
                        }
                      ]
                    }
                  },
                  "name": "TriggeredRules"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Selection summary\n\nYou are investigating requests that matched WAF rule **{RuleDisplayId}**.\n\nSelected request: host *{HostName}*, URL *{FullUri}*, transaction ID *{TransactionId}*.\n\nSelected rule match:\n- Message: {message}\n- Details: {details}\n- Matched data: {matcheddata}"
                  },
                  "name": "text - 7"
                }
              ],
              "exportParameters": true
            },
            "conditionalVisibility": {
              "parameterName": "SelectedTabPage",
              "comparison": "isEqualTo",
              "value": "investigate-by-rule"
            },
            "name": "Investigate by rule"
          }
        ],
        "exportParameters": true
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "investigate-tab"
      },
      "name": "Investigate Page"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [
                {
                  "id": "9a5fb8f4-61fa-4a63-bc89-ade6a64187a9",
                  "cellValue": "MonitorSelectedTab",
                  "linkTarget": "parameter",
                  "linkLabel": "Azure WAF Logs",
                  "subTarget": "WAFLogsTab",
                  "style": "link"
                },
                {
                  "id": "b3e39e6e-e8ba-418d-a632-63b5903fd594",
                  "cellValue": "MonitorSelectedTab",
                  "linkTarget": "parameter",
                  "linkLabel": "Azure WAF Metrics ",
                  "subTarget": "WAFMetricsTab",
                  "style": "link"
                }
              ]
            },
            "name": "Workbook Tabs"
          },
          {
            "type": 1,
            "content": {
              "json": "---"
            },
            "name": "text - 12"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/applicationgatewaywebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet WafLogs = union isfuzzy=true\n(AzureDiagnostics | where OperationName == \"ApplicationGatewayFirewall\" or Category == \"ApplicationGatewayFirewallLog\" | where TimeGenerated {detectionTime} | where PolicyMatch(tostring(column_ifexists(\"policyId_s\", \"\"))) | extend RawAction=tostring(column_ifexists(\"action_s\", \"\")) | extend TrackingID=tostring(column_ifexists(\"transactionId_g\", \"\")),RuleId=tostring(column_ifexists(\"ruleId_s\", \"\")),RuleSetType=tostring(column_ifexists(\"ruleSetType_s\", \"\")),RuleSetVersion=tostring(column_ifexists(\"ruleSetVersion_s\", \"\")),RuleGroup=iff(tostring(column_ifexists(\"ruleSetType_s\", \"\"))==\"Custom\",\"Custom Rules\",tostring(column_ifexists(\"ruleGroup_s\", \"\"))),Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction),ClientIP=tostring(coalesce(column_ifexists(\"clientIp_s\", \"\"),column_ifexists(\"clientIP_s\", \"\"))),RequestUri=tostring(column_ifexists(\"requestUri_s\", \"\")),RuleDescription=tostring(Message),Details=tostring(column_ifexists(\"details_message_s\", \"\")),MatchedData=tostring(column_ifexists(\"details_data_s\", \"\")),Hostname=tostring(column_ifexists(\"hostname_s\", \"\")),LogSchema=\"AzureDiagnostics\" | extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema),\n(AGWFirewallLogs | where TimeGenerated {detectionTime} | where PolicyMatch(tostring(column_ifexists(\"PolicyId\", \"\"))) | extend RawAction=tostring(Action) | extend TrackingID=tostring(TransactionId),RuleId=tostring(RuleId),RuleSetType=tostring(RuleSetType),RuleSetVersion=tostring(RuleSetVersion),RuleGroup=case(tostring(RuleSetType)==\"Custom\",\"Custom Rules\",tostring(RuleSetType) contains \"BotManager\" or tostring(RuleId) matches regex @\"^(Bot)?(100|200|300)[1-9]00$\",case(tostring(RuleId) matches regex @\"^(Bot)?100\",\"BadBots\",tostring(RuleId) matches regex @\"^(Bot)?200\",\"GoodBots\",\"UnknownBots\"),tostring(RuleId) startswith \"99001\",\"MS-ThreatIntel-CVEs\",tostring(RuleId) startswith \"99005\",\"MS-ThreatIntel-WebShells\",tostring(RuleId) startswith \"99030\",\"MS-ThreatIntel-AppSec\",tostring(RuleId) startswith \"99031\",\"MS-ThreatIntel-SQLI\",tostring(RuleId) startswith \"99032\",\"MS-ThreatIntel-XSS\",tostring(RuleId) in (\"200002\",\"200003\",\"200004\"),\"General\",isnotempty(tostring(FileDetails)),replace_string(tostring(FileDetails),\".conf\",\"\"),\"Unknown\"),Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction),ClientIP=tostring(ClientIp),RequestUri=tostring(RequestUri),RuleDescription=tostring(Message),Details=tostring(DetailedMessage),MatchedData=tostring(DetailedData),Hostname=tostring(Hostname),LogSchema=\"ResourceSpecific\" | extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema)\n// Collapse records that were collected by both diagnostic settings modes during a migration\n| summarize arg_max(LogSchema, *) by TrackingID, RuleId, Action, TimeGenerated, Details, MatchedData;\nlet W = materialize(WafLogs);\nlet PerRequest = W\n| where isnotempty(Action) and isnotempty(TrackingID)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by TrackingID\n| extend FinalAction=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\");\nlet R = PerRequest | summarize Requests=count(), Blocked=countif(FinalAction==\"Blocked\"), Challenged=countif(FinalAction in (\"JSChallenge\",\"CAPTCHA\")), Logged=countif(FinalAction==\"Logged\");\nlet X = W | summarize SourceIPs=dcountif(ClientIP, isnotempty(ClientIP), 4), Rules=dcountif(RuleDisplayId, isnotempty(RuleDisplayId), 4);\nR | extend k=1 | join kind=inner (X | extend k=1) on k\n| project Tiles=pack_array(pack(\"Order\",1,\"Metric\",\"Requests with WAF matches\",\"Value\",Requests), pack(\"Order\",2,\"Metric\",\"Blocked\",\"Value\",Blocked), pack(\"Order\",3,\"Metric\",\"Challenged (JS / CAPTCHA)\",\"Value\",Challenged), pack(\"Order\",4,\"Metric\",\"Logged\",\"Value\",Logged), pack(\"Order\",5,\"Metric\",\"Source IPs\",\"Value\",SourceIPs), pack(\"Order\",6,\"Metric\",\"Rules triggered\",\"Value\",Rules))\n| mv-expand Tile=Tiles\n| project Order=toint(Tile.Order), Metric=tostring(Tile.Metric), Value=tolong(Tile.Value)\n| order by Order asc",
