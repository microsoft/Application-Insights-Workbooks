            "version": "KqlParameterItem/1.0",
            "name": "SelectedRuleSet",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "2ca92b25-4393-409c-ace8-79519922a8ed",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedRuleGroup",
            "type": 1,
