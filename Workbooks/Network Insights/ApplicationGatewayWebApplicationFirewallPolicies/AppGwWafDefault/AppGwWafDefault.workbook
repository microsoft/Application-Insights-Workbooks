                        "fieldName": "DetailsData",
                        "parameterName": "matcheddata",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "Url",
                        "parameterName": "SpiderLabsUrl",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.network/applicationgateways",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "action_s",
                          "formatter": 18,
                          "formatOptions": {
