(tostring(RuleId) matches regex @\"^(Bot)?100\",\"BadBots\",tostring(RuleId) matches regex @\"^(Bot)?200\",\"GoodBots\",\"UnknownBots\"),tostring(RuleId) startswith \"99001\",\"MS-ThreatIntel-CVEs\",tostring(RuleId) startswith \"99005\",\"MS-ThreatIntel-WebShells\",tostring(RuleId) startswith \"99030\",\"MS-ThreatIntel-AppSec\",tostring(RuleId) startswith \"99031\",\"MS-ThreatIntel-SQLI\",tostring(RuleId) startswith \"99032\",\"MS-ThreatIntel-XSS\",tostring(RuleId) in (\"200002\",\"200003\",\"200004\"),\"General\",isnotempty(tostring(FileDetails)),replace_string(tostring(FileDetails),\".conf\",\"\"),\"Unknown\"),Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction),ClientIP=tostring(ClientIp),RequestUri=tostring(RequestUri),RuleDescription=tostring(Message),Details=tostring(DetailedMessage),MatchedData=tostring(DetailedData),Hostname=tostring(Hostname),LogSchema=\"ResourceSpecific\" | extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema)\n// Collapse records that were collected by both diagnostic settings modes during a migration\n| summarize arg_max(LogSchema, *) by TrackingID, RuleId, Action, TimeGenerated, Details, MatchedData;\nlet RequestOutcomes = WafLogs\n| where isnotempty(TrackingID)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by TrackingID\n| extend FinalAction=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\")\n| project TrackingID,FinalAction;\nlet FilteredWafLogs = union isfuzzy=true\n(WafLogs | where isempty('{SelectedAction}')),\n(WafLogs\n | where isnotempty('{SelectedAction}')\n | join kind=inner RequestOutcomes on TrackingID\n | where '{SelectedAction}' contains FinalAction\n | project-away TrackingID1,FinalAction)\n| where isempty('{SelectedRuleSet}') or '{SelectedRuleSet}' contains iff(RuleSetType == \"Custom\",\"Custom Rules\",strcat(RuleSetType,\" \",RuleSetVersion))\n| where isempty('{SelectedRuleGroup}') or '{SelectedRuleGroup}' contains RuleGroup;\nFilteredWafLogs\n| where isempty('{RequestURI}') or RequestUri == '{RequestURI}'\n| where isempty('{SelectedRule}') or '{SelectedRule}' contains RuleDisplayId\n| summarize RequestsMatchingRule=dcountif(TrackingID,isnotempty(TrackingID)) by RuleDisplayId,bin(TimeGenerated,1h)\n| order by TimeGenerated asc",
