    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend\n    ResourceId = tostring(ResourceId),\n    policyScopeName = tostring(column_ifexists(\"policy_s\", \"NA\")),\n    policyScope = \"Azure Front Door WAF Policy\",\n    Action = tostring(column_ifexists(\"action_s\", \"NA\"))\n| summarize Count = count() by ResourceId, policyScopeName, policyScope, Action\n| evaluate pivot(Action, sum(Count), ResourceId, policyScope, policyScopeName)",
              "size": 1,
              "title": "Select the scope of the WAF policy",
              "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
              "timeContextFromParameter": "detectionTime",
              "showRefreshButton": true,
              "exportMultipleValues": true,
              "exportedParameters": [
                {
                  "fieldName": "policyScopeName",
                  "parameterName": "PolicyScope",
                  "parameterType": 1
                },
                {
                  "fieldName": "ResourceId",
                  "parameterName": "ResourceId",
                  "parameterType": 1
                }
              ],
              "queryType": 0,
              "resourceType": "microsoft.cdn/profiles",
              "crossComponentResources": [
                "{Associations}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Allow",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Allowed",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Block",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Blocked",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Log",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "AnomalyScoring",
