            "id": "02d532c9-b4b4-434e-a11a-38ee9f1e8f7a",
            "cellValue": "https://learn.microsoft.com/azure/web-application-firewall/afds/waf-front-door-monitor",
            "linkTarget": "Url",
            "linkLabel": " WAF monitoring and logging for Azure Front Door ",
            "preText": "Learn more about",
            "postText": "",
            "style": "link"
          }
        ]
      },
      "name": "instructions"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Resource}"
        ],
        "parameters": [
          {
            "id": "63ea93e5-3270-4447-9572-ad9e62095e7b",
            "version": "KqlParameterItem/1.0",
            "name": "Resource",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false,
              "componentIdOnly": true
            }
          },
          {
            "id": "f451ddc5-00e3-4fe7-908e-22d0be9ab59c",
            "version": "KqlParameterItem/1.0",
            "name": "detectionTime",
            "label": "Detection Time",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 604800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 300000
                },
                {
                  "durationMs": 900000
                },
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2419200000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                }
              ]
            }
          },
          {
            "id": "12476248-81b7-46af-a9b4-790f93306442",
            "version": "KqlParameterItem/1.0",
            "name": "Associations",
            "type": 5,
            "isRequired": true,
            "query": "resources\r\n| where type == 'microsoft.network/frontdoorwebapplicationfirewallpolicies'\r\n| where id =~  {Resource}          // or: | where id =~ '<full WAF policy resource id>'\r\n| extend spl = iff(isnull(properties.securityPolicyLinks), dynamic([]), properties.securityPolicyLinks),\r\n         fel = iff(isnull(properties.frontendEndpointLinks), dynamic([]), properties.frontendEndpointLinks)\r\n| project wafPolicyId = id, wafPolicyName = name, links = array_concat(spl, fel)\r\n| mv-expand link = links\r\n| extend linkId = tolower(tostring(link.id))\r\n| extend profileId = extract(@'^(.+/providers/microsoft\\.(?:cdn/profiles|network/frontdoors)/[^/]+)', 1, linkId)\r\n| where isnotempty(profileId)\r\n| summarize associationCount = count(), associations = make_set(linkId)\r\n          by wafPolicyId, wafPolicyName, profileId\r\n| join kind=leftouter (\r\n    resources\r\n    | where type in~ ('microsoft.cdn/profiles','microsoft.network/frontdoors')\r\n    | project profileId = tolower(id), profileName = name, profileType = type,\r\n              sku = tostring(sku.name), profileRg = resourceGroup, profileSub = subscriptionId\r\n  ) on profileId\r\n|  project Id=profileId1\r\n",
            "crossComponentResources": [
              "{Resource}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "value": [
              "value::all"
            ]
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "customWidth": "50",
      "name": "Workbook Parameters"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "tabs",
        "tabStyle": "bigger",
        "links": [
