                        "sortOrder": 2
                      }
                    ]
                  },
                  "customWidth": "100",
                  "name": "Rules Triggered for Selected Scope"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\n\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where ResourceId in (Resource_list)\n| where policy_s in (Policy_list)\n| extend Parts = split(tostring(ruleName_s), \"-\")\n| extend\n    RuleId = tostring(Parts[array_length(Parts)-1]),\n    RuleSetType = tostring(Parts[0]),\n    RuleSetVersion = tostring(Parts[1]),\n    RuleSet_V = strcat(tostring(Parts[0]), \"-\", tostring(Parts[1])),\n    Hostname = tostring(host_s)\n| where RuleSetVersion == trim(@'\"', '{RuleSetVersion}')\n| where action_s == trim(@'\"', '{selectedAction}')\n| where RuleId contains trim(@'\"', '{RuleId}')\n| summarize\n    total = count()\n    by hostname_s_noport = Hostname, RuleId\n| project hostname_s_noport, total\n| order by total desc",
                    "size": 0,
                    "title": "Impacted Hosts",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportFieldName": "hostname_s_noport",
                    "exportParameterName": "HostNameNoPort",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "labelSettings": [
                        {
                          "columnId": "hostname_s_noport",
                          "label": "Host"
                        },
                        {
                          "columnId": "total",
                          "label": "Total"
                        }
                      ]
                    }
                  },
                  "customWidth": "30",
                  "name": "Affected Hosts"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list   = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\n\nlet selectedActionParam = replace_string(tostring('{selectedAction}'), '\"', '');\nlet ruleIdParam         = replace_string(tostring('{RuleId}'), '\"', '');\nlet hostNameParam       = replace_string(tostring('{HostNameNoPort}'), '\"', '');\n\n// ---- AFD WAF transactions ----\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where ResourceId in (Resource_list)\n| where policy_s in (Policy_list)\n| where action_s == selectedActionParam\n| extend Parts = split(ruleName_s, \"-\")\n| extend\n    RuleSetType    = iff(array_length(Parts) > 0, tostring(Parts[0]), \"\"),\n    RuleSetVersion = iff(array_length(Parts) > 1, tostring(Parts[1]), \"\"),\n    RuleGroup      = iff(array_length(Parts) > 2, tostring(Parts[2]), \"\"),\n    RuleId         = iff(array_length(Parts) > 3, tostring(Parts[3]), ruleName_s),\n    Hostname       = iif(isempty(tostring(host_s)), \"NA\", tostring(host_s)),\n    TransactionId  = tostring(trackingReference_s)\n| where isempty(ruleIdParam) or RuleId == ruleIdParam or ruleName_s contains ruleIdParam\n| where isempty(hostNameParam) or Hostname contains hostNameParam\n| distinct TransactionId\n| join kind=inner\n(\n    // ---- AFD Access logs ----\n    AzureDiagnostics\n    | where Category == \"FrontDoorAccessLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in (Resource_list)\n    | extend\n        TransactionId = tostring(trackingReference_s),\n        HostNameCol   = tostring(column_ifexists(\"hostName_s\", \"\")),\n        HostCol       = tostring(column_ifexists(\"host_s\", \"\")),\n        RequestUriCol = tostring(column_ifexists(\"requestUri_s\", \"\")),\n        HttpMethodCol = tostring(column_ifexists(\"httpMethod_s\", \"\"))\n    | extend\n        host_s1 = iif(isempty(HostNameCol), HostCol, HostNameCol),\n        requestUri_s1 = RequestUriCol,\n        httpMethod_s1 = HttpMethodCol,\n        originalRequestUriWithArgs_s1 = RequestUriCol\n    | project\n        TransactionId,\n        host_s1,\n        requestUri_s1,\n        httpMethod_s1,\n        originalRequestUriWithArgs_s1\n)\non TransactionId\n| extend\n    access_log = strcat(\n        'AzureDiagnostics | where Category == \"FrontDoorAccessLog\" | where TimeGenerated {detectionTime} | where trackingReference_s == \"',\n        TransactionId,\n        '\"'\n    ),\n    firewall_log = strcat(\n        'AzureDiagnostics | where Category == \"FrontDoorWebApplicationFirewallLog\" | where TimeGenerated {detectionTime} | where trackingReference_s == \"',\n        TransactionId,\n        '\"'\n    )\n| project\n    host_s1,\n    requestUri_s1,\n    httpMethod_s1,\n    originalRequestUriWithArgs_s1,\n    transactionId_g = TransactionId,\n    access_log,\n    firewall_log\n| order by\n    host_s1,\n    requestUri_s1,\n    httpMethod_s1,\n    originalRequestUriWithArgs_s1,\n    transactionId_g\n| extend id = new_guid()",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rule-Impacted URLs for Selected Host",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "httpMethod_s1",
                        "parameterName": "Method",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "originalRequestUriWithArgs_s1",
                        "parameterName": "FullUri",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "requestUri_s1",
                        "parameterName": "RequestUri",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "transactionId_g",
                        "parameterName": "TransactionId",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "host_s1",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "requestUri_s1",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "access_log",
                          "formatter": 7,
                          "formatOptions": {
                            "linkTarget": "OpenBlade",
                            "linkLabel": "Find in Access Log",
                            "linkIsContextBlade": true,
                            "bladeOpenContext": {
                              "bladeName": "LogsBlade",
                              "extensionName": "Microsoft_Azure_Monitoring_Logs",
                              "bladeParameters": [
                                {
                                  "name": "resourceId",
                                  "source": "parameter",
                                  "value": "ResourceId"
                                },
                                {
                                  "name": "source",
