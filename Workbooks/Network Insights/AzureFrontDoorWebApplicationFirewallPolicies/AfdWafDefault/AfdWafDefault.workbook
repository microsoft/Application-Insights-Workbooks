                    "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet ToPathQuery = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet ToPath = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^?#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet WafLogs = AzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where PolicyMatch(tostring(column_ifexists(\"policy_s\", \"\")))\n| extend WafRuleName=tostring(column_ifexists(\"ruleName_s\",\"\")), WafRuleSetTypeField=tostring(column_ifexists(\"ruleSetType_s\",\"\")), WafRuleGroupField=tostring(column_ifexists(\"ruleGroup_s\",\"\"))\n| extend IsCustomRule = WafRuleSetTypeField =~ \"Custom\" or WafRuleGroupField =~ \"Custom\" or WafRuleGroupField =~ \"Custom Rules\" or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\")\n| extend Parts=split(WafRuleName,\"-\")\n| extend RuleId=iff(IsCustomRule, WafRuleName, tostring(Parts[array_length(Parts)-1])), RuleSetType=iff(IsCustomRule,\"Custom\",tostring(Parts[0])), RuleSetVersion=iff(IsCustomRule,\"\",tostring(Parts[1]))\n| extend RuleGroup=iff(IsCustomRule,\"Custom Rules\",iff(isnotempty(WafRuleGroupField),WafRuleGroupField,substring(WafRuleName,strlen(RuleSetType)+strlen(RuleSetVersion)+2,strlen(WafRuleName)-strlen(RuleSetType)-strlen(RuleSetVersion)-strlen(RuleId)-3)))\n| extend RawAction=tostring(column_ifexists(\"action_s\",\"\"))\n| extend Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction)\n| extend TrackingID=tostring(column_ifexists(\"trackingReference_s\",\"\")), ClientIP=tostring(coalesce(column_ifexists(\"clientIP_s\",\"\"),column_ifexists(\"clientIp_s\",\"\"))), RequestUri=ToPathQuery(tostring(column_ifexists(\"requestUri_s\",\"\"))), RuleDescription=tostring(column_ifexists(\"details_msg_s\",\"\")), Details=tostring(column_ifexists(\"details_msg_s\",\"\")), MatchedData=tostring(column_ifexists(\"details_matches_s\",\"\")), Hostname=tostring(column_ifexists(\"host_s\",\"\")), LogSchema=\"AzureDiagnostics\"\n| project TimeGenerated,TrackingID,RuleId,RuleSetType,RuleSetVersion,RuleGroup,Action,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema;\nWafLogs\n| where RuleSetType == \"Custom\"\n| summarize RuleMatches=count() by bin(TimeGenerated, 5m)\n| order by TimeGenerated asc",
