          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where ResourceId in (Resource_list)\n| where tostring(column_ifexists(\"policy_s\", \"NA\")) in (Policy_list)\n| extend Hostname = iif(isempty(tostring(column_ifexists(\"host_s\", \"\"))), \"NA\", tostring(column_ifexists(\"host_s\", \"\")))\n| extend hostname_s_noport = tostring(split(Hostname, ':')[0])\n| summarize total=count() by hostname_s_noport\n| order by total desc",
                    "size": 0,
                    "title": "Impacted Hosts",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportFieldName": "hostname_s_noport",
                    "exportParameterName": "HostName",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "hostname_s_noport",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "100%"
                          }
                        }
                      ],
                      "sortBy": [
                        {
                          "itemKey": "hostname_s_noport",
                          "sortOrder": 1
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "hostname_s_noport",
                          "label": "Host"
                        },
                        {
                          "columnId": "total",
                          "label": "Total"
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "hostname_s_noport",
                        "sortOrder": 1
                      }
                    ]
                  },
                  "customWidth": "30",
                  "name": "Hostnames with entries in Firewall Log"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\nlet FirewallTransactions =\n    AzureDiagnostics\n    | where Category == \"FrontDoorWebApplicationFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in (Resource_list)\n    | where tostring(column_ifexists(\"policy_s\", \"NA\")) in (Policy_list)\n    | extend Hostname = iif(isempty(tostring(column_ifexists(\"host_s\", \"\"))), \"NA\", tostring(column_ifexists(\"host_s\", \"\")))\n    | where Hostname contains '{HostName}'\n    | project TrackingReference = tostring(column_ifexists(\"trackingReference_s\", \"\"));\nFirewallTransactions\n| join kind=inner (\n    AzureDiagnostics\n    | where Category == \"FrontDoorAccessLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in (Resource_list)\n    | project\n        TrackingReference = tostring(column_ifexists(\"trackingReference_s\", \"\")),\n        requestUri = tostring(column_ifexists(\"requestUri_s\", \"\")),\n        originalUri = tostring(column_ifexists(\"requestUri_s\", \"\")),\n        httpMethod = tostring(column_ifexists(\"httpMethod_s\", \"\")),\n        httpStatus = tostring(column_ifexists(\"httpStatusCode_s\", column_ifexists(\"httpStatusCode_d\", \"\")))\n) on TrackingReference\n| extend\n    access_log = strcat(\"AzureDiagnostics | where Category == \\\"FrontDoorAccessLog\\\" | where TimeGenerated {detectionTime} | where trackingReference_s == \\\"\", TrackingReference, \"\\\"\"),\n    firewall_log = strcat(\"AzureDiagnostics | where Category == \\\"FrontDoorWebApplicationFirewallLog\\\" | where TimeGenerated {detectionTime} | where trackingReference_s == \\\"\", TrackingReference, \"\\\"\")\n| project requestUri, originalUri, httpMethod, httpStatus, TransactionId = TrackingReference, access_log, firewall_log",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "URL Impacted for Selected Scope",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "requestUri",
                        "parameterName": "RequestUri"
                      },
                      {
                        "fieldName": "originalUri",
                        "parameterName": "RequestUriWithArgs",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "httpMethod",
                        "parameterName": "HttpMethod",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "httpStatus",
                        "parameterName": "HttpStatus",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "TransactionId",
                        "parameterName": "TransactionId",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "$gen_group",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "64.4266ch"
                          }
                        },
                        {
                          "columnMatch": "requestUri",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "access_log",
                          "formatter": 7,
                          "formatOptions": {
                            "linkTarget": "OpenBlade",
                            "linkLabel": "Find in Access Log",
                            "linkIsContextBlade": true,
                            "bladeOpenContext": {
                              "bladeName": "LogsBlade",
                              "extensionName": "Microsoft_Azure_Monitoring_Logs",
                              "bladeParameters": [
                                {
                                  "name": "resourceId",
                                  "source": "parameter",
                                  "value": "ResourceId"
                                },
                                {
                                  "name": "source",
                                  "source": "static",
                                  "value": "Microsoft_Azure_Monitoring_Logs/LogsBlade"
                                },
                                {
                                  "name": "query",
                                  "source": "cell",
                                  "value": ""
                                }
                              ]
                            }
                          }
                        },
                        {
                          "columnMatch": "firewall_log",
                          "formatter": 7,
                          "formatOptions": {
                            "linkTarget": "OpenBlade",
                            "linkLabel": "Find in Firewall Log",
                            "linkIsContextBlade": true,
                            "bladeOpenContext": {
                              "bladeName": "LogsBlade",
                              "extensionName": "Microsoft_Azure_Monitoring_Logs",
                              "bladeParameters": [
                                {
                                  "name": "resourceId",
                                  "source": "parameter",
                                  "value": "ResourceId"
                                },
                                {
                                  "name": "source",
                                  "source": "static",
                                  "value": "Microsoft_Azure_Monitoring_Logs/LogsBlade"
                                },
                                {
                                  "name": "query",
                                  "source": "cell",
                                  "value": ""
                                }
                              ]
                            }
                          }
                        },
                        {
                          "columnMatch": "-- Group By --",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "64.4266ch"
                          }
                        }
                      ],
                      "filter": true,
                      "hierarchySettings": {
                        "treeType": 1,
                        "groupBy": [
                          "requestUri"
                        ],
                        "expandTopLevel": false,
                        "finalBy": "requestUri"
                      },
                      "labelSettings": [
                        {
                          "columnId": "requestUri",
                          "label": "Request URI"
                        },
                        {
                          "columnId": "originalUri",
                          "label": "Original Request"
                        },
                        {
                          "columnId": "httpMethod",
                          "label": "HTTP Method"
                        },
                        {
                          "columnId": "httpStatus",
                          "label": "HTTP Status"
                        },
                        {
                          "columnId": "TransactionId",
                          "label": "Request Id"
                        },
                        {
                          "columnId": "access_log",
                          "label": "Access Log"
                        },
                        {
                          "columnId": "firewall_log",
                          "label": "Firewall Log"
                        }
                      ]
                    }
                  },
                  "customWidth": "70",
                  "name": "Paths which have triggered firewall rules"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where tostring(trackingReference_s) == '{TransactionId}'\n| extend\n    Parts = split(tostring(ruleName_s), \"-\"),\n    Action = tostring(action_s),\n    MessageText = tostring(details_msg_s),\n    DetailsMessage = tostring(details_msg_s),\n    DetailsMatches = tostring(details_matches_s)\n| extend\n    RuleId = tostring(Parts[array_length(Parts)-1]),\n    RuleSetType = tostring(Parts[0]),\n    RuleSetVersion = tostring(Parts[1])\n| extend\n    RuleSet_V = strcat(RuleSetType, \"-\", RuleSetVersion)\n| extend\n    RuleGroup = substring(\n        tostring(ruleName_s),\n        strlen(RuleSet_V) + 1,\n        strlen(tostring(ruleName_s)) - strlen(RuleSet_V) - strlen(RuleId) - 2\n    )\n| project\n    Action,\n    RuleId,\n    RuleSet_V,\n    RuleGroup,\n    MessageText,\n    DetailsMessage,\n    DetailsMatches,\n    TimeGenerated\n| order by TimeGenerated asc",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rules Triggered for Selected Request",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "MessageText",
                        "parameterName": "message",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsMessage",
                        "parameterName": "details",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsData",
                        "parameterName": "matcheddata",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Action",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Block",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Blocked",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "AnomalyScoring",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "success",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "RuleId",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "{RuleId}",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "RuleId",
                          "label": "Rule Id"
                        },
                        {
                          "columnId": "RuleSet_V",
                          "label": "Ruleset Version"
                        },
                        {
                          "columnId": "RuleGroup",
                          "label": "Rule Group"
                        },
                        {
                          "columnId": "MessageText",
                          "label": "Description"
                        },
                        {
                          "columnId": "DetailsMessage",
                          "label": "Details"
                        },
                        {
                          "columnId": "DetailsMatches",
                          "label": "Matched Data"
                        },
                        {
                          "columnId": "TimeGenerated",
                          "label": "Time Generated"
                        }
                      ]
                    }
                  },
                  "name": "TriggeredRules - By Url"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Selection Summary:\r\n\r\nYou were looking for requests which triggered a WAF rule on url: _{RequestUri}_.  \r\nYou have found an HTTP request with request id equal to *{TransactionId}*.  \r\n\r\nMore info on this request and the selected rule:\r\n- Message: {message}\r\n- Details: {details}\r\n- Matched Data: {matcheddata}"
                  },
                  "name": "URL Triage Selection Summary"
                }
              ],
              "exportParameters": true
            },
            "conditionalVisibility": {
              "parameterName": "SelectedTabPage",
              "comparison": "isEqualTo",
              "value": "triage-by-url"
            },
            "name": "Triage by URL"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\n\nlet Base =\n    AzureDiagnostics\n    | where Category == \"FrontDoorWebApplicationFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in (Resource_list)\n    | where tostring(policy_s) in (Policy_list)\n    | extend\n        RuleName = tostring(ruleName_s),\n        Parts = split(tostring(ruleName_s), \"-\"),\n        Action = tostring(action_s),\n        PolicyScopeName = tostring(policy_s),\n        PolicyScope = \"Azure Front Door WAF Policy\"\n    | extend\n        RuleId = tostring(Parts[array_length(Parts)-1]),\n        RuleSetType = tostring(Parts[0]),\n        RuleSetVersion = tostring(Parts[1])\n    | extend\n        RuleSet_V = strcat(RuleSetType, \"-\", RuleSetVersion)\n    | extend\n        RuleGroup = substring(\n            RuleName,\n            strlen(RuleSet_V) + 1,\n            strlen(RuleName) - strlen(RuleSet_V) - strlen(RuleId) - 2\n        );\n\nBase\n| summarize Count=count()\n    by\n        RuleId,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleSet_V,\n        RuleGroup,\n        RuleName,\n        ResourceId,\n        PolicyScopeName,\n        PolicyScope\n\n| join kind=inner (\n    Base\n    | make-series Trend=count()\n        on TimeGenerated\n        from ago(7d)\n        to now()\n        step (time(604800 seconds) / 20)\n        by RuleId\n) on RuleId\n\n| project-away RuleId1\n\n| project-reorder\n    Count,\n    RuleId,\n    Action,\n    RuleSet_V,\n    RuleGroup,\n    ResourceId,\n    PolicyScopeName,\n    PolicyScope,\n    Trend\n\n| order by Count desc",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rules Triggered for Selected Scope",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
