                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend Action=tostring(column_ifexists(\"action_s\", \"\"))\n| summarize Requests=count() by Action, bin(TimeGenerated, 5m)\n| order by TimeGenerated asc",
