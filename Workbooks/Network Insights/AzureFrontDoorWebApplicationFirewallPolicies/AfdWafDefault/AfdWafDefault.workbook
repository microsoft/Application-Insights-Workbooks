{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "WAF data is shown only if Diagnostic Settings are enabled for the Azure Front Door profile and WAF policy associations.",
        "style": "info"
      },
      "name": "Diagnostic Settings Note"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
