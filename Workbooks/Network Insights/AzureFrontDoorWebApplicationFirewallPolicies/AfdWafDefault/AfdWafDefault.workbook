                          "columnId": "RuleId",
                          "label": "Rule ID"
                        },
                        {
                          "columnId": "RuleSet_V",
                          "label": "Ruleset Version"
                        },
                        {
                          "columnId": "RuleGroup",
                          "label": "Rule Group"
                        },
                        {
                          "columnId": "ResourceId",
                          "label": "Azure Front Door"
                        },
                        {
                          "columnId": "PolicyScopeName",
                          "label": "Scope Name"
                        },
                        {
