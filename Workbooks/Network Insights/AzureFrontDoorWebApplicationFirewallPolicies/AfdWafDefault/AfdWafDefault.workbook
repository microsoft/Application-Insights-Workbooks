                  "customWidth": "70",
                  "name": "affected urls"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where tostring(column_ifexists(\"trackingReference_s\", \"\")) == '{TransactionId}'\n| extend WafRuleName=tostring(column_ifexists(\"ruleName_s\",\"\")), WafRuleSetTypeField=tostring(column_ifexists(\"ruleSetType_s\",\"\")), WafRuleGroupField=tostring(column_ifexists(\"ruleGroup_s\",\"\"))\n| extend IsCustomRule=WafRuleSetTypeField =~ \"Custom\" or WafRuleGroupField =~ \"Custom\" or WafRuleGroupField =~ \"Custom Rules\"\n    or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\"), Parts=split(WafRuleName,\"-\")\n| extend ParsedRuleToken=iff(array_length(Parts)>0,tostring(Parts[array_length(Parts)-1]),\"\"), RuleSetType=iff(array_length(Parts)>0,tostring(Parts[0]),\"\"), RuleSetVersion=iff(array_length(Parts)>1,tostring(Parts[1]),\"\")\n| extend DerivedRuleGroup=substring(WafRuleName,strlen(strcat(RuleSetType,\"-\",RuleSetVersion))+1,strlen(WafRuleName)-strlen(strcat(RuleSetType,\"-\",RuleSetVersion))-strlen(ParsedRuleToken)-2)\n| extend RuleGroup=iff(IsCustomRule,\"[Custom Rules]\",iff(isnotempty(WafRuleGroupField),WafRuleGroupField,DerivedRuleGroup))\n| extend RuleId=case(IsCustomRule,coalesce(tostring(column_ifexists(\"customRuleName_s\",\"\")),WafRuleName),ParsedRuleToken matches regex @\"^[0-9]+$\",ParsedRuleToken,\"\"), RuleSet_V=iff(IsCustomRule,\"Custom\",strcat(RuleSetType,\" \",RuleSetVersion)), Action=tostring(column_ifexists(\"action_s\", \"\")), MessageText=tostring(column_ifexists(\"details_msg_s\", \"\")), DetailsMessage=tostring(column_ifexists(\"details_msg_s\", \"\")), MatchedData=tostring(column_ifexists(\"details_matches_s\", \"\"))\n| extend RuleId=case(iff(isempty(RuleId), ParsedRuleToken, RuleId) matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, iff(isempty(RuleId), ParsedRuleToken, RuleId))), RuleSetType contains \"BotManager\" or iff(isempty(RuleId), ParsedRuleToken, RuleId) matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", iff(isempty(RuleId), ParsedRuleToken, RuleId)), iff(isempty(RuleId), ParsedRuleToken, RuleId))\n| project Action,RuleSet_V,RuleGroup,RuleId,MessageText,DetailsMessage,MatchedData,TimeGenerated\n| order by TimeGenerated asc",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rules Triggered for Selected Request",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "MessageText",
                        "parameterName": "message",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsMessage",
                        "parameterName": "details",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "MatchedData",
                        "parameterName": "matcheddata",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "DetailsMessage",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "Action",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Block",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Blocked",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "JSChallenge",
                                "representation": "more",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "CAPTCHA",
                                "representation": "more",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "success",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "RuleId",
                          "formatter": 18,
                          "formatOptions": {
