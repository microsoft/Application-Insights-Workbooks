    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [
                {
                  "id": "9a5fb8f4-61fa-4a63-bc89-ade6a64187a9",
                  "cellValue": "MonitorSelectedTab",
                  "linkTarget": "parameter",
                  "linkLabel": "Azure WAF Logs",
                  "subTarget": "WAFLogsTab",
                  "style": "link"
                },
                {
                  "id": "b3e39e6e-e8ba-418d-a632-63b5903fd594",
                  "cellValue": "MonitorSelectedTab",
                  "linkTarget": "parameter",
                  "linkLabel": "Azure WAF Metrics",
                  "subTarget": "WAFMetricsTab",
                  "style": "link"
                }
              ]
            },
            "name": "Workbook Tabs"
          },
          {
            "type": 1,
            "content": {
              "json": "---"
            },
            "name": "text - 12"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet ToPathQuery = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet ToPath = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^?#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet WafLogs = AzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where PolicyMatch(tostring(column_ifexists(\"policy_s\", \"\")))\n| extend WafRuleName=tostring(column_ifexists(\"ruleName_s\",\"\")), WafRuleSetTypeField=tostring(column_ifexists(\"ruleSetType_s\",\"\")), WafRuleGroupField=tostring(column_ifexists(\"ruleGroup_s\",\"\"))\n| extend IsCustomRule = WafRuleSetTypeField =~ \"Custom\" or WafRuleGroupField =~ \"Custom\" or WafRuleGroupField =~ \"Custom Rules\" or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\")\n| extend Parts=split(WafRuleName,\"-\")\n| extend RuleId=iff(IsCustomRule, WafRuleName, tostring(Parts[array_length(Parts)-1])), RuleSetType=iff(IsCustomRule,\"Custom\",tostring(Parts[0])), RuleSetVersion=iff(IsCustomRule,\"\",tostring(Parts[1]))\n| extend RuleGroup=iff(IsCustomRule,\"Custom Rules\",iff(isnotempty(WafRuleGroupField),WafRuleGroupField,substring(WafRuleName,strlen(RuleSetType)+strlen(RuleSetVersion)+2,strlen(WafRuleName)-strlen(RuleSetType)-strlen(RuleSetVersion)-strlen(RuleId)-3)))\n| extend RawAction=tostring(column_ifexists(\"action_s\",\"\"))\n| extend Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction)\n| extend TrackingID=tostring(column_ifexists(\"trackingReference_s\",\"\")), ClientIP=tostring(coalesce(column_ifexists(\"clientIP_s\",\"\"),column_ifexists(\"clientIp_s\",\"\"))), RequestUri=ToPathQuery(tostring(column_ifexists(\"requestUri_s\",\"\"))), RuleDescription=tostring(column_ifexists(\"details_msg_s\",\"\")), Details=tostring(column_ifexists(\"details_msg_s\",\"\")), MatchedData=tostring(column_ifexists(\"details_matches_s\",\"\")), Hostname=tostring(column_ifexists(\"host_s\",\"\")), LogSchema=\"AzureDiagnostics\"\n| extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema;\nlet W = materialize(WafLogs);\nlet PerRequest = W\n| where isnotempty(Action) and isnotempty(TrackingID)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by TrackingID\n| extend FinalAction=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\");\nlet R = PerRequest | summarize Requests=count(), Blocked=countif(FinalAction==\"Blocked\"), Challenged=countif(FinalAction in (\"JSChallenge\",\"CAPTCHA\")), Logged=countif(FinalAction==\"Logged\");\nlet X = W | summarize SourceIPs=dcountif(ClientIP, isnotempty(ClientIP), 4), Rules=dcountif(RuleDisplayId, isnotempty(RuleDisplayId), 4);\nR | extend k=1 | join kind=inner (X | extend k=1) on k\n| project Tiles=pack_array(pack(\"Order\",1,\"Metric\",\"Requests with WAF matches\",\"Value\",Requests), pack(\"Order\",2,\"Metric\",\"Blocked\",\"Value\",Blocked), pack(\"Order\",3,\"Metric\",\"Challenged (JS / CAPTCHA)\",\"Value\",Challenged), pack(\"Order\",4,\"Metric\",\"Logged\",\"Value\",Logged), pack(\"Order\",5,\"Metric\",\"Source IPs\",\"Value\",SourceIPs), pack(\"Order\",6,\"Metric\",\"Rules triggered\",\"Value\",Rules))\n| mv-expand Tile=Tiles\n| project Order=toint(Tile.Order), Metric=tostring(Tile.Metric), Value=tolong(Tile.Value)\n| order by Order asc",
                    "size": 4,
                    "title": "Summary for the selected time range",
                    "noDataMessage": "No WAF log records were found for the selected time range and associations.",
                    "timeContextFromParameter": "detectionTime",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "tiles",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Metric",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Value",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 0,
                          "options": {
                            "style": "decimal",
                            "useGrouping": true,
                            "maximumFractionDigits": 0
                          }
                        }
                      },
                      "showBorder": true
                    }
                  },
                  "name": "query - kpi summary"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nlet ToPathQuery = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet ToPath = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^?#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet WafLogs = AzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where PolicyMatch(tostring(column_ifexists(\"policy_s\", \"\")))\n| extend WafRuleName=tostring(column_ifexists(\"ruleName_s\",\"\")), WafRuleSetTypeField=tostring(column_ifexists(\"ruleSetType_s\",\"\")), WafRuleGroupField=tostring(column_ifexists(\"ruleGroup_s\",\"\"))\n| extend IsCustomRule = WafRuleSetTypeField =~ \"Custom\" or WafRuleGroupField =~ \"Custom\" or WafRuleGroupField =~ \"Custom Rules\" or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\")\n| extend Parts=split(WafRuleName,\"-\")\n| extend RuleId=iff(IsCustomRule, WafRuleName, tostring(Parts[array_length(Parts)-1])), RuleSetType=iff(IsCustomRule,\"Custom\",tostring(Parts[0])), RuleSetVersion=iff(IsCustomRule,\"\",tostring(Parts[1]))\n| extend RuleGroup=iff(IsCustomRule,\"Custom Rules\",iff(isnotempty(WafRuleGroupField),WafRuleGroupField,substring(WafRuleName,strlen(RuleSetType)+strlen(RuleSetVersion)+2,strlen(WafRuleName)-strlen(RuleSetType)-strlen(RuleSetVersion)-strlen(RuleId)-3)))\n| extend RawAction=tostring(column_ifexists(\"action_s\",\"\"))\n| extend Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction)\n| extend TrackingID=tostring(column_ifexists(\"trackingReference_s\",\"\")), ClientIP=tostring(coalesce(column_ifexists(\"clientIP_s\",\"\"),column_ifexists(\"clientIp_s\",\"\"))), RequestUri=ToPathQuery(tostring(column_ifexists(\"requestUri_s\",\"\"))), RuleDescription=tostring(column_ifexists(\"details_msg_s\",\"\")), Details=tostring(column_ifexists(\"details_msg_s\",\"\")), MatchedData=tostring(column_ifexists(\"details_matches_s\",\"\")), Hostname=tostring(column_ifexists(\"host_s\",\"\")), LogSchema=\"AzureDiagnostics\"\n| extend RuleDisplayId=case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId) | project TimeGenerated,TrackingID,RuleId,RuleDisplayId,RuleSetType,RuleSetVersion,RuleGroup,Action,RawAction,ClientIP,RequestUri,RuleDescription,Details,MatchedData,Hostname,LogSchema;\nlet Pie1Logs = WafLogs;\nPie1Logs\n| extend RuleSetOrCustomRule=iff(RuleSetType == \"Custom\",\"Custom Rules\",strcat(RuleSetType,\" \",RuleSetVersion))\n| where isnotempty(RuleSetOrCustomRule)\n| summarize number=dcountif(TrackingID,isnotempty(TrackingID)) by series=RuleSetOrCustomRule\n| order by number desc",
                    "size": 3,
                    "showAnalytics": true,
                    "title": "Requests by Rule Set / Custom Rule (select to filter)",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportMultipleValues": true,
                    "exportedParameters": [
                      {
                        "fieldName": "series",
                        "parameterName": "SelectedRuleSet"
                      }
                    ],
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "piechart"
                  },
                  "customWidth": "33",
                  "name": "Total by RuleSet or Custom Rule"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
