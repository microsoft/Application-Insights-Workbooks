          },
          {
            "id": "12476248-81b7-46af-a9b4-790f93306442",
            "version": "KqlParameterItem/1.0",
            "name": "Associations",
            "type": 5,
            "isRequired": true,
            "query": "resources\n| where type == 'microsoft.network/frontdoorwebapplicationfirewallpolicies'\n| where id =~  {Resource}          // or: | where id =~ '<full WAF policy resource id>'\n| extend spl = iff(isnull(properties.securityPolicyLinks), dynamic([]), properties.securityPolicyLinks),\n         fel = iff(isnull(properties.frontendEndpointLinks), dynamic([]), properties.frontendEndpointLinks)\n| project wafPolicyId = id, wafPolicyName = name, links = array_concat(spl, fel)\n| mv-expand link = links\n| extend linkId = tolower(tostring(link.id))\n| extend profileId = extract(@'^(.+/providers/microsoft\\.(?:cdn/profiles|network/frontdoors)/[^/]+)', 1, linkId)\n| where isnotempty(profileId)\n| summarize associationCount = count(), associations = make_set(linkId)\n          by wafPolicyId, wafPolicyName, profileId\n| join kind=leftouter (\n    resources\n    | where type in~ ('microsoft.cdn/profiles','microsoft.network/frontdoors')\n    | project profileId = tolower(id), profileName = name, profileType = type,\n              sku = tostring(sku.name), profileRg = resourceGroup, profileSub = subscriptionId\n  ) on profileId\n|  project Id=profileId1\n",
            "crossComponentResources": [
              "{Resource}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "value": [
              "value::all"
            ]
          },
          {
            "id": "8dd96c4f-47a2-4d4a-a09f-38dba58f1e3f",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedRule",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "db5e0120-cd0e-4d42-9490-fcfc41229905",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedClientIP",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "ebe2bcdd-b130-4796-b139-e9fa41a3a69c",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedTrackingID",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "9ea7c9e3-4c43-4d1c-b8d6-f8ddadec3feb",
            "version": "KqlParameterItem/1.0",
            "name": "RequestURI",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "2b6e6762-ebff-42e1-ad0d-95f5cdbe37f1",
            "version": "KqlParameterItem/1.0",
            "name": "MessageFilter",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "25aa92a0-e6dd-497f-88a2-8355c47a271b",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedRuleSet",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "2ca92b25-4393-409c-ace8-79519922a8ed",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedRuleGroup",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "id": "e61a8982-221e-4cf3-8cf3-fae0d00298ce",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedAction",
            "type": 1,
            "value": "",
            "isHiddenWhenLocked": true
          },
          {
            "version": "KqlParameterItem/1.0",
            "type": 1,
            "isHiddenWhenLocked": true,
            "crossComponentResources": [
              "{Associations}"
            ],
            "timeContextFromParameter": "detectionTime",
            "queryType": 0,
            "resourceType": "microsoft.cdn/profiles",
            "id": "0c732e95-892c-49ab-9bd4-840f5341122a",
            "name": "PolicyActivityNotice",
            "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\n// Notice: \"yes\" when this WAF policy processed no requests, but other WAF policies on the same resources did\nAzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| project P = tostring(column_ifexists(\"policy_s\", \"\"))\n| summarize Total = count(), ThisPolicy = countif(PolicyMatch(P))\n| project Value = iff(array_length(SelectedPolicies) > 0 and Total > 0 and ThisPolicy == 0, \"yes\", \"no\")"
          },
          {
            "version": "KqlParameterItem/1.0",
            "type": 1,
            "isHiddenWhenLocked": true,
            "crossComponentResources": [
              "{Associations}"
            ],
            "timeContextFromParameter": "detectionTime",
            "queryType": 0,
            "resourceType": "microsoft.cdn/profiles",
            "id": "90ab4487-f0b8-423c-9f0a-19bacf5003a6",
            "name": "OtherPolicyNames",
            "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\n// Names of the other WAF policies that processed requests on the same resources\nAzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| project P = tostring(column_ifexists(\"policy_s\", \"\"))\n| where isnotempty(P) and not(PolicyMatch(P))\n| extend Name = iff(P contains \"/\" or P contains \"#\", extract(@\"(?i)frontdoorwebapplicationfirewallpolicies[/_](.+)$\", 1, P), P)\n| where isnotempty(Name)\n| summarize Records = count() by Name\n| top 5 by Records desc\n| summarize Names = strcat_array(make_list(Name), \", \")"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "customWidth": "50",
      "name": "parameters - 0"
    },
    {
      "type": 11,
