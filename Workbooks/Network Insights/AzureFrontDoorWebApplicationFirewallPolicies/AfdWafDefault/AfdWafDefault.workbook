                    }
                  },
                  "name": "TriggeredRules"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Selection summary\n\nYou are investigating requests that matched WAF rule **{RuleDisplayId}**.\n\nSelected request: host *{HostNameNoPort}*, URL *{FullUri}*, tracking reference *{TransactionId}*.\n\nSelected rule match:\n- Message: {message}\n- Matched data: {matcheddata}"
                  },
                  "name": "text - 7"
                }
              ],
