                  "name": "TriggeredRules - By Url"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Selection summary\n\nYou are investigating requests to URL *{RequestUri}* that matched WAF rules.\n\nSelected request: tracking reference *{TransactionId}*.\n\nSelected rule match:\n- Message: {message}\n- Matched data: {matcheddata}"
                  },
                  "name": "text - 7 - Copy"
                }
              ],
              "exportParameters": true
            },
            "conditionalVisibility": {
              "parameterName": "SelectedTabPage",
              "comparison": "isEqualTo",
              "value": "investigate-by-url"
            },
            "name": "Investigate by URL"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\n\nlet Base =\n    AzureDiagnostics\n    | where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n    | where TimeGenerated {detectionTime}\n| extend WafRuleName = tostring(column_ifexists(\"ruleName_s\", \"\")),\n    WafRuleSetTypeField = tostring(column_ifexists(\"ruleSetType_s\", \"\")),\n    WafRuleGroupField = tostring(column_ifexists(\"ruleGroup_s\", \"\"))\n| extend IsCustomRule = WafRuleSetTypeField =~ \"Custom\"\n    or WafRuleGroupField =~ \"Custom\"\n    or WafRuleGroupField =~ \"Custom Rules\"\n    or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\")\n    | where ResourceId in~ (Resource_list)\n    | where tostring(column_ifexists(\"policy_s\", \"\")) in (Policy_list)\n    | extend\n        RuleName = tostring(column_ifexists(\"ruleName_s\", \"\")),\n        Parts = split(tostring(column_ifexists(\"ruleName_s\", \"\")), \"-\"),\n        Action = tostring(column_ifexists(\"action_s\", \"\")),\n        PolicyScopeName = tostring(column_ifexists(\"policy_s\", \"\")),\n        PolicyScope = \"Azure Front Door WAF Policy\"\n    | extend\n        RuleId = iff(IsCustomRule, WafRuleName, tostring(Parts[array_length(Parts)-1])),\n        RuleSetType = iff(IsCustomRule, \"Custom\", tostring(Parts[0])),\n        RuleSetVersion = iff(IsCustomRule, \"N/A\", tostring(Parts[1]))\n    | extend\n        RuleSet_V = iff(IsCustomRule, \"Custom\", strcat(RuleSetType, \" \", RuleSetVersion))\n    | extend\n        RuleGroup = iff(IsCustomRule, \"Custom Rules\", substring(\n            RuleName,\n            strlen(RuleSet_V) + 1,\n            strlen(RuleName) - strlen(RuleSet_V) - strlen(RuleId) - 2\n    ));\n\nBase\n| extend ResourceId = tolower(tostring(ResourceId))\n| summarize Count=count()\n    by\n        RuleId,\n        Action,\n        RuleSetType,\n        RuleSetVersion,\n        RuleSet_V,\n        RuleGroup,\n        RuleName,\n        ResourceId,\n        PolicyScopeName,\n        PolicyScope\n\n| join kind=inner (\n    Base\n    | make-series Trend=count()\n        on TimeGenerated\n        from {detectionTime:start}\n        to {detectionTime:end}\n        step {detectionTime:grain}\n        by RuleId\n) on RuleId\n\n| project-away RuleId1\n| extend RuleDisplayId = case(RuleId matches regex @\"^Bot\\s*[0-9]+$\", strcat(\"Bot \", extract(@\"([0-9]+)$\", 1, RuleId)), RuleSetType contains \"BotManager\" or RuleId matches regex @\"^(100|200|300)[1-9]00$\", strcat(\"Bot \", RuleId), RuleId)\n\n| extend Resource = extract(@\"([^/]+)$\", 1, tostring(ResourceId))\n| project-reorder\n    Count,\n    RuleDisplayId,\n    RuleId,\n    Action,\n    RuleSet_V,\n    RuleGroup,\n    Resource,\n    PolicyScopeName,\n    PolicyScope,\n    Trend\n\n| order by Count desc",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rules Triggered for Selected Scope",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportMultipleValues": true,
                    "exportedParameters": [
                      {
                        "fieldName": "RuleId",
                        "parameterName": "RuleId",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "RuleSetVersion",
                        "parameterName": "RuleSetVersion",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "Action",
                        "parameterName": "selectedAction",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "RuleDisplayId",
                        "parameterName": "RuleDisplayId",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "ResourceId",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "Count",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "greenRed"
                          }
                        },
                        {
                          "columnMatch": "Trend",
                          "formatter": 9,
                          "formatOptions": {
                            "palette": "greenRed"
                          }
                        },
                        {
                          "columnMatch": "RuleSetType",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "RuleSetVersion",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "RuleName",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "TimeGenerated",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "RuleId",
                          "formatter": 5
                        }
                      ],
                      "filter": true,
                      "sortBy": [
                        {
                          "itemKey": "Action",
                          "sortOrder": 2
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "RuleSet_V",
                          "label": "Ruleset Version"
                        },
                        {
                          "columnId": "RuleGroup",
                          "label": "Rule Group"
                        },
                        {
                          "columnId": "PolicyScopeName",
                          "label": "Scope Name"
                        },
                        {
                          "columnId": "PolicyScope",
                          "label": "Scope Type"
                        },
                        {
                          "columnId": "RuleDisplayId",
                          "label": "Rule ID"
                        },
                        {
                          "columnId": "Resource",
                          "label": "Azure Front Door"
                        },
                        {
                          "columnId": "Action",
                          "label": "Action (as logged)"
                        },
                        {
                          "columnId": "Count",
                          "label": "Rule matches"
