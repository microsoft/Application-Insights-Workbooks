          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend Parts = split(ruleName_s, \"-\")\n| extend ParsedRuleId = tostring(Parts[array_length(Parts)-1])\n| extend RuleSet = strcat(tostring(Parts[0]), \"-\", tostring(Parts[1]))\n| extend RuleGroup = substring(\n    ruleName_s,\n    strlen(RuleSet) + 1,\n    strlen(ruleName_s) - strlen(RuleSet) - strlen(ParsedRuleId) - 2\n)\n| summarize TransactionCount = count() by RuleGroup\n| order by TransactionCount desc",
                    "size": 3,
                    "showAnalytics": true,
                    "title": "Total WAF Requests by Rule Group (select to filter)",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportMultipleValues": true,
                    "exportedParameters": [
                      {
                        "fieldName": "series",
                        "parameterName": "SelectedRuleGroup",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "piechart"
                  },
                  "customWidth": "50",
                  "name": "Total by RuleGroup"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let SelectedRuleGroup = '{SelectedRuleGroup}';\n\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend Parts = split(ruleName_s, \"-\")\n| extend ParsedRuleId = tostring(Parts[array_length(Parts)-1])\n| extend RuleSet = strcat(tostring(Parts[0]), \"-\", tostring(Parts[1]))\n| extend RuleGroup = substring(\n    ruleName_s,\n    strlen(RuleSet) + 1,\n    strlen(ruleName_s) - strlen(RuleSet) - strlen(ParsedRuleId) - 2\n)\n| extend Action = tostring(action_s)\n| where isempty(SelectedRuleGroup) or RuleGroup contains SelectedRuleGroup\n| summarize number=count() by Action",
                    "size": 3,
                    "showAnalytics": true,
                    "title": "WAF Actions (select to filter)",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportMultipleValues": true,
                    "exportedParameters": [
                      {
                        "fieldName": "series",
                        "parameterName": "SelectedAction",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "piechart",
                    "chartSettings": {
                      "yAxis": [
                        "number"
                      ]
                    }
                  },
                  "customWidth": "50",
                  "name": "WAF Actions"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let SelectedRuleGroup = '{SelectedRuleGroup}';\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend\n    ruleGroup = iif(tostring(column_ifexists(\"ruleSetType_s\", \"\")) == \"Custom\", \"[Custom Rules]\", tostring(column_ifexists(\"ruleGroup_s\", column_ifexists(\"ruleSetType_s\", \"Unknown\")))),\n    Action = tostring(column_ifexists(\"action_s\", \"\")),\n    requestUri = tostring(column_ifexists(\"requestUri_s\", \"\")),\n    transactionId = tostring(column_ifexists(\"trackingReference_s\", \"\"))\n| where Action in (\"Block\", \"Blocked\") and requestUri != \"/\"\n| where SelectedRuleGroup == \"\" or SelectedRuleGroup contains ruleGroup\n| summarize Transactions=count() by requestUri\n| top 40 by Transactions desc",
                    "size": 3,
                    "showAnalytics": true,
                    "title": "Top 40 Blocked Request URIs (select to filter)",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportFieldName": "requestUri",
                    "exportParameterName": "RequestURI",
                    "exportDefaultValue": "''",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "tiles",
                    "tileSettings": {
                      "showBorder": false,
                      "titleContent": {
                        "columnMatch": "requestUri",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "Transactions",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "maximumSignificantDigits": 3,
                            "maximumFractionDigits": 2
                          }
                        }
                      }
                    }
                  },
                  "customWidth": "100",
                  "name": "Top Blocked Request URIs"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated > ago(7d)\n| extend Parts = split(tostring(ruleName_s), \"-\")\n| extend RuleId = tostring(Parts[array_length(Parts)-1])\n| summarize\n    Count = count(),\n    RuleName = any(details_msg_s)\nby RuleId\n| order by Count desc",
                          "size": 0,
                          "showAnalytics": true,
                          "title": "Top 50 WAF Rules (select to filter)",
                          "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                          "timeContextFromParameter": "detectionTime",
                          "showRefreshButton": true,
                          "exportMultipleValues": true,
                          "exportedParameters": [
                            {
                              "fieldName": "RuleId",
                              "parameterName": "Selected",
                              "parameterType": 1,
                              "quote": ""
                            }
                          ],
                          "queryType": 0,
                          "resourceType": "microsoft.cdn/profiles",
                          "crossComponentResources": [
                            "{Associations}"
                          ],
                          "visualization": "table",
                          "gridSettings": {
                            "formatters": [
                              {
                                "columnMatch": "Count",
                                "formatter": 8,
                                "formatOptions": {
                                  "palette": "blueDark"
                                }
                              }
                            ],
                            "rowLimit": 50,
                            "filter": true,
                            "labelSettings": [
                              {
                                "columnId": "RuleId",
                                "label": "Rule Id"
                              },
                              {
                                "columnId": "RuleName",
                                "label": "Rule "
                              }
                            ]
                          }
                        },
                        "customWidth": "40",
                        "name": "Top WAF Rules"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let SelectedAction = '{SelectedAction}';\nlet RequestURI = '{RequestURI}';\nlet SelectedRuleGroup = '{SelectedRuleGroup}';\nlet Selected = '{Selected}';\n\nAzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend\n    Action = tostring(action_s),\n    requestUri = tostring(requestUri_s),\n    RuleName = tostring(details_msg_s),\n    Parts = split(tostring(ruleName_s), \"-\")\n| extend\n    RuleId = tostring(Parts[array_length(Parts)-1]),\n    RuleSet = strcat(tostring(Parts[0]), \"-\", tostring(Parts[1]))\n| extend\n    RuleGroup = substring(\n        ruleName_s,\n        strlen(RuleSet) + 1,\n        strlen(ruleName_s) - strlen(RuleSet) - strlen(RuleId) - 2\n    )\n| extend Rule = strcat(RuleId, \" \", RuleName)\n| where isempty(SelectedAction) or SelectedAction contains Action\n| where isempty(RequestURI) or requestUri contains RequestURI\n| where isempty(SelectedRuleGroup) or SelectedRuleGroup contains RuleGroup\n| where Selected == \"\" or Selected contains RuleId\n| summarize Count = count() by Rule, bin(TimeGenerated, 1h)\n| order by TimeGenerated asc",
                          "size": 0,
                          "showAnalytics": true,
                          "title": "Rules Over Time",
                          "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
