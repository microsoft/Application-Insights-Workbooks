          {
            "id": "f451ddc5-00e3-4fe7-908e-22d0be9ab59c",
            "version": "KqlParameterItem/1.0",
            "name": "detectionTime",
            "label": "Detection Time",
            "type": 4,
            "isRequired": true,
            "value": {
