                                  "value": "Microsoft_Azure_Monitoring_Logs/LogsBlade"
                                },
                                {
                                  "name": "query",
                                  "source": "cell",
                                  "value": ""
                                }
                              ]
                            }
                          }
                        },
                        {
                          "columnMatch": "firewall_log",
                          "formatter": 7,
                          "formatOptions": {
                            "linkTarget": "OpenBlade",
                            "linkLabel": "Find in Firewall Log",
                            "linkIsContextBlade": true,
                            "bladeOpenContext": {
                              "bladeName": "LogsBlade",
                              "extensionName": "Microsoft_Azure_Monitoring_Logs",
                              "bladeParameters": [
                                {
                                  "name": "resourceId",
                                  "source": "parameter",
                                  "value": "ResourceId"
                                },
                                {
                                  "name": "source",
                                  "source": "static",
                                  "value": "Microsoft_Azure_Monitoring_Logs/LogsBlade"
                                },
                                {
                                  "name": "query",
                                  "source": "cell",
                                  "value": ""
                                }
                              ]
                            }
                          }
                        },
                        {
                          "columnMatch": "id",
                          "formatter": 5
                        }
                      ],
                      "rowLimit": 1000,
                      "filter": true,
                      "hierarchySettings": {
                        "treeType": 1,
                        "groupBy": [
                          "requestUri_s1"
                        ],
                        "expandTopLevel": true
                      },
                      "labelSettings": [
                        {
                          "columnId": "host_s1",
                          "label": "Host"
                        },
                        {
                          "columnId": "requestUri_s1",
                          "label": "Request URI"
                        },
                        {
                          "columnId": "httpMethod_s1",
                          "label": "HTTP Method"
                        },
                        {
                          "columnId": "originalRequestUriWithArgs_s1",
                          "label": "Original Request"
                        },
                        {
                          "columnId": "transactionId_g",
                          "label": "Request Id"
                        },
                        {
                          "columnId": "access_log",
                          "label": "Access Log"
                        },
                        {
                          "columnId": "firewall_log",
                          "label": "Firewall Log"
                        }
                      ]
                    }
                  },
                  "customWidth": "70",
                  "name": "affected urls"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AzureDiagnostics\n| where Category == \"FrontDoorWebApplicationFirewallLog\"\n| where trackingReference_s == '{TransactionId}'\n| extend Parts = split(ruleName_s, \"-\")\n| extend\n    RuleSetType    = iff(array_length(Parts) > 0, tostring(Parts[0]), \"\"),\n    RuleSetVersion = iff(array_length(Parts) > 1, tostring(Parts[1]), \"\"),\n    RuleGroup      = iff(array_length(Parts) > 2, tostring(Parts[2]), \"\"),\n    RuleId         = iff(array_length(Parts) > 3, tostring(Parts[3]), ruleName_s),\n    Action         = tostring(action_s),\n    Hostname       = tostring(host_s),\n    RequestUri     = tostring(requestUri_s),\n    DetailsMessage = tostring(details_msg_s),\n    DetailsData    = tostring(details_matches_s),\n    MessageText    = tostring(details_msg_s),\n    TransactionId  = tostring(trackingReference_s)\n| extend\n    Id = new_guid(),\n    RuleSet_V = strcat(RuleSetType, \" \", RuleSetVersion)\n| project\n    Action,\n    RuleSet_V,\n    RuleId,\n    MessageText,\n    DetailsMessage,\n    DetailsData,\n    TimeGenerated\n| order by TimeGenerated asc",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "Rules Triggered for Selected Request",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportedParameters": [
                      {
                        "fieldName": "MessageText",
                        "parameterName": "message",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsMessage",
                        "parameterName": "details",
                        "parameterType": 1
                      },
                      {
                        "fieldName": "DetailsData",
                        "parameterName": "matcheddata",
                        "parameterType": 1
                      }
                    ],
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Action",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Block",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "==",
                                "thresholdValue": "Blocked",
                                "representation": "4",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "success",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "RuleId",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "colors",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "{RuleId}",
                                "representation": "yellow",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "RuleId",
                          "label": "Rule Id"
                        },
                        {
                          "columnId": "MessageText",
                          "label": "Description"
                        },
                        {
                          "columnId": "DetailsMessage",
                          "label": "Details"
                        },
                        {
                          "columnId": "DetailsData",
                          "label": "Matched Data"
                        },
                        {
                          "columnId": "TimeGenerated",
                          "label": "Time Generated"
                        }
                      ]
                    }
                  },
                  "name": "TriggeredRules"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Selection Summary:\r\n\r\nYou were looking for example requests impacted by WAF rule id: **{RuleId}**.  \r\n\r\nOn host \"*{HostNameNoPort}*\" and url \"*{FullUri}*\" you found an HTTP request with request id *{TransactionId}*.  \r\n\r\nMore info on this request and the selected rule:\r\n- Message: {message}\r\n- Details: {details}\r\n- Matched Data: {matcheddata}"
                  },
                  "name": "Rule Triage Selection Summary"
                }
              ],
              "exportParameters": true
            },
            "conditionalVisibility": {
              "parameterName": "SelectedTabPage",
              "comparison": "isEqualTo",
              "value": "triage-by-rule"
            },
            "name": "Triage by rule"
          }
        ],
        "exportParameters": true
      },
