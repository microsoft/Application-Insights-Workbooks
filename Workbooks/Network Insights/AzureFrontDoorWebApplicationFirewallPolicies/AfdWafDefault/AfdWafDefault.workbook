    },
    {
      "type": 1,
      "content": {
        "json": "**This WAF policy didn't process any requests in the selected time range.** WAF activity on the associated Front Door profiles was processed by other WAF policies: **{OtherPolicyNames}**.\n\nThis can happen when other WAF policies protect other domains on the same Front Door profile. To see this activity, open WAF Insights from that policy.",
        "style": "info"
      },
      "conditionalVisibility": {
        "parameterName": "PolicyActivityNotice",
        "comparison": "isEqualTo",
        "value": "yes"
      },
      "name": "text - policy activity notice"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// Keep only requests processed by the WAF policy the workbook was opened from.\n// If the workbook isn't opened from a WAF policy (for example, a saved copy opened from a resource group), show all requests.\nlet SelectedPolicies = toscalar(print p = dynamic([{Resource}]) | mv-expand p to typeof(string) | where tolower(p) contains \"/providers/microsoft.network/frontdoorwebapplicationfirewallpolicies/\" | summarize make_set(p));\n// The firewall log can record the policy ID in an encoded form (a numeric prefix such as \"74#\", and \"_\" instead of \"/\"),\n// so the logged ID and the workbook policy ID are both normalized before they are compared.\nlet PolicyKey = (s:string) { trim(@\"_\", replace_regex(replace_regex(tolower(s), @\"^[0-9]+#\", \"\"), @\"[^a-z0-9-]\", \"_\")) };\nlet SelectedPolicyKeys = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(PolicyKey(p)));\nlet SelectedPolicyNames = toscalar(print p = SelectedPolicies | mv-expand p to typeof(string) | summarize make_set(tolower(extract(@\"([^/]+)$\", 1, p))));\nlet PolicyMatch = (p:string) { array_length(SelectedPolicies) == 0 or PolicyKey(p) in (SelectedPolicyKeys) or (p !contains \"/\" and tolower(p) in (SelectedPolicyNames)) };\nAzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| where PolicyMatch(tostring(column_ifexists(\"policy_s\", \"\")))\n| extend\n    ResourceId = tolower(tostring(ResourceId)),\n    policyScopeName = tostring(column_ifexists(\"policy_s\", \"NA\")),\n    policyScope = \"Azure Front Door WAF Policy\",\n    RawAction = tostring(column_ifexists(\"action_s\", \"\")),\n    TransactionId = tostring(column_ifexists(\"trackingReference_s\", \"\"))\n// Count each request once, by its final WAF outcome (same logic as Requests by WAF Outcome)\n| where isnotempty(TransactionId)\n| extend Action=case(tolower(replace_string(RawAction,\" \",\"\")) in (\"block\",\"blocked\",\"jschallengeblock\",\"captchablock\"),\"Blocked\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"jschallenge\",\"JSChallenge\",tolower(replace_string(RawAction,\" \",\"\")) startswith \"captcha\",\"CAPTCHA\",tolower(replace_string(RawAction,\" \",\"\")) == \"redirect\",\"Redirect\",tolower(replace_string(RawAction,\" \",\"\")) in (\"allow\",\"allowed\",\"pass\",\"passed\"),\"Allowed\",tolower(replace_string(RawAction,\" \",\"\")) in (\"log\",\"logged\",\"detected\",\"matched\",\"anomalyscoring\",\"logandscore\"),\"Logged\",RawAction)\n| summarize ActionPriority=max(case(Action == \"Blocked\",5,Action == \"Redirect\",4,Action in (\"JSChallenge\",\"CAPTCHA\"),3,Action == \"Allowed\",2,1)),Actions=make_set(Action) by ResourceId, policyScope, policyScopeName, TransactionId\n| extend Outcome=case(ActionPriority==5,\"Blocked\",ActionPriority==4,\"Redirect\",ActionPriority==3,iff(Actions has \"JSChallenge\",\"JSChallenge\",\"CAPTCHA\"),ActionPriority==2,\"Allowed\",\"Logged\")\n| extend Resource = extract(@\"([^/]+)$\", 1, ResourceId)\n| summarize Requests=count(), Blocked=countif(Outcome==\"Blocked\"), Redirect=countif(Outcome==\"Redirect\"), JSChallenge=countif(Outcome==\"JSChallenge\"), CAPTCHA=countif(Outcome==\"CAPTCHA\"), Allowed=countif(Outcome==\"Allowed\"), Logged=countif(Outcome==\"Logged\") by ResourceId, Resource, policyScope, policyScopeName\n| project Resource, policyScope, policyScopeName, Requests, Blocked, Redirect, JSChallenge, CAPTCHA, Allowed, Logged, ResourceId\n| order by Requests desc",
              "size": 1,
              "title": "Select the scope of the WAF policy",
              "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
              "timeContextFromParameter": "detectionTime",
              "showRefreshButton": true,
              "exportMultipleValues": true,
              "exportedParameters": [
                {
                  "fieldName": "policyScopeName",
                  "parameterName": "PolicyScope",
                  "parameterType": 1
                },
                {
                  "fieldName": "ResourceId",
                  "parameterName": "ResourceId",
                  "parameterType": 1
                }
              ],
              "queryType": 0,
              "resourceType": "microsoft.cdn/profiles",
              "crossComponentResources": [
                "{Associations}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Requests",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "Blocked",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Redirect",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "JSChallenge",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "CAPTCHA",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Allowed",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Logged",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  }
                ],
                "rowLimit": 500,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Resource",
                    "label": "Azure Front Door"
                  },
                  {
                    "columnId": "policyScope",
                    "label": "Scope Type"
                  },
                  {
                    "columnId": "policyScopeName",
                    "label": "Scope Name"
                  },
                  {
                    "columnId": "Requests",
                    "label": "Requests"
                  }
                ]
              }
            },
            "name": "query-frontdoor-resources"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [
                {
                  "id": "14e61d36-d59a-405d-8363-ac1aa8a2f491",
                  "cellValue": "SelectedTabPage",
                  "linkTarget": "parameter",
                  "linkLabel": "Investigate by Rule",
                  "subTarget": "investigate-by-rule",
                  "preText": "Investigate by Rule",
                  "style": "link"
                },
                {
                  "id": "93464fc4-d183-4d74-9e06-111c6de081a9",
                  "cellValue": "SelectedTabPage",
                  "linkTarget": "parameter",
                  "linkLabel": "Investigate by URL",
                  "subTarget": "investigate-by-url",
                  "preText": "Investigate ",
                  "style": "link"
                }
              ]
            },
            "name": "TabNavigation"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\nAzureDiagnostics\n| where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n| where TimeGenerated {detectionTime}\n| extend WafRuleName = tostring(column_ifexists(\"ruleName_s\", \"\")),\n    WafRuleSetTypeField = tostring(column_ifexists(\"ruleSetType_s\", \"\")),\n    WafRuleGroupField = tostring(column_ifexists(\"ruleGroup_s\", \"\"))\n| extend IsCustomRule = WafRuleSetTypeField =~ \"Custom\"\n    or WafRuleGroupField =~ \"Custom\"\n    or WafRuleGroupField =~ \"Custom Rules\"\n    or not(WafRuleName matches regex @\"RuleSet-[0-9.]+-\")\n| where ResourceId in~ (Resource_list)\n| where tostring(column_ifexists(\"policy_s\", \"NA\")) in (Policy_list)\n| extend Hostname = iif(isempty(tostring(column_ifexists(\"host_s\", \"\"))), \"NA\", tostring(column_ifexists(\"host_s\", \"\")))\n| extend hostname_s_noport = tostring(split(Hostname, ':')[0])\n| summarize total=dcount(tostring(column_ifexists(\"trackingReference_s\", \"\")), 4) by hostname_s_noport\n| order by total desc",
                    "size": 0,
                    "title": "Impacted Hosts",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
                    "timeContextFromParameter": "detectionTime",
                    "showRefreshButton": true,
                    "exportFieldName": "hostname_s_noport",
                    "exportParameterName": "HostName",
                    "queryType": 0,
                    "resourceType": "microsoft.cdn/profiles",
                    "crossComponentResources": [
                      "{Associations}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "hostname_s_noport",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "100%"
                          }
                        }
                      ],
                      "sortBy": [
                        {
                          "itemKey": "hostname_s_noport",
                          "sortOrder": 1
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "hostname_s_noport",
                          "label": "Host"
                        },
                        {
                          "columnId": "total",
                          "label": "Total"
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "hostname_s_noport",
                        "sortOrder": 1
                      }
                    ]
                  },
                  "customWidth": "30",
                  "name": "Hostnames with entries in Firewall Log"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let ToPathQuery = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet ToPath = (u:string) { let t = extract(@\"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*([^?#]*)\", 1, u); iff(u matches regex @\"^[A-Za-z][A-Za-z0-9+.-]*://\", iff(t startswith \"/\", t, strcat(\"/\", t)), u) };\nlet Policy_list = dynamic([{PolicyScope}]);\nlet Resource_list = dynamic([{ResourceId}]);\nlet FirewallTransactions =\n    AzureDiagnostics\n    | where Category =~ \"FrontDoorWebApplicationFirewallLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | where tostring(column_ifexists(\"policy_s\", \"NA\")) in (Policy_list)\n    | extend Hostname = iif(isempty(tostring(column_ifexists(\"host_s\", \"\"))), \"NA\", tostring(column_ifexists(\"host_s\", \"\")))\n    | where Hostname contains '{HostName}'\n    | project TrackingReference = tostring(column_ifexists(\"trackingReference_s\", \"\"));\nFirewallTransactions\n| join kind=inner (\n    AzureDiagnostics\n    | where Category =~ \"FrontDoorAccessLog\"\n    | where TimeGenerated {detectionTime}\n    | where ResourceId in~ (Resource_list)\n    | project\n        TrackingReference = tostring(column_ifexists(\"trackingReference_s\", \"\")),\n        ResourceId = tostring(ResourceId),\n        requestUri = ToPath(tostring(column_ifexists(\"requestUri_s\", \"\"))),\n        originalUri = ToPathQuery(tostring(column_ifexists(\"requestUri_s\", \"\"))),\n        httpMethod = tostring(column_ifexists(\"httpMethod_s\", \"\")),\n        httpStatus = tostring(column_ifexists(\"httpStatusCode_s\", column_ifexists(\"httpStatusCode_d\", \"\")))\n) on TrackingReference\n| extend\n    access_log = strcat(\"AzureDiagnostics | where Category =~ \\\"FrontDoorAccessLog\\\" | where TimeGenerated {detectionTime} | where trackingReference_s == \\\"\", TrackingReference, \"\\\"\"),\n    firewall_log = strcat(\"AzureDiagnostics | where Category =~ \\\"FrontDoorWebApplicationFirewallLog\\\" | where TimeGenerated {detectionTime} | where trackingReference_s == \\\"\", TrackingReference, \"\\\"\")\n| project ResourceId, requestUri, originalUri, httpMethod, httpStatus, TransactionId = TrackingReference, access_log, firewall_log",
                    "size": 0,
                    "showAnalytics": true,
                    "title": "URL Impacted for Selected Scope",
                    "noDataMessage": "No data found. Expand the detection time range or change the selected filters.",
