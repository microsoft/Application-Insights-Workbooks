          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsTelemetry\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| where Severity in~ (\\\"Warning\\\", \\\"Error\\\", \\\"Critical\\\")\\n    or Status in~ (\\\"failed\\\", \\\"degraded\\\")\\n    or ConsecutiveFailures > 0\\n| project PreciseTimeStamp,\\n          Switch=coalesce(Switch, SwitchId),\\n          EventType,\\n          Severity=iff(isempty(Severity), \\\"Unknown\\\", Severity),\\n          Component,\\n          Operation,\\n          Status=iff(isempty(Status), \\\"Unknown\\\", Status),\\n          DurationMs,\\n          ConsecutiveFailures,\\n          LastSuccessTime,\\n          ErrorCode\\n| order by PreciseTimeStamp desc\\n| take 500\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
