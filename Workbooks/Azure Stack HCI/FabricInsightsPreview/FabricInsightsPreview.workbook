{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "8cabaa29-c967-447b-a1de-281ab9a18480",
            "version": "KqlParameterItem/1.0",
            "name": "timeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 604800000
                }
              ]
            },
            "timeContext": {
              "durationMs": 86400000
            }
          },
          {
            "id": "ecb1b341-c697-4e40-bb6e-8cb9f28e96c5",
            "version": "KqlParameterItem/1.0",
            "name": "resource",
            "label": "Azure Local cluster",
            "type": 5,
            "isRequired": true,
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.azurestackhci/clusters": true
              },
              "additionalResourceOptions": [
                "value::1"
              ],
              "showDefault": false,
              "componentIdOnly": true
            },
            "defaultValue": "value::1"
          },
          {
            "id": "4efce71f-088a-4871-9065-086d71b41d93",
            "version": "KqlParameterItem/1.0",
            "name": "adxClusterUri",
            "label": "Azure Data Explorer cluster URI",
            "type": 1,
            "isRequired": true,
            "description": "Customer-accessible Azure Data Explorer cluster containing Fabric Insights telemetry.",
            "value": ""
          },
          {
            "id": "f7104a51-bd80-428b-a0ce-2eeb7847aaef",
            "version": "KqlParameterItem/1.0",
            "name": "adxDatabase",
            "label": "Azure Data Explorer database",
            "type": 1,
            "isRequired": true,
            "description": "Database containing the FabricInsights* telemetry tables.",
            "value": ""
          },
          {
            "id": "8879bc6b-0b77-45b5-af8a-b3bd828ba7cf",
            "version": "KqlParameterItem/1.0",
            "name": "selectedTab",
            "label": "Selected tab",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true,
            "value": "overview"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Fabric Insights parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "This preview workbook uses customer-accessible **Kusto telemetry only**. Interface utilization, errors, discards, PFC counters, ECN, queue depth, watchdog, and RDMA metrics are intentionally excluded because they use a separate metrics database. Enter the Azure Data Explorer cluster and database that contain the Fabric Insights telemetry tables.",
        "style": "info"
      },
      "name": "Preview notice"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "tabs",
        "links": [
          {
            "id": "d4d7cae1-4bfb-462b-8984-bb73b4a0fd3f",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "Overview",
            "subTarget": "overview",
            "style": "link"
          },
          {
            "id": "9e80a544-26a1-41c8-9d17-fcd0a3559397",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "Interfaces",
            "subTarget": "interfaces",
            "style": "link"
          },
          {
            "id": "3ccde196-2bc9-4bca-a3fe-ef812996f9c3",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "BGP",
            "subTarget": "bgp",
            "style": "link"
          },
          {
            "id": "521bc169-7dc8-4572-a93a-b0921ce5d57e",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "Collector health",
            "subTarget": "collector",
            "style": "link"
          }
        ]
      },
      "name": "Fabric Insights tabs"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Showing observations for the selected Azure Local cluster and time range. **Current** means the latest observation inside that range. Missing rows or blank fields mean data was not emitted or is unavailable; they do not prove that a feature is healthy, disabled, or unused."
            },
            "name": "Overview interpretation"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nlet LatestDevices =\\n    FabricInsightsDevice\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, DeviceId;\\nlet LatestInterfaces =\\n    FabricInsightsInterface\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Interface;\\nlet LatestPeers =\\n    FabricInsightsBGP\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Vrf, NeighborAddress;\\nlet LatestCycles =\\n    FabricInsightsTelemetry\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | where EventType =~ \\\"collection_cycle_completed\\\"\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId;\\nlet DeviceStats =\\n    LatestDevices\\n    | summarize Reported=count(),\\n                Unhealthy=countif(isnotempty(Health) and Health !in~ (\\\"healthy\\\", \\\"ok\\\", \\\"up\\\")),\\n                Unknown=countif(isempty(Health));\\nlet InterfaceStats =\\n    LatestInterfaces\\n    | summarize Reported=count(),\\n                NonUp=countif(isnotempty(OperStatus) and OperStatus !~ \\\"UP\\\"),\\n                Unknown=countif(isempty(OperStatus));\\nlet BgpStats =\\n    LatestPeers\\n    | summarize Reported=count(),\\n                Unhealthy=countif(isempty(SessionState) or SessionState !~ \\\"ESTABLISHED\\\" or isnull(Enabled) or Enabled != 1);\\nlet CollectorStats =\\n    LatestCycles\\n    | summarize Reported=count(),\\n                Failed=countif(Status in~ (\\\"failed\\\", \\\"degraded\\\")\\n                    or Severity in~ (\\\"Warning\\\", \\\"Error\\\", \\\"Critical\\\")\\n                    or ConsecutiveFailures > 0),\\n                Stale=countif(_end - PreciseTimeStamp > 15m);\\nunion\\n    (DeviceStats\\n     | project Sort=1, Metric=\\\"Devices reporting\\\", Value=Reported,\\n               State=iff(Reported == 0, \\\"No data\\\", iff(Unhealthy > 0 or Unknown > 0, \\\"Warning\\\", \\\"Healthy\\\")),\\n               Detail=strcat(Unhealthy, \\\" unhealthy; \\\", Unknown, \\\" unknown\\\")),\\n    (InterfaceStats\\n     | project Sort=2, Metric=\\\"Interfaces needing attention\\\", Value=NonUp + Unknown,\\n               State=iff(Reported == 0, \\\"No data\\\", iff(NonUp + Unknown > 0, \\\"Warning\\\", \\\"Healthy\\\")),\\n               Detail=strcat(Reported, \\\" interfaces reported; \\\", Unknown, \\\" unknown\\\")),\\n    (BgpStats\\n     | project Sort=3, Metric=\\\"BGP peers needing attention\\\", Value=Unhealthy,\\n               State=iff(Reported == 0, \\\"No data\\\", iff(Unhealthy > 0, \\\"Critical\\\", \\\"Healthy\\\")),\\n               Detail=iff(Reported == 0, \\\"No BGP rows were emitted\\\", strcat(Reported, \\\" peers reported\\\"))),\\n    (CollectorStats\\n     | project Sort=4, Metric=\\\"Collectors needing attention\\\", Value=Failed + Stale,\\n               State=iff(Reported == 0, \\\"No data\\\", iff(Failed > 0, \\\"Critical\\\", iff(Stale > 0, \\\"Warning\\\", \\\"Healthy\\\"))),\\n               Detail=iff(Reported == 0, \\\"No completed collection cycles were emitted\\\", strcat(Failed, \\\" failed/degraded; \\\", Stale, \\\" older than 15 minutes\\\")))\\n| order by Sort asc\\n| project Metric, Value, State, Detail\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Health summary",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "tiles",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "Metric",
                    "label": "Signal"
                  },
                  {
                    "columnId": "Value",
                    "label": "Items"
                  },
                  {
                    "columnId": "State",
                    "label": "State"
                  },
                  {
                    "columnId": "Detail",
                    "label": "Details"
                  }
                ]
              }
            },
            "name": "Health summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nlet InterfaceIssues =\\n    FabricInsightsInterface\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Interface\\n    | where isempty(OperStatus) or OperStatus !~ \\\"UP\\\"\\n    | project Observed=PreciseTimeStamp,\\n              Severity=\\\"Warning\\\",\\n              Category=\\\"Interface\\\",\\n              Switch=coalesce(SwitchName, SwitchId),\\n              Subject=Interface,\\n              State=iff(isempty(OperStatus), \\\"Unknown\\\", OperStatus),\\n              Detail=strcat(\\\"Kind: \\\", coalesce(InterfaceKind, \\\"Unknown\\\"));\\nlet BgpIssues =\\n    FabricInsightsBGP\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Vrf, NeighborAddress\\n    | where isempty(SessionState) or SessionState !~ \\\"ESTABLISHED\\\" or isnull(Enabled) or Enabled != 1\\n    | project Observed=PreciseTimeStamp,\\n              Severity=\\\"Critical\\\",\\n              Category=\\\"BGP\\\",\\n              Switch=coalesce(SwitchName, SwitchId),\\n              Subject=strcat(coalesce(Vrf, \\\"Unknown VRF\\\"), \\\" / \\\", NeighborAddress),\\n              State=strcat(iff(isnull(Enabled), \\\"Enabled unknown\\\", iff(Enabled == 1, \\\"Enabled\\\", \\\"Disabled\\\")), \\\"; \\\", coalesce(SessionState, \\\"State unknown\\\")),\\n              Detail=strcat(\\\"Peer AS: \\\", tostring(PeerAs), \\\"; received: \\\", tostring(PrefixesReceived));\\nlet CollectorIssues =\\n    FabricInsightsTelemetry\\n    | where PreciseTimeStamp between (_start .. _end)\\n    | where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n    | where Severity in~ (\\\"Warning\\\", \\\"Error\\\", \\\"Critical\\\")\\n        or Status in~ (\\\"failed\\\", \\\"degraded\\\")\\n        or ConsecutiveFailures > 0\\n    | project Observed=PreciseTimeStamp,\\n              Severity=iff(Severity in~ (\\\"Error\\\", \\\"Critical\\\"), \\\"Critical\\\", \\\"Warning\\\"),\\n              Category=coalesce(Component, EventType, \\\"Collector\\\"),\\n              Switch=coalesce(Switch, SwitchId),\\n              Subject=coalesce(Operation, EventType, \\\"Collection\\\"),\\n              State=coalesce(Status, Severity, \\\"Unknown\\\"),\\n              Detail=coalesce(ErrorCode, \\\"No additional detail\\\");\\nunion InterfaceIssues, BgpIssues, CollectorIssues\\n| extend SeveritySort=case(Severity == \\\"Critical\\\", 1, Severity == \\\"Warning\\\", 2, 3)\\n| order by SeveritySort asc, Observed desc\\n| project Observed, Severity, Category, Switch, Subject, State, Detail\\n| take 200\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Attention required",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "table",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "Observed",
                    "label": "Observed"
                  },
                  {
                    "columnId": "Severity",
                    "label": "Severity"
                  },
                  {
                    "columnId": "Category",
                    "label": "Category"
                  },
                  {
                    "columnId": "Switch",
                    "label": "Switch"
                  },
                  {
                    "columnId": "Subject",
                    "label": "Subject"
                  },
                  {
                    "columnId": "State",
                    "label": "State"
                  },
                  {
                    "columnId": "Detail",
                    "label": "Details"
                  }
                ]
              }
            },
            "name": "Attention required"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsDevice\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, DeviceId\\n| project LastObserved=PreciseTimeStamp,\\n          DeviceId,\\n          DeviceType,\\n          Name,\\n          MgmtIp,\\n          OsVersion,\\n          Health=iff(isempty(Health), \\\"Unknown\\\", Health),\\n          InterfaceCount\\n| order by DeviceType asc, Name asc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Device inventory",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "table",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "LastObserved",
                    "label": "Last observed"
                  },
                  {
                    "columnId": "DeviceId",
                    "label": "Device ID"
                  },
                  {
                    "columnId": "DeviceType",
                    "label": "Device type"
                  },
                  {
                    "columnId": "Name",
                    "label": "Name"
                  },
                  {
                    "columnId": "MgmtIp",
                    "label": "Management IP"
                  },
                  {
                    "columnId": "OsVersion",
                    "label": "OS version"
                  },
                  {
                    "columnId": "Health",
                    "label": "Health"
                  },
                  {
                    "columnId": "InterfaceCount",
                    "label": "Interfaces"
                  }
                ]
              }
            },
            "name": "Device inventory"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "overview"
      },
      "name": "Overview group"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Empty status is shown as **Unknown**. No rows means interface data was not emitted or is unavailable for the selected scope and time range."
            },
            "name": "Interface interpretation"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsInterface\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Interface\\n| extend Status=iff(isempty(OperStatus), \\\"Unknown\\\", toupper(OperStatus))\\n| summarize Interfaces=count() by Status\\n| order by Interfaces desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Current interface states",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "piechart",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "Status",
                    "label": "Status"
                  },
                  {
                    "columnId": "Interfaces",
                    "label": "Interfaces"
                  }
                ]
              }
            },
            "name": "Interface state distribution"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsInterface\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Interface\\n| where isempty(OperStatus) or OperStatus !~ \\\"UP\\\"\\n| project LastObserved=PreciseTimeStamp,\\n          Switch=coalesce(SwitchName, SwitchId),\\n          Interface,\\n          InterfaceKind,\\n          OperStatus=iff(isempty(OperStatus), \\\"Unknown\\\", OperStatus),\\n          Speed,\\n          Mtu,\\n          Mode,\\n          AccessVlan,\\n          NativeVlan,\\n          TrunkVlans,\\n          Vrf,\\n          Ipv4Prefixes\\n| order by Switch asc, Interface asc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Interfaces needing attention",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "table",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "LastObserved",
                    "label": "Last observed"
                  },
                  {
                    "columnId": "Switch",
                    "label": "Switch"
                  },
                  {
                    "columnId": "Interface",
                    "label": "Interface"
                  },
                  {
                    "columnId": "InterfaceKind",
                    "label": "Kind"
                  },
                  {
                    "columnId": "OperStatus",
                    "label": "Operational status"
                  },
                  {
                    "columnId": "Speed",
                    "label": "Speed"
                  },
                  {
                    "columnId": "Mtu",
                    "label": "MTU"
                  },
                  {
                    "columnId": "Mode",
                    "label": "Mode"
                  },
                  {
                    "columnId": "AccessVlan",
                    "label": "Access VLAN"
                  },
                  {
                    "columnId": "NativeVlan",
                    "label": "Native VLAN"
                  },
                  {
                    "columnId": "TrunkVlans",
                    "label": "Trunk VLANs"
                  },
                  {
                    "columnId": "Vrf",
                    "label": "VRF"
                  },
                  {
                    "columnId": "Ipv4Prefixes",
                    "label": "IPv4 prefixes"
                  }
                ]
              }
            },
            "name": "Interfaces needing attention"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsInterface\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| project PreciseTimeStamp, AEODeviceARMResourceUri, SwitchId, SwitchName, Interface, OperStatus\\n| sort by AEODeviceARMResourceUri asc, SwitchId asc, Interface asc, PreciseTimeStamp asc\\n| serialize\\n| extend PreviousResourceId=prev(AEODeviceARMResourceUri),\\n         PreviousSwitchId=prev(SwitchId),\\n         PreviousInterface=prev(Interface),\\n         PreviousStatus=prev(OperStatus)\\n| where AEODeviceARMResourceUri == PreviousResourceId\\n    and SwitchId == PreviousSwitchId\\n    and Interface == PreviousInterface\\n    and OperStatus != PreviousStatus\\n| summarize StateChanges=count(), arg_max(PreciseTimeStamp, OperStatus)\\n    by AEODeviceARMResourceUri, SwitchId, SwitchName, Interface\\n| project LastChange=PreciseTimeStamp,\\n          Switch=coalesce(SwitchName, SwitchId),\\n          Interface,\\n          LatestState=iff(isempty(OperStatus), \\\"Unknown\\\", OperStatus),\\n          StateChanges\\n| order by StateChanges desc, LastChange desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Observed interface state changes",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "table",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "LastChange",
                    "label": "Last change"
                  },
                  {
                    "columnId": "Switch",
                    "label": "Switch"
                  },
                  {
                    "columnId": "Interface",
                    "label": "Interface"
                  },
                  {
                    "columnId": "LatestState",
                    "label": "Latest state"
                  },
                  {
                    "columnId": "StateChanges",
                    "label": "State changes"
                  }
                ]
              }
            },
            "name": "Interface state changes"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "interfaces"
      },
      "name": "Interfaces group"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "No BGP rows does not prove that BGP is healthy or unconfigured. It means BGP telemetry was not emitted or is unavailable for this scope and time range."
            },
            "name": "BGP interpretation"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsBGP\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Vrf, NeighborAddress\\n| extend PeerState=case(\\n    isnull(Enabled), \\\"Enabled unknown\\\",\\n    Enabled != 1, \\\"Disabled\\\",\\n    isempty(SessionState), \\\"State unknown\\\",\\n    toupper(SessionState))\\n| summarize Peers=count() by PeerState\\n| order by Peers desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Current BGP peer states",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "piechart",
              "gridSettings": {
                "labelSettings": [
                  {
                    "columnId": "PeerState",
                    "label": "Peer state"
                  },
                  {
                    "columnId": "Peers",
                    "label": "Peers"
                  }
                ]
              }
            },
            "name": "BGP state distribution"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsBGP\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId, Vrf, NeighborAddress\\n| where isempty(SessionState) or SessionState !~ \\\"ESTABLISHED\\\" or isnull(Enabled) or Enabled != 1\\n| project LastObserved=PreciseTimeStamp,\\n          Switch=coalesce(SwitchName, SwitchId),\\n          Vrf,\\n          NeighborAddress,\\n          LocalAs,\\n          PeerAs,\\n          PeerType,\\n          Enabled=case(isnull(Enabled), \\\"Unknown\\\", Enabled == 1, \\\"Yes\\\", \\\"No\\\"),\\n          SessionState=iff(isempty(SessionState), \\\"Unknown\\\", SessionState),\\n          EstablishedTransitions,\\n          PrefixesReceived,\\n          PrefixesSent,\\n          LastEstablished\\n| order by Switch asc, Vrf asc, NeighborAddress asc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "BGP peers needing attention",
