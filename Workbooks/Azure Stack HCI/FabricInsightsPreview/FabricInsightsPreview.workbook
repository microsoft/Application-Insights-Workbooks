              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsBGP\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| project PreciseTimeStamp, AEODeviceARMResourceUri, SwitchId, SwitchName, Vrf,\\n          NeighborAddress, SessionState, EstablishedTransitions, PrefixesReceived, PrefixesSent\\n| sort by AEODeviceARMResourceUri asc, SwitchId asc, Vrf asc, NeighborAddress asc, PreciseTimeStamp asc\\n| serialize\\n| extend PreviousResourceId=prev(AEODeviceARMResourceUri),\\n         PreviousSwitchId=prev(SwitchId),\\n         PreviousVrf=prev(Vrf),\\n         PreviousNeighbor=prev(NeighborAddress),\\n         PreviousState=prev(SessionState)\\n| where AEODeviceARMResourceUri == PreviousResourceId\\n    and SwitchId == PreviousSwitchId\\n    and Vrf == PreviousVrf\\n    and NeighborAddress == PreviousNeighbor\\n    and SessionState != PreviousState\\n| project PreciseTimeStamp,\\n          Switch=coalesce(SwitchName, SwitchId),\\n          Vrf,\\n          NeighborAddress,\\n          PreviousState=iff(isempty(PreviousState), \\\"Unknown\\\", PreviousState),\\n          SessionState=iff(isempty(SessionState), \\\"Unknown\\\", SessionState),\\n          EstablishedTransitions,\\n          PrefixesReceived,\\n          PrefixesSent\\n| order by PreciseTimeStamp desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Observed BGP state transitions",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
