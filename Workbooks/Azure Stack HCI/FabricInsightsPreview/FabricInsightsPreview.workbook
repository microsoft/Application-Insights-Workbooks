            "name": "Latest collection cycles"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsTelemetry\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| where Severity in~ (\\\"Warning\\\", \\\"Error\\\", \\\"Critical\\\")\\n    or Status in~ (\\\"failed\\\", \\\"degraded\\\")\\n    or isnotempty(ErrorCode)\\n| summarize Events=count(),\\n            AffectedSwitches=dcount(coalesce(SwitchId, Switch)),\\n            FirstSeen=min(PreciseTimeStamp),\\n            LastSeen=max(PreciseTimeStamp)\\n    by EventType, Component, Operation, Status, ErrorCode\\n| order by LastSeen desc, Events desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
