    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Freshness is measured relative to the selected time range end. The 15-minute threshold is an initial preview threshold, not a service-level agreement."
            },
            "name": "Collector interpretation"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"AzureDataExplorerQuery/1.0\",\"queryText\":\"let _start = todatetime('{timeRange:start}');\\r\\nlet _end = todatetime('{timeRange:end}');\\r\\nlet _resourceId = '{resource}';\\nFabricInsightsTelemetry\\n| where PreciseTimeStamp between (_start .. _end)\\n| where isnotempty(_resourceId) and AEODeviceARMResourceUri =~ _resourceId\\n| where EventType =~ \\\"collection_cycle_completed\\\"\\n| summarize arg_max(PreciseTimeStamp, *) by AEODeviceARMResourceUri, SwitchId\\n| extend CycleAge=_end - PreciseTimeStamp,\\n         Freshness=iff(_end - PreciseTimeStamp > 15m, \\\"Stale\\\", \\\"Current\\\")\\n| project LastCycle=PreciseTimeStamp,\\n          CycleAge,\\n          Freshness,\\n          Switch=coalesce(Switch, SwitchId),\\n          Status=iff(isempty(Status), \\\"Unknown\\\", Status),\\n          Severity=iff(isempty(Severity), \\\"Unknown\\\", Severity),\\n          DurationMs,\\n          ConsecutiveFailures,\\n          LastSuccess=todatetime(LastSuccessTime),\\n          ErrorCode,\\n          ArpCollectionStatus,\\n          MacCollectionStatus,\\n          RouteCollectionStatus,\\n          ArpCount,\\n          MacCount,\\n          EndpointExportedCount,\\n          RouteCount,\\n          DefaultRouteV4,\\n          DefaultRouteV6,\\n          RoutesByProtocol\\n| order by ConsecutiveFailures desc, CycleAge desc\",\"clusterName\":\"{adxClusterUri}\",\"databaseName\":\"{adxDatabase}\"}",
              "size": 0,
              "title": "Latest collection cycle by switch",
              "noDataMessage": "Data was not emitted or is unavailable for this resource and time range.",
              "queryType": 9,
              "visualization": "table",
              "gridSettings": {
