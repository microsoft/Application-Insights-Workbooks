{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "f79972a5-80f4-47b6-9dcb-97f4c61d3549",
            "version": "KqlParameterItem/1.0",
            "name": "HealthModelsAvailable",
            "type": 1,
            "description": "Controls whether the Health Models overview or creation experience is displayed.",
            "isRequired": true,
            "isGlobal": true,
            "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| summarize HealthModelCount = count()\r\n| project value = iff(HealthModelCount > 0, '1', '0')",
            "crossComponentResources": [
              "value::all"
            ],
            "isHiddenWhenLocked": true,
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills"
      },
      "name": "Health model availability"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 10,
            "content": {
              "chartId": "workbook7ec455c1-e95a-42b6-8bb1-1218ec5b90a1",
              "version": "MetricsItem/2.0",
              "size": 0,
              "chartType": 0,
              "resourceType": "microsoft.cloudhealth/healthmodels",
              "metricScope": 0,
              "resourceParameter": "Resources",
              "resourceIds": [
                "{Resources}"
              ],
              "timeContext": {
                "durationMs": 300000
              },
              "metrics": [
                {
                  "namespace": "microsoft.cloudhealth/healthmodels",
                  "metric": "microsoft.cloudhealth/healthmodels-Saturation-EntityCount",
                  "aggregation": 4,
                  "columnName": "Entity Count"
                }
              ],
              "gridFormatType": 1,
              "timeGrain": "PT5M"
            },
            "name": "Entity count metric data",
            "conditionalVisibility": {
              "parameterName": "1",
              "comparison": "isEqualTo",
              "value": "2"
            }
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "title": "Filter",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "parameters": [
                {
                  "id": "2b6a9bde-d117-4acf-ab32-6f30d86e252b",
                  "version": "KqlParameterItem/1.0",
                  "name": "Subscription",
                  "label": "Subscriptions",
                  "type": 6,
                  "description": "Subscriptions containing Azure Monitor Health Models. Add missing subscriptions to your default subscriptions.",
                  "isRequired": true,
                  "isGlobal": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| summarize Count = count() by subscriptionId\r\n| order by Count desc, subscriptionId asc\r\n| extend Rank = row_number()\r\n| project value = subscriptionId, label = subscriptionId, selected = Rank == 1",
                  "crossComponentResources": [
                    "value::selected"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                },
                {
                  "id": "1a25d38b-8c05-4b36-90c2-2fe3fc2d07d2",
                  "version": "KqlParameterItem/1.0",
                  "name": "Resources",
                  "label": "Health Models",
                  "type": 5,
                  "description": "Entity count uses a five-minute average. Azure Workbooks metrics queries support up to 200 resources, so the first 200 health models are selected by default.",
                  "isRequired": true,
                  "isGlobal": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| order by id asc\r\n| extend Rank = row_number()\r\n| project value = id, label = name, selected = Rank <= 200, group = resourceGroup",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "isHiddenWhenLocked": false,
                  "typeSettings": {
                    "resourceTypeFilter": {
                      "microsoft.cloudhealth/healthmodels": true
                    },
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "selectAllValue": "",
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "formVertical"
            },
            "customWidth": "25",
            "name": "Health model filters"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "9d828ae6-b5e2-4cd8-b922-6165af23a7c8",
                  "version": "KqlParameterItem/1.0",
                  "name": "SelectedHealthModelCount",
                  "type": 1,
                  "description": "Number of selected health models displayed in the summary.",
                  "isRequired": true,
                  "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| where id in~ ({Resources:value})\r\n| summarize HealthModelCount = count()\r\n| project value = tostring(HealthModelCount)",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "isHiddenWhenLocked": true,
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "pills"
            },
            "name": "Selected health model count"
          },
          {
            "type": 15,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| where id in~ ({Resources:value})\r\n| project Name = id, Region = location, HealthModelCount = 1",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ]
            },
            "name": "Health model regions"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"1.0.0\",\"content\":\"[{\\\"Health Model Count\\\": \\\"{SelectedHealthModelCount}\\\"}]\",\"transformers\":null}",
              "size": 4,
              "title": "Total Health Models",
              "queryType": 8,
              "visualization": "stat",
              "statSettings": {
                "valueField": "Health Model Count",
                "valueAggregation": "None",
                "colorSettings": {
                  "type": "static",
                  "mode": "background",
                  "heatmapPalette": "greenRed",
                  "thresholdsGrid": []
                },
                "iconSettings": {
                  "thresholdsGrid": [
                    {
                      "representation": "dot-blue"
                    },
                    {
                      "sourceColumn": "Health Model Count",
                      "operator": ">",
                      "thresholdValue": "0",
                      "representation": "resource"
                    }
                  ]
                },
                "tagText": "Health Models",
                "valueFontStyle": "xxLarge",
                "tagTextPosition": "bottom"
              }
            },
            "customWidth": "25",
            "name": "Total health model count",
            "styleSettings": {
              "progressStyle": "spinner"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e92d3da4-bbb2-48a9-b46b-cf6159e0f1f1\",\"mergeType\":\"table\",\"leftTable\":\"Entity count metric data\"}],\"projectRename\":[{\"originalName\":\"[Entity count metric data].Value\",\"mergedName\":\"Entity Count\",\"fromId\":\"e92d3da4-bbb2-48a9-b46b-cf6159e0f1f1\"}]}",
              "size": 4,
              "title": "Total Entities",
              "noDataMessage": "No entity count metric was reported for the selected health models in the last five minutes.",
              "queryType": 7,
              "visualization": "stat",
              "statSettings": {
                "valueField": "Entity Count",
                "valueAggregation": "Sum",
                "colorSettings": {
                  "type": "static",
                  "mode": "background",
                  "heatmapPalette": "greenRed",
                  "thresholdsGrid": []
                },
                "iconSettings": {
                  "thresholdsGrid": [
                    {
                      "representation": "dot-blue"
                    },
                    {
                      "sourceColumn": "Entity Count",
                      "operator": ">",
                      "thresholdValue": "0",
                      "representation": "resource"
                    }
                  ]
                },
                "numberFormatSettings": {
                  "unit": 0,
                  "options": {
                    "style": "decimal",
                    "useGrouping": true,
                    "minimumIntegerDigits": 1,
                    "maximumFractionDigits": 0,
                    "notation": "standard"
                  }
                },
                "tagText": "Entities",
                "valueFontStyle": "xxLarge",
                "tagTextPosition": "bottom"
              }
            },
            "customWidth": "25",
            "name": "Total entity count",
            "styleSettings": {
              "progressStyle": "spinner"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"2774626b-301b-4b49-a2e2-7587e4358fb1\",\"mergeType\":\"leftouter\",\"leftTable\":\"Health model regions\",\"rightTable\":\"Entity count metric data\",\"leftColumn\":\"Name\",\"rightColumn\":\"Name\"}],\"projectRename\":[{\"originalName\":\"[Health model regions].Name\",\"mergedName\":\"Health Model\",\"fromId\":\"2774626b-301b-4b49-a2e2-7587e4358fb1\"},{\"originalName\":\"[Health model regions].Region\",\"mergedName\":\"Region\",\"fromId\":\"2774626b-301b-4b49-a2e2-7587e4358fb1\"},{\"originalName\":\"[Entity count metric data].Value\",\"mergedName\":\"Entity Count\",\"fromId\":\"2774626b-301b-4b49-a2e2-7587e4358fb1\"}]}",
              "size": 2,
              "title": "Health Model Metrics",
              "noDataMessage": "No entity count metric was reported for the selected health models in the last five minutes.",
              "showExportToExcel": true,
              "queryType": 7,
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Health Model",
                    "formatter": 13,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "Region",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "Entity Count",
                    "formatter": 1,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "minimumIntegerDigits": 1,
                        "maximumFractionDigits": 0,
                        "notation": "standard"
                      },
                      "emptyValCustomText": "Not reported"
                    }
                  }
                ],
                "filter": true
              }
            },
            "customWidth": "50",
            "name": "Health model entity table",
            "styleSettings": {
              "showBorder": true
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"b3489d99-7361-4e66-99c5-c96fd44834de\",\"mergeType\":\"table\",\"leftTable\":\"Health model regions\"}],\"projectRename\":[{\"originalName\":\"[Health model regions].Region\",\"mergedName\":\"Region\",\"fromId\":\"b3489d99-7361-4e66-99c5-c96fd44834de\"},{\"originalName\":\"[Health model regions].HealthModelCount\",\"mergedName\":\"Health Model Count\",\"fromId\":\"b3489d99-7361-4e66-99c5-c96fd44834de\"}]}",
              "size": 2,
              "title": "Health Model Distribution",
              "showExportToExcel": true,
              "queryType": 7,
              "visualization": "map",
              "mapSettings": {
                "locInfo": "AzureLoc",
                "locInfoColumn": "Region",
                "sizeSettings": "Health Model Count",
                "sizeAggregation": "Sum",
                "labelSettings": "Region",
                "legendMetric": "Health Model Count",
                "legendAggregation": "Sum",
                "numberFormatSettings": {
                  "unit": 0,
                  "options": {
                    "style": "decimal",
                    "useGrouping": true,
                    "maximumFractionDigits": 0,
                    "notation": "standard"
                  }
                }
              }
            },
            "customWidth": "50",
            "name": "Health model regional distribution",
            "styleSettings": {
              "showBorder": true
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "HealthModelsAvailable",
        "comparison": "isEqualTo",
        "value": "1"
      },
      "name": "Health models overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "<div style=\"box-sizing: border-box; padding: 47px 24px 0; text-align: center;\"><img src=\"https://catalogartifact.azureedge.net/publicartifacts/Microsoft.CloudHealth-HealthModels-2.0.1-preview/Icons/AzureMonitorHealthModels_Icon-Large.png\" alt=\"\" aria-hidden=\"true\" style=\"display: block; width: 100px; height: 100px; margin: 0 auto 40px; filter: grayscale(1); opacity: 0.4;\" /><h2 style=\"margin: 0; font-size: 14px; line-height: 20px; font-weight: 600;\">No health models to display</h2><p style=\"max-width: 620px; margin: 8px auto 0; font-size: 14px; line-height: 20px;\">Configure health models to calculate health states for the physical and logical components which make up your workloads and IT estate. Use health models to identify, interpret, and swiftly react to changes in health state.</p></div>"
            },
            "customWidth": "100",
            "name": "No health models message",
            "styleSettings": {
              "margin": "0",
              "padding": "0"
            }
          },
          {
            "type": 11,
            "content": {
