          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "title": "Filter",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "parameters": [
                {
                  "id": "2b6a9bde-d117-4acf-ab32-6f30d86e252b",
                  "version": "KqlParameterItem/1.0",
                  "name": "Subscription",
                  "label": "Subscriptions",
                  "type": 6,
                  "description": "Subscriptions containing Azure Monitor Health Models. Add missing subscriptions to your default subscriptions.",
                  "isRequired": true,
                  "isGlobal": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| summarize Count = count() by subscriptionId\r\n| order by Count desc, subscriptionId asc\r\n| extend Rank = row_number()\r\n| project value = subscriptionId, label = subscriptionId, selected = Rank == 1",
                  "crossComponentResources": [
                    "value::selected"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                },
                {
                  "id": "1a25d38b-8c05-4b36-90c2-2fe3fc2d07d2",
                  "version": "KqlParameterItem/1.0",
                  "name": "Resources",
                  "label": "Health Models",
                  "type": 5,
                  "description": "Health model metric data refreshes every 15 minutes.",
                  "isRequired": false,
                  "isGlobal": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "Resources\r\n| where type =~ 'microsoft.cloudhealth/healthmodels'\r\n| order by id asc\r\n| project value = id, label = name, selected = true, group = resourceGroup",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "isHiddenWhenLocked": false,
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "selectAllValue": "",
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "formVertical"
            },
