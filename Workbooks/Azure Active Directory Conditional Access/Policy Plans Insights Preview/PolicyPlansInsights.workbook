                  "type": 2,
                  "isRequired": true,
                  "value": "principals",
                  "jsonData": "[{\"value\":\"principals\",\"label\":\"users\",\"selected\":true},{\"value\":\"signIns\",\"label\":\"sign-ins\",\"selected\":false}]",
