            "isHiddenWhenLocked": true,
            "isGlobal": false,
            "queryType": 14,
            "query": "{\"version\":\"MsGraphEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/beta/identity/conditionalAccess/plans\",\"urlParams\":[]}",
            "typeSettings": {
              "multiLineText": true,
              "editorLanguage": "json"
            }
          },
          {
            "id": "b7c8b043-7bef-53db-8638-3bedfe394a0c",
            "version": "KqlParameterItem/1.0",
            "name": "PolicyInventory",
            "label": "PolicyInventory",
            "type": 1,
            "isRequired": false,
            "value": null,
            "isHiddenWhenLocked": true,
            "isGlobal": false,
            "queryType": 14,
            "query": "{\"version\":\"MsGraphEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GETARRAY\",\"path\":\"/v1.0/identity/conditionalAccess/policies\",\"urlParams\":[],\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$\",\"columnid\":\"value\"}]}}]}",
            "typeSettings": {
              "multiLineText": true,
