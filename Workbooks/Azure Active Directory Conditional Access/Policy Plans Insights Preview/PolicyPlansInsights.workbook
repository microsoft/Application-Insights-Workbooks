                {
                  "id": "dc9f0dd1-cbfe-4610-a8c7-414da5856a60",
                  "version": "KqlParameterItem/1.0",
                  "name": "App_servicePrincipal",
                  "label": "Resource",
                  "type": 1,
                  "description": "Exact match on resource display name. Default value is \"All apps\"",
                  "value": "All apps",
                  "timeContext": {
