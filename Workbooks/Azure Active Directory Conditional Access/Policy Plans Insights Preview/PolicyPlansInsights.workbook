            }
          },
          {
            "id": "d083b0e7-f9bf-58ce-9c86-fd1eca520882",
            "version": "KqlParameterItem/1.0",
            "name": "PlanInventory",
            "label": "PlanInventory",
            "type": 1,
            "isRequired": false,
            "value": null,
            "isHiddenWhenLocked": true,
            "isGlobal": false,
            "queryType": 14,
            "query": "{\"version\":\"MsGraphEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GETARRAY\",\"path\":\"/beta/identity/conditionalAccess/plans\",\"urlParams\":[],\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$\",\"columnid\":\"value\"}]}}]}",
