          {
            "type": 1,
            "name": "servicePrincipal details guidance",
            "content": {
              "json": "\ud83d\udca1 *Select a principal to inspect sign-ins; select an event for recorded details and member evidence.*"
            },
            "conditionalVisibility": {
              "parameterName": "Guide",
