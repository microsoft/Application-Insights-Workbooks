      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "28e7b14b-de2a-5fde-85b3-e05e9fb70dcd",
            "version": "KqlParameterItem/1.0",
            "name": "WorkspaceTenant",
            "label": "WorkspaceTenant",
            "type": 1,
            "isRequired": true,
            "value": null,
            "isHiddenWhenLocked": true,
            "isGlobal": false,
            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/subscriptions/{Workspace:subscriptionId}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2022-12-01\"}],\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$\",\"columns\":[{\"path\":\"$.tenantId\",\"columnid\":\"value\",\"columnType\":\"string\"}]}}]}"
          },
          {
            "id": "227e03a2-dcd3-502f-8bc7-80b8dbd0a726",
            "version": "KqlParameterItem/1.0",
