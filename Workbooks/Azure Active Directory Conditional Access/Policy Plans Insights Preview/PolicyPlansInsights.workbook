                {
                  "id": "f2163f7f-6575-5b90-a7af-638e94710b19",
                  "version": "KqlParameterItem/1.0",
                  "name": "Unit_servicePrincipal",
                  "label": "Data view",
                  "type": 2,
                  "isRequired": true,
                  "value": "principals",
                  "jsonData": "[{\"value\":\"principals\",\"label\":\"service principals\",\"selected\":true},{\"value\":\"signIns\",\"label\":\"sign-ins\",\"selected\":false}]",
