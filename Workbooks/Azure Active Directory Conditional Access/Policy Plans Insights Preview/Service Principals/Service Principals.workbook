    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let IdentityView = \"servicePrincipal\";\n\nlet PolicyPage = parse_json(base64_decode_tostring('{PolicyInventoryPage:base64}'));\nlet PlanPage = parse_json(base64_decode_tostring('{PlanInventoryPage:base64}'));\nlet NormalizeInventory = (Raw:dynamic, Page:dynamic) {\n    case(gettype(Raw) == \"array\", Raw,\n        gettype(Raw) == \"dictionary\" and isnotempty(tostring(Raw.id)), pack_array(Raw),\n        isempty(tostring(Raw)) and gettype(Page.value) == \"array\" and array_length(Page.value) == 0\n            and isempty(tostring(Page[\"@odata.nextLink\"])), dynamic([]),\n        dynamic(null))\n};\nlet CollectionReady = (Rows:dynamic, Page:dynamic) {\n    let FirstIds = toscalar(print P=Page.value | mv-expand P | summarize make_set(tostring(P.id)));\n    let LoadedIds = toscalar(print P=Rows | mv-expand P | summarize make_set(tostring(P.id)));\n    gettype(Page.value) == \"array\" and gettype(Rows) == \"array\"\n        and array_length(Rows) < 1000\n        and array_length(set_difference(FirstIds, LoadedIds)) == 0\n        and (isnotempty(tostring(Page[\"@odata.nextLink\"]))\n            or (array_length(Rows) == array_length(Page.value)\n                and array_length(set_difference(LoadedIds, FirstIds)) == 0))\n};\nlet PolicyResponse = bag_pack(\"value\", NormalizeInventory(\n    parse_json(base64_decode_tostring('{PolicyInventory:base64}')), PolicyPage));\nlet PlanResponse = bag_pack(\"value\", NormalizeInventory(\n    parse_json(base64_decode_tostring('{PlanInventory:base64}')), PlanPage));\nlet PolicyLimitReached = array_length(PolicyResponse.value) >= 1000;\nlet PlanLimitReached = array_length(PlanResponse.value) >= 1000;\nlet PolicyResponseReady = CollectionReady(PolicyResponse.value, PolicyPage);\nlet PlanResponseReady = CollectionReady(PlanResponse.value, PlanPage);\nlet Plans = print P=PlanResponse.value | mv-expand P\n    | project Plan=P;\nlet UniquePlanIds = toscalar(Plans | summarize Records=count() by PlanId=tostring(Plan.id)\n    | summarize Invalid=countif(isempty(PlanId) or Records != 1) | project Invalid == 0);\nlet EmbeddedRulesReady = toscalar(Plans | summarize Invalid=countif(\n    gettype(Plan.rules) != \"array\" or isnotempty(tostring(Plan[\"rules@odata.nextLink\"]))\n    or isempty(tostring(Plan.id))) | project Invalid == 0);\nlet CAObjects = print P=PolicyResponse.value | mv-expand P\n    | project ObjectId=tostring(P.id), Key=strcat(\"ca|\", tostring(P.id)),\n        Engine=\"CA policy\", Name=tostring(P.displayName), RawState=tostring(P.state),\n        ParentName=\"Not applicable\", ParentId=\"\", Local=P.conditions, Shared=dynamic(null),\n        Grant=P.grantControls, Session=P.sessionControls, ReturnedDefinition=P;\nlet RuleObjects = Plans | mv-expand R=Plan.rules\n    | project ObjectId=tostring(R.id), Key=strcat(\"cav2|\", tostring(R.id)),\n        Engine=\"Policy Plans rule\", Name=tostring(R.displayName), RawState=tostring(R.state),\n        ParentName=tostring(Plan.displayName), ParentId=tostring(Plan.id),\n        Local=R.conditions, Shared=Plan.sharedConditions,\n        Grant=R.controls.grantControls, Session=R.controls.sessionControls,\n        ReturnedDefinition=bag_pack(\"rule\", R, \"sharedConditions\", Plan.sharedConditions,\n            \"parentPlanId\", Plan.id, \"parentPlanName\", Plan.displayName);\nlet Supplied = (L:dynamic, S:dynamic) {\n    strcat(iff(isnull(L), \"Not supplied\", tostring(L)),\n        iff(isnull(S), \"\", strcat(\" | [Plan-shared] \", tostring(S))))\n};\nlet Catalogue = union CAObjects, RuleObjects\n    | extend State=case(RawState == \"enabled\", \"Enabled\",\n        RawState == \"enabledForReportingButNotEnforced\", \"Report-only\",\n        RawState == \"disabled\", \"Disabled\", \"Unknown\")\n    | extend Definition=bag_pack(\n        \"Included principals\", Supplied(bag_pack(\"users\", Local.users.includeUsers,\n            \"groups\", Local.users.includeGroups, \"roles\", Local.users.includeRoles,\n            \"guestsOrExternalUsers\", Local.users.includeGuestsOrExternalUsers,\n            \"workloads\", Local.clientApplications.includeServicePrincipals),\n            bag_pack(\"users\", Shared.users.includeUsers, \"groups\", Shared.users.includeGroups,\n                \"roles\", Shared.users.includeRoles,\n                \"guestsOrExternalUsers\", Shared.users.includeGuestsOrExternalUsers,\n                \"workloads\", Shared.clientApplications.includeServicePrincipals)),\n        \"Excluded principals\", Supplied(bag_pack(\"users\", Local.users.excludeUsers,\n            \"groups\", Local.users.excludeGroups, \"roles\", Local.users.excludeRoles,\n            \"workloads\", Local.clientApplications.excludeServicePrincipals),\n            bag_pack(\"users\", Shared.users.excludeUsers, \"groups\", Shared.users.excludeGroups,\n                \"roles\", Shared.users.excludeRoles, \"workloads\", Shared.clientApplications.excludeServicePrincipals)),\n        \"Included target resources\", Supplied(bag_pack(\"applications\", Local.applications.includeApplications,\n            \"userActions\", Local.applications.includeUserActions,\n            \"authenticationContexts\", Local.applications.includeAuthenticationContextClassReferences),\n            bag_pack(\"applications\", Shared.applications.includeApplications,\n                \"userActions\", Shared.applications.includeUserActions,\n                \"authenticationContexts\", Shared.applications.includeAuthenticationContextClassReferences)),\n        \"Excluded target resources\", Supplied(Local.applications.excludeApplications, Shared.applications.excludeApplications),\n        \"Client types\", Supplied(Local.clientAppTypes, Shared.clientAppTypes),\n        \"Device/platform conditions\", Supplied(bag_pack(\"platforms\", Local.platforms,\n            \"devices\", Local.devices, \"deviceStates\", Local.deviceStates),\n            bag_pack(\"platforms\", Shared.platforms, \"devices\", Shared.devices, \"deviceStates\", Shared.deviceStates)),\n        \"Location conditions\", Supplied(Local.locations, Shared.locations),\n        \"Risk conditions\", Supplied(bag_pack(\"userRisk\", Local.userRiskLevels, \"signInRisk\", Local.signInRiskLevels),\n            bag_pack(\"userRisk\", Shared.userRiskLevels, \"signInRisk\", Shared.signInRiskLevels)),\n        \"Grant controls\", tostring(Grant),\n        \"Authentication-strength reference\", tostring(Grant.authenticationStrength.id),\n        \"Session controls\", tostring(Session), \"ReturnedDefinition\", ReturnedDefinition);\nlet UniqueCAIds = toscalar(CAObjects | summarize Records=count() by ObjectId\n    | summarize Invalid=countif(isempty(ObjectId) or Records != 1) | project Invalid == 0);\nlet UniqueRuleIds = toscalar(RuleObjects | summarize Records=count() by ObjectId\n    | summarize Invalid=countif(isempty(ObjectId) or Records != 1) | project Invalid == 0);\nlet CAInventoryReady = PolicyResponseReady and UniqueCAIds;\nlet PlanInventoryReady = PlanResponseReady and EmbeddedRulesReady and UniquePlanIds and UniqueRuleIds;\nlet InventoryReady = CAInventoryReady and PlanInventoryReady;\n\nlet IdentityCatalogue = Catalogue\n    | where (Engine == \"CA policy\" and CAInventoryReady)\n        or (Engine == \"Policy Plans rule\" and PlanInventoryReady);\nlet InputA = iff(base64_decode_tostring('{Policy_servicePrincipalMode:base64}') == \"individual\", dynamic([{Policy_servicePrincipal}]), pack_array(base64_decode_tostring('{Policy_servicePrincipalMode:base64}')));\nlet InputB = InputA;\nlet ValidSelection = (Values:dynamic) {\n    let Presets = set_intersect(Values,\n        dynamic([\"aggregate-all-enabled\", \"aggregate-enabled-ca\", \"aggregate-enabled-rules\"]));\n    array_length(Presets) == 0\n        or (array_length(Presets) == 1 and array_length(set_difference(Values, Presets)) == 0)\n};\nlet SelectionInputsValid = ValidSelection(InputA)\n    and (true or ValidSelection(InputB));\nlet Resolve = (Values:dynamic) {\n    let Explicit = print V=Values | mv-expand K=V to typeof(string)\n        | where not(K startswith \"aggregate-\") | distinct K;\n    let HasExplicit = toscalar(Explicit | count) > 0;\n    IdentityCatalogue\n    | where ValidSelection(Values)\n    | where (HasExplicit and Key in (Explicit)) or\n        (not(HasExplicit) and State == \"Enabled\" and (\n            array_index_of(Values, \"aggregate-all-enabled\") >= 0\n            or (array_index_of(Values, \"aggregate-enabled-ca\") >= 0 and Engine == \"CA policy\")\n            or (array_index_of(Values, \"aggregate-enabled-rules\") >= 0 and Engine == \"Policy Plans rule\")))\n};\nlet SelectionAObjects = Resolve(InputA);\nlet SelectionBObjects = Resolve(InputB);\nlet SelectionAIds = toscalar(SelectionAObjects | summarize make_set(ObjectId));\nlet SelectionBIds = toscalar(SelectionBObjects | summarize make_set(ObjectId));\nlet SelectionAKeys = toscalar(SelectionAObjects | summarize make_set(Key));\nlet SelectionBKeys = toscalar(SelectionBObjects | summarize make_set(Key));\nlet RequiredInventoryReady = (Values:dynamic) {\n    case(array_index_of(Values, \"aggregate-all-enabled\") >= 0, CAInventoryReady and PlanInventoryReady,\n        array_index_of(Values, \"aggregate-enabled-ca\") >= 0, CAInventoryReady,\n        array_index_of(Values, \"aggregate-enabled-rules\") >= 0, PlanInventoryReady,\n        true)\n};\nlet SelectionAResolved = RequiredInventoryReady(InputA) and ValidSelection(InputA)\n    and array_length(set_difference(InputA, set_union(SelectionAKeys,\n        dynamic([\"aggregate-all-enabled\", \"aggregate-enabled-ca\", \"aggregate-enabled-rules\"])))) == 0;\nlet SelectionBResolved = RequiredInventoryReady(InputB) and ValidSelection(InputB)\n    and array_length(set_difference(InputB, set_union(SelectionBKeys,\n        dynamic([\"aggregate-all-enabled\", \"aggregate-enabled-ca\", \"aggregate-enabled-rules\"])))) == 0;\nlet SelectionReady = SelectionAResolved and array_length(SelectionAIds) > 0\n    and (true or (SelectionBResolved and array_length(SelectionBIds) > 0));\n\nlet StartTime = {TimeRange:start};\nlet EndTime = {TimeRange:end};\nlet EntraTenant = base64_decode_tostring('{WorkspaceTenant:base64}');\nlet RequestedPrincipal = base64_decode_tostring('{spid:base64}');\nlet RequestedApp = base64_decode_tostring('{App_servicePrincipal:base64}');\nlet PrincipalFilter = iff(RequestedPrincipal in (\"All\", \"All users\", \"All service principals\", \"\"), \"All\", RequestedPrincipal);\nlet AppFilter = iff(RequestedApp in (\"All\", \"All apps\", \"All resources\", \"\"), \"All apps\", RequestedApp);\nlet DataView = iff(base64_decode_tostring('{Unit_servicePrincipal:base64}') == \"signIns\", \"Sign-ins\", \"Principals\");\nlet UnitLabel = iff(DataView == \"Sign-ins\", \"sign-ins\", iff(IdentityView == \"user\", \"users\", \"service principals\"));\nlet IsComparison = false;\nlet WorkloadEvents =\n    AADServicePrincipalSignInLogs\n    | where TimeGenerated >= StartTime and TimeGenerated < EndTime\n    | where AADTenantId == EntraTenant\n    | where PrincipalFilter == \"All\" or ServicePrincipalId =~ PrincipalFilter\n    | where AppFilter == \"All apps\" or ResourceDisplayName =~ AppFilter\n    | project TimeGenerated, ActivityTime = CreatedDateTime,\n        TenantKey = AADTenantId, EventId = Id, Source = \"ServicePrincipal\",\n        PrincipalId = ServicePrincipalId, PrincipalName = ServicePrincipalName,\n        AppId, AppName = \"\",\n        ResourceKey = ResourceIdentity, ResourceName = ResourceDisplayName,\n        CorrelationId, OverallCAStatus = ConditionalAccessStatus,\n        ActualResultType = ResultType, ActualReason = ResultDescription,\n        ActualStatus = dynamic(null),\n        Policies = parse_json(ConditionalAccessPolicies),\n        Geo = parse_json(LocationDetails), Device = dynamic(null),\n        ClientApp = \"\", Risk = \"\";\nlet RawEvents = WorkloadEvents;\n\nlet AReady = SelectionAResolved and array_length(SelectionAIds) > 0 and isnotempty(EntraTenant);\nlet BReady = SelectionBResolved and array_length(SelectionBIds) > 0 and isnotempty(EntraTenant);\nlet DataKeysReady = toscalar(RawEvents | summarize MissingEvents=countif(isempty(EventId)),\n    MissingPrincipals=countif(isempty(PrincipalId))\n    | project MissingEvents == 0 and (DataView == \"Sign-ins\" or MissingPrincipals == 0));\nlet Events = materialize(\n    RawEvents\n    | where DataKeysReady\n    | where isnotempty(EventId)\n    | extend EventKey = tostring(pack_array(TenantKey, Source, EventId))\n    | extend PayloadSignature = hash_sha256(tostring(pack_array(\n        ActivityTime, PrincipalId, PrincipalName, AppId, AppName,\n        ResourceKey, ResourceName, CorrelationId, OverallCAStatus,\n        ActualResultType, ActualReason, ActualStatus,\n        Policies, Geo, Device, ClientApp, Risk)))\n    | summarize arg_max(TimeGenerated, *),\n        PayloadVariants = make_set(PayloadSignature, 2),\n        ObservationCount = count() by EventKey\n    | extend RecordConflict = array_length(PayloadVariants) > 1,\n        DuplicateObservations = ObservationCount - 1,\n        Country = tostring(Geo.countryOrRegion),\n        Latitude = todouble(Geo.geoCoordinates.latitude),\n        Longitude = todouble(Geo.geoCoordinates.longitude),\n        Platform = tostring(Device.operatingSystem),\n        DeviceTrust = tostring(Device.trustType),\n        DeviceManaged = tostring(Device.isManaged),\n        DeviceCompliant = tostring(Device.isCompliant),\n        AggregateCAResult = case(\n            tolower(tostring(OverallCAStatus)) == \"success\", \"Success\",\n            tolower(tostring(OverallCAStatus)) == \"failure\", \"Failure\",\n            tolower(tostring(OverallCAStatus)) == \"notapplied\", \"Not applied\",\n            \"Unavailable\")\n);\nlet ReduceSelection = (\n    T:(EventKey:string, Policies:dynamic, RecordConflict:bool),\n    SelectedIds:dynamic, Resolved:bool, SideReady:bool)\n{\n    let IDs = print Values = SelectedIds\n        | mv-expand MemberId = Values to typeof(string)\n        | where isnotempty(MemberId)\n        | distinct MemberId;\n    let Expected = toscalar(IDs | count);\n    let Observed = T\n        | mv-expand Entry = Policies\n        | extend MemberId = tostring(Entry.id)\n        | where MemberId in (IDs)\n        | summarize Entry = take_any(Entry),\n            Variants = make_set(tostring(Entry), 2) by EventKey, MemberId\n        | extend Conflict = array_length(Variants) > 1,\n            RawResult = tostring(Entry.result)\n        | extend Token = tolower(RawResult)\n        | extend Outcome = case(\n            not(SideReady), \"Unavailable\",\n            Conflict, \"Unavailable\",\n            Token in (\"success\", \"reportonlysuccess\"), \"Success\",\n            Token in (\"failure\", \"reportonlyfailure\"), \"Failure\",\n            Token in (\"notapplied\", \"reportonlynotapplied\"), \"Not applied\",\n            \"Unavailable\"),\n            Mode = case(\n                not(SideReady), \"Unavailable\",\n                Conflict, \"Unavailable\",\n                Token in (\"success\", \"failure\", \"notapplied\"), \"Enforced\",\n                Token in (\"reportonlysuccess\", \"reportonlyfailure\",\n                    \"reportonlynotapplied\", \"reportonlyinterrupted\"), \"Report-only\",\n                \"Unavailable\");\n    let Stats = Observed\n        | summarize Seen = count(),\n            Failures = countif(Outcome == \"Failure\"),\n            Successes = countif(Outcome == \"Success\"),\n            NotApplied = countif(Outcome == \"Not applied\"),\n            Unknowns = countif(Outcome == \"Unavailable\"),\n            Enforced = countif(Mode == \"Enforced\"),\n            ReportOnly = countif(Mode == \"Report-only\"),\n            UnknownModes = countif(Mode == \"Unavailable\"),\n            SeenIds = make_set(MemberId),\n            Evidence = make_list(bag_pack(\n                \"id\", MemberId, \"displayName\", tostring(Entry.displayName),\n                \"rawResult\", RawResult, \"outcome\", Outcome, \"mode\", Mode,\n                \"conflict\", Conflict, \"raw\", Entry))\n          by EventKey;\n    T\n    | project EventKey, RecordConflict\n    | join kind=leftouter Stats on EventKey\n    | extend Seen = coalesce(Seen, 0),\n        Failures = coalesce(Failures, 0),\n        Successes = coalesce(Successes, 0),\n        NotApplied = coalesce(NotApplied, 0),\n        Unknowns = coalesce(Unknowns, 0),\n        Enforced = coalesce(Enforced, 0),\n        ReportOnly = coalesce(ReportOnly, 0),\n        UnknownModes = coalesce(UnknownModes, 0),\n        SeenIds = iff(isnull(SeenIds), dynamic([]), SeenIds),\n        Evidence = iff(isnull(Evidence), dynamic([]), Evidence)\n    | extend Complete = SideReady and Resolved and Expected > 0\n        and Seen == Expected and Unknowns == 0 and not(RecordConflict)\n    | extend Result = case(\n        not(SideReady) or not(Resolved) or Expected == 0 or RecordConflict,\n            \"Unavailable\",\n        Failures > 0, \"Failure\",\n        not(Complete), \"Unavailable\",\n        Successes > 0, \"Success\",\n        NotApplied == Expected, \"Not applied\",\n        \"Unavailable\"),\n        Mode = case(\n            not(SideReady) or not(Resolved) or Expected == 0\n                or RecordConflict, \"Unavailable\",\n            Seen < Expected or UnknownModes > 0, \"Partially available\",\n            Enforced > 0 and ReportOnly > 0, \"Mixed: enforced and report-only\",\n            ReportOnly > 0, \"Report-only\",\n            Enforced > 0, \"Enforced\",\n            \"Unavailable\")\n    | project EventKey, Result, Mode, Complete, Evidence,\n        MissingIds = set_difference(SelectedIds, SeenIds);\n};\nlet ReducerInput = Events | project EventKey, Policies, RecordConflict;\nlet SelectionAIsAggregateCA = array_index_of(InputA, \"aggregate-enabled-ca\") >= 0;\nlet SelectionBIsAggregateCA = array_index_of(InputB, \"aggregate-enabled-ca\") >= 0;\nlet A = union\n    (Events | where SelectionAIsAggregateCA\n        | project EventKey, AResult = AggregateCAResult, AMode = \"Aggregate CA\",\n            AComplete = AggregateCAResult != \"Unavailable\", AEvidence = dynamic([]), AMissingIds = dynamic([])),\n    (ReduceSelection(ReducerInput, SelectionAIds, SelectionAResolved, AReady)\n        | where not(SelectionAIsAggregateCA)\n    | project EventKey, AResult = Result, AMode = Mode, AComplete = Complete,\n        AEvidence = Evidence, AMissingIds = MissingIds);\nlet B = union\n    (Events | where SelectionBIsAggregateCA\n        | project EventKey, BResult = AggregateCAResult, BMode = \"Aggregate CA\",\n            BComplete = AggregateCAResult != \"Unavailable\", BEvidence = dynamic([]), BMissingIds = dynamic([])),\n    (ReduceSelection(ReducerInput, SelectionBIds, SelectionBResolved, BReady)\n        | where not(SelectionBIsAggregateCA)\n    | project EventKey, BResult = Result, BMode = Mode, BComplete = Complete,\n        BEvidence = Evidence, BMissingIds = MissingIds);\nlet Compared = materialize(\n    Events\n    | join kind=leftouter A on EventKey\n    | join kind=leftouter B on EventKey\n    | extend Difference = case(\n        AResult == \"Unavailable\" or BResult == \"Unavailable\", \"Unavailable\",\n        AResult != BResult, \"Different\",\n        \"Same\")\n);\nlet SideRows = union\n    (Compared | extend Selection = \"Selection A\", Outcome = AResult, Mode = AMode),\n    (Compared | extend Selection = \"Selection B\", Outcome = BResult, Mode = BMode)\n    | where IsComparison or Selection == \"Selection A\";\nlet ScopeKey = hash_sha256(tostring(pack_array(\n    base64_decode_tostring('{Workspace:base64}'), EntraTenant, IdentityView,\n    array_sort_asc(SelectionAIds), array_sort_asc(SelectionBIds),\n    StartTime, EndTime, PrincipalFilter, AppFilter, DataView)));\n\nlet CardResult = base64_decode_tostring('{resultName:base64}');\n\nlet ReportRows = Compared | where DataKeysReady | where CardResult == \"Total\" or AResult == CardResult;\nlet ReportScope = hash_sha256(strcat(ScopeKey, CardResult));\n\nReportRows\n| summarize Count=count(), Label=take_any(PrincipalName) by PrincipalId\n| project ServicePrincipalId=PrincipalId, Count,\n    PrincipalToken=tostring(bag_pack(\"scope\", ReportScope, \"id\", PrincipalId))\n| order by Count desc",
        "size": 0,
        "showAnalytics": true,
        "title": "Service principal sign-in count - {resultName}",
        "timeContext": {
          "durationMs": 86400000
        },
        "timeContextFromParameter": "TimeRange",
        "exportFieldName": "PrincipalToken",
        "exportParameterName": "ReportPrincipal_servicePrincipal",
