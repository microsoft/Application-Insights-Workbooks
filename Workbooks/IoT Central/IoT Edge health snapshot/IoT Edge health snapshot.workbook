{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "name": "metrics-source-guidance",
      "content": {
        "json": "# IoT Edge health snapshot\nSelect the subscription, workspace, IoT resource and time range. **Legacy only** uses the existing collector data. Select **New only** for the migrated collector, or **Combine legacy and new history** to join the two at your actual cutover time without overlap."
      }
    },
    {
      "type": 9,
      "name": "migration-workspace-cutover-parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "bf9feb4c-2bd3-4491-9c4d-613916efd665",
            "version": "KqlParameterItem/1.0",
            "name": "Subscription",
            "label": "Subscriptions",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "includeAll": false,
              "showDefault": false
            },
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ]
          },
          {
            "id": "a45f8156-951f-5863-a9f7-11016d5e2054",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsWorkspace",
            "type": 5,
            "label": "Metrics Log Analytics workspace",
            "isRequired": true,
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project value = id, label = id, selected = false, group = resourceGroup",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscription}"
            ],
            "description": "Select the workspace containing InsightsMetrics and/or IoTEdgeMetrics_CL. Workspace query access is required.",
            "multiSelect": false,
            "value": null,
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            }
          },
          {
            "id": "21ba18c6-7e02-5fac-bed6-acfd56609356",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsSourceMode",
            "type": 2,
            "label": "Metrics source",
            "isRequired": true,
            "value": "Legacy",
            "jsonData": "[{\"value\": \"Legacy\", \"label\": \"Legacy only\"}, {\"value\": \"New\", \"label\": \"New only\"}, {\"value\": \"Cutover\", \"label\": \"Combine legacy and new history\"}]",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            }
          },
          {
            "id": "979649a8-9b99-407e-bd77-79ce9223ae1f",
            "version": "KqlParameterItem/1.0",
            "name": "timeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "isGlobal": true,
            "value": {
              "durationMs": 7200000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 7200000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          }
        ],
        "style": "pills"
      }
    },
    {
      "type": 9,
      "name": "metrics-cutover-input",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "0021cb85-46b4-5acd-a082-e4fa44f97167",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsCutoverUtc",
            "type": 1,
            "label": "Cutover time (UTC)",
            "value": "",
            "description": "Enter YYYY-MM-DDTHH:mm:ssZ. Use the actual changeover time, not the current time."
          }
        ],
        "style": "pills"
      },
      "conditionalVisibility": {
        "parameterName": "MetricsSourceMode",
        "comparison": "isEqualTo",
        "value": "Cutover"
      }
    },
    {
      "type": 9,
      "name": "metrics-effective-cutover",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "f1a256d1-1227-554b-9c1a-cac191f8e0a1",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsCutoverEffective",
            "type": 1,
            "isHiddenWhenLocked": true,
            "criteriaData": [
              {
                "criteriaContext": {
                  "leftOperand": "MetricsSourceMode",
                  "operator": "!=",
                  "rightValType": "static",
                  "rightVal": "Cutover",
                  "resultValType": "static",
                  "resultVal": "not-applicable"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "MetricsCutoverUtc",
                  "operator": "is Empty",
                  "rightValType": "static",
                  "resultValType": "static",
                  "resultVal": "not-set"
                }
              },
              {
                "criteriaContext": {
                  "operator": "Default",
                  "rightValType": "static",
                  "resultValType": "param",
                  "resultVal": "MetricsCutoverUtc"
                }
              }
            ]
          }
        ],
        "style": "pills"
      }
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "2243e822-b290-4f4a-9e84-762f6c7a1670",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedResource",
            "label": "(Input parameter) The selected IoT Resource.",
            "type": 1,
            "isRequired": true,
            "isGlobal": true,
            "query": "{\"version\":\"1.0.0\",\"content\":\"{ \\\"value\\\": null }\",\"transformers\":null}",
            "isHiddenWhenLocked": true,
            "timeContext": {
              "durationMs": 86400000
            },
            "defaultValue": "value::1",
            "queryType": 8
          },
          {
            "id": "31596d7b-c0a9-448f-b3cc-a3a906cb9d48",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceType",
            "type": 7,
            "isRequired": true,
            "value": "microsoft.iotcentral/iotapps",
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\"microsoft.iotcentral/iotapps\"]",
            "defaultValue": "value::1"
          },
          {
            "id": "59a4f202-f0c0-4ca3-9f36-bea664c4f751",
            "version": "KqlParameterItem/1.0",
            "name": "invokedFromFleetViewWorkbook",
            "type": 1,
            "isRequired": true,
            "isGlobal": true,
            "query": "print \"no\"",
            "isHiddenWhenLocked": true,
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{MetricsWorkspace}"
        ]
      },
      "conditionalVisibility": {
        "parameterName": "neverset",
        "comparison": "isNotEqualTo"
      },
      "name": "parameters - 7"
    },
    {
      "type": 9,
      "name": "migration-iot-resource-selection",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "772b73b4-5f47-4f57-941b-ce38259fa721",
            "version": "KqlParameterItem/1.0",
            "name": "IoTResources",
            "label": "IoT resources",
            "type": 5,
            "isRequired": true,
            "multiSelect": false,
            "query": "Resources\r\n| where type == '{ResourceType}'\r\n| order by name asc\r\n| extend Rank = row_number()\r\n| project value = id, label = name, selected = Rank <= 10, group = resourceGroup",
            "isHiddenWhenLocked": false,
            "crossComponentResources": [
              "{Subscription}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ]
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## This workbook is designed to be invoked from the IoT Edge Fleet view workbook.",
        "style": "upsell"
      },
      "conditionalVisibility": {
        "parameterName": "invokedFromFleetViewWorkbook",
        "comparison": "isEqualTo",
        "value": "no"
      },
      "name": "text - 8"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "nav",
        "links": [
          {
            "id": "dc44ee65-21ec-486d-9dad-d0efb00f4fa6",
            "linkTarget": "WorkbookTemplate",
            "linkLabel": "Open Fleet view workbook",
            "style": "secondary",
            "workbookContext": {
              "componentIdSource": "workbook",
              "resourceIdsSource": "workbook",
              "templateIdSource": "static",
              "templateId": "Community-Workbooks/IoT Central/IoT Edge Fleet view",
              "typeSource": "default",
              "gallerySource": "default",
              "locationSource": "default",
              "passSpecificParams": true,
              "templateParameters": [
                {
                  "name": "MetricsWorkspace",
                  "source": "parameter",
                  "value": "MetricsWorkspace"
                },
                {
                  "name": "MetricsSourceMode",
                  "source": "parameter",
                  "value": "MetricsSourceMode"
                },
                {
                  "name": "MetricsCutoverUtc",
                  "source": "parameter",
                  "value": "MetricsCutoverUtc"
                },
                {
                  "name": "timeRange",
                  "source": "parameter",
                  "value": "timeRange"
                },
                {
                  "name": "IoTResources",
                  "source": "parameter",
                  "value": "IoTResources"
                }
              ]
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "invokedFromFleetViewWorkbook",
        "comparison": "isEqualTo",
        "value": "no"
      },
      "name": "links - 9"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "55873e95-d307-447f-b424-658d974a6b35",
            "version": "KqlParameterItem/1.0",
            "name": "hostDiskPercentThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "d3772e57-23fc-4c88-9a94-789b42d1443b",
            "version": "KqlParameterItem/1.0",
            "name": "hostMemPercentThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "963fbd91-e407-4a8d-8ed7-819db38def1c",
            "version": "KqlParameterItem/1.0",
            "name": "hostCpuPercentThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "415e783d-36b0-4cb3-927c-542efc856401",
            "version": "KqlParameterItem/1.0",
            "name": "localMessagesSentThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "4440ff57-019f-4853-8f85-7ff21fca6c71",
            "version": "KqlParameterItem/1.0",
            "name": "upstreamMessagesSentThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "601fdb2e-7d15-4d8f-be85-cf618391e165",
            "version": "KqlParameterItem/1.0",
            "name": "qlenThreshold",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{MetricsWorkspace}"
        ]
      },
      "conditionalVisibility": {
        "parameterName": "neverset",
        "comparison": "isNotEqualTo"
      },
      "name": "MainParams"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "1613525f-d44c-47d6-b556-154edf69b3b0",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedDevice",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true,
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ],
            "value": ""
          },
          {
            "id": "396cd2ec-92f8-4be2-97d9-5130202dca93",
            "version": "KqlParameterItem/1.0",
            "name": "LastUpdated",
            "type": 1,
            "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nEdgeMetrics\n| where Name == \"edgehub_gettwin_total\"\n     or Name == \"edgeAgent_total_time_running_correctly_seconds\"\n| where Tags matches regex (\"edge_device.:.{SelectedDevice}.,\")\n//| extend dimensions=parse_json(Tags)\n//| extend device = tostring(dimensions.edge_device)\n//| where device == '{SelectedDevice}'\n| summarize lastUpdateTime = max(TimeGenerated)\n| extend  lastUpdatedSeconds = tolong(datetime_diff('second', now(), lastUpdateTime))\n| extend  lastUpdatedMins = tolong(datetime_diff('minute', now(), lastUpdateTime))\n| extend  lastUpdatedHours = tolong(datetime_diff('hour', now(), lastUpdateTime))\n| extend  lastUpdatedDays = tolong(datetime_diff('day', now(), lastUpdateTime))\n| extend agoText = case(lastUpdatedSeconds <= 60, strcat(lastUpdatedSeconds, iff(lastUpdatedSeconds == 1, \" sec ago\", \" secs ago\")),\n                        lastUpdatedSeconds <= 3600, strcat(lastUpdatedMins, iff(lastUpdatedMins == 1, \" min ago\", \" mins ago\")), \n                        lastUpdatedSeconds <= 86400, strcat(lastUpdatedHours, iff(lastUpdatedHours == 1, \" hr ago\", \" hrs ago\")),\n                        strcat(lastUpdatedDays, iff(lastUpdatedHours == 1, \" day ago\", \" days ago\")))\n| project agoText\n",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ],
            "isHiddenWhenLocked": true,
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "18b0553c-911b-44cc-96ac-32ac9a0ca844",
            "version": "KqlParameterItem/1.0",
            "name": "ShowCPU",
            "type": 1,
            "query": "print \"1\"",
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          },
          {
            "id": "d1c4428c-9617-49d0-b980-d98f5418d52b",
            "version": "KqlParameterItem/1.0",
            "name": "CPUThreshold",
            "type": 1,
            "query": "print tolong(12)",
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          },
          {
            "id": "664577f7-537f-490e-b668-49a25f7991b5",
            "version": "KqlParameterItem/1.0",
            "name": "MemThreshold",
            "type": 1,
            "query": "print tolong(80)",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          },
          {
            "id": "72cac956-dec6-49e2-9f3c-1a37ca330440",
            "version": "KqlParameterItem/1.0",
            "name": "timeBin",
            "type": 1,
            "query": "print time(5m)",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{MetricsWorkspace}"
        ]
      },
      "conditionalVisibility": {
        "parameterName": "neverset",
        "comparison": "isNotEqualTo"
      },
      "name": "parameters - 2"
    },
    {
      "type": 9,
      "name": "migration-data-state",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "706e89b6-f494-5152-969b-7b8a223332e8",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsDataState",
            "type": 1,
            "label": "Metrics query status",
            "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nEdgeMetrics\n| where TimeGenerated between ({timeRange:start} .. {timeRange:end})\n| where tostring(parse_json(Tags).edge_device) == '{SelectedDevice:escape}'\n| summarize LegacyRows = countif(SourceTable == \"InsightsMetrics\"), NewRows = countif(SourceTable == \"IoTEdgeMetrics_CL\")\n| project State = case(\n    EdgeMode !in (\"Legacy\", \"New\", \"Cutover\") or (EdgeMode == \"Cutover\" and isnull(EdgeCutover)), \"InvalidCutover\",\n    LegacyRows > 0 and NewRows > 0, \"Transition\",\n    LegacyRows > 0, \"LegacyOnly\",\n    NewRows > 0, \"NewOnly\", \"Empty\")",
            "isHiddenWhenLocked": true,
            "description": "A blank or pending value means the query has not produced a state. It does not mean no metrics exist. Check unresolved inputs and query errors.",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ],
            "timeContextFromParameter": "timeRange"
          },
          {
            "id": "877f5ea9-1862-5bd8-bcdb-adc9c9ad0737",
            "version": "KqlParameterItem/1.0",
            "name": "MetricsAvailable",
            "type": 1,
            "query": "print IsPresent = iff('{MetricsDataState}' in (\"LegacyOnly\", \"NewOnly\", \"Transition\"), \"yes\", \"no\")",
            "isHiddenWhenLocked": true,
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{MetricsWorkspace}"
            ]
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{MetricsWorkspace}"
        ]
      }
    },
    {
      "type": 1,
      "name": "migration-invalid-cutover",
      "content": {
        "json": "## Enter a valid cutover time\nTo combine history, enter the actual UTC cutover timestamp. Legacy samples are used before this time and new samples at or after it. Alternatively, select Legacy only or New only."
      },
      "conditionalVisibility": {
        "parameterName": "MetricsDataState",
        "comparison": "isEqualTo",
        "value": "InvalidCutover"
      }
    },
    {
      "type": 1,
      "name": "migration-empty-state",
      "content": {
        "json": "## No metrics in this selection\nNo matching IoT Edge metrics were returned. Check the selected workspace, IoT resource, device, time range and metrics source. If the collector has stopped, select a time range when it was running. Query or access errors must be resolved separately.\n\n[Set up metrics collection](https://aka.ms/edgemon-docs)"
      },
      "conditionalVisibility": {
        "parameterName": "MetricsDataState",
        "comparison": "isEqualTo",
        "value": "Empty"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "<div style=\"display:flex; align-items: flex-end; flex-wrap: wrap;\">\r\n  <div class=\"msportalfx-text-ellipsis ext-usage-param\"  style=\"align-self:end; cursor: auto;\">\r\n    <span style=\"margin:0px 4px;\">IoT resource: &nbsp; <span style=\"font-weight:600\">{SelectedResource}</span></span>\r\n  </div>\r\n  <div class=\"msportalfx-text-ellipsis ext-usage-param\" style=\"align-self:end; cursor: auto;\">\r\n    <span style=\"margin:0px 4px\">Device: &nbsp; <span style=\"font-weight:600\">{SelectedDevice}</span></span>\r\n  </div>\r\n </div>"
            },
            "customWidth": "0",
            "conditionalVisibilities": [
              {
                "parameterName": "SelectedResource",
                "comparison": "isNotEqualTo"
              },
              {
                "parameterName": "invokedFromFleetViewWorkbook",
                "comparison": "isEqualTo",
                "value": "yes"
              }
            ],
            "name": "text - selected device"
          },
          {
            "type": 1,
            "content": {
              "json": "Metrics updated: <span style=\"font-weight:600\"> _{LastUpdated}_ </span>"
            },
            "customWidth": "0",
            "name": "text - last updated",
            "styleSettings": {
