    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "loadType": "always",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Health snapshot uses the signals below to determine device health.\r\nThe last 3 measurements from the device are evaluated against the configured thresholds to report health information.\r\n\r\n\r\n\r\n",
              "style": "info"
            },
            "name": "text - 2",
            "styleSettings": {
              "margin": "8px 0px 10px 0px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nlet minPeriod = 5m;\nEdgeMetrics\n| where TimeGenerated > startTime and TimeGenerated < endTime\n| where Name == \"edgehub_messages_sent_total\"\n| extend dimensions=parse_json(Tags)\n| extend device = tostring(dimensions.edge_device)\n| extend target = tostring(extractjson(\"$.to\",Tags,typeof(string)))\n| extend routeInput = (dimensions.to_route_input)\n| where device  == '{SelectedDevice}'\n| where target == 'upstream'\n| extend source = iff(isempty(tostring(dimensions.from_route_output)),\n                        tostring(dimensions.from),\n                        strcat(trim_start(@\"[^/]+/\", tostring(dimensions.from)), \"::\", tostring(dimensions.from_route_output)))\n| extend messages = toint(Val)\n| order by source, TimeGenerated\n| serialize | extend nextCount = next(messages, 1) | extend nextSource = next(source, 1)\n| extend diff = iff((messages - nextCount) >= 0 and source == nextSource, messages - nextCount, iff(TimeGenerated - startTime > 2*minPeriod, messages, 0))\n| project source, TimeGenerated, messages=diff\n| make-series Count=sum(messages) on TimeGenerated from startTime to endTime step time({timeBin}) by source;\n",
                    "size": 1,
                    "title": "Upstream messages",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 0
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "barchart",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Count",
                          "label": "Usage (%)"
                        },
                        {
                          "seriesName": "thresholdLine",
                          "label": "Health Threshold"
                        }
                      ],
                      "customThresholdLine": "{upstreamMessagesSentThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "upstream-messages"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nlet minPeriod = 5m;\nEdgeMetrics\n| where TimeGenerated > startTime and TimeGenerated < endTime\n| where Name == \"edgehub_messages_sent_total\"\n| extend dimensions=parse_json(Tags)\n| extend device = tostring(dimensions.edge_device)\n| extend target = tostring(extractjson(\"$.to\",Tags,typeof(string)))\n| extend routeInput = (dimensions.to_route_input)\n| where device  == '{SelectedDevice}'\n| where target != 'upstream'\n| extend source = iff(isempty(tostring(dimensions.from_route_output)),\n                        tostring(dimensions.from),\n                        strcat(trim_start(@\"[^/]+/\", tostring(dimensions.from)), \"::\", tostring(dimensions.from_route_output)))\n| extend messages = toint(Val)\n| order by source, TimeGenerated\n| serialize | extend nextCount = next(messages, 1) | extend nextSource = next(source, 1)\n| extend diff = iff((messages - nextCount) >= 0 and source == nextSource, messages - nextCount, iff(TimeGenerated - startTime > 2*minPeriod, messages, 0))\n| project source, TimeGenerated, messages=diff\n| make-series Count=sum(messages) on TimeGenerated from startTime to endTime step time({timeBin}) by source;\n\n",
                    "size": 1,
                    "title": "Local messages",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 0
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "barchart",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Count",
                          "label": "Usage (%)"
                        },
                        {
                          "seriesName": "thresholdLine",
                          "label": "Health Threshold"
                        }
                      ],
                      "customThresholdLine": "{localMessagesSentThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "Local messages"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nlet Qlen = EdgeMetrics\n| where TimeGenerated > startTime\n| where TimeGenerated < endTime\n| where Name == \"edgehub_queue_length\"\n| extend dimensions=parse_json(Tags)\n| extend device = tostring(dimensions.edge_device)\n| where device == '{SelectedDevice}'\n| extend ep = tostring(dimensions.endpoint)\n| extend ep = iif(ep == \"iothub\", \"upstream\", ep)\n| extend qlen = iif(Val > 0x7FFFFFFFFFFFFFFF, toreal(0), Val)\n| project device, qlen, ep, TimeGenerated\n| make-series Count=max(qlen) on TimeGenerated from startTime to endTime step time({timeBin}) by ep;\nQlen",
                    "size": 1,
                    "aggregation": 3,
                    "title": "Queue length (max)",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 14400000
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "linechart",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "group": "ep",
                      "createOtherGroup": 2,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Count",
                          "label": "QLen"
                        },
                        {
                          "seriesName": "thresholdLine",
                          "label": "Health Threshold"
                        }
                      ],
                      "customThresholdLine": "{qlenThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "queue-query"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nlet totalBytesByDevice = EdgeMetrics\n    | where TimeGenerated > startTime\n    | where Name == \"edgeAgent_total_disk_space_bytes\"\n    | extend dimensions=parse_json(Tags)\n    | extend device = tostring(dimensions.edge_device)\n    | where device == \"{SelectedDevice}\"\n    | extend value = tolong(Val)\n    | extend diskname = tostring(dimensions.disk_name)\n    | extend diskfs = tostring(dimensions.disk_filesystem)\n    | where diskfs != \"overlay\"\n    | top-nested of device by Ignore0=max(1),\n      top-nested 1 of TimeGenerated by Ignore1=max(TimeGenerated),\n      top-nested of value by Ignore2=max(1),\n      top-nested of diskname by Ignore3=max(1)\n    | project-away Ignore*\n    | summarize totalBytes=max(value) by diskname;\nlet used_disk_trend = EdgeMetrics\n    | where TimeGenerated > startTime\n    | where Name == \"edgeAgent_available_disk_space_bytes\"\n    | extend dimensions=parse_json(Tags)\n    | extend device = tostring(dimensions.edge_device)\n    | where device == '{SelectedDevice}'\n    | extend value = tolong(Val)\n    | extend diskname = tostring(dimensions.disk_name)\n    | extend diskfs = tostring(dimensions.disk_filesystem)\n    | where diskfs != \"overlay\"\n    | project device, diskname, value, TimeGenerated\n    | summarize availBytes=sum(value) by diskname, TimeGenerated\n    | join kind=leftouter\n        totalBytesByDevice\n        on $left.diskname == $right.diskname\n    | extend percentUsed = round((todouble(totalBytes) - todouble(availBytes)) / todouble(totalBytes) * 100, 0)\n    | project TimeGenerated, diskname, percentUsed\n    | make-series Count=max(percentUsed) on TimeGenerated from startTime to endTime step time({timeBin}) by diskname;\nused_disk_trend",
                    "size": 1,
                    "aggregation": 5,
                    "title": "Disk space usage (%)",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 0
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "linechart",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "group": "diskname",
                      "createOtherGroup": 2,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Count",
                          "label": "Used (%)"
                        },
                        {
                          "seriesName": "thresholdLine",
                          "label": "Health Threshold"
                        }
                      ],
                      "customThresholdLine": "{hostDiskPercentThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0,
                        "max": 100
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "disk-query"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nEdgeMetrics\n| where TimeGenerated > startTime and TimeGenerated < endTime\n| where Name == \"edgeAgent_used_cpu_percent\" and Tags contains \"host\"\n| extend dimensions=parse_json(Tags)\n| extend quantile = tostring(dimensions.quantile)\n| where quantile == \"0.99\"\n| extend device = tostring(dimensions.edge_device)\n| where device == '{SelectedDevice}'\n| extend value = round(toint(Val),2)\n| make-series max(value) on TimeGenerated from startTime to endTime step time({timeBin})",
                    "size": 1,
                    "aggregation": 3,
                    "title": "Host-level CPU utilization",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 14400000
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "unstackedbar",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "seriesLabelSettings": [
                        {
                          "seriesName": "thresholdLine",
                          "label": " Health Threshold"
                        },
                        {
                          "seriesName": "max_value",
                          "label": "CPU %"
                        }
                      ],
                      "customThresholdLine": "{hostCpuPercentThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0,
                        "max": 100
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "host-cpu-query - Copy"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// BEGIN IoT Edge migration normalization\nlet EdgeMode = '{MetricsSourceMode:escape}';\nlet EdgeCutover = todatetime('{MetricsCutoverEffective:escape}');\nlet EdgeSelection = pack_array(\"{IoTResources:escape}\");\nlet EdgeResourceIds = parse_json(tolower(tostring(iff(gettype(EdgeSelection) == \"array\", EdgeSelection, pack_array(tostring(EdgeSelection))))));\nlet EdgeLegacy = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Val:real, Tags:string, _ResourceId:string) []),\n    InsightsMetrics\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"Legacy\" or (EdgeMode == \"Cutover\" and TimeGenerated < EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Val), Tags = tostring(Tags),\n        ResourceId = tolower(_ResourceId), SourceTable = \"InsightsMetrics\";\nlet EdgeNew = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, Origin:string, Name:string, Value:real, Tags:string, ResourceId:string) []),\n    IoTEdgeMetrics_CL\n    | where Origin == \"iot.azm.ms\"\n    | where EdgeMode == \"New\" or (EdgeMode == \"Cutover\" and TimeGenerated >= EdgeCutover)\n    | project TimeGenerated, Name, Val = todouble(Value), Tags = tostring(Tags),\n        ResourceId = tolower(ResourceId), SourceTable = \"IoTEdgeMetrics_CL\";\nlet EdgeMetrics = union EdgeLegacy, EdgeNew\n    | where isnotempty(ResourceId) and ResourceId in (EdgeResourceIds);\n// END IoT Edge migration normalization\nlet startTime = {timeRange:start};\nlet endTime = {timeRange:end};\nlet totalMemByDevice = EdgeMetrics\n    | where TimeGenerated > startTime and TimeGenerated < endTime\n    | where Name == \"edgeAgent_total_memory_bytes\" and Tags contains \"host\"\n    | extend dimensions=parse_json(Tags)\n    | extend device = tostring(dimensions.edge_device)\n    | where device == '{SelectedDevice}'\n    | extend value = tolong(Val)\n    | project device, value, TimeGenerated\n    | top-nested of device by Ignore0=max(1),\n      top-nested of TimeGenerated by Ignore1=max(TimeGenerated),\n      top-nested of value by Ignore2=max(1)\n    | project-away Ignore*\n    | summarize total_bytes=max(value) by device;\nEdgeMetrics\n    | where TimeGenerated > startTime\n    | where Name == \"edgeAgent_used_memory_bytes\" and Tags contains \"host\"\n    | extend dimensions=parse_json(Tags)\n    | extend device = tostring(dimensions.edge_device)\n    | where device == '{SelectedDevice}'\n    | extend used_bytes = tolong(Val) \n    | project device, used_bytes, TimeGenerated\n    | join kind=leftouter totalMemByDevice on $left.device == $right.device\n    | extend mem_used_percent = (todouble(used_bytes) / todouble(total_bytes)) * 100\n    | extend mem_used_percent = round(mem_used_percent, 0)\n    | make-series max(mem_used_percent) on TimeGenerated from startTime to endTime step time({timeBin})",
                    "size": 1,
                    "aggregation": 3,
                    "title": "Host-level Memory utilization",
                    "noDataMessage": "Metric not reported in selected time range",
                    "noDataMessageStyle": 4,
                    "timeContext": {
                      "durationMs": 14400000
                    },
                    "timeContextFromParameter": "timeRange",
                    "timeBrushParameterName": "timeRange",
                    "showRefreshButton": true,
                    "queryType": 0,
                    "crossComponentResources": [
                      "{MetricsWorkspace}"
                    ],
                    "visualization": "unstackedbar",
                    "tileSettings": {
                      "showBorder": false
                    },
                    "graphSettings": {
                      "type": 0
                    },
                    "chartSettings": {
                      "xAxis": "TimeGenerated",
                      "seriesLabelSettings": [
                        {
                          "seriesName": "max_mem_used_percent",
                          "label": "Memory %"
                        },
                        {
                          "seriesName": "thresholdLine",
                          "label": "Health threshold"
                        }
                      ],
                      "customThresholdLine": "{hostMemPercentThreshold}",
                      "customThresholdLineStyle": 1,
                      "ySettings": {
                        "min": 0,
                        "max": 100
                      }
                    },
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "customWidth": "50",
                  "name": "memory-query"
                }
              ]
            },
            "name": "snapshot-charts"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "MetricsAvailable",
        "comparison": "isEqualTo",
        "value": "yes"
      },
      "name": "snapshot",
      "styleSettings": {
        "margin": "0px 0px 0px 0px",
        "showBorder": true
      }
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
