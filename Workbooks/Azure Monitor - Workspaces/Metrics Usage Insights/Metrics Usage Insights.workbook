          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let startDate = startofday({start_end_date:start});\r\nlet table_endDate = toscalar(AMWMetricsUsageDetails\r\n| where StartTime >= ago(5d)\r\n| summarize max(StartTime));\r\nlet endDate = startofday(min_of({start_end_date:end}, table_endDate));\r\nlet startEndTime = toscalar(AMWMetricsUsageDetails\r\n| where startofday(StartTime) == startDate\r\n| summarize max(EndTime));\r\nlet endEndTime = toscalar(AMWMetricsUsageDetails\r\n| where startofday(StartTime) == endDate\r\n| summarize max(EndTime));\r\nprint Header = \"Effective Comparison Period\", StartDate = startEndTime, EndDate = endEndTime",
              "size": 4,
              "timeContextFromParameter": "start_end_date",
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "tiles",
