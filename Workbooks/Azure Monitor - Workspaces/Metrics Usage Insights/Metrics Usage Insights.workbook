    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "loadType": "always",
        "items": [
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "4294ad1b-1515-46c7-9437-52bb3514e046",
                  "version": "KqlParameterItem/1.0",
                  "name": "DataPresent",
                  "type": 1,
                  "query": "AMWMetricsUsageDetails\r\n| summarize c=count(),max(EndTime)\r\n| project label=iff(c>0,\"Insights as of:\",\"\"),max_EndTime\r\n| where isnotempty(label) ",
                  "timeContext": {
                    "durationMs": 604800000
                  },
                  "queryType": 0,
                  "isHiddenWhenLocked": true,
                  "resourceType": "microsoft.monitor/accounts"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts"
            },
            "name": "parameters - 5"
          },
          {
            "type": 1,
            "content": {
              "json": "Configure diagnostic settings to send Metrics Usage Details for this Azure Monitor workspace.",
              "style": "warning"
            },
            "conditionalVisibility": {
              "parameterName": "DiagnosticSettingsEnabled",
              "comparison": "isEqualTo"
            },
            "name": "DiagnosticSettingsError-Text"
          },
          {
            "type": 1,
            "content": {
              "json": "Verify that this Azure Monitor workspace is actively ingesting data and that Metrics Usage Insights is supported in the workspace's region. [View supported regions](https://learn.microsoft.com/azure/azure-monitor/metrics/metrics-usage-insights#supported-regions).",
              "style": "warning"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isEqualTo"
              }
            ],
            "name": "MissingInsights-Text"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "paragraph",
              "links": [
                {
                  "id": "0f8a2de0-a254-431f-92e1-e1ad3b4b2a0f",
                  "cellValue": "https://learn.microsoft.com/azure/azure-monitor/metrics/metrics-usage-insights",
                  "linkTarget": "Url",
                  "linkLabel": "Learn more about metrics usage insights",
                  "preText": "",
                  "postText": "",
                  "style": "link"
                }
              ]
            },
            "name": "InsightsPresent"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "e9c58894-b986-4a28-a8da-452d0813d7d7",
                  "version": "KqlParameterItem/1.0",
                  "name": "WorkspaceNamespace",
                  "label": "Namespace",
                  "type": 2,
                  "isRequired": true,
                  "value": "*",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "query": "union (print value=\"*\", label=\"All\", selected=true, sortOrder=0), (AMWMetricsUsageDetails | distinct MetricNamespace | project value=MetricNamespace, label=MetricNamespace, selected=false, sortOrder=1)\r\n| order by sortOrder asc, label asc\r\n| project value, label, selected",
                  "timeContext": {
                    "durationMs": 7776000000
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.monitor/accounts"
                },
                {
                  "id": "b04e124e-a2ce-478d-83fd-51fc98cb46b3",
                  "version": "KqlParameterItem/1.0",
                  "name": "WorkspaceMetric",
                  "label": "Metric",
                  "type": 2,
                  "isRequired": true,
                  "value": "*",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "query": "let selectedNamespace = \"{WorkspaceNamespace}\";\r\nunion (print value=\"*\", label=\"All\", selected=true, sortOrder=0), (AMWMetricsUsageDetails | where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace | distinct MetricName | project value=MetricName, label=MetricName, selected=false, sortOrder=1)\r\n| order by sortOrder asc, label asc\r\n| project value, label, selected",
                  "timeContext": {
                    "durationMs": 7776000000
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.monitor/accounts"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isNotEqualTo"
              }
            ],
            "customWidth": "70",
            "name": "workspaceFilters"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AMWMetricsUsageDetails\r\n| summarize c=count(), max(EndTime)\r\n| project label=iff(c>0,\"Insights as of:\",\"\"), max_EndTime\r\n| where isnotempty(label)",
              "size": 4,
              "timeContext": {
                "durationMs": 604800000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "formatter": 5
                },
                "leftContent": {
                  "columnMatch": "label",
                  "formatter": 1
                },
                "rightContent": {
                  "columnMatch": "max_EndTime",
                  "formatter": 6,
                  "dateFormat": {
                    "formatName": "shortDateTimeNoMsPattern"
                  }
                },
                "showBorder": false,
                "size": "full"
              }
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isNotEqualTo"
              }
            ],
            "customWidth": "30",
            "name": "freshnessDate",
            "styleSettings": {
              "margin": "0 0 -90px 0"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let minutesPerDay = 1440.0;\nlet selectedNamespace = \"{WorkspaceNamespace}\";\nlet selectedMetric = \"{WorkspaceMetric}\";\nlet maxStartTimeUTC = toscalar(\n  AMWMetricsUsageDetails\n  | summarize max(StartTime));\nAMWMetricsUsageDetails\n| where StartTime == maxStartTimeUTC\n| where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace\n| where selectedMetric == \"*\" or MetricName == selectedMetric\n| summarize\n  DailyTimeseriesCount = max(DailyTimeseriesCount),\n  IncomingEventsCount = max(IncomingEventsCount),\n  DaysSinceMetricQueried = min(DaysSinceMetricQueried),\n  NumberOfQueries = max(NumberOfQueries)\n  by\n  MetricNamespace,\n  MetricName,\n  DimensionsList\n| project\n  Namespace = MetricNamespace,\n  Metric = MetricName,\n  Dimensions = DimensionsList,\n  [\"Daily Timeseries\"] = DailyTimeseriesCount,\n  [\"Per Minute Event Rate\"] = round(todouble(IncomingEventsCount) / minutesPerDay),\n  [\"Daily Incoming Events\"] = IncomingEventsCount,\n  [\"Days Since Last Query\"] = DaysSinceMetricQueried,\n  [\"Number of Queries\"] = NumberOfQueries\n| order by [\"Per Minute Event Rate\"] desc",
              "size": 0,
              "showAnalytics": true,
              "noDataMessage": "No metrics match the selected filters.",
              "noDataMessageStyle": 3,
              "timeContext": {
                "durationMs": 604800000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Namespace",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "Namespace in the Azure Monitor workspace that the metric belongs to."
                    }
                  },
                  {
                    "columnMatch": "Metric",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The name of the metric that the insight describes."
                    }
                  },
                  {
                    "columnMatch": "Dimensions",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The set of labels or dimensions being described. \"*\" indicates that all dimensions are included."
                    }
                  },
                  {
                    "columnMatch": "Daily Timeseries",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The daily timeseries count associated with the metric's labels or dimensions."
                    }
                  },
                  {
                    "columnMatch": "Daily Incoming Events",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal"
                      }
                    },
                    "tooltipFormat": {
                      "tooltip": "The total number of metric events received on the date shown by the \"Insights as of\" value. Rows are sorted by Event Rate (/min) in descending order; a zero can represent a very low event rate."
                    }
                  },
                  {
                    "columnMatch": "Per Minute Event Rate",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    },
                    "tooltipFormat": {
                      "tooltip": "The average number of metric events received per minute on the date shown by the \"Insights as of\" value. Values are rounded to the nearest whole number; a zero can represent a very low event rate."
                    }
                  },
                  {
                    "columnMatch": "Days Since Last Query",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The number of days before the \"Insights as of\" date that the metric was last queried."
                    }
                  },
                  {
                    "columnMatch": "Number of Queries",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The number of queries run on the metric on the date shown by the \"Insights as of\" value."
                    }
                  },
                  {
                    "columnMatch": "Azure Monitor Workspace",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Ingested Samples",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    },
                    "tooltipFormat": {
                      "tooltip": "The percentage change in the per-minute event rate from the start date to the end date of the comparison period. Shows 100% when the start value is zero and the end value is nonzero; blank when both values are zero."
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "Namespace",
                    "label": "Namespace"
                  },
                  {
                    "columnId": "Metric",
                    "label": "Metric"
                  },
                  {
                    "columnId": "Dimensions",
                    "label": "Dimensions"
                  },
                  {
                    "columnId": "Daily Timeseries",
                    "label": "Daily Timeseries"
                  },
                  {
                    "columnId": "Per Minute Event Rate",
                    "label": "Event Rate (/min)"
                  },
                  {
                    "columnId": "Daily Incoming Events",
                    "label": "Daily Events"
                  },
                  {
                    "columnId": "Days Since Last Query",
                    "label": "Days Since Last Query"
                  },
                  {
                    "columnId": "Number of Queries",
                    "label": "Number of Queries"
                  }
                ]
              }
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "explorationTable"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let table1 = AMWMetricsUsageDetails\n| summarize timeseries=sum(DailyTimeseriesCount) by StartTime, MetricNamespace, MetricName;\n\nlet table2 = table1\n| where StartTime > ago(7d)\n| summarize week=avg(timeseries) by MetricNamespace, MetricName;\n\nlet table3 = table1\n| where StartTime > ago(28d)\n| summarize month=avg(timeseries) by MetricNamespace, MetricName;\n\ntable2\n| join table3 on MetricNamespace, MetricName\n| extend diffTs = week-month\n| order by diffTs desc\n| project MetricName, diffTs\n| limit 10",
              "size": 0,
              "showAnalytics": true,
              "title": "Top 10 Metrics by Timeseries Growth (7-Day vs. 28-Day Average)",
              "noDataMessage": "No metrics are available for the selected time range.",
              "noDataMessageStyle": 3,
              "timeContext": {
                "durationMs": 2592000000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "categoricalbar",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Azure Monitor Workspace",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Daily Timeseries",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    }
                  }
                ]
              }
            },
            "customWidth": "49",
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "TopTimeSeries"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let top10Metrics = AMWMetricsUsageDetails\n| summarize timeseries=sum(DailyTimeseriesCount) by MetricName, MetricNamespace\n| order by timeseries desc\n| limit 10;\nlet allMetrics = AMWMetricsUsageDetails\n| summarize timeseries=sum(DailyTimeseriesCount) by StartTime, MetricName, MetricNamespace;\nallMetrics\n| join kind=inner top10Metrics on MetricName, MetricNamespace\n| summarize by StartTime, timeseries, MetricName",
              "size": 0,
              "aggregation": 5,
              "showAnalytics": true,
              "title": "Top 10 Metrics: Daily Timeseries Trend",
              "noDataMessage": "No metrics are available for the selected time range.",
              "noDataMessageStyle": 3,
              "timeContext": {
                "durationMs": 2592000000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "linechart",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Azure Monitor Workspace",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Daily Timeseries",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    }
                  }
                ]
              },
              "chartSettings": {
                "group": "MetricName",
                "createOtherGroup": 99,
                "showDataPoints": true
              }
            },
            "customWidth": "49",
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "TsTrend"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tabName",
        "comparison": "isEqualTo",
        "value": "accountExploration"
      },
      "name": "groupAccountExploration"
    },
    {
      "type": 12,
      "content": {
