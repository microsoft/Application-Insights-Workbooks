              "version": "KqlItem/1.0",
              "query": "let minutesPerDay = 1440.0;\r\nlet selectedNamespace = \"{IngestionNamespace}\";\r\nlet selectedMetric = \"{IngestionMetric}\";\r\nlet startDate = {start_end_date:start};\r\nlet table_endDate = toscalar(AMWMetricsUsageDetails\r\n| where StartTime >= ago(5d)\r\n| summarize max(StartTime));\r\nlet endDate = min_of({start_end_date:end}, table_endDate);\r\nlet End_TS =\r\n  AMWMetricsUsageDetails\r\n  | where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace\r\n  | where selectedMetric == \"*\" or MetricName == selectedMetric\r\n  | where startofday(StartTime) == startofday(endDate)\r\n  | project-rename ['Final Timeseries'] = DailyTimeseriesCount, [\"Final Daily Incoming Events\"] = IncomingEventsCount;\r\nlet Start_TS =\r\n  AMWMetricsUsageDetails\r\n  | where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace\r\n  | where selectedMetric == \"*\" or MetricName == selectedMetric\r\n  | where startofday(StartTime) == startofday(startDate)\r\n  | project-rename ['Initial Timeseries'] = DailyTimeseriesCount, [\"Initial Daily Incoming Events\"] = IncomingEventsCount;\r\nEnd_TS\r\n| join kind=fullouter Start_TS on MetricNamespace, MetricName, DimensionsList\r\n| extend\r\n    ['Final Timeseries'] = coalesce(['Final Timeseries'], 0),\r\n    ['Initial Timeseries'] = coalesce(['Initial Timeseries'], 0),\r\n    [\"Final Daily Incoming Events\"] = coalesce([\"Final Daily Incoming Events\"], 0),\r\n    [\"Initial Daily Incoming Events\"] = coalesce([\"Initial Daily Incoming Events\"], 0)\r\n| extend\r\n    [\"Final Per Minute Event Rate\"] = round(todouble([\"Final Daily Incoming Events\"]) / minutesPerDay),\r\n    [\"Initial Per Minute Event Rate\"] = round(todouble([\"Initial Daily Incoming Events\"]) / minutesPerDay)\r\n| extend\r\n    [\"Timeseries Difference\"] = ['Final Timeseries'] - ['Initial Timeseries'],\r\n    [\"Daily Incoming Events Difference\"] = [\"Final Daily Incoming Events\"] - [\"Initial Daily Incoming Events\"],\r\n    [\"Per Minute Event Rate Difference\"] = [\"Final Per Minute Event Rate\"] - [\"Initial Per Minute Event Rate\"]\r\n| extend\r\n    [\"Timeseries Change %\"] = iff(['Initial Timeseries'] == 0, iff(['Final Timeseries'] == 0, real(null), 100.0), abs(round([\"Timeseries Difference\"] * 100.0 / ['Initial Timeseries']))),\r\n    [\"Per Minute Event Rate Change %\"] = iff([\"Initial Per Minute Event Rate\"] == 0, iff([\"Final Per Minute Event Rate\"] == 0, real(null), 100.0), abs(round([\"Per Minute Event Rate Difference\"] * 100.0 / [\"Initial Per Minute Event Rate\"])))\r\n| project Namespace = coalesce(MetricNamespace, MetricNamespace1), Metric = coalesce(MetricName, MetricName1), Dimensions = coalesce(DimensionsList, DimensionsList1), ['Initial Timeseries'], ['Final Timeseries'], [\"Timeseries Difference\"], [\"Timeseries Change %\"], [\"Initial Per Minute Event Rate\"], [\"Final Per Minute Event Rate\"], [\"Per Minute Event Rate Difference\"], [\"Per Minute Event Rate Change %\"], [\"Initial Daily Incoming Events\"], [\"Final Daily Incoming Events\"], [\"Daily Incoming Events Difference\"]\r\n| sort by [\"Per Minute Event Rate Difference\"] desc\r\n",
