              }
            ],
            "name": "MissingInsightsUnusedText"
          },
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "paragraph",
              "links": [
                {
                  "id": "66b3bdf2-503b-43db-a299-c8d4b61371fb",
                  "cellValue": "https://learn.microsoft.com/azure/azure-monitor/metrics/metrics-usage-insights",
                  "linkTarget": "Url",
                  "linkLabel": "Learn more about metrics usage insights",
                  "preText": "",
                  "style": "link"
                }
              ]
            },
            "name": "InsightssPresent"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "05607eff-fcbc-40b8-8eda-e36c4b90a6f7",
                  "version": "KqlParameterItem/1.0",
                  "name": "notUsedInDays",
                  "label": "Not Used In Days",
                  "type": 2,
                  "isRequired": true,
                  "value": "30",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "jsonData": "[\r\n  { \"value\": \"30\", \"label\": \"30d\", \"selected\": true },\r\n  { \"value\": \"60\", \"label\": \"60d\", \"selected\": false },\r\n  { \"value\": \"90\", \"label\": \"90d\", \"selected\": false }\r\n]"
                },
                {
                  "id": "46e33ae7-ecfc-4e47-8812-f269b1eac889",
                  "version": "KqlParameterItem/1.0",
                  "name": "UnusedNamespace",
                  "label": "Namespace",
                  "type": 2,
                  "isRequired": true,
                  "value": "*",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "query": "union (print value=\"*\", label=\"All\", selected=true, sortOrder=0), (AMWMetricsUsageDetails | distinct MetricNamespace | project value=MetricNamespace, label=MetricNamespace, selected=false, sortOrder=1)\r\n| order by sortOrder asc, label asc\r\n| project value, label, selected",
                  "timeContext": {
                    "durationMs": 7776000000
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.monitor/accounts"
                },
                {
                  "id": "5488fcde-d6c2-4838-ae39-e50ae03676de",
                  "version": "KqlParameterItem/1.0",
                  "name": "UnusedMetric",
                  "label": "Metric",
                  "type": 2,
                  "isRequired": true,
                  "value": "*",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "query": "let selectedNamespace = \"{UnusedNamespace}\";\r\nunion (print value=\"*\", label=\"All\", selected=true, sortOrder=0), (AMWMetricsUsageDetails | where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace | distinct MetricName | project value=MetricName, label=MetricName, selected=false, sortOrder=1)\r\n| order by sortOrder asc, label asc\r\n| project value, label, selected",
                  "timeContext": {
                    "durationMs": 7776000000
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.monitor/accounts"
                }
              ],
              "style": "pills",
              "queryType": 0
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent2",
                "comparison": "isNotEqualTo"
              }
            ],
            "customWidth": "70",
            "name": "parameters - 2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AMWMetricsUsageDetails\r\n| summarize c=count(), max(EndTime)\r\n| project label=iff(c>0,\"Insights as of:\",\"\"), max_EndTime\r\n| where isnotempty(label)",
              "size": 4,
              "timeContext": {
                "durationMs": 604800000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "formatter": 5
                },
                "leftContent": {
                  "columnMatch": "label",
                  "formatter": 1
                },
                "rightContent": {
                  "columnMatch": "max_EndTime",
                  "formatter": 6,
                  "dateFormat": {
                    "formatName": "shortDateTimeNoMsPattern"
                  }
                },
                "showBorder": false,
                "size": "full"
              }
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent2",
                "comparison": "isNotEqualTo"
              }
            ],
            "customWidth": "30",
            "name": "freshnessDateUnused",
            "styleSettings": {
              "margin": "0 0 -90px 0"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let daysLimit = tolong(\"{notUsedInDays}\");\nlet minutesPerDay = 1440.0;\nlet selectedNamespace = \"{UnusedNamespace}\";\nlet selectedMetric = \"{UnusedMetric}\";\nlet maxStartTimeUTC = toscalar(\n  AMWMetricsUsageDetails\n  | summarize max(StartTime));\nAMWMetricsUsageDetails\n| where StartTime == maxStartTimeUTC\n| where selectedNamespace == \"*\" or MetricNamespace == selectedNamespace\n| where selectedMetric == \"*\" or MetricName == selectedMetric\n| where DaysSinceMetricQueried >= daysLimit\n| summarize\n  DailyTimeseriesCount = max(DailyTimeseriesCount),\n  IncomingEventsCount = max(IncomingEventsCount),\n  DaysSinceMetricQueried = min(DaysSinceMetricQueried),\n  NumberOfQueries = max(NumberOfQueries)\n  by\n  MetricNamespace,\n  MetricName,\n  DimensionsList\n| project\n  Namespace = MetricNamespace,\n  Metric = MetricName,\n  Dimensions = DimensionsList,\n  [\"Daily Timeseries\"] = DailyTimeseriesCount,\n  [\"Per Minute Event Rate\"] = round(todouble(IncomingEventsCount) / minutesPerDay),\n  [\"Daily Incoming Events\"] = IncomingEventsCount,\n  [\"Days Since Last Query\"] = DaysSinceMetricQueried,\n  [\"Number of Queries\"] = NumberOfQueries\n| order by [\"Per Minute Event Rate\"] desc",
              "size": 2,
              "showAnalytics": true,
              "noDataMessage": "No unused metrics match the selected inactivity period and filters.",
              "noDataMessageStyle": 3,
              "timeContext": {
                "durationMs": 259200000
              },
              "queryType": 0,
              "resourceType": "microsoft.monitor/accounts",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Namespace",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "Namespace in the Azure Monitor workspace that the metric belongs to."
                    }
                  },
                  {
                    "columnMatch": "Metric",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The name of the metric that the insight describes."
                    }
                  },
                  {
                    "columnMatch": "Dimensions",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The set of labels or dimensions being described. \"*\" indicates that all dimensions are included."
                    }
                  },
                  {
                    "columnMatch": "Daily Timeseries",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The daily timeseries count associated with the metric's labels or dimensions."
                    }
                  },
                  {
                    "columnMatch": "Daily Incoming Events",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal"
                      }
                    },
                    "tooltipFormat": {
                      "tooltip": "The total number of metric events received on the date shown by the \"Insights as of\" value. Rows are sorted by Event Rate (/min) in descending order; a zero can represent a very low event rate."
                    }
                  },
                  {
                    "columnMatch": "Per Minute Event Rate",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    },
                    "tooltipFormat": {
                      "tooltip": "The average number of metric events received per minute on the date shown by the \"Insights as of\" value. Values are rounded to the nearest whole number; a zero can represent a very low event rate."
                    }
                  },
                  {
                    "columnMatch": "Days Since Last Query",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The number of days before the \"Insights as of\" date that the metric was last queried."
                    }
                  },
                  {
                    "columnMatch": "Number of Queries",
                    "formatter": 0,
                    "tooltipFormat": {
                      "tooltip": "The number of queries run on the metric on the date shown by the \"Insights as of\" value."
                    }
                  },
                  {
                    "columnMatch": "Azure Monitor Workspace",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Ingested Samples",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "orangeRed"
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "Namespace",
                    "label": "Namespace"
                  },
                  {
                    "columnId": "Metric",
                    "label": "Metric"
                  },
                  {
                    "columnId": "Dimensions",
                    "label": "Dimensions"
                  },
                  {
                    "columnId": "Daily Timeseries",
                    "label": "Daily Timeseries"
                  },
                  {
                    "columnId": "Per Minute Event Rate",
                    "label": "Event Rate (/min)"
                  },
                  {
                    "columnId": "Daily Incoming Events",
                    "label": "Daily Events"
                  },
                  {
                    "columnId": "Days Since Last Query",
                    "label": "Days Since Last Query"
                  },
                  {
                    "columnId": "Number of Queries",
                    "label": "Number of Queries"
                  }
                ]
              }
            },
            "conditionalVisibilities": [
              {
                "parameterName": "DiagnosticSettingsEnabled",
                "comparison": "isEqualTo",
                "value": "true"
              },
              {
                "parameterName": "DataPresent2",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "paramsUnusedMetrics"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tabName",
        "comparison": "isEqualTo",
        "value": "unusedMetrics"
      },
      "name": "groupUnusedMetrics"
    },
