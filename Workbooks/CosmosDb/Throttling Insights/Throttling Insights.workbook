            "queryType": 12,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2019-07-01\"},{\"key\":\"metricnames\",\"value\":\"TotalRequests\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"$filter\",\"value\":\"DatabaseName eq '{DatabaseName}' and CollectionName eq '{Container}' and StatusCode eq '429'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries[0].data[0].total\",\"columns\":[]}}]}"
          },
          {
            "id": "a1b2c3d4-0000-4000-8000-000000000003",
            "version": "KqlParameterItem/1.0",
            "name": "MProv",
            "type": 1,
            "isHiddenWhenLocked": true,
            "queryType": 12,
