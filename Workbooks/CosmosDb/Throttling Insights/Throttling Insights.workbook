                            "customColumnWidthSetting": "40%"
                          }
                        },
                        {
                          "columnMatch": "Peak RU %",
                          "formatter": 8,
                          "formatOptions": {
                            "min": 0,
                            "max": 100,
                            "palette": "red"
                          }
