{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "<div style=\"padding:16px 20px;background:linear-gradient(135deg,#f8fafc 0%,#eef2ff 100%);border-radius:12px;border:1px solid #e2e8f0;\">\n  <div style=\"display:flex;align-items:center;gap:10px;\">\n    <span style=\"font-size:22px;line-height:1;\">🩺</span>\n    <h1 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:700;font-size:21px;color:#0f172a;letter-spacing:-0.4px;\">Cosmos DB throttling triage</h1>\n  </div>\n  <p style=\"margin:8px 0 0 0;font-family:'Segoe UI',sans-serif;font-size:13px;color:#475569;line-height:1.5;\">\n    Pick an account, container and time range. The <strong>Verdict</strong> tab answers <em>why</em> you are throttled and what to change &mdash; using free platform metrics only.\n  </p>\n</div>"
      },
      "name": "hero"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "style": "pills",
        "parameters": [
          {
            "id": "4999c6c6-c7ba-df45-6f5b-0053b09a2076",
            "version": "KqlParameterItem/1.0",
            "name": "Subscription",
            "label": "Subscription",
            "type": 6,
            "isRequired": true,
            "multiSelect": false,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\n| where type =~ 'microsoft.documentdb/databaseaccounts'\n| summarize count() by subscriptionId\n| project value = subscriptionId, label = subscriptionId, selected = false",
            "crossComponentResources": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "6b484740-3944-ba7b-7918-5e8f8eec680a",
            "version": "KqlParameterItem/1.0",
            "name": "CosmosAccount",
            "label": "Cosmos DB account",
            "description": "Select the customer-accessible Cosmos DB resource whose diagnostic settings send logs to Log Analytics.",
            "type": 5,
            "isRequired": true,
            "multiSelect": false,
            "query": "resources\n| where type =~ 'microsoft.documentdb/databaseaccounts'\n| project value = id, label = name, selected = false, group = resourceGroup\n| order by label asc",
            "crossComponentResources": [
              "{Subscription}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "44a5069f-5d67-87c3-c90c-a1ba115e197e",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "label": "Log Analytics workspace (optional)",
            "description": "Only used by the collapsed section at the bottom. Leave it empty — everything above runs on platform metrics.",
            "type": 5,
            "isRequired": false,
            "multiSelect": false,
            "query": "resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project value = id, label = name, selected = false, group = strcat(subscriptionId, ' / ', resourceGroup)\n| order by label asc",
            "crossComponentResources": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "54248f27-3a61-5f0e-0ba3-72c9bbc48d52",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "isGlobal": true,
            "value": {
              "durationMs": 2592000000
            },
            "description": "Applies to every metric chart and log query in this workbook.",
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 900000
                },
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "1c4769f5-9ade-aa69-c0cb-d5a0634a77cb",
            "version": "KqlParameterItem/1.0",
            "name": "EnabledApiTypes",
            "type": 1,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2021-01-15\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"properties.EnabledApiTypes\",\"columns\":[]}}]}",
            "isHiddenWhenLocked": true,
            "queryType": 12
          },
          {
            "id": "9c102367-caf3-eb51-7552-86a8c813371b",
            "version": "KqlParameterItem/1.0",
            "name": "ApiDatabases",
            "type": 1,
            "isHiddenWhenLocked": true,
            "criteriaData": [
              {
                "criteriaContext": {
                  "leftOperand": "EnabledApiTypes",
                  "operator": "=",
                  "rightValType": "static",
                  "rightVal": "Sql",
                  "resultValType": "static",
                  "resultVal": "sqlDatabases"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "EnabledApiTypes",
                  "operator": "contains",
                  "rightValType": "static",
                  "rightVal": "MongoDB",
                  "resultValType": "static",
                  "resultVal": "mongodbDatabases"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "EnabledApiTypes",
                  "operator": "contains",
                  "rightValType": "static",
                  "rightVal": "Cassandra",
                  "resultValType": "static",
                  "resultVal": "cassandraKeyspaces"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "EnabledApiTypes",
                  "operator": "contains",
                  "rightValType": "static",
                  "rightVal": "Gremlin",
                  "resultValType": "static",
                  "resultVal": "gremlinDatabases"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "EnabledApiTypes",
                  "operator": "contains",
                  "rightValType": "static",
                  "rightVal": "Table",
                  "resultValType": "static",
                  "resultVal": "tables"
                }
              },
              {
                "criteriaContext": {
                  "operator": "Default",
                  "rightValType": "param",
                  "resultValType": "static",
                  "resultVal": "sqlDatabases"
                }
              }
            ]
          },
          {
            "id": "30874a7e-e019-e8cf-d13d-37f0f1694c5e",
            "version": "KqlParameterItem/1.0",
            "name": "DatabaseName",
            "label": "Database",
            "description": "Select a database to populate the container filter.",
            "type": 2,
            "isGlobal": true,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/{ApiDatabases}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2020-04-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value.*.properties.resource.id\",\"columns\":[]}}]}",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 12,
            "isRequired": true
          }
        ]
      },
      "name": "scope-parameters"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "style": "pills",
        "parameters": [
          {
            "id": "aeb6f730-6ddd-5261-3fbc-d196e6ba3c38",
            "version": "KqlParameterItem/1.0",
            "name": "ApiContainerType",
            "type": 1,
            "isHiddenWhenLocked": true,
            "criteriaData": [
              {
                "criteriaContext": {
                  "leftOperand": "ApiDatabases",
                  "operator": "=",
                  "rightValType": "static",
                  "rightVal": "cassandraKeyspaces",
                  "resultValType": "static",
                  "resultVal": "tables"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "ApiDatabases",
                  "operator": "=",
                  "rightValType": "static",
                  "rightVal": "gremlinDatabases",
                  "resultValType": "static",
                  "resultVal": "graphs"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "ApiDatabases",
                  "operator": "=",
                  "rightValType": "static",
                  "rightVal": "mongodbDatabases",
                  "resultValType": "static",
                  "resultVal": "collections"
                }
              },
              {
                "criteriaContext": {
                  "leftOperand": "ApiDatabases",
                  "operator": "=",
                  "rightValType": "static",
                  "rightVal": "sqlDatabases",
                  "resultValType": "static",
                  "resultVal": "containers"
                }
              },
              {
                "criteriaContext": {
                  "operator": "Default",
                  "rightValType": "param",
                  "resultValType": "static",
                  "resultVal": "containers"
                }
              }
            ]
          },
          {
            "id": "d150200d-2918-f721-1f81-d1b2205f3a6c",
            "version": "KqlParameterItem/1.0",
            "name": "Container",
            "label": "Container",
            "description": "Select the container to investigate. This is a collection in MongoDB, a graph in Gremlin, and a table in Cassandra.",
            "type": 2,
            "isGlobal": true,
            "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/{ApiDatabases}/{DatabaseName:label}/{ApiContainerType}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2020-04-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value.*.properties.resource.id\",\"columns\":[]}}]}",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 12,
            "isRequired": true
          }
        ]
      },
      "conditionalVisibilities": [
        {
          "parameterName": "DatabaseName",
          "comparison": "isNotEqualTo"
        },
        {
          "parameterName": "ApiDatabases",
          "comparison": "isNotEqualTo",
          "value": "tables"
        }
      ],
      "name": "collection-parameters"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Subscription}"
