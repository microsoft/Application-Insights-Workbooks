            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.documentdb/databaseaccounts'\n| where id =~ '{CosmosAccount}'\n| take 1\n| extend Throttled = coalesce(todouble('{M429}'), 0.0)\n| extend AllReq    = coalesce(todouble('{MAll}'), 0.0)\n| extend ProvRU    = coalesce(todouble('{MProv}'), 0.0)\n| extend AutoRU    = coalesce(todouble('{MAuto}'), 0.0)\n| extend PartCount  = coalesce(todouble('{MPartCount}'), 0.0)\n| extend AutoScaled = coalesce(todouble('{MAutoScaled}'), 0.0)\n| extend Meta429    = coalesce(todouble('{MMeta429}'), 0.0)\n| extend NormHot    = coalesce(todouble('{MNormHot}'), 0.0)\n| extend NormCold   = coalesce(todouble('{MNormCold}'), 0.0)\n| extend Pct = iff(AllReq > 0.0, round(100.0 * Throttled / AllReq, 2), 0.0)\n| extend Status = case(\n    AllReq == 0.0, '⚪  NO TRAFFIC',\n    Pct >= 5.0,    '🔴  THROTTLED',\n    Pct >= 1.0,    '🟠  THROTTLING STARTING',\n    Pct >  0.0,    '🟡  NEGLIGIBLE',\n                   '🟢  NOT THROTTLED')\n| extend Headline = case(\n    AllReq == 0.0, 'No requests reached this container in the selected window. Widen the time range to 7 days.',\n    Pct >= 5.0,    strcat(tostring(Pct), '% of requests were rejected with HTTP 429 (', tostring(tolong(Throttled)), ' of ', tostring(tolong(AllReq)), '). This container IS being throttled.'),\n    Pct >= 1.0,    strcat(tostring(Pct), '% of requests were rejected with HTTP 429 (', tostring(tolong(Throttled)), ' of ', tostring(tolong(AllReq)), '). Retries are still absorbing it, but headroom is thin.'),\n    Pct >  0.0,    strcat(tostring(Pct), '% of requests were rejected with HTTP 429 (', tostring(tolong(Throttled)), ' of ', tostring(tolong(AllReq)), '). Normal for a bursty workload.'),\n                   strcat('Zero 429 responses across ', tostring(tolong(AllReq)), ' requests. This container is NOT throttled.'))\n| project Status, Pct, Headline",
              "size": 4,
              "title": "Throttling verdict",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "noDataMessage": "Select a Cosmos DB account, database and container above.",
              "noDataMessageStyle": 1,
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Status",
                  "formatter": 1
                },
                "subtitleContent": {
                  "columnMatch": "Headline",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Pct",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 1,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "showPin": true,
            "name": "auto-verdict"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.documentdb/databaseaccounts'\n| where id =~ '{CosmosAccount}'\n| take 1\n| extend Throttled = coalesce(todouble('{M429}'), 0.0)\n| extend AllReq    = coalesce(todouble('{MAll}'), 0.0)\n| extend ProvRU    = coalesce(todouble('{MProv}'), 0.0)\n| extend AutoRU    = coalesce(todouble('{MAuto}'), 0.0)\n| extend PartCount  = coalesce(todouble('{MPartCount}'), 0.0)\n| extend AutoScaled = coalesce(todouble('{MAutoScaled}'), 0.0)\n| extend Meta429    = coalesce(todouble('{MMeta429}'), 0.0)\n| extend NormHot    = coalesce(todouble('{MNormHot}'), 0.0)\n| extend NormCold   = coalesce(todouble('{MNormCold}'), 0.0)\n| extend Pct = iff(AllReq > 0.0, round(100.0 * Throttled / AllReq, 2), 0.0)\n| extend Base = iff(AutoRU > 0.0, AutoRU, ProvRU)\n| extend Mode = iff(AutoRU > 0.0, 'autoscale max throughput', 'manual throughput')\n| extend Step = iff(AutoRU > 0.0, 1000.0, 100.0)\n| extend RequiredRU = iff(Pct > 0.0 and Pct < 99.0, Base / (1.0 - Pct / 100.0), Base)\n| extend RecommendedRU = iff(Pct > 0.0 and Pct < 99.0 and Base > 0.0, ceiling(RequiredRU * 1.2 / Step) * Step, Base)\n| extend PerPartitionRU = iff(PartCount > 0.0 and Base > 0.0, Base / PartCount, 0.0)\n| extend ScaledTotal = AutoScaled * PartCount\n| extend AtCeiling = AutoRU > 0.0 and ScaledTotal >= AutoRU * 0.95\n| extend Diluted = PartCount >= 2.0 and Base > 0.0\n| extend Skewed = PartCount >= 2.0 and NormHot >= 80.0 and NormCold < NormHot * 0.75\n| extend Cause = case(\n    Throttled == 0.0 and Meta429 <= 0.0, 'No throttling in this window',\n    Throttled == 0.0 and Meta429 >  0.0, 'Control-plane / metadata rate limiting — the data plane is clean',\n    Base <= 0.0,         'Shared database throughput or serverless',\n    Skewed,              strcat('Hot partition — 1 of ', tostring(tolong(PartCount)), ' partitions peaked at ', tostring(tolong(NormHot)), '% of its RU/s budget while the quietest reached only ', tostring(tolong(NormCold)), '%. This is usually driven by one hot logical partition key'),\n    AtCeiling,           'Autoscale ceiling reached — already scaled to its maximum',\n    Diluted,             strcat('Insufficient RU/s — throughput split across ', tostring(tolong(PartCount)), ' physical partitions'),\n                         'Insufficient RU/s — physical partition saturated')\n| extend Action = case(\n    Throttled == 0.0 and Meta429 <= 0.0, 'No action needed.',\n    Throttled == 0.0 and Meta429 >  0.0, 'Reuse one CosmosClient singleton and cache container references — avoid CreateIfNotExists on every request.',\n    Base <= 0.0,         'Raise throughput at the database level, or give this container its own dedicated throughput.',\n    Skewed,              'Do not add RU/s — it widens every partition equally. This is almost always one hot logical key, which no amount of RU/s can fix. Repartition on a higher-cardinality or hierarchical key; enable diagnostic settings and open the Partitions tab to name the key.',\n    AtCeiling,           strcat('Raise the autoscale maximum to ', tostring(tolong(RecommendedRU)), ' RU/s — it is already running at its ceiling.'),\n    Diluted,             strcat('Increase ', Mode, ' to ', tostring(tolong(RecommendedRU)), ' RU/s (+', tostring(tolong(round(100.0 * (RecommendedRU - Base) / Base, 0))), '%) — throughput is divided evenly across all ', tostring(tolong(PartCount)), ' partitions. If it persists, check the Partitions tab for a hot key.'),\n                         strcat('Increase ', Mode, ' to ', tostring(tolong(RecommendedRU)), ' RU/s (+', tostring(tolong(round(100.0 * (RecommendedRU - Base) / Base, 0))), '%). If it persists, check the Partitions tab for a hot key.'))\n| extend Suppress = (Throttled == 0.0) or (Base <= 0.0) or Skewed\n| extend CurrentRU = iff(Base > 0.0, strcat(tostring(tolong(Base)), ' RU/s  (', Mode, ')'), 'not reported at container level')\n| extend TargetRU = iff(Suppress, 'n/a', strcat(tostring(tolong(RecommendedRU)), ' RU/s'))\n| extend PartWord =  iff(PartCount == 1.0, ' physical partition', ' physical partitions')\n| extend SkewInfo = iff(PartCount >= 2.0 and NormHot > 0.0, strcat(' — busiest peaked at ', tostring(tolong(NormHot)), '% RU, quietest at ', tostring(tolong(NormCold)), '%'), '')\n| extend PartitionInfo = strcat(iff(PerPartitionRU > 0.0, strcat(tostring(tolong(PartCount)), PartWord, ' — about ', tostring(tolong(PerPartitionRU)), ' RU/s each'), strcat(tostring(tolong(PartCount)), PartWord)), SkewInfo)\n| extend MetaInfo = strcat(tostring(tolong(Meta429)), ' metadata/control-plane requests were rate-limited (HTTP 429) on this account. Cache container references and reuse a single CosmosClient.')\n| extend Rows = pack_array(\n    pack_array('1', '🧭  Root cause', Cause),\n    pack_array('2', '📊  Current throughput', CurrentRU),\n    pack_array('3', '🧩  Physical partitions', PartitionInfo),\n    pack_array('4', '🎯  Recommended throughput', TargetRU),\n    pack_array('6', '🛠️  What to do', Action),\n    pack_array('7', '🗂️  Metadata throttling', MetaInfo))\n| mv-expand Rows\n| extend Ord = tostring(Rows[0]), Item = tostring(Rows[1]), Detail = tostring(Rows[2])\n| where not(Suppress) or Ord != '4'\n| where Ord != '3' or PartCount > 0.0\n| where Ord != '7' or (Meta429 > 0.0 and Throttled > 0.0)\n| order by Ord asc\n| project Ord, Item, Detail",
              "size": 1,
              "title": "Recommended action",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "noDataMessage": "Select a Cosmos DB account, database and container above.",
              "noDataMessageStyle": 1,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Ord",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Item",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "26%"
                    }
                  },
                  {
                    "columnMatch": "Detail",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "74%"
                    }
                  }
                ],
                "sortBy": [],
                "labelSettings": [
                  {
                    "columnId": "Ord",
                    "label": "Ord"
                  },
                  {
                    "columnId": "Item",
                    "label": "Finding"
                  },
                  {
                    "columnId": "Detail",
                    "label": "Recommendation"
                  }
                ]
              }
            },
            "showPin": true,
            "name": "auto-recommendation"
          }
        ]
      },
      "name": "tab-verdict",
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Verdict"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "<div style=\"display:flex;align-items:center;gap:10px;margin:2px 0 2px 0;\">\n  <span style=\"font-size:18px;line-height:1;\">🔎</span>\n  <h3 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:600;font-size:16px;color:#0f172a;letter-spacing:-0.2px;\">Request outcomes</h3>\n</div>\n<p style=\"margin:0 0 6px 0;font-family:'Segoe UI',sans-serif;font-size:12.5px;color:#64748b;line-height:1.45;\">How many requests succeeded and how many were rejected. <strong>429</strong> is the throttling code — the panels below identify what caused it.</p>"
            },
            "name": "evidence-card"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2019-07-01\"},{\"key\":\"metricnames\",\"value\":\"TotalRequests\"},{\"key\":\"aggregation\",\"value\":\"Total\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"orderby\",\"value\":\"total desc\"},{\"key\":\"$filter\",\"value\":\"DatabaseName eq '{DatabaseName}' and CollectionName eq '{Container}' and StatusCode eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries\",\"columns\":[{\"path\":\"$.metadatavalues[2].value\",\"columnid\":\"StatusCode\",\"columnType\":\"string\"},{\"path\":\"$.data[0].total\",\"columnid\":\"Requests\",\"columnType\":\"long\"}]}}]}",
              "size": 4,
              "title": "Requests by outcome",
              "noDataMessage": "No data for this scope and window. Platform metrics need no setup, so an empty result means the container genuinely received no traffic — try widening the time range.",
              "noDataMessageStyle": 1,
              "queryType": 12,
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "StatusCode",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Requests",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "maximumSignificantDigits": 3,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": false
              }
            },
            "showPin": true,
            "customWidth": "100",
            "name": "kpi-status"
          },
          {
            "type": 1,
            "content": {
              "json": "<div style=\"display:flex;align-items:center;gap:10px;margin:2px 0 2px 0;\">\n  <span style=\"font-size:18px;line-height:1;\">📈</span>\n  <h3 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:600;font-size:16px;color:#0f172a;letter-spacing:-0.2px;\">Sustained or a spike?</h3>\n</div>\n<p style=\"margin:0 0 6px 0;font-family:'Segoe UI',sans-serif;font-size:12.5px;color:#64748b;line-height:1.45;\">Short bursts are absorbed by SDK retries. A flat line at the top means real capacity pressure.</p>"
            },
            "name": "trend-card"
          },
          {
            "type": 10,
            "content": {
              "chartId": "39e949cc-bf5d-ee56-9870-66fb7f51c5c4",
