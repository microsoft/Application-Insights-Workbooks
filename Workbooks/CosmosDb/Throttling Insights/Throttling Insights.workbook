                          "label": "Partition key range"
                        },
                        {
                          "columnId": "Peak RU %",
                          "label": "Peak normalized RU %"
                        }
                      ],
                      "sortBy": [
                        {
                          "itemKey": "Peak RU %",
                          "sortOrder": 2
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "Peak RU %",
                        "sortOrder": 2
                      }
                    ]
                  },
                  "showPin": true,
                  "customWidth": "100",
                  "name": "range-saturation"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2019-07-01\"},{\"key\":\"metricnames\",\"value\":\"PhysicalPartitionSizeInfo\"},{\"key\":\"aggregation\",\"value\":\"Maximum\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"orderby\",\"value\":\"maximum desc\"},{\"key\":\"$filter\",\"value\":\"DatabaseName eq '{DatabaseName}' and CollectionName eq '{Container}' and PhysicalPartitionId eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries\",\"columns\":[{\"path\":\"$.metadatavalues[2].value\",\"columnid\":\"PhysicalPartitionId\",\"columnType\":\"string\"},{\"path\":\"$.data[0].maximum\",\"columnid\":\"Bytes\",\"columnType\":\"real\"}]}}]}",
                    "size": 1,
                    "title": "Storage per physical partition",
                    "noDataMessage": "No data for this scope and window. Platform metrics need no setup, so an empty result means the container genuinely received no traffic — try widening the time range.",
                    "noDataMessageStyle": 1,
                    "queryType": 12,
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "PhysicalPartitionId",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "40%"
                          }
                        },
                        {
                          "columnMatch": "Bytes",
                          "formatter": 8,
                          "formatOptions": {
                            "min": 0,
                            "palette": "purple"
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "PhysicalPartitionId",
                          "label": "Partition"
                        },
                        {
                          "columnId": "Bytes",
                          "label": "Storage (bytes)"
                        }
                      ],
                      "sortBy": [
                        {
                          "itemKey": "Bytes",
                          "sortOrder": 2
                        }
                      ]
                    },
                    "sortBy": [
                      {
                        "itemKey": "Bytes",
                        "sortOrder": 2
                      }
                    ]
                  },
                  "showPin": true,
                  "customWidth": "100",
                  "name": "partition-storage"
                }
              ]
            },
            "name": "partition-metrics",
            "customWidth": "50"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "<div style=\"display:flex;align-items:center;gap:10px;margin:2px 0 2px 0;\">\n  <span style=\"font-size:18px;line-height:1;\">🔬</span>\n  <h3 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:600;font-size:16px;color:#0f172a;letter-spacing:-0.2px;\">Which key is hot?</h3>\n</div>\n<p style=\"margin:0 0 6px 0;font-family:'Segoe UI',sans-serif;font-size:12.5px;color:#64748b;line-height:1.45;\">Log Analytics. Metrics prove a <em>partition</em> is saturated; only logs name the <em>key</em> responsible.</p>"
                  },
                  "name": "partition-logs-card",
                  "conditionalVisibility": {
                    "parameterName": "IsPkRuEnabled",
                    "comparison": "isEqualTo",
                    "parameterValue": "true"
                  }
                },
                {
                  "type": 1,
                  "content": {
                    "json": "<div style=\"padding:18px 20px;background:#ffffff;border-radius:12px;border:1px solid #e2e8f0;\">\n  <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:6px;\">\n    <span style=\"font-size:18px;line-height:1;\">🔍</span>\n    <h3 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:600;font-size:16px;color:#0f172a;\">Which key is hot?</h3>\n  </div>\n  <p style=\"margin:0 0 12px 0;font-family:'Segoe UI',sans-serif;font-size:12.5px;color:#64748b;line-height:1.5;\">Metrics can tell you a <em>partition</em> is saturated. Only logs can name the <em>key</em> doing it.</p>\n  <div style=\"padding:10px 14px;background:linear-gradient(135deg,#fffbeb 0%,#fef9c3 100%);border-radius:8px;border:1px solid #fde68a;\">\n    <p style=\"margin:0;font-family:'Segoe UI',sans-serif;font-size:12px;color:#92400e;line-height:1.6;\">\n      <strong>Setup required</strong> &mdash; enable the <code style=\"background:#dbeafe;padding:2px 7px;border-radius:5px;color:#1d4ed8;font-size:11px;\">PartitionKeyRUConsumption</code> category under <strong>Diagnostic settings</strong>, then pick the workspace above. Allow ~24h for data.\n    </p>\n  </div>\n</div>"
                  },
                  "name": "pkru-setup-card",
                  "conditionalVisibility": {
                    "parameterName": "IsPkRuEnabled",
                    "comparison": "isNotEqualTo",
                    "parameterValue": "true"
                  }
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "parameters": [
                      {
                        "id": "9c4e77a0-1b28-4f3d-9a10-6e5c8b2f7d41",
                        "version": "KqlParameterItem/1.0",
                        "name": "PartitionKeyRangeId",
                        "label": "Physical partition",
                        "type": 2,
                        "description": "Drill into one physical partition to see its key mix.",
                        "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\nCDBPartitionKeyRUConsumption\n| where _ResourceId =~ accountResourceId\n| where isempty(databaseFilter) or DatabaseName =~ databaseFilter\n| where isempty(containerFilter) or CollectionName =~ containerFilter\n| where isnotempty(PartitionKeyRangeId)\n| distinct PartitionKeyRangeId\n| order by PartitionKeyRangeId asc",
                        "crossComponentResources": [
                          "{Workspace}"
                        ],
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "timeContext": {
                          "durationMs": 0
                        },
                        "timeContextFromParameter": "TimeRange",
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces"
                      }
                    ],
                    "style": "above"
                  },
                  "name": "pkrange-parameters",
                  "conditionalVisibility": {
                    "parameterName": "IsPkRuEnabled",
                    "comparison": "isEqualTo",
                    "parameterValue": "true"
                  }
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\nlet rangeId = tostring(dynamic(\"{PartitionKeyRangeId:escapejson}\"));\nlet scoped = materialize(\n    CDBPartitionKeyRUConsumption\n    | where _ResourceId =~ accountResourceId\n    | where isempty(databaseFilter) or DatabaseName =~ databaseFilter\n    | where isempty(containerFilter) or CollectionName =~ containerFilter\n    | where isempty(rangeId) or PartitionKeyRangeId == rangeId\n    | where isnotempty(PartitionKey)\n);\nlet OthersThreshold = 5.0;\nscoped\n| summarize Ops = count() by Hour = bin(TimeGenerated, 1h), PartitionKey\n| as T\n| join kind=inner (T | summarize TotalOps = sum(Ops) by Hour) on Hour\n| extend Pct = round(100.0 * Ops / TotalOps, 2)\n| extend DisplayKey = iff(Pct < OthersThreshold, \"Others\", PartitionKey)\n| summarize Ops = sum(Ops) by Hour, DisplayKey\n| order by Hour asc, Ops desc",
                    "size": 0,
                    "title": "Requests per key over time",
                    "timeContextFromParameter": "TimeRange",
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "visualization": "barchart"
                  },
                  "customWidth": "100",
                  "name": "pkru-share",
                  "conditionalVisibility": {
                    "parameterName": "IsPkRuEnabled",
                    "comparison": "isEqualTo",
                    "parameterValue": "true"
                  }
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\nlet rangeId = tostring(dynamic(\"{PartitionKeyRangeId:escapejson}\"));\nlet scoped = materialize(\n    CDBPartitionKeyRUConsumption\n    | where _ResourceId =~ accountResourceId\n    | where isempty(databaseFilter) or DatabaseName =~ databaseFilter\n    | where isempty(containerFilter) or CollectionName =~ containerFilter\n    | where isempty(rangeId) or PartitionKeyRangeId == rangeId\n    | where isnotempty(PartitionKey)\n);\nlet HotThreshold = 60.0;\nlet RejectedCharge = 0.5;\nlet perHour = scoped\n    | summarize RU = sum(RequestCharge), Ops = count(), Rejected = countif(RequestCharge < RejectedCharge)\n      by Hour = bin(TimeGenerated, 1h), PartitionKey;\nlet totals = perHour | summarize TotalOps = sum(Ops) by Hour;\nperHour\n| join kind=inner totals on Hour\n| extend Pct = 100.0 * Ops / TotalOps\n| summarize\n    Hours = dcount(Hour),\n    HotHours = dcountif(Hour, Pct >= HotThreshold),\n    PeakPct = round(max(Pct), 1),\n    Ops = sum(Ops),\n    Rejected = sum(Rejected),\n    TotalRU = round(sum(RU), 0)\n  by PartitionKey\n| extend HotSharePct = round(100.0 * HotHours / Hours, 0)\n| extend RejectPct = iff(Ops > 0, round(100.0 * Rejected / Ops, 0), 0.0)\n| extend Verdict = case(\n    HotSharePct >= 80.0 and Rejected > 0, \"🔥 Hot key — being throttled\",\n    HotSharePct >= 80.0,                  \"🔥 Hot key\",\n    Rejected > 0,                         \"⚠️ Throttled\",\n                                          \"✅ Normal\")\n| extend Action = case(\n    HotSharePct >= 80.0, strcat(\"This single key took \", tostring(PeakPct), \"% of all requests at peak. Adding RU/s will not help — one logical key cannot be split across physical partitions. Raise the key's cardinality or add a synthetic suffix.\"),\n    Rejected > 0,        \"Requests on this key were rejected but it is not dominating the partition — this points to overall throughput, not key skew.\",\n                         \"\")\n| order by HotSharePct desc, PeakPct desc\n| project PartitionKey, Verdict, PeakPct, HotSharePct, RejectPct, TotalRU\n| take 20",
                    "size": 0,
                    "title": "Hottest keys in this partition",
                    "timeContextFromParameter": "TimeRange",
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "PartitionKey",
                          "formatter": 1
                        },
                        {
                          "columnMatch": "Verdict",
                          "formatter": 1
                        },
                        {
                          "columnMatch": "PeakPct",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "redGreen",
                            "min": 0,
                            "max": 100
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 1
                            }
                          }
                        },
                        {
                          "columnMatch": "HotSharePct",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "red",
                            "min": 0,
                            "max": 100
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0
                            }
                          }
                        },
                        {
                          "columnMatch": "RejectPct",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "red",
                            "min": 0,
                            "max": 100
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0
                            }
                          }
                        },
                        {
                          "columnMatch": "TotalRU",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "PartitionKey",
                          "label": "Partition key"
                        },
                        {
                          "columnId": "Verdict",
                          "label": "Verdict"
                        },
                        {
                          "columnId": "PeakPct",
                          "label": "Peak request share"
                        },
                        {
                          "columnId": "HotSharePct",
                          "label": "% hours hot"
                        },
                        {
                          "columnId": "RejectPct",
                          "label": "% rejected"
                        },
                        {
                          "columnId": "TotalRU",
                          "label": "RU charged"
                        },
                        {
                          "columnId": "Action",
                          "label": "What to do"
                        }
                      ],
                      "sortBy": []
                    }
                  },
                  "customWidth": "100",
                  "name": "pkru-hot-keys",
                  "conditionalVisibility": {
                    "parameterName": "IsPkRuEnabled",
                    "comparison": "isEqualTo",
                    "parameterValue": "true"
                  }
                }
              ]
            },
            "name": "partition-logs",
            "customWidth": "50"
          }
        ]
      },
      "name": "tab-partitions",
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Partitions"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "<div style=\"display:flex;align-items:center;gap:10px;margin:2px 0 2px 0;\">\n  <span style=\"font-size:18px;line-height:1;\">🔬</span>\n  <h3 style=\"margin:0;font-family:'Segoe UI',sans-serif;font-weight:600;font-size:16px;color:#0f172a;letter-spacing:-0.2px;\">Log Analytics assessment</h3>\n</div>\n<p style=\"margin:0 0 6px 0;font-family:'Segoe UI',sans-serif;font-size:12.5px;color:#64748b;line-height:1.45;\">Needs <code>DataPlaneRequests</code> and <code>PartitionKeyRUConsumption</code> in resource-specific mode. Empty results mean the logs are missing, not that the account is healthy.</p>"
            },
            "name": "deepdive-card"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\nlet accountRequests = materialize(\n    CDBDataPlaneRequests\n    | where _ResourceId =~ accountResourceId\n    | project TimeGenerated, StatusCode, DurationMs, RequestCharge, DatabaseName, CollectionName\n);\nlet scopedRequests = materialize(\n    accountRequests\n    | where isempty(databaseFilter) or isempty(DatabaseName) or DatabaseName =~ databaseFilter\n    | where isempty(containerFilter) or isempty(CollectionName) or CollectionName =~ containerFilter\n);\nlet accountRowCount = toscalar(accountRequests | count);\nlet accountThrottledCount = toscalar(accountRequests | summarize countif(StatusCode == 429));\nlet partitionRuRaw = materialize(\n    CDBPartitionKeyRUConsumption\n    | where _ResourceId =~ accountResourceId\n    | where isnotempty(PartitionKeyRangeId)\n    | project DatabaseName, CollectionName, PartitionKeyRangeId, RequestCharge\n);\nlet scopedPartitionRu = materialize(\n    partitionRuRaw\n    // Do NOT admit isempty(DatabaseName)/isempty(CollectionName) here. This table emits\n    // account-wide rows with blank dimensions; letting them through makes every container\n    // inherit the whole account's partition ranges and RU skew.\n    | where isempty(databaseFilter) or DatabaseName =~ databaseFilter\n    | where isempty(containerFilter) or CollectionName =~ containerFilter\n    | summarize RU = sum(RequestCharge) by PartitionKeyRangeId\n);\nlet scopedPartitions = toscalar(scopedPartitionRu | count);\nlet scopedTopShare = toscalar(\n    scopedPartitionRu\n    | summarize Total = sum(RU), Top = max(RU)\n    | project Share = iff(Total > 0, round(100.0 * Top / Total, 2), real(null))\n);\nlet assess = (T:(TimeGenerated:datetime, StatusCode:int, DurationMs:real, RequestCharge:real), ScopeLabel:string)\n{\n    let persistence = T\n        | summarize Requests = count(), Throttled = countif(StatusCode == 429) by Bin = bin(TimeGenerated, 1m)\n        | summarize TotalBins = count(), ThrottledBins = countif(Throttled > 0), PeakMinuteRequests = max(Requests)\n        | extend JoinKey = 1;\n    T\n    | summarize\n        TotalRequests = count(),\n        ThrottledRequests = countif(StatusCode == 429),\n        SucceededRequests = countif(StatusCode != 429),\n        TotalRequestCharge = sum(RequestCharge),\n        P99DurationMs = percentile(DurationMs, 99)\n    | extend JoinKey = 1\n    | join kind=inner persistence on JoinKey\n    | extend Scope = ScopeLabel\n    | project-away JoinKey, JoinKey1\n};\nassess(scopedRequests, \"Selected database / container\")\n| extend\n    ThrottleRatePct = iff(TotalRequests > 0, round(100.0 * ThrottledRequests / TotalRequests, 2), real(null)),\n    ConsistentThrottlingPct = iff(TotalBins > 0, round(100.0 * ThrottledBins / TotalBins, 2), real(null)),\n    PartitionsWithTraffic = scopedPartitions,\n    TopPartitionSharePct = scopedTopShare\n| extend\n    ThrottlingDetected = case(\n        accountRowCount == 0, \"No data\",\n        TotalRequests == 0, \"No data in scope\",\n        ThrottledRequests > 0, \"Yes\",\n        \"No\"),\n    ImpactLevel = case(\n        TotalRequests == 0, \"No data\",\n        ThrottledRequests == 0, \"None\",\n        ThrottleRatePct <= 5.0, \"Low (5% or less throttled)\",\n        \"Elevated (over 5% throttled)\")\n| extend\n    AvgRuPerRequest = iff(SucceededRequests > 0, TotalRequestCharge / SucceededRequests, real(null))\n| extend\n    PeakDemandRuPerSec = iff(isnull(AvgRuPerRequest) or PeakMinuteRequests == 0, real(null),\n        round(PeakMinuteRequests * AvgRuPerRequest / 60.0, 0))\n| extend\n    RecommendedRuPerSec = iff(isnull(PeakDemandRuPerSec), real(null),\n        max_of(400.0, ceiling(PeakDemandRuPerSec * 1.2 / 100.0) * 100.0))\n| extend\n    Issue = case(\n        accountRowCount == 0,\n            \"No diagnostic-log data in this window\",\n        TotalRequests == 0 and accountThrottledCount > 0,\n            \"Scope filter excludes all traffic\",\n        TotalRequests == 0,\n            \"No requests matched this scope\",\n        ThrottledRequests == 0 and accountThrottledCount > 0,\n            \"No throttling in this scope, but throttling exists elsewhere in the account\",\n        ThrottledRequests == 0,\n            \"Healthy - no throttling detected\",\n        ThrottleRatePct <= 5.0,\n            strcat(\"Minor throttling - \", tostring(ThrottleRatePct), \"% of requests returned 429\"),\n        PartitionsWithTraffic == 0,\n            strcat(\"Throttling at \", tostring(ThrottleRatePct), \"% - partition attribution unavailable\"),\n        isnull(TopPartitionSharePct),\n            strcat(\"Throttling at \", tostring(ThrottleRatePct), \"% - no partition RU recorded\"),\n        PartitionsWithTraffic == 1,\n            strcat(\"Throttling at \", tostring(ThrottleRatePct), \"% - all RU landed on a single partition key range\"),\n        TopPartitionSharePct >= 60.0,\n            strcat(\"Hot partition - 1 of \", tostring(PartitionsWithTraffic), \" active ranges consumed \", tostring(TopPartitionSharePct), \"% of RU\"),\n        strcat(\"Insufficient provisioned throughput - \", tostring(ThrottleRatePct), \"% throttled, RU spread evenly across \", tostring(PartitionsWithTraffic), \" ranges\")),\n    Recommendation = case(\n        accountRowCount == 0,\n            \"Enable the DataPlaneRequests diagnostic category in resource-specific mode, then re-run.\",\n        TotalRequests == 0 and accountThrottledCount > 0,\n            strcat(\"Clear the Database / Container filter — \", tostring(accountThrottledCount), \" throttled request(s) sit outside this scope.\"),\n        TotalRequests == 0,\n            \"Widen the time range, or clear the database and container filters.\",\n        ThrottledRequests == 0 and accountThrottledCount > 0,\n            strcat(\"Switch Container to the affected one — \", tostring(accountThrottledCount), \" throttled request(s) came from elsewhere.\"),\n        ThrottledRequests == 0,\n            \"No action required — provisioned throughput is adequate for this window.\",\n        ThrottleRatePct <= 5.0,\n            strcat(\"No RU increase needed — confirm SDK retries absorb transient 429s (peak \", tostring(toint(PeakDemandRuPerSec)), \" RU/s).\"),\n        PartitionsWithTraffic == 0,\n            \"Enable the PartitionKeyRUConsumption diagnostic category to attribute RU per partition.\",\n        isnull(TopPartitionSharePct),\n            \"Use the Normalized RU consumption by partition panel above to find the saturated range.\",\n        PartitionsWithTraffic == 1,\n            strcat(\"Check the partition panel above — if other ranges are idle this is key skew, else raise to ~\", tostring(toint(RecommendedRuPerSec)), \" RU/s.\"),\n        TopPartitionSharePct >= 60.0,\n            \"Redesign the partition key for higher cardinality — added RU/s lands on idle ranges and will not help.\",\n        strcat(\"Raise throughput to ~\", tostring(toint(RecommendedRuPerSec)), \" RU/s, or autoscale to that max — peak \", tostring(toint(PeakDemandRuPerSec)), \" RU/s plus 20% headroom.\"))\n| extend P99DurationMs = round(P99DurationMs, 2)\n| extend IssueParts = split(replace_string(Issue, \". \", \".~|~\"), \"~|~\")\n| mv-apply with_itemindex = ii Part = IssueParts on (\n    summarize IssueRows = make_list(pack(\"k\", iff(ii == 0, \"Issue\", \"\"), \"v\", Part))\n)\n| extend RecParts = split(replace_string(Recommendation, \". \", \".~|~\"), \"~|~\")\n| mv-apply with_itemindex = ri Part = RecParts on (\n    summarize RecRows = make_list(pack(\"k\", iff(ri == 0, \"Recommendation\", \"\"), \"v\", Part))\n)\n| extend Rows = array_concat(\n    pack_array(pack(\"k\", \"Impact\", \"v\", ImpactLevel)),\n    IssueRows,\n    RecRows,\n    pack_array(\n        pack(\"k\", \"Recommended RU/s\", \"v\", iff(isnull(RecommendedRuPerSec), \"n/a\", tostring(toint(RecommendedRuPerSec)))),\n        pack(\"k\", \"Peak demand RU/s\", \"v\", iff(isnull(PeakDemandRuPerSec), \"n/a\", tostring(toint(PeakDemandRuPerSec)))),\n        pack(\"k\", \"Throttle rate\", \"v\", strcat(tostring(ThrottleRatePct), \"%\")),\n        pack(\"k\", \"Throttled requests\", \"v\", tostring(ThrottledRequests)),\n        pack(\"k\", \"Total requests\", \"v\", tostring(TotalRequests)),\n        pack(\"k\", \"Consistently throttled minutes\", \"v\", strcat(tostring(ConsistentThrottlingPct), \"%\")),\n        pack(\"k\", \"Partitions with traffic\", \"v\", tostring(PartitionsWithTraffic)),\n        pack(\"k\", \"P99 latency\", \"v\", iff(isnull(P99DurationMs), \"n/a\", strcat(tostring(P99DurationMs), \" ms\")))\n    ))\n| mv-expand Rows\n| project Metric = tostring(Rows.k), Value = tostring(Rows.v)\n",
              "size": 0,
              "title": "Log-based confirmation and capacity recommendation",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "showExportToExcel": true,
              "showRefreshButton": true,
              "noDataMessage": "No log rows. Diagnostic logs are not reaching this workspace for the selected scope and window — this does NOT mean there is no throttling. The metrics panels above hold the verdict.",
              "noDataMessageStyle": 1,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Metric",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "24ch"
                    }
                  },
                  {
                    "columnMatch": "Value",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "120ch"
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "Metric",
                    "label": "Measure"
                  },
                  {
                    "columnId": "Value",
                    "label": "Result"
                  }
                ]
              },
              "timeContextFromParameter": "TimeRange"
            },
            "name": "automated-assessment"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\n\nCDBDataPlaneRequests\n| where _ResourceId =~ accountResourceId\n\n| where isempty(databaseFilter) or isempty(DatabaseName) or DatabaseName =~ databaseFilter\n| where isempty(containerFilter) or isempty(CollectionName) or CollectionName =~ containerFilter\n\n| where StatusCode == 429\n| summarize\n    ThrottledRequests = count(),\n    TotalRequestCharge = sum(RequestCharge),\n    AverageRequestCharge = avg(RequestCharge),\n    P95DurationMs = percentile(DurationMs, 95)\n    by RegionName, OperationName, RequestResourceType\n| project RegionName, OperationName, RequestResourceType, ThrottledRequests,\n    TotalRequestCharge = round(TotalRequestCharge, 2),\n    AverageRequestCharge = round(AverageRequestCharge, 2),\n    P95DurationMs = round(P95DurationMs, 2)\n| order by ThrottledRequests desc",
              "size": 0,
              "title": "Throttled requests by operation, resource type, and region",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "showExportToExcel": true,
              "showRefreshButton": true,
              "noDataMessage": "No matching rows in the selected Log Analytics workspace. Confirm the workspace receives this account's resource-specific diagnostic logs.",
              "noDataMessageStyle": 1,
              "gridSettings": {
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "RegionName",
                    "label": "Region"
                  },
                  {
                    "columnId": "OperationName",
                    "label": "Operation"
                  },
                  {
                    "columnId": "RequestResourceType",
                    "label": "Resource"
                  },
                  {
                    "columnId": "ThrottledRequests",
                    "label": "Throttled"
                  },
                  {
                    "columnId": "TotalRequestCharge",
                    "label": "Total RU"
                  },
                  {
                    "columnId": "AverageRequestCharge",
                    "label": "Avg RU"
                  },
                  {
                    "columnId": "P95DurationMs",
                    "label": "P95 ms"
                  }
                ]
              },
              "timeContextFromParameter": "TimeRange"
            },
            "name": "throttled-operations",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\n\nCDBDataPlaneRequests\n| where _ResourceId =~ accountResourceId\n\n| where isempty(databaseFilter) or isempty(DatabaseName) or DatabaseName =~ databaseFilter\n| where isempty(containerFilter) or isempty(CollectionName) or CollectionName =~ containerFilter\n\n| summarize\n    TotalRequests = count(),\n    ThrottledRequests = countif(StatusCode == 429),\n    SuccessfulRequests = countif(StatusCode between (200 .. 399) or StatusCode == 409),\n    P95DurationMs = percentile(DurationMs, 95),\n    P99DurationMs = percentile(DurationMs, 99)\n    by bin(TimeGenerated, 5m), RegionName\n| extend\n    ThrottleRatePct = round(100.0 * ThrottledRequests / TotalRequests, 2),\n    SuccessRatePct = round(100.0 * SuccessfulRequests / TotalRequests, 2)\n| project TimeGenerated, RegionName, ThrottleRatePct, SuccessRatePct\n| order by TimeGenerated asc",
              "size": 0,
              "title": "429 rate and success rate over time (%)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "timechart",
              "showExportToExcel": true,
              "showRefreshButton": true,
              "noDataMessage": "No matching rows in the selected Log Analytics workspace. Confirm the workspace receives this account's resource-specific diagnostic logs.",
              "noDataMessageStyle": 1,
              "gridSettings": {
                "filter": true
              },
              "timeContextFromParameter": "TimeRange"
            },
            "name": "request-impact",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let accountResourceId = tolower('{CosmosAccount}');\nlet databaseFilter = tostring(dynamic(\"{DatabaseName:escapejson}\"));\nlet containerFilter = tostring(dynamic(\"{Container:escapejson}\"));\n\nCDBDataPlaneRequests\n| where _ResourceId =~ accountResourceId\n\n| where isempty(databaseFilter) or isempty(DatabaseName) or DatabaseName =~ databaseFilter\n| where isempty(containerFilter) or isempty(CollectionName) or CollectionName =~ containerFilter\n\n| summarize\n    TotalRequests = count(),\n    ThrottledRequests = countif(StatusCode == 429),\n    SuccessfulRequests = countif(StatusCode between (200 .. 399) or StatusCode == 409),\n    P95DurationMs = percentile(DurationMs, 95),\n    P99DurationMs = percentile(DurationMs, 99)\n    by bin(TimeGenerated, 5m), RegionName\n| extend\n    ThrottleRatePct = round(100.0 * ThrottledRequests / TotalRequests, 2),\n    SuccessRatePct = round(100.0 * SuccessfulRequests / TotalRequests, 2)\n| project TimeGenerated, RegionName,\n    P95DurationMs = round(P95DurationMs, 2),\n    P99DurationMs = round(P99DurationMs, 2)\n| order by TimeGenerated asc",
              "size": 0,
              "title": "Server-side latency over time (ms)",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "timechart",
              "showExportToExcel": true,
              "showRefreshButton": true,
              "noDataMessage": "No matching rows in the selected Log Analytics workspace. Confirm the workspace receives this account's resource-specific diagnostic logs.",
              "noDataMessageStyle": 1,
              "gridSettings": {
                "filter": true
              },
              "timeContextFromParameter": "TimeRange"
            },
            "name": "request-latency",
            "customWidth": "50"
          },
          {
            "type": 1,
            "content": {
              "json": "### Data sources\n\n- Azure Monitor Metrics: `TotalRequests` and `NormalizedRUConsumption`.\n- Resource-specific Log Analytics tables: `CDBDataPlaneRequests` and `CDBPartitionKeyRUConsumption`.\n\nOfficial guidance: [Troubleshoot 429 responses](https://learn.microsoft.com/azure/cosmos-db/troubleshoot-request-rate-too-large) and [Monitor normalized RU consumption](https://learn.microsoft.com/azure/cosmos-db/monitor-normalized-request-units)."
            },
            "name": "sources",
            "customWidth": "50"
          }
        ]
      },
      "name": "tab-deepdive",
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "DeepDive"
      }
    }
  ],
