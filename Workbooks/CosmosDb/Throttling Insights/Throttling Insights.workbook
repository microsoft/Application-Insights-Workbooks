                        "splitBySortOrder": -1,
                        "splitByLimit": 10
                      }
                    ],
                    "title": "Normalized RU consumption by PartitionKeyRangeId (10 ranges max — see grid below)",
                    "showOpenInMe": true,
                    "filters": [
                      {
                        "id": "normalized-ru-by-range-database",
                        "key": "DatabaseName",
