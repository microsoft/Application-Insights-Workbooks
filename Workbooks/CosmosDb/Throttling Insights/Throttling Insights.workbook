                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{CosmosAccount}/providers/microsoft.insights/metrics\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2019-07-01\"},{\"key\":\"metricnames\",\"value\":\"PhysicalPartitionThroughputInfo\"},{\"key\":\"aggregation\",\"value\":\"Maximum\"},{\"key\":\"interval\",\"value\":\"FULL\"},{\"key\":\"timespan\",\"value\":\"{TimeRange:startISO}/{TimeRange:endISO}\"},{\"key\":\"top\",\"value\":\"1000\"},{\"key\":\"orderby\",\"value\":\"maximum desc\"},{\"key\":\"$filter\",\"value\":\"DatabaseName eq '{DatabaseName}' and CollectionName eq '{Container}' and PhysicalPartitionId eq '*'\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[0].timeseries\",\"columns\":[{\"path\":\"$.metadatavalues[2].value\",\"columnid\":\"PhysicalPartitionId\",\"columnType\":\"string\"},{\"path\":\"$.data[0].maximum\",\"columnid\":\"RU/s\",\"columnType\":\"real\"}]}}]}",
                    "size": 1,
