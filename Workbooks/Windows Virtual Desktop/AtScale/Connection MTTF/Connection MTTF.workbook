{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "b859a03f-2283-43dd-8536-42714bbfced6",
            "version": "KqlParameterItem/1.0",
            "name": "Subscriptions",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "where type startswith 'Microsoft.DesktopVirtualization/'\r\n    | summarize Count = count() by subscriptionId\r\n    | order by Count desc\r\n    | extend Rank = row_number()\r\n    | project value = subscriptionId, label = subscriptionId, selected = Rank == 1\r\n",
            "crossComponentResources": [
              "value::selected"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1
          },
          {
            "id": "2e3dfd9b-2d0f-4feb-94e8-107f220c4e28",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroups",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\r\n| where type contains  \"desktopvirtualization\"\r\n| summarize Count = count() by resourceGroup\r\n| project Label = resourceGroup, Id = resourceGroup, Selected = Count >= 0",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "951b5870-e216-45c6-b159-34150868a46e",
            "version": "KqlParameterItem/1.0",
            "name": "HostPools",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\r\n| where type == \"microsoft.desktopvirtualization/hostpools\" and resourceGroup in ({ResourceGroups})\r\n",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "MTTFTimeRange",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "e416af24-9d8b-4c42-939f-63bc28b8dcbb",
            "version": "KqlParameterItem/1.0",
            "name": "MTTFTimeRange",
            "label": "Time Range",
            "type": 4,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 604800000
            }
          },
          {
            "id": "a1c2e3f4-1234-5678-9abc-def012345678",
            "version": "KqlParameterItem/1.0",
            "name": "GatewayRegion",
            "label": "Gateway Region",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let WindowStart = {MTTFTimeRange:start};\r\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\r\nlet Lookback = 7d;\r\nunion isfuzzy=true WVDMultiLinkAdd,\r\n    (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n| where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n| where _ResourceId in~ ({HostPools})\r\n| extend GatewayLocation = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n| distinct GatewayLocation\r\n| union (datatable(GatewayLocation:string)[\"Unknown\", \"Unavailable\"])\r\n| distinct GatewayLocation\r\n| order by GatewayLocation asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          },
          {
            "id": "c3e4f5a6-3456-789a-bcde-f0123456789a",
            "version": "KqlParameterItem/1.0",
            "name": "ClientType",
            "label": "Client Type",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let WindowStart = {MTTFTimeRange:start};\r\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\r\nlet Lookback = 7d;\r\nlet _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayUnavailableSelected = _FilterGateway and 'Unavailable' in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nlet _HasMultiLink = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _GatewayUnavailableSelected\r\n    | distinct CorrelationId\r\n);\r\nWVDConnections\r\n| where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n| where _ResourceId in~ ({HostPools})\r\n| where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed) or (_GatewayUnavailableSelected and CorrelationId !in (_HasMultiLink))\r\n| where isnotempty(ClientType)\r\n| distinct ClientType\r\n| order by ClientType asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          },
          {
            "id": "b2d3f4a5-2345-6789-abcd-ef0123456789",
            "version": "KqlParameterItem/1.0",
            "name": "ClientVersion",
            "label": "Client Version",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let WindowStart = {MTTFTimeRange:start};\r\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\r\nlet Lookback = 7d;\r\nlet _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayUnavailableSelected = _FilterGateway and 'Unavailable' in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nlet _HasMultiLink = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _GatewayUnavailableSelected\r\n    | distinct CorrelationId\r\n);\r\nWVDConnections\r\n| where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n| where _ResourceId in~ ({HostPools})\r\n| where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed) or (_GatewayUnavailableSelected and CorrelationId !in (_HasMultiLink))\r\n| summarize\r\n    ClientType    = take_anyif(ClientType, isnotempty(ClientType)),\r\n    ClientVersion = take_anyif(ClientVersion, isnotempty(ClientVersion))\r\n    by CorrelationId\r\n| where '*' in ({ClientType}) or ClientType in ({ClientType})\r\n| where isnotempty(ClientVersion)\r\n| distinct ClientVersion\r\n| order by ClientVersion asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          },
          {
            "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedMTTFBin",
            "type": 1,
            "isHiddenWhenLocked": true,
            "value": ""
          },
          {
            "id": "bdd131b6-edb0-49e3-a136-40b5ef879c46",
            "version": "KqlParameterItem/1.0",
            "name": "MTTFPivot",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true,
            "value": ""
          },
          {
            "id": "f1e2d3c4-b5a6-7890-1234-fedcba987654",
            "version": "KqlParameterItem/1.0",
            "name": "MTTFPivotLabel",
            "type": 1,
            "isHiddenWhenLocked": true,
            "query": "{\"version\":\"1.0.0\",\"content\":\"{\\\"UserName\\\":\\\"User Name\\\",\\\"TransportType\\\":\\\"Transport Capability\\\",\\\"GatewayRegion\\\":\\\"Gateway Region\\\",\\\"HostPool\\\":\\\"Host Pool\\\",\\\"ArmPathSubscriptionId\\\":\\\"Subscription\\\",\\\"ArmPathResourceGroupName\\\":\\\"Resource Group\\\",\\\"SessionHostName\\\":\\\"Session Host\\\",\\\"SessionHostIPAddress\\\":\\\"Session Host IP/16\\\",\\\"ClientVersion\\\":\\\"Client Version\\\",\\\"ClientIPAddress\\\":\\\"Client IP/16\\\"}\",\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$[\\\"{MTTFPivot}\\\"]\",\"columns\":[]}}]}",
            "queryType": 8
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters_general"
    },
    {
      "type": 1,
      "content": {
        "json": "## MTTF Insight"
      },
      "name": "MTTFInsightTitle"
    },
    {
      "type": 1,
      "content": {
        "json": "Distribution of users across MTTF buckets. MTTF is calculated per user as connected hours within the selected time range divided by the number of connection failures in that range. Still-connected sessions are included only when their Connected event is available within the 7-day lookback. Completed sessions are also included when a Completed event falls in the selected range, even when their earlier lifecycle events are outside the lookback. Only hours within the selected range count. Connections without MultiLink telemetry are grouped as **Unavailable** for transport capability and gateway region; **Unknown** is reserved for a present MultiLink row with an empty gateway region. Users with no failures or an MTTF of 10 hours or more are classified as **Infinite**."
      },
      "name": "MTTFDescription"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let WindowStart = {MTTFTimeRange:start};\r\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\r\nlet Lookback = 7d;\r\nlet _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayUnavailableSelected = _FilterGateway and 'Unavailable' in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nlet _HasMultiLink = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _GatewayUnavailableSelected\r\n    | distinct CorrelationId\r\n);\r\nlet Connections = materialize(\r\n    WVDConnections\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed) or (_GatewayUnavailableSelected and CorrelationId !in (_HasMultiLink))\r\n    | summarize\r\n        ClientType    = take_anyif(ClientType, isnotempty(ClientType)),\r\n        ClientVersion = take_anyif(ClientVersion, isnotempty(ClientVersion)),\r\n        StartedTime   = minif(TimeGenerated, State == \"Started\"),\r\n        ConnectedTime = minif(TimeGenerated, State == \"Connected\"),\r\n        EndTime       = minif(TimeGenerated, State == \"Completed\"),\r\n        UserName      = take_any(UserName)\r\n        by CorrelationId\r\n    | where '*' in ({ClientType}) or ClientType in ({ClientType})\r\n    | where '*' in ({ClientVersion}) or ClientVersion in ({ClientVersion})\r\n    | where isnotempty(ConnectedTime) or (isempty(StartedTime) and isnotempty(EndTime))\r\n    | extend WindowedStart = max_of(coalesce(ConnectedTime, WindowStart), WindowStart)\r\n    | extend WindowedEnd = min_of(coalesce(EndTime, WindowEnd), WindowEnd)\r\n    | where WindowedEnd > WindowedStart\r\n    | extend DurationHours = datetime_diff('second', WindowedEnd, WindowedStart) / 3600.0\r\n);\r\nlet Failures = materialize(\r\n    WVDErrors\r\n    | where TimeGenerated between (WindowStart .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | distinct CorrelationId\r\n    | extend HasFailure = true\r\n);\r\nConnections\r\n| join kind=leftouter Failures on CorrelationId\r\n| extend IsDisruption = coalesce(HasFailure, false)\r\n| summarize\r\n    TotalDurationHours = sum(DurationHours),\r\n    DisruptionCount    = countif(IsDisruption)\r\n    by UserName\r\n| extend MeanTimeToFailureHours = iff(DisruptionCount > 0, TotalDurationHours / todouble(DisruptionCount), todouble(0))\r\n| extend MTTFBin = case(\r\n    DisruptionCount == 0 or MeanTimeToFailureHours >= 10, \"Infinite\",\r\n    MeanTimeToFailureHours < 1,  \"0 - 1 hrs\",\r\n    MeanTimeToFailureHours < 2,  \"1 - 2 hrs\",\r\n    MeanTimeToFailureHours < 3,  \"2 - 3 hrs\",\r\n    MeanTimeToFailureHours < 4,  \"3 - 4 hrs\",\r\n    MeanTimeToFailureHours < 5,  \"4 - 5 hrs\",\r\n    MeanTimeToFailureHours < 6,  \"5 - 6 hrs\",\r\n    MeanTimeToFailureHours < 7,  \"6 - 7 hrs\",\r\n    MeanTimeToFailureHours < 8,  \"7 - 8 hrs\",\r\n    MeanTimeToFailureHours < 9,  \"8 - 9 hrs\",\r\n    \"9 - 10 hrs\"\r\n)\r\n| summarize UserCount = count() by MTTFBin\r\n| extend SortOrder = case(\r\n    MTTFBin == \"0 - 1 hrs\",   1,\r\n    MTTFBin == \"1 - 2 hrs\",   2,\r\n    MTTFBin == \"2 - 3 hrs\",   3,\r\n    MTTFBin == \"3 - 4 hrs\",   4,\r\n    MTTFBin == \"4 - 5 hrs\",   5,\r\n    MTTFBin == \"5 - 6 hrs\",   6,\r\n    MTTFBin == \"6 - 7 hrs\",   7,\r\n    MTTFBin == \"7 - 8 hrs\",   8,\r\n    MTTFBin == \"8 - 9 hrs\",   9,\r\n    MTTFBin == \"9 - 10 hrs\", 10,\r\n    11\r\n)\r\n| sort by SortOrder asc\r\n| project MTTFBin, UserCount",
              "size": 0,
              "title": "MTTF Bucket Distribution",
              "queryType": 0,
              "resourceType": "microsoft.desktopvirtualization/hostpools",
              "crossComponentResources": [
                "{HostPools}"
              ],
              "visualization": "barchart",
              "chartSettings": {
                "xAxis": "MTTFBin",
                "yAxis": [
                  "UserCount"
                ],
                "xAxisTitle": "MTTF Time Range",
                "yAxisTitle": "Number of Users",
                "seriesLabelSettings": [
                  {
                    "seriesName": "UserCount",
                    "label": "Users",
                    "color": "blue"
                  }
                ],
                "ySettings": {
                  "min": 0
                }
              }
            },
            "name": "MTTFBarChart"
          }
        ]
      },
      "name": "MTTFBarChartGroup"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let WindowStart = {MTTFTimeRange:start};\r\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\r\nlet Lookback = 7d;\r\nlet _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayUnavailableSelected = _FilterGateway and 'Unavailable' in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nlet _HasMultiLink = materialize(\r\n    union isfuzzy=true WVDMultiLinkAdd,\r\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _GatewayUnavailableSelected\r\n    | distinct CorrelationId\r\n);\r\nlet Connections = materialize(\r\n    WVDConnections\r\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed) or (_GatewayUnavailableSelected and CorrelationId !in (_HasMultiLink))\r\n    | summarize\r\n        ClientType    = take_anyif(ClientType, isnotempty(ClientType)),\r\n        ClientVersion = take_anyif(ClientVersion, isnotempty(ClientVersion)),\r\n        StartedTime   = minif(TimeGenerated, State == \"Started\"),\r\n        ConnectedTime = minif(TimeGenerated, State == \"Connected\"),\r\n        EndTime       = minif(TimeGenerated, State == \"Completed\"),\r\n        UserName      = take_any(UserName)\r\n        by CorrelationId\r\n    | where '*' in ({ClientType}) or ClientType in ({ClientType})\r\n    | where '*' in ({ClientVersion}) or ClientVersion in ({ClientVersion})\r\n    | where isnotempty(ConnectedTime) or (isempty(StartedTime) and isnotempty(EndTime))\r\n    | extend WindowedStart = max_of(coalesce(ConnectedTime, WindowStart), WindowStart)\r\n    | extend WindowedEnd = min_of(coalesce(EndTime, WindowEnd), WindowEnd)\r\n    | where WindowedEnd > WindowedStart\r\n    | extend DurationHours = datetime_diff('second', WindowedEnd, WindowedStart) / 3600.0\r\n);\r\nlet Failures = materialize(\r\n    WVDErrors\r\n    | where TimeGenerated between (WindowStart .. WindowEnd)\r\n    | where _ResourceId in~ ({HostPools})\r\n    | distinct CorrelationId\r\n    | extend HasFailure = true\r\n);\r\nConnections\r\n| join kind=leftouter Failures on CorrelationId\r\n| extend IsDisruption = coalesce(HasFailure, false)\r\n| summarize\r\n    TotalDurationHours = sum(DurationHours),\r\n    DisruptionCount    = countif(IsDisruption)\r\n    by UserName\r\n| extend MeanTimeToFailureHours = iff(DisruptionCount > 0, TotalDurationHours / todouble(DisruptionCount), todouble(0))\r\n| extend MTTFBin = case(\r\n    DisruptionCount == 0 or MeanTimeToFailureHours >= 10, \"Infinite\",\r\n    MeanTimeToFailureHours < 1,  \"0 - 1 hrs\",\r\n    MeanTimeToFailureHours < 2,  \"1 - 2 hrs\",\r\n    MeanTimeToFailureHours < 3,  \"2 - 3 hrs\",\r\n    MeanTimeToFailureHours < 4,  \"3 - 4 hrs\",\r\n    MeanTimeToFailureHours < 5,  \"4 - 5 hrs\",\r\n    MeanTimeToFailureHours < 6,  \"5 - 6 hrs\",\r\n    MeanTimeToFailureHours < 7,  \"6 - 7 hrs\",\r\n    MeanTimeToFailureHours < 8,  \"7 - 8 hrs\",\r\n    MeanTimeToFailureHours < 9,  \"8 - 9 hrs\",\r\n    \"9 - 10 hrs\"\r\n)\r\n| summarize UserCount = count() by MTTFBin\r\n| extend SortOrder = case(\r\n    MTTFBin == \"0 - 1 hrs\",   1,\r\n    MTTFBin == \"1 - 2 hrs\",   2,\r\n    MTTFBin == \"2 - 3 hrs\",   3,\r\n    MTTFBin == \"3 - 4 hrs\",   4,\r\n    MTTFBin == \"4 - 5 hrs\",   5,\r\n    MTTFBin == \"5 - 6 hrs\",   6,\r\n    MTTFBin == \"6 - 7 hrs\",   7,\r\n    MTTFBin == \"7 - 8 hrs\",   8,\r\n    MTTFBin == \"8 - 9 hrs\",   9,\r\n    MTTFBin == \"9 - 10 hrs\", 10,\r\n    11\r\n)\r\n| sort by SortOrder asc\r\n| project MTTFBin, UserCount",
        "size": 4,
        "title": "User Distribution by MTTF Bucket",
        "queryType": 0,
        "resourceType": "microsoft.desktopvirtualization/hostpools",
        "crossComponentResources": [
          "{HostPools}"
        ],
        "visualization": "table",
        "exportFieldName": "MTTFBin",
        "exportParameterName": "SelectedMTTFBin",
        "exportDefaultValue": "",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "MTTFBin",
              "formatter": 0
            },
            {
              "columnMatch": "UserCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "blue",
                "min": 0
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "MTTFBin",
              "label": "MTTF Bucket"
            },
            {
              "columnId": "UserCount",
              "label": "Users"
            }
          ]
        }
      },
      "name": "MTTFHistogram",
      "customWidth": "30"
    },
    {
      "type": 1,
      "content": {
        "json": "&nbsp;\r\n\r\n# &nbsp; ⬅️ &nbsp; To begin, select an MTTF bucket\r\n\r\n# &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; from User Distribution by MTTF Bucket"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedMTTFBin",
        "comparison": "isEqualTo"
      },
      "name": "MTTFBucketSelectionHint",
      "styleSettings": {
        "padding": "20px"
      },
      "customWidth": "70"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": []
      },
      "name": "MTTFPivotRowSeparator"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"1.0.0\",\"content\":\"[\\r\\n    {\\r\\n        \\\"label\\\": \\\"User Name\\\",\\r\\n        \\\"value\\\": \\\"UserName\\\",\\r\\n        \\\"icon\\\": \\\"Person\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Transport Capability\\\",\\r\\n        \\\"value\\\": \\\"TransportType\\\",\\r\\n        \\\"icon\\\": \\\"Connector\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Gateway Region\\\",\\r\\n        \\\"value\\\": \\\"GatewayRegion\\\",\\r\\n        \\\"icon\\\": \\\"Globe\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Host Pool\\\",\\r\\n        \\\"value\\\": \\\"HostPool\\\",\\r\\n        \\\"icon\\\": \\\"Server\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Subscription\\\",\\r\\n        \\\"value\\\": \\\"ArmPathSubscriptionId\\\",\\r\\n        \\\"icon\\\": \\\"Resource\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Resource Group\\\",\\r\\n        \\\"value\\\": \\\"ArmPathResourceGroupName\\\",\\r\\n        \\\"icon\\\": \\\"Resource\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Session Host\\\",\\r\\n        \\\"value\\\": \\\"SessionHostName\\\",\\r\\n        \\\"icon\\\": \\\"VM\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Session Host IP/16\\\",\\r\\n        \\\"value\\\": \\\"SessionHostIPAddress\\\",\\r\\n        \\\"icon\\\": \\\"World\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Client Version\\\",\\r\\n        \\\"value\\\": \\\"ClientVersion\\\",\\r\\n        \\\"icon\\\": \\\"App\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"label\\\": \\\"Client IP/16\\\",\\r\\n        \\\"value\\\": \\\"ClientIPAddress\\\",\\r\\n        \\\"icon\\\": \\\"World\\\"\\r\\n    }\\r\\n]\",\"transformers\":null}",
