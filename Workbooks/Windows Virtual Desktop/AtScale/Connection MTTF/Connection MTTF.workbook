    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let WindowStart = {MTTFTimeRange:start};\nlet WindowEnd = min_of({MTTFTimeRange:end}, now());\nlet Lookback = 7d;\nlet _FilterGateway = '*' !in ({GatewayRegion});\nlet _GatewayUnavailableSelected = _FilterGateway and 'Unavailable' in ({GatewayRegion});\nlet _GatewayAllowed = materialize(\n    union isfuzzy=true WVDMultiLinkAdd,\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\n    | where _ResourceId in~ ({HostPools})\n    | where _FilterGateway\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\n    | where _GR in ({GatewayRegion})\n    | distinct CorrelationId\n);\nlet _HasMultiLink = materialize(\n    union isfuzzy=true WVDMultiLinkAdd,\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\n    | where _ResourceId in~ ({HostPools})\n    | where _GatewayUnavailableSelected\n    | distinct CorrelationId\n);\nlet SelectedBin = '{SelectedMTTFBin}';\nlet SelectedPivot = '{MTTFPivot}';\nlet SelectedValue = '{SelectedPivotValue}';\nlet Connections = materialize(\n    WVDConnections\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\n    | where _ResourceId in~ ({HostPools})\n    | where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed) or (_GatewayUnavailableSelected and CorrelationId !in (_HasMultiLink))\n    | summarize\n        ClientType    = take_anyif(ClientType, isnotempty(ClientType)),\n        ClientVersion = take_anyif(ClientVersion, isnotempty(ClientVersion)),\n        StartedTime   = minif(TimeGenerated, State == \"Started\"),\n        ConnectedTime = minif(TimeGenerated, State == \"Connected\"),\n        EndTime       = minif(TimeGenerated, State == \"Completed\"),\n        UserName             = take_any(UserName),\n        SessionHostName      = take_any(SessionHostName),\n        SessionHostIPAddress = take_any(SessionHostIPAddress),\n        ClientIPAddress      = take_any(ClientIPAddress),\n        ResourceId           = take_any(_ResourceId)\n        by CorrelationId\n    | where '*' in ({ClientType}) or ClientType in ({ClientType})\n    | where '*' in ({ClientVersion}) or ClientVersion in ({ClientVersion})\n    | where isnotempty(ConnectedTime) or (isempty(StartedTime) and isnotempty(EndTime))\n    | extend WindowedStart = max_of(coalesce(ConnectedTime, WindowStart), WindowStart)\n    | extend WindowedEnd = min_of(coalesce(EndTime, WindowEnd), WindowEnd)\n    | where WindowedEnd > WindowedStart\n    | extend DurationHours = datetime_diff('second', WindowedEnd, WindowedStart) / 3600.0\n    | extend HostPool        = iff(isempty(tostring(split(ResourceId, '/')[8])), \"Unknown\", tostring(split(ResourceId, '/')[8]))\n    | extend SubscriptionId  = iff(isempty(tostring(split(ResourceId, '/')[2])), \"Unknown\", tostring(split(ResourceId, '/')[2]))\n    | extend ResourceGroup   = iff(isempty(tostring(split(ResourceId, '/')[4])), \"Unknown\", tostring(split(ResourceId, '/')[4]))\n    | extend SessionHostIP16 = iff(isempty(SessionHostIPAddress), \"Unknown\", format_ipv4_mask(SessionHostIPAddress, 16))\n    | extend ClientIP16      = case(isempty(ClientIPAddress), \"Unknown\", ClientIPAddress contains \":\", \"<IPv6>\", format_ipv4_mask(ClientIPAddress, 16))\n    | extend SessionHostNameSafe = iff(isempty(SessionHostName), \"Unknown\", SessionHostName)\n    | extend ClientVersionSafe   = iff(isempty(ClientVersion), \"Unknown\", ClientVersion)\n);\nlet ErrorInfo = materialize(\n    WVDErrors\n    | where TimeGenerated between (WindowStart .. WindowEnd)\n    | where _ResourceId in~ ({HostPools})\n    | summarize CodeSymbolic = make_set(CodeSymbolic, 20), ErrorMessage = make_set(Message, 20), HasError = true by CorrelationId\n);\nlet SelectedUsers = materialize(\n    Connections\n    | join kind=leftouter (ErrorInfo | project CorrelationId, HasError) on CorrelationId\n    | extend IsDisruption = coalesce(HasError, false)\n    | summarize\n        TotalDurationHours = sum(DurationHours),\n        DisruptionCount = countif(IsDisruption)\n        by UserName\n    | extend MeanTimeToFailureHours = iff(DisruptionCount > 0, TotalDurationHours / todouble(DisruptionCount), todouble(0))\n    | extend MTTFBin = case(\n        DisruptionCount == 0 or MeanTimeToFailureHours >= 10, \"Infinite\",\n        MeanTimeToFailureHours < 1, \"0 - 1 hrs\",\n        MeanTimeToFailureHours < 2, \"1 - 2 hrs\",\n        MeanTimeToFailureHours < 3, \"2 - 3 hrs\",\n        MeanTimeToFailureHours < 4, \"3 - 4 hrs\",\n        MeanTimeToFailureHours < 5, \"4 - 5 hrs\",\n        MeanTimeToFailureHours < 6, \"5 - 6 hrs\",\n        MeanTimeToFailureHours < 7, \"6 - 7 hrs\",\n        MeanTimeToFailureHours < 8, \"7 - 8 hrs\",\n        MeanTimeToFailureHours < 9, \"8 - 9 hrs\",\n        \"9 - 10 hrs\"\n    )\n    | where MTTFBin == SelectedBin\n    | project UserName\n);\nlet SelectedConnections = materialize(\n    Connections\n    | join kind=leftsemi SelectedUsers on UserName\n    | extend PivotValue = case(\n        SelectedPivot == \"UserName\", UserName,\n        SelectedPivot == \"HostPool\", HostPool,\n        SelectedPivot == \"ArmPathSubscriptionId\", SubscriptionId,\n        SelectedPivot == \"ArmPathResourceGroupName\", ResourceGroup,\n        SelectedPivot == \"SessionHostName\", SessionHostNameSafe,\n        SelectedPivot == \"SessionHostIPAddress\", SessionHostIP16,\n        SelectedPivot == \"ClientVersion\", ClientVersionSafe,\n        SelectedPivot == \"ClientIPAddress\", ClientIP16,\n        \"\"\n    )\n    | where PivotValue == SelectedValue\n);\nlet LinkTransport = materialize(\n    union isfuzzy=true WVDMultiLinkAdd,\n        (datatable(TimeGenerated:datetime, _ResourceId:string, CorrelationId:string, GatewayRegion:string, LinkId:string, ClientTransportType:string, ServerTransportType:string)[])\n    | where TimeGenerated between ((WindowStart - Lookback) .. WindowEnd)\n    | where _ResourceId in~ ({HostPools})\n    | extend GatewayLocation = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\n    | where '*' in ({GatewayRegion}) or GatewayLocation in ({GatewayRegion})\n    | join kind=inner (SelectedConnections | project CorrelationId) on CorrelationId\n    | summarize\n        HasTURN = countif(ClientTransportType has \"TURN\" or ServerTransportType has \"TURN\") > 0,\n        AllDirect = countif(not(ClientTransportType =~ \"DIRECT\" and ServerTransportType =~ \"DIRECT\")) == 0,\n        AllDirectOrStun = countif(not((ClientTransportType in~ (\"DIRECT\", \"STUN\")) and (ServerTransportType in~ (\"DIRECT\", \"STUN\")))) == 0,\n        AllWebsocket = countif(not((ClientTransportType in~ (\"WEBSOCKET\", \"\")) and (ServerTransportType in~ (\"WEBSOCKET\", \"\")))) == 0\n        by CorrelationId, LinkId\n    | extend LinkTransport = case(\n        HasTURN, \"TURN Relay\",\n        AllDirect, \"Direct UDP\",\n        AllDirectOrStun, \"NAT Traversal\",\n        AllWebsocket, \"TCP WebSocket\",\n        \"Other\"\n    )\n);\nlet MultiLinkInfo = materialize(\n    LinkTransport\n    | summarize\n        HasDirectUDP = countif(LinkTransport == \"Direct UDP\") > 0,\n        HasNATTraversal = countif(LinkTransport == \"NAT Traversal\") > 0,\n        HasTURNRelay = countif(LinkTransport == \"TURN Relay\") > 0,\n        HasTCPWebSocket = countif(LinkTransport == \"TCP WebSocket\") > 0,\n        LinkCount = dcount(LinkId)\n        by CorrelationId\n    | extend TransportCapability = case(\n        HasDirectUDP, \"Direct UDP\",\n        HasNATTraversal, \"NAT Traversal\",\n        HasTURNRelay, \"TURN Relay\",\n        HasTCPWebSocket, \"TCP WebSocket\",\n        \"Other\"\n    )\n);\nSelectedConnections\n| extend DurationHours = round(DurationHours, 2)\n| join kind=leftouter MultiLinkInfo on CorrelationId\n| join kind=leftouter ErrorInfo on CorrelationId\n| extend IsMultiLink = coalesce(LinkCount, 0) > 1\n| extend TransportCapability = coalesce(TransportCapability, \"Unavailable\")\n| extend IsDisruption = coalesce(HasError, false)\n| extend CodeSymbolic = iff(IsDisruption, strcat_array(CodeSymbolic, \", \"), \"\")\n| extend ErrorMessage = iff(IsDisruption, strcat_array(ErrorMessage, \", \"), \"\")\n| project CorrelationId, UserName, SessionHostName, ConnectedTime, EndTime, DurationHours, IsMultiLink, TransportCapability, IsDisruption, CodeSymbolic, ErrorMessage\n| sort by ConnectedTime desc",
        "size": 0,
        "title": "Connections for {MTTFPivotLabel}: {SelectedPivotValue}",
        "noDataMessage": "No connections found for the selected value.",
        "showExportToExcel": true,
        "queryType": 0,
