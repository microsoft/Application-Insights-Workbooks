              "columnMatch": "GatewayLocation",
              "formatter": 0
            },
            {
              "columnMatch": "ConnectionCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "blue",
                "min": 0
              }
            }
          ],
          "filter": true,
          "labelSettings": [
