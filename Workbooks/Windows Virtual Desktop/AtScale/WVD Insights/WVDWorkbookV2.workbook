{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Subscriptions}"
        ],
        "parameters": [
          {
            "id": "b859a03f-2283-43dd-8536-42714bbfced6",
            "version": "KqlParameterItem/1.0",
            "name": "Subscriptions",
            "label": "Subscriptions",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "where type startswith 'Microsoft.DesktopVirtualization/'\r\n    | summarize Count = count() by subscriptionId\r\n    | order by Count desc\r\n    | extend Rank = row_number()\r\n    | project value = subscriptionId, label = subscriptionId, selected = Rank == 1\r\n",
            "crossComponentResources": [
              "value::selected"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "2e3dfd9b-2d0f-4feb-94e8-107f220c4e28",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroups",
            "label": "Resource Groups",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\r\n| where type contains  \"desktopvirtualization\"\r\n| summarize Count = count() by resourceGroup\r\n| project Label = resourceGroup, Id = resourceGroup, Selected = Count >= 0",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "951b5870-e216-45c6-b159-34150868a46e",
            "version": "KqlParameterItem/1.0",
            "name": "HostPools",
            "label": "Host Pools",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\r\n| where type == \"microsoft.desktopvirtualization/hostpools\" and resourceGroup in ({ResourceGroups})\r\n| project id, name, selected=1, group=resourceGroup\r\n",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "875c91e3-2744-4509-9656-68bdce082076",
            "version": "KqlParameterItem/1.0",
            "name": "wvdworkspaces",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\r\n| where type == \"microsoft.desktopvirtualization/applicationgroups\"\r\n| project id, workspace= properties.workspaceArmPath, hp=properties.hostPoolArmPath\r\n| where isnotnull(workspace)\r\n| where hp in~ ({HostPools})\r\n| project workspace, label=workspace,selected=1",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "d6ca7a4d-342f-44d3-a5ae-ea3de67f513f",
            "version": "KqlParameterItem/1.0",
            "name": "selectedTab",
            "type": 1,
            "isHiddenWhenLocked": true,
            "value": "Overview"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "customWidth": "75",
      "name": "parameters_general"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "04a8ead2-1fb2-4666-a7b0-6d92e3c29b46",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "value": {
              "durationMs": 172800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            },
            "timeContextFromParameter": "TimeRange",
            "label": "Time Range"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isNotEqualTo",
        "value": "ConnectionMTTF"
      },
      "customWidth": "25",
      "name": "parameters_timerange"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "e416af24-9d8b-4c42-939f-63bc28b8dcbb",
            "version": "KqlParameterItem/1.0",
            "name": "MTTFTimeRange",
            "label": "Time Range",
            "type": 4,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            },
            "value": {
              "durationMs": 604800000
            }
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "ConnectionMTTF"
      },
      "customWidth": "25",
      "name": "parameters_mttf_timerange"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a1c2e3f4-1234-5678-9abc-def012345678",
            "version": "KqlParameterItem/1.0",
            "name": "GatewayRegion",
            "label": "Gateway Region",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "WVDMultiLinkAdd\r\n| where _ResourceId in~ ({HostPools})\r\n| extend GatewayLocation = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n| distinct GatewayLocation\r\n| order by GatewayLocation asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "timeContextFromParameter": "MTTFTimeRange",
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          },
          {
            "id": "c3e4f5a6-3456-789a-bcde-f0123456789a",
            "version": "KqlParameterItem/1.0",
            "name": "ClientType",
            "label": "Client Type",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    WVDMultiLinkAdd\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nWVDConnections\r\n| where _ResourceId in~ ({HostPools})\r\n| where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed)\r\n| where isnotempty(ClientType)\r\n| distinct ClientType\r\n| order by ClientType asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "timeContextFromParameter": "MTTFTimeRange",
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          },
          {
            "id": "b2d3f4a5-2345-6789-abcd-ef0123456789",
            "version": "KqlParameterItem/1.0",
            "name": "ClientVersion",
            "label": "Client Version",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let _FilterGateway = '*' !in ({GatewayRegion});\r\nlet _GatewayAllowed = materialize(\r\n    WVDMultiLinkAdd\r\n    | where _ResourceId in~ ({HostPools})\r\n    | where _FilterGateway\r\n    | extend _GR = iff(isempty(GatewayRegion) or GatewayRegion == \"\", \"Unknown\", GatewayRegion)\r\n    | where _GR in ({GatewayRegion})\r\n    | distinct CorrelationId\r\n);\r\nWVDConnections\r\n| where _ResourceId in~ ({HostPools})\r\n| where '*' in ({GatewayRegion}) or CorrelationId in (_GatewayAllowed)\r\n| where '*' in ({ClientType}) or ClientType in ({ClientType})\r\n| where isnotempty(ClientVersion)\r\n| distinct ClientVersion\r\n| order by ClientVersion asc",
            "crossComponentResources": [
              "{HostPools}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "timeContextFromParameter": "MTTFTimeRange",
            "queryType": 0,
            "resourceType": "microsoft.desktopvirtualization/hostpools"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "ConnectionMTTF"
      },
      "name": "parameters_mttf_filters"
    },
