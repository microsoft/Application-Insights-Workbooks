                  {
                    "columnId": "Severity",
                    "label": "Reported severity"
                  },
                  {
                    "columnId": "Remediation",
                    "label": "Complete remediation"
                  },
                  {
                    "columnId": "FirstEvaluated",
                    "label": "First evaluated (UTC)"
