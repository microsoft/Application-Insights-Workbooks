    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Selected recommendation details",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "Select a row in the list above to load complete remediation and the entire reported properties object for that record only. Complete properties JSON includes top-level description, scanner-specific id, category, all nested metadata/status/risk/resource/additional data, and any other reported fields. It remains available for inspection and export. The current subscription and server-side status/search filters still apply."
            },
            "name": "selected_recommendation_guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "title": "Selected recommendation - complete reported context",
              "query": "securityresources\n| where type =~ \"microsoft.security/assessments\"\n| where isnotempty(\"{SelectedAssessmentId:escape}\") and id =~ \"{SelectedAssessmentId:escape}\"\n| where \"{FindingStatus:escape}\" == \"All\" or tostring(properties.status.code) =~ \"{FindingStatus:escape}\"\n    or (\"{FindingStatus:escape}\" == \"Other\" and tostring(properties.status.code) !in~ (\"Unhealthy\", \"Healthy\", \"NotApplicable\"))\n| where isempty(\"{FindingSearch:escape}\") or id contains \"{FindingSearch:escape}\" or tostring(properties) contains \"{FindingSearch:escape}\"\n| take 1\n| project subscriptionId, RecordId = id, Name = coalesce(tostring(properties.displayName), tostring(properties.metadata.displayName), \"Not reported\"),\n    Status = coalesce(tostring(properties.status.code), \"Not reported\"),\n    Severity = coalesce(tostring(properties.metadata.severity), tostring(properties.additionalData.Severity), tostring(properties.additionalData.severity), \"Not reported\"),\n    Remediation = coalesce(tostring(properties.metadata.remediationDescription), tostring(properties.additionalData.RemediationDescription), tostring(properties.additionalData.remediationDescription), \"Not reported\"),\n    FirstEvaluated = todatetime(properties.status.firstEvaluationDate),\n    TimeGenerated = todatetime(properties.timeGenerated),\n    Properties = tostring(properties),\n    PortalLink = tostring(properties.links.azurePortal)",
              "size": 1,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{subscriptions}"
              ],
              "visualization": "table",
              "noDataMessage": "Select a row in the corresponding list. If the selection no longer matches the scope or filters, select another row; no data is not proof of healthy coverage.",
              "gridSettings": {
                "filter": false,
                "rowLimit": 1,
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "showIcon": true
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription"
                  },
                  {
