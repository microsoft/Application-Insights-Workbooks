    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping, name\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| project apId = name, apTemplate = tostring(properties.displayName), tostring(riskLevelText)\r\n| summarize dcount(apId) by riskLevelText",
        "size": 1,
        "title": "Risk Level Categories",
