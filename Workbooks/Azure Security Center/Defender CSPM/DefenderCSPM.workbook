        "value": "main"
      },
      "customWidth": "50",
      "name": "text - 28"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/securescores\" and tostring(properties.displayName) != \"Score grace excluded\"\r\n| extend secScore = round(properties.score.percentage * 100.0,0)\r\n| extend env = tostring(properties.environment)\r\n| project subscriptionId,secScore, env",
        "size": 1,
        "aggregation": 3,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "secScore",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "max": 100,
                "palette": "redGreen"
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscriptions"
            },
            {
              "columnId": "secScore",
              "label": "Secure Score"
            },
            {
              "columnId": "env",
              "label": "Cloud"
            }
          ]
        },
        "chartSettings": {
          "xAxis": "env"
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "35",
      "name": "query - 9",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| summarize apCount = count()\r\n| project lable = \"Attack Paths\", apCount",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "lable",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "apCount",
            "formatter": 12,
            "formatOptions": {
              "palette": "blue"
            }
          },
          "showBorder": true,
          "size": "auto"
        },
        "textSettings": {
          "style": "bignumber"
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "15",
      "name": "query - 24",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping, name\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| project apId = name, apTemplate = tostring(properties.displayName), tostring(riskLevelText)\r\n| summarize dcount(apId) by riskLevelText",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "piechart",
        "chartSettings": {
          "yAxis": [
            "dcount_apId"
          ],
          "createOtherGroup": 0,
          "showMetrics": false,
          "showLegend": true
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "50",
      "name": "query - 25",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Defender plans\nSubscription-level configurations across all reported Defender plans, including API and App Service plans when present. Subplans and reported resource coverage remain separate from plan enablement; resource-level overrides and multicloud connector settings are not evaluated here."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "text - 23"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Reported Defender plan configurations",
        "query": "securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| extend PricingTier = tostring(properties.pricingTier), SubPlan = tostring(properties.subPlan)\n| extend Status = case(PricingTier =~ \"Standard\", \"Enabled\", PricingTier =~ \"Free\", \"Disabled\", \"Not reported\")\n| extend planOrder = iff(name =~ \"CloudPosture\", 0, 1)\n| order by planOrder asc, name asc, subscriptionId asc\n| project subscriptionId, Plan = name, Status, PricingTier, SubPlan, ResourceCoverage = tostring(properties.resourcesCoverageStatus)",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No subscription-level pricing configurations were returned. Check scope, access, and Resource Graph availability; missing data is not disabled or healthy.",
        "gridSettings": {
          "filter": true,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Operation failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Conflicting",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "Plan",
              "label": "Plan"
            },
            {
              "columnId": "Status",
              "label": "Plan status"
            },
            {
              "columnId": "PricingTier",
              "label": "Pricing tier"
            },
            {
              "columnId": "SubPlan",
              "label": "Subplan"
            },
            {
              "columnId": "ResourceCoverage",
              "label": "Reported resource coverage"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "mdc_plans_enabled",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Settings & monitoring\nThe eight components below follow the Defender CSPM Settings page from top to bottom. This view reads **CloudPosture only**, so a shared extension enabled under another plan cannot incorrectly mark the CSPM toggle as enabled. Missing extensions remain visible as **Not reported**; a missing plan is **Plan not reported**, not disabled. Configuration includes reported exclusions and operation details. The table displays at most 1,000 rows (eight per Azure subscription); select at most 125 subscriptions to see every component.\n\nAPI sensitive-data insights also require **Sensitive data discovery**. Full **Serverless containers** features require **Registry access**. Initial discovery can take up to 24 hours for some features. Enablement alone does not establish feature availability or scanning success; check the [current requirements and cloud support](https://learn.microsoft.com/azure/defender-for-cloud/tutorial-enable-cspm-plan#enable-the-components-of-the-defender-cspm-plan)."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "settings_monitoring_guidance"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Defender CSPM components in Settings page order",
        "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, subscriptionName = name\n| join kind=leftouter (\n    securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n    | where name =~ \"CloudPosture\"\n    | project subscriptionId, pricingTier = tostring(properties.pricingTier), extensions = properties.extensions\n) on subscriptionId\n| extend component = dynamic([{\"order\":1,\"label\":\"Agentless scanning for machines\",\"name\":\"AgentlessVmScanning\"},{\"order\":2,\"label\":\"Kubernetes API access\",\"name\":\"AgentlessDiscoveryForKubernetes\"},{\"order\":3,\"label\":\"Registry access\",\"name\":\"ContainerRegistriesVulnerabilityAssessments\"},{\"order\":4,\"label\":\"Sensitive data discovery\",\"name\":\"SensitiveDataDiscovery\"},{\"order\":5,\"label\":\"Cloud Infrastructure and Entitlements Management (CIEM)\",\"name\":\"EntraPermissionsManagement\"},{\"order\":6,\"label\":\"API Security Posture Management\",\"name\":\"ApiPosture\"},{\"order\":7,\"label\":\"Serverless protection\",\"name\":\"AgentlessServerlessPosture\"},{\"order\":8,\"label\":\"Serverless containers\",\"name\":\"ServerlessContainers\"}])\n| mv-expand component\n| extend componentOrder = toint(component[\"order\"]), Component = tostring(component[\"label\"]), ExtensionName = tostring(component[\"name\"])\n| mv-expand extension = iff(array_length(extensions) > 0, extensions, dynamic([{}]))\n| extend matched = ExtensionName =~ tostring(extension.name), rawState = tolower(tostring(extension.isEnabled))\n| summarize reported = countif(matched),\n    enabled = countif(matched and rawState == \"true\"),\n    disabled = countif(matched and rawState == \"false\"),\n    unknown = countif(matched and rawState !in (\"true\", \"false\")),\n    failed = countif(matched and extension.operationStatus.code =~ \"Failed\"),\n    operationUnknown = countif(matched and isnotempty(tostring(extension.operationStatus.code)) and tostring(extension.operationStatus.code) !in~ (\"Succeeded\", \"Failed\")),\n    Configuration = make_set(iff(matched, extension.additionalExtensionProperties, dynamic(null))),\n    OperationStatus = make_set(iff(matched, extension.operationStatus, dynamic(null)))\n    by subscriptionId, subscriptionName, componentOrder, Component, ExtensionName, pricingTier\n| extend Status = case(\n    pricingTier =~ \"Free\", \"Plan disabled\",\n    pricingTier !~ \"Standard\", \"Plan not reported\",\n    failed > 0, \"Operation failed\",\n    operationUnknown > 0, \"Operation not successful\",\n    enabled > 0 and disabled > 0, \"Conflicting\",\n    reported == 0, \"Not reported\",\n    unknown > 0, \"Unknown\",\n    enabled > 0, \"Enabled\",\n    disabled > 0, \"Disabled\",\n    \"Unknown\")\n| order by componentOrder asc, subscriptionName asc, subscriptionId asc\n| project subscriptionId, subscriptionName, Component, Status, PricingTier = pricingTier, ExtensionName, Configuration, OperationStatus",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No Azure subscriptions were returned. Check the subscription selection and permissions; missing configuration does not mean healthy coverage.",
        "gridSettings": {
          "filter": true,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Operation failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Conflicting",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "subscriptionName",
              "label": "Subscription name"
            },
            {
              "columnId": "Component",
              "label": "Component"
            },
            {
              "columnId": "Status",
              "label": "Configuration status"
            },
            {
              "columnId": "PricingTier",
              "label": "CSPM pricing tier"
            },
            {
              "columnId": "ExtensionName",
              "label": "Extension API name"
            },
            {
              "columnId": "Configuration",
              "label": "Reported configuration"
            },
            {
              "columnId": "OperationStatus",
              "label": "Enablement operation details"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "settings_monitoring",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "### Reported extensions across Defender plans\nThis diagnostic inventory includes every returned extension name, including newer capabilities not in the eight-component Settings layout. Shared extensions keep their source plan and subplan. Raw enablement is not effective coverage: check plan status, entitlements, exclusions, operation details, and resource-level settings. Plans without extension data remain visible. Resource Graph returns at most 1,000 rows per table; narrow subscriptions before exporting large inventories."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "extension_inventory_guidance"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Raw subscription-level extension inventory",
        "query": "securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| mv-expand extension = iff(array_length(properties.extensions) > 0, properties.extensions, dynamic([{}]))\n| project subscriptionId, Plan = name, PricingTier = tostring(properties.pricingTier), SubPlan = tostring(properties.subPlan),\n    ExtensionName = iff(isempty(tostring(extension.name)), \"No extension data\", tostring(extension.name)),\n    ReportedEnablement = iff(isempty(tostring(extension.isEnabled)), \"Not reported\", tostring(extension.isEnabled)),\n    Configuration = extension.additionalExtensionProperties, OperationStatus = extension.operationStatus\n| order by Plan asc, ExtensionName asc, subscriptionId asc",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No subscription-level pricing data was returned. Check scope and access; no data does not prove that extensions are absent.",
        "gridSettings": {
          "filter": true,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "Plan",
              "label": "Source plan"
            },
            {
              "columnId": "PricingTier",
              "label": "Pricing tier"
            },
            {
              "columnId": "SubPlan",
              "label": "Subplan"
            },
            {
              "columnId": "ExtensionName",
              "label": "Extension API name"
            },
            {
              "columnId": "ReportedEnablement",
              "label": "Raw enablement"
            },
            {
              "columnId": "Configuration",
              "label": "Reported configuration"
            },
            {
              "columnId": "OperationStatus",
              "label": "Enablement operation details"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "extension_inventory",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| summarize count()",
        "size": 4,
        "title": "Num. Attack Paths",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "card",
        "tileSettings": {
          "showBorder": false
        },
        "mapSettings": {
          "locInfo": "LatLong",
          "sizeSettings": "count_",
          "sizeAggregation": "Sum",
          "legendMetric": "count_",
          "legendAggregation": "Sum",
          "itemColorSettings": {
            "type": "heatmap",
            "colorAggregation": "Sum",
            "nodeColorField": "count_",
            "heatmapPalette": "greenRed"
          }
        },
        "textSettings": {
          "style": "bignumber"
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "attackpath"
      },
      "customWidth": "10",
      "name": "num_of_attack_path",
      "styleSettings": {
        "margin": "0",
        "padding": "0",
        "maxWidth": "10"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "    securityresources\r\n    | where type == \"microsoft.security/attackpaths\" \r\n    | mv-expand properties.graphComponent.entities\r\n    | extend    apNAme = name, \r\n                nodeName = tostring(properties_graphComponent_entities.entityName),\r\n                nodeId = tostring(properties_graphComponent_entities.entityInternalId),\r\n                nodeType = tostring(properties_graphComponent_entities.entityType)\r\n    | distinct nodeName, nodeType\r\n    | summarize  count() by nodeType",
        "size": 4,
        "title": "Resource Type in Attack Paths",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "piechart",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "nodeType",
