    {
      "type": 1,
      "content": {
        "json": "This workbook uses Azure Resource Graph for the selected subscriptions. Review Defender plans, then **Settings & monitoring** in portal order. **Enabled** means a reported configuration, not verified resource coverage or absence of risk. Use **All findings** for recommendations beyond those linked to attack paths. Reader access is required at the selected scopes; this workbook does not change settings."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "cspm_overview_guidance"
    },
    {
      "type": 1,
      "content": {
        "json": "**Secure Score**"
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "35",
      "name": "text - 26"
    },
    {
      "type": 1,
      "content": {
        "json": "**Total Number of Attack Paths**"
      },
      "conditionalVisibility": {
