              "label": "Remediation preview truncated"
            },
            {
              "columnId": "FirstEvaluated",
              "label": "First evaluated (UTC)"
            },
            {
              "columnId": "TimeGenerated",
              "label": "Reported generation time"
            }
          ]
        },
        "exportFieldName": "FindingId",
        "exportParameterName": "SelectedFindingId",
        "exportDefaultValue": ""
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "findings"
      },
      "name": "detailed_findings",
      "styleSettings": {
        "showBorder": true
      }
