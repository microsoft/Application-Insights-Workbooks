                  {
                    "columnId": "TimeGenerated",
                    "label": "Reported generation time"
                  },
                  {
                    "columnId": "Properties",
                    "label": "Complete record properties (JSON)"
                  },
                  {
                    "columnId": "PortalLink",
                    "label": "Portal link"
                  }
                ]
              }
            },
            "conditionalVisibility": {
              "parameterName": "SelectedAssessmentId",
              "comparison": "isNotEqualTo",
              "value": ""
            },
            "name": "selected_recommendation_context",
            "styleSettings": {
              "showBorder": true
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "findings"
      },
      "name": "selected_recommendation_details"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Reported detailed findings - select a row for full context",
        "query": "securityresources\n| where type =~ \"microsoft.security/assessments/subassessments\"\n| where \"{FindingStatus:escape}\" == \"All\" or tostring(properties.status.code) =~ \"{FindingStatus:escape}\"\n    or (\"{FindingStatus:escape}\" == \"Other\" and tostring(properties.status.code) !in~ (\"Unhealthy\", \"Healthy\", \"NotApplicable\"))\n| where isempty(\"{FindingSearch:escape}\") or id contains \"{FindingSearch:escape}\" or tostring(properties) contains \"{FindingSearch:escape}\"\n| extend Finding = coalesce(tostring(properties.displayName), tostring(properties.metadata.displayName), \"Not reported\"), Status = coalesce(tostring(properties.status.code), \"Not reported\"),\n    Severity = coalesce(tostring(properties.status.severity), tostring(properties.additionalData.Severity), tostring(properties.additionalData.severity), tostring(properties.metadata.severity), \"Not reported\")\n| extend statusOrder = case(Status =~ \"Unhealthy\", 0, Status =~ \"Healthy\", 2, Status =~ \"NotApplicable\", 3, 1), severityOrder = case(Severity =~ \"Critical\", 0, Severity =~ \"High\", 1, Severity =~ \"Medium\", 2, Severity =~ \"Low\", 3, 4)\n| order by statusOrder asc, severityOrder asc, Finding asc, id asc\n| take toint(\"{FindingLimit:escape}\")\n| take 250\n| extend fullRemediation = coalesce(tostring(properties.remediation), tostring(properties.metadata.remediationDescription), tostring(properties.additionalData.RemediationDescription), tostring(properties.additionalData.remediationDescription), \"Not reported\")\n| project subscriptionId, Finding, Status, Severity, Source = coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source), \"Not reported\"), ResourceId = coalesce(tostring(properties.resourceDetails.Id), tostring(properties.resourceDetails.id), tostring(properties.resourceDetails.NativeResourceId), tostring(properties.resourceDetails.AwsResourceId), tostring(properties.resourceDetails.GcpResourceId)),\n    RecommendationId = extract(\"(?i)/assessments/([^/]+)/subassessments/\", 1, id), FindingId = id,\n    Remediation = substring(fullRemediation, 0, 512), RemediationTruncated = strlen(fullRemediation) > 512,\n    FirstEvaluated = todatetime(properties.status.firstEvaluationDate),\n    TimeGenerated = todatetime(properties.timeGenerated)",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No detailed findings matched. Newer findings can be individual recommendations instead of subassessments; check the recommendation table and product portals.",
        "gridSettings": {
          "filter": true,
          "rowLimit": 250,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            }
