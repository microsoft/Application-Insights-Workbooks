    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Sensitive data discovery",
        "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, subscriptionName = name\n| join kind=leftouter (\n    securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n    | where name =~ \"CloudPosture\"\n    | project subscriptionId, pricingTier = tostring(properties.pricingTier), extensions = properties.extensions\n) on subscriptionId\n| extend targetExtension = \"SensitiveDataDiscovery\"\n| mv-expand extension = iff(array_length(extensions) > 0, extensions, dynamic([{}]))\n| extend matched = targetExtension =~ tostring(extension.name), rawState = tolower(tostring(extension.isEnabled))\n| summarize reported = countif(matched),\n    enabled = countif(matched and rawState == \"true\"),\n    disabled = countif(matched and rawState == \"false\"),\n    unknown = countif(matched and rawState !in (\"true\", \"false\")),\n    failed = countif(matched and extension.operationStatus.code =~ \"Failed\"),\n    operationUnknown = countif(matched and isnotempty(tostring(extension.operationStatus.code)) and tostring(extension.operationStatus.code) !in~ (\"Succeeded\", \"Failed\"))\n    by subscriptionId, subscriptionName, pricingTier\n| extend Status = case(\n    pricingTier =~ \"Free\", \"Plan disabled\",\n    pricingTier !~ \"Standard\", \"Plan not reported\",\n    failed > 0, \"Operation failed\",\n    operationUnknown > 0, \"Operation not successful\",\n    enabled > 0 and disabled > 0, \"Conflicting\",\n    reported == 0, \"Not reported\",\n    unknown > 0, \"Unknown\",\n    enabled > 0, \"Enabled\",\n    disabled > 0, \"Disabled\",\n    \"Unknown\")\n| order by subscriptionName asc, subscriptionId asc\n| project subscriptionId, Status",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No Azure subscriptions were returned. Check the subscription selection and permissions; missing configuration does not mean healthy coverage.",
