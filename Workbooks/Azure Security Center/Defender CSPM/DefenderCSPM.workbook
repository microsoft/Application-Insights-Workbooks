              "columnId": "Attack_Path",
              "label": "Attack Path"
            },
            {
              "columnId": "apId",
              "label": "GUID"
            },
            {
              "columnId": "description",
              "label": "Description"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
