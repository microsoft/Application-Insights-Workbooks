    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/securescores\" and tostring(properties.displayName) != \"Score grace excluded\"\r\n| extend secScore = round(properties.score.percentage * 100.0,0)\r\n| extend env = tostring(properties.environment)\r\n| project subscriptionId,secScore, env",
        "size": 1,
        "aggregation": 3,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "secScore",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "max": 100,
                "palette": "redGreen"
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscriptions"
            },
            {
              "columnId": "secScore",
              "label": "Secure Score"
            },
            {
              "columnId": "env",
              "label": "Cloud"
            }
          ]
        },
        "chartSettings": {
          "xAxis": "env"
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "35",
      "name": "query - 9",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| summarize apCount = count()\r\n| project lable = \"Attack Paths\", apCount",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "lable",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "apCount",
            "formatter": 12,
            "formatOptions": {
              "palette": "blue"
            }
          },
          "showBorder": true,
          "size": "auto"
        },
        "textSettings": {
          "style": "bignumber"
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "15",
      "name": "query - 24",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend CorrelationIdForGrouping = tolower(tostring(coalesce(properties.correlationId, properties.attackPathId)))\r\n| summarize id=any(id), type=any(type),  properties=any(properties) by CorrelationIdForGrouping, name\r\n| extend riskLevelText = iff(isnotempty(properties.RiskLevel), tostring(properties.RiskLevel), tostring(properties.riskLevel)),\r\n         hasRiskCategories = isnotnull(properties.riskCategories),\r\n         mapVersion = iff(tobool(tostring(properties.attackPathVersion) == \"V2\"), 'v2', 'v1')\r\n| where type == \"microsoft.security/attackpaths\" and (mapVersion == 'v2' or hasRiskCategories)\r\n| extend RiskLevel = case(riskLevelText =~ \"Critical\", 4,\r\n                        riskLevelText =~ \"High\", 3,\r\n                        riskLevelText =~ \"Medium\", 2,\r\n                        riskLevelText =~ \"Low\", 1,\r\n                        0)\r\n| where RiskLevel != 0\r\n| project apId = name, apTemplate = tostring(properties.displayName), tostring(riskLevelText)\r\n| summarize dcount(apId) by riskLevelText",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "piechart",
        "chartSettings": {
          "yAxis": [
            "dcount_apId"
          ],
          "createOtherGroup": 0,
          "showMetrics": false,
          "showLegend": true
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "customWidth": "50",
      "name": "query - 25",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Defender plans\nSubscription-level configurations across all reported Defender plans, including API and App Service plans when present. Subplans and reported resource coverage remain separate from plan enablement; resource-level overrides and multicloud connector settings are not evaluated here."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "text - 23"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Reported Defender plan configurations",
        "query": "securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| extend PricingTier = tostring(properties.pricingTier), SubPlan = tostring(properties.subPlan)\n| extend Status = case(PricingTier =~ \"Standard\", \"Enabled\", PricingTier =~ \"Free\", \"Disabled\", \"Not reported\")\n| extend planOrder = iff(name =~ \"CloudPosture\", 0, 1)\n| order by planOrder asc, name asc, subscriptionId asc\n| project subscriptionId, Plan = name, Status, PricingTier, SubPlan, ResourceCoverage = tostring(properties.resourcesCoverageStatus)",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No subscription-level pricing configurations were returned. Check scope, access, and Resource Graph availability; missing data is not disabled or healthy.",
        "gridSettings": {
          "filter": true,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Operation failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Conflicting",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "Plan",
              "label": "Plan"
            },
            {
              "columnId": "Status",
              "label": "Plan status"
            },
            {
              "columnId": "PricingTier",
              "label": "Pricing tier"
            },
            {
              "columnId": "SubPlan",
              "label": "Subplan"
            },
            {
              "columnId": "ResourceCoverage",
              "label": "Reported resource coverage"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "mdc_plans_enabled",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Settings & monitoring\nEach component has its own compact status table. Read left to right across the first row, then the second row, to follow the Defender CSPM Settings page. The panels read **CloudPosture only**; shared extensions on other plans do not change the CSPM toggle shown here.\n\n**Green:** enabled. **Red:** disabled, failed, or conflicting. **Amber:** missing, unknown, or a non-successful operation. A missing plan is **Plan not reported**, not disabled. **CIEM** means Cloud Infrastructure and Entitlements Management. Use **Show advanced extension diagnostics** below for exclusions, raw configuration, and operation details.\n\nEach panel displays up to 1,000 selected Azure subscriptions; narrow the selection if needed. Configuration is not proof of scanning coverage or absence of risk. API sensitive-data insights also require **Sensitive data discovery**; full **Serverless containers** features require **Registry access**. Some initial discovery takes up to 24 hours. Review the [current feature requirements and cloud support](https://learn.microsoft.com/azure/defender-for-cloud/tutorial-enable-cspm-plan#enable-the-components-of-the-defender-cspm-plan)."
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "settings_monitoring_guidance"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Agentless scanning for machines",
        "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, subscriptionName = name\n| join kind=leftouter (\n    securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n    | where name =~ \"CloudPosture\"\n    | project subscriptionId, pricingTier = tostring(properties.pricingTier), extensions = properties.extensions\n) on subscriptionId\n| extend targetExtension = \"AgentlessVmScanning\"\n| mv-expand extension = iff(array_length(extensions) > 0, extensions, dynamic([{}]))\n| extend matched = targetExtension =~ tostring(extension.name), rawState = tolower(tostring(extension.isEnabled))\n| summarize reported = countif(matched),\n    enabled = countif(matched and rawState == \"true\"),\n    disabled = countif(matched and rawState == \"false\"),\n    unknown = countif(matched and rawState !in (\"true\", \"false\")),\n    failed = countif(matched and extension.operationStatus.code =~ \"Failed\"),\n    operationUnknown = countif(matched and isnotempty(tostring(extension.operationStatus.code)) and tostring(extension.operationStatus.code) !in~ (\"Succeeded\", \"Failed\"))\n    by subscriptionId, subscriptionName, pricingTier\n| extend Status = case(\n    pricingTier =~ \"Free\", \"Plan disabled\",\n    pricingTier !~ \"Standard\", \"Plan not reported\",\n    failed > 0, \"Operation failed\",\n    operationUnknown > 0, \"Operation not successful\",\n    enabled > 0 and disabled > 0, \"Conflicting\",\n    reported == 0, \"Not reported\",\n    unknown > 0, \"Unknown\",\n    enabled > 0, \"Enabled\",\n    disabled > 0, \"Disabled\",\n    \"Unknown\")\n| order by subscriptionName asc, subscriptionId asc\n| project subscriptionId, Status",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No Azure subscriptions were returned. Check the subscription selection and permissions; missing configuration does not mean healthy coverage.",
        "gridSettings": {
          "filter": false,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Operation failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Conflicting",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "Status",
              "label": "Status"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "settings_agentless_scanning",
      "styleSettings": {
        "showBorder": true
      },
      "customWidth": "25"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Kubernetes API access",
        "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, subscriptionName = name\n| join kind=leftouter (\n    securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n    | where name =~ \"CloudPosture\"\n    | project subscriptionId, pricingTier = tostring(properties.pricingTier), extensions = properties.extensions\n) on subscriptionId\n| extend targetExtension = \"AgentlessDiscoveryForKubernetes\"\n| mv-expand extension = iff(array_length(extensions) > 0, extensions, dynamic([{}]))\n| extend matched = targetExtension =~ tostring(extension.name), rawState = tolower(tostring(extension.isEnabled))\n| summarize reported = countif(matched),\n    enabled = countif(matched and rawState == \"true\"),\n    disabled = countif(matched and rawState == \"false\"),\n    unknown = countif(matched and rawState !in (\"true\", \"false\")),\n    failed = countif(matched and extension.operationStatus.code =~ \"Failed\"),\n    operationUnknown = countif(matched and isnotempty(tostring(extension.operationStatus.code)) and tostring(extension.operationStatus.code) !in~ (\"Succeeded\", \"Failed\"))\n    by subscriptionId, subscriptionName, pricingTier\n| extend Status = case(\n    pricingTier =~ \"Free\", \"Plan disabled\",\n    pricingTier !~ \"Standard\", \"Plan not reported\",\n    failed > 0, \"Operation failed\",\n    operationUnknown > 0, \"Operation not successful\",\n    enabled > 0 and disabled > 0, \"Conflicting\",\n    reported == 0, \"Not reported\",\n    unknown > 0, \"Unknown\",\n    enabled > 0, \"Enabled\",\n    disabled > 0, \"Disabled\",\n    \"Unknown\")\n| order by subscriptionName asc, subscriptionId asc\n| project subscriptionId, Status",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No Azure subscriptions were returned. Check the subscription selection and permissions; missing configuration does not mean healthy coverage.",
        "gridSettings": {
          "filter": false,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Operation failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Conflicting",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "subscriptionId",
              "label": "Subscription"
            },
            {
              "columnId": "Status",
              "label": "Status"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "main"
      },
      "name": "settings_kubernetes_api_access",
      "styleSettings": {
        "showBorder": true
      },
      "customWidth": "25"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "title": "Registry access",
        "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, subscriptionName = name\n| join kind=leftouter (\n    securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n    | where name =~ \"CloudPosture\"\n    | project subscriptionId, pricingTier = tostring(properties.pricingTier), extensions = properties.extensions\n) on subscriptionId\n| extend targetExtension = \"ContainerRegistriesVulnerabilityAssessments\"\n| mv-expand extension = iff(array_length(extensions) > 0, extensions, dynamic([{}]))\n| extend matched = targetExtension =~ tostring(extension.name), rawState = tolower(tostring(extension.isEnabled))\n| summarize reported = countif(matched),\n    enabled = countif(matched and rawState == \"true\"),\n    disabled = countif(matched and rawState == \"false\"),\n    unknown = countif(matched and rawState !in (\"true\", \"false\")),\n    failed = countif(matched and extension.operationStatus.code =~ \"Failed\"),\n    operationUnknown = countif(matched and isnotempty(tostring(extension.operationStatus.code)) and tostring(extension.operationStatus.code) !in~ (\"Succeeded\", \"Failed\"))\n    by subscriptionId, subscriptionName, pricingTier\n| extend Status = case(\n    pricingTier =~ \"Free\", \"Plan disabled\",\n    pricingTier !~ \"Standard\", \"Plan not reported\",\n    failed > 0, \"Operation failed\",\n    operationUnknown > 0, \"Operation not successful\",\n    enabled > 0 and disabled > 0, \"Conflicting\",\n    reported == 0, \"Not reported\",\n    unknown > 0, \"Unknown\",\n    enabled > 0, \"Enabled\",\n    disabled > 0, \"Disabled\",\n    \"Unknown\")\n| order by subscriptionName asc, subscriptionId asc\n| project subscriptionId, Status",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{subscriptions}"
        ],
        "visualization": "table",
        "noDataMessage": "No Azure subscriptions were returned. Check the subscription selection and permissions; missing configuration does not mean healthy coverage.",
        "gridSettings": {
          "filter": false,
          "rowLimit": 1000,
          "formatters": [
            {
              "columnMatch": "subscriptionId",
              "formatter": 15,
              "formatOptions": {
                "showIcon": true
              }
            },
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Enabled",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Plan disabled",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
