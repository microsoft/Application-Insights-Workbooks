            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "style": "decimal",
                "maximumFractionDigits": 2,
                "maximumSignificantDigits": 3
              }
            }
          },
          "showBorder": true
        }
      },
      "conditionalVisibility": {
        "parameterName": "tab",
        "comparison": "isEqualTo",
        "value": "attackpath"
      },
      "customWidth": "60",
      "name": "attack_path_risk_categories",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "securityresources\r\n| where type == \"microsoft.security/attackpaths\"\r\n| extend riskCategories = tostring(properties.riskLevel)\r\n| project apId = name, apTemplate = tostring(properties.displayName), riskCategories\r\n| summarize Path_Count = count() by Attack_Path = apTemplate, riskCategories\r\n| project Attack_Path, Path_Count, riskCategories\r\n",
        "size": 0,
        "title": "Attack Path (Type) List",
