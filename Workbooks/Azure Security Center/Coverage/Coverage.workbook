          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\" and name =~ \"VirtualMachines\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/VirtualMachines\")\n| where tostring(properties.pricingTier) =~ \"Standard\" and tostring(properties.subPlan) =~ \"P2\"\n| mv-expand extensionSettings = iff(array_length(properties.extensions) > 0, properties.extensions, dynamic([{}]))\n| extend planSet = iff(isnotempty(tostring(extensionSettings.name)), pack(tostring(extensionSettings.name), tostring(extensionSettings.isEnabled)), dynamic({}))\n| summarize extensions = make_bag(planSet) by subscriptionId\n| project subscriptionId,\n    AgentlessVmScanning = case(tolower(tostring(extensions.AgentlessVmScanning)) == \"true\", \"true\", tolower(tostring(extensions.AgentlessVmScanning)) == \"false\", \"false\", \"unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for subscriptions with Defender for Servers Plan 2 enabled",
              "noDataMessage": "No subscription found with Defender for Servers Plan 2 enabled.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
