          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where name !~ \"AI\" or id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/AI\")\n| where name !~ \"Api\" or id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/Api\")\n| where name !in~ (\"SqlServers\", \"SqlServerVirtualMachines\", \"OpenSourceRelationalDatabases\", \"CosmosDbs\") or id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| where name !in~ (\"VirtualMachines\", \"StorageAccounts\", \"KeyVaults\", \"Arm\") or id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| extend pricingTier = properties.pricingTier, subPlan = properties.subPlan\n| extend planSet = pack(iif(name =~ \"Api\", \"Api\", name), level = case(name =~ \"AI\", pricingTier, name =~ \"Api\", pricingTier, isnotempty(subPlan),subPlan,pricingTier))\n| summarize defenderPlans = make_bag(planSet), databasePlans = make_bag(iif(name in~ (\"SqlServers\", \"SqlServerVirtualMachines\", \"OpenSourceRelationalDatabases\", \"CosmosDbs\"), pack(tolower(name), tostring(pricingTier)), dynamic({}))), planDetails = make_bag(iif(name in~ (\"VirtualMachines\", \"StorageAccounts\", \"Api\", \"KeyVaults\", \"Arm\"), pack(tolower(name), pack(\"tier\", tostring(pricingTier), \"plan\", trim(\" \", tostring(subPlan)))), dynamic({}))) by subscriptionId\n| extend dbSql = tolower(tostring(databasePlans.sqlservers)), dbMachines = tolower(tostring(databasePlans.sqlservervirtualmachines)), dbOpenSource = tolower(tostring(databasePlans.opensourcerelationaldatabases)), dbCosmos = tolower(tostring(databasePlans.cosmosdbs))\n| extend dbEnabled = iff(dbSql == \"standard\", 1, 0) + iff(dbMachines == \"standard\", 1, 0) + iff(dbOpenSource == \"standard\", 1, 0) + iff(dbCosmos == \"standard\", 1, 0),\n    dbUnreported = iff(dbSql !in (\"standard\", \"free\"), 1, 0) + iff(dbMachines !in (\"standard\", \"free\"), 1, 0) + iff(dbOpenSource !in (\"standard\", \"free\"), 1, 0) + iff(dbCosmos !in (\"standard\", \"free\"), 1, 0)\n|Â project subscriptionId,\n    CloudPosture = defenderPlans.CloudPosture,\n    VirtualMachines = case(tostring(planDetails.virtualmachines.tier) =~ \"Free\", \"Disabled\", tostring(planDetails.virtualmachines.tier) =~ \"Standard\", strcat(\"Enabled (\", case(tostring(planDetails.virtualmachines.plan) =~ \"P1\", \"Plan 1\", tostring(planDetails.virtualmachines.plan) =~ \"P2\", \"Plan 2\", isnotempty(tostring(planDetails.virtualmachines.plan)), tostring(planDetails.virtualmachines.plan), \"plan not reported\"), \")\"), \"Not reported\"),\n    AppServices = defenderPlans.AppServices,\n    Databases = iff(dbUnreported == 4, \"Not reported\", strcat(\"Enabled (\", dbEnabled, \"/4 Plans)\", iff(dbUnreported > 0, strcat(\" (\", dbUnreported, \" not reported)\"), \"\"))),\n    StorageAccounts = case(tostring(planDetails.storageaccounts.tier) =~ \"Free\", \"Disabled\", tostring(planDetails.storageaccounts.tier) =~ \"Standard\", strcat(\"Enabled (\", case(tostring(planDetails.storageaccounts.plan) =~ \"DefenderForStorageV2\", \"Defender for Storage\", tostring(planDetails.storageaccounts.plan) =~ \"PerTransaction\", \"per transaction\", tostring(planDetails.storageaccounts.plan) =~ \"PerStorageAccount\", \"per storage account\", isnotempty(tostring(planDetails.storageaccounts.plan)), tostring(planDetails.storageaccounts.plan), \"plan not reported\"), \")\"), \"Not reported\"),\n    Containers = defenderPlans.Containers,\n    AI = defenderPlans.AI,\n    Api = case(tostring(planDetails.api.tier) =~ \"Free\", \"Disabled\", tostring(planDetails.api.tier) =~ \"Standard\", strcat(\"Enabled (\", case(tostring(planDetails.api.plan) =~ \"P1\", \"Plan 1\", tostring(planDetails.api.plan) =~ \"P2\", \"Plan 2\", tostring(planDetails.api.plan) =~ \"P3\", \"Plan 3\", tostring(planDetails.api.plan) =~ \"P4\", \"Plan 4\", tostring(planDetails.api.plan) =~ \"P5\", \"Plan 5\", isnotempty(tostring(planDetails.api.plan)), tostring(planDetails.api.plan), \"plan not reported\"), \")\"), \"Not reported\"),\n    KeyVaults = case(tostring(planDetails.keyvaults.tier) =~ \"Free\", \"Disabled\", tostring(planDetails.keyvaults.tier) =~ \"Standard\", strcat(\"Enabled (\", case(tostring(planDetails.keyvaults.plan) =~ \"PerKeyVault\", \"per key vault\", tostring(planDetails.keyvaults.plan) =~ \"PerTransaction\", \"per transaction\", isnotempty(tostring(planDetails.keyvaults.plan)), tostring(planDetails.keyvaults.plan), \"plan not reported\"), \")\"), \"Not reported\"),\n    Arm = case(tostring(planDetails.arm.tier) =~ \"Free\", \"Disabled\", tostring(planDetails.arm.tier) =~ \"Standard\", strcat(\"Enabled (\", case(tostring(planDetails.arm.plan) =~ \"PerApiCall\", \"per API call\", tostring(planDetails.arm.plan) =~ \"PerSubscription\", \"per subscription\", isnotempty(tostring(planDetails.arm.plan)), tostring(planDetails.arm.plan), \"plan not reported\"), \")\"), \"Not reported\"),\n    DNS = defenderPlans.Dns,\n    KubernetesService = defenderPlans.KubernetesService,\n    ContainerRegistry = defenderPlans.ContainerRegistry",
              "size": 1,
              "showAnalytics": true,
              "title": "Absolute coverage across Azure subscriptions",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "showIcon": true,
                      "customColumnWidthSetting": "50ch"
                    }
                  },
                  {
                    "columnMatch": "CloudPosture",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "subscriptionId",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Standard",
                          "representation": "lightBlue",
                          "text": "on"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "blueDark",
                          "text": "off"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "PolicyPricingWithBundlesBlade",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
                            "name": "subscriptionId",
                            "source": "column",
                            "value": "subscriptionId"
                          }
                        ]
                      },
                      "customColumnWidthSetting": "20ch"
                    }
                  },
                  {
                    "columnMatch": "VirtualMachines",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "subscriptionId",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "Enabled",
                          "representation": "lightBlue",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disabled",
                          "representation": "blueDark",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "PolicyPricingWithBundlesBlade",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
                            "name": "subscriptionId",
                            "source": "column",
                            "value": "subscriptionId"
                          }
                        ]
                      },
                      "customColumnWidthSetting": "32ch"
                    }
                  },
                  {
                    "columnMatch": "AppServices",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "subscriptionId",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Standard",
                          "representation": "lightBlue",
                          "text": "on"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "blueDark",
                          "text": "off"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "PolicyPricingWithBundlesBlade",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
                            "name": "subscriptionId",
                            "source": "column",
                            "value": "subscriptionId"
                          }
                        ]
                      },
                      "customColumnWidthSetting": "16ch"
                    }
                  },
                  {
                    "columnMatch": "Databases",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "subscriptionId",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Not reported",
                          "representation": "gray",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "not reported",
                          "representation": "gray",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled (4/4 Plans)",
                          "representation": "lightBlue",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled (0/4 Plans)",
                          "representation": "blueDark",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "yellow",
                          "text": "{0}{1}"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "PolicyPricingWithBundlesBlade",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
