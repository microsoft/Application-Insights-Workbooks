              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"AWS\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderForContainersAws\"\n| project id,\n    vmScanners = case(tolower(tostring(offering.vmScanners.enabled)) == \"true\", \"true\", tolower(tostring(offering.vmScanners.enabled)) == \"false\", \"false\", \"unknown\"),\n    enableAuditLogsAutoProvisioning = case(tolower(tostring(offering.enableAuditLogsAutoProvisioning)) == \"true\", \"true\", tolower(tostring(offering.enableAuditLogsAutoProvisioning)) == \"false\", \"false\", \"unknown\"),\n    kubeAuditRetentionTime = case(isnotnull(toint(offering.kubeAuditRetentionTime)) and toint(offering.kubeAuditRetentionTime) >= 0, tostring(toint(offering.kubeAuditRetentionTime)), \"Not reported\"),\n    enableDefenderAgentAutoProvisioning = case(tolower(tostring(offering.enableDefenderAgentAutoProvisioning)) == \"true\", \"true\", tolower(tostring(offering.enableDefenderAgentAutoProvisioning)) == \"false\", \"false\", \"unknown\"),\n    enablePolicyAgentAutoProvisioning = case(tolower(tostring(offering.enablePolicyAgentAutoProvisioning)) == \"true\", \"true\", tolower(tostring(offering.enablePolicyAgentAutoProvisioning)) == \"false\", \"false\", \"unknown\"),\n    mdcContainersAgentlessDiscoveryK8s = case(tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdcContainersImageAssessment = case(tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"false\", \"false\", \"unknown\")",
