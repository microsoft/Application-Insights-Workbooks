          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\",\"mergeType\":\"table\",\"leftTable\":\"Storage activity metrics\"}],\"projectRename\":[{\"originalName\":\"[Storage activity metrics].Subscription\",\"mergedName\":\"Subscription\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].Name\",\"mergedName\":\"Name\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/blobservices-Transaction-Transactions\",\"mergedName\":\"BlobTransactions\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/fileservices-Transaction-Transactions\",\"mergedName\":\"FileTransactions\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/blobservices-Transaction-Ingress\",\"mergedName\":\"UploadIngressBytes\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Added column]\",\"mergedName\":\"MonthlyTransactions\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"BlobTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"BlobTransactions\"}},{\"criteriaContext\":{\"leftOperand\":\"FileTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"FileTransactions\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"([\\\"BlobTransactions\\\"]+[\\\"FileTransactions\\\"])*30/7\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"MonthlyUploadedBytes\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"UploadIngressBytes\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"UploadIngressBytes\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"[\\\"UploadIngressBytes\\\"]*30/7\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"ModeledCapBytes\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"{ModeledScanningCapGB}*1073741824\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"ModeledMonthlyMalwareScanningBytes\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"MonthlyUploadedBytes\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedBytes\"}},{\"criteriaContext\":{\"leftOperand\":\"ModeledCapBytes\",\"operator\":\"<\",\"rightValType\":\"static\",\"rightVal\":\"0\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedBytes\"}},{\"criteriaContext\":{\"leftOperand\":\"MonthlyUploadedBytes\",\"operator\":\"<=\",\"rightValType\":\"column\",\"rightVal\":\"ModeledCapBytes\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedBytes\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"ModeledCapBytes\"}}]}]}",
              "size": 3,
              "title": "Activity monitoring for Defender for Storage",
