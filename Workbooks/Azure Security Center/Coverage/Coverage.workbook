              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\",\"mergeType\":\"table\",\"leftTable\":\"Storage activity metrics\"}],\"projectRename\":[{\"originalName\":\"[Storage activity metrics].Subscription\",\"mergedName\":\"Subscription\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].Name\",\"mergedName\":\"Name\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/blobservices-Transaction-Transactions\",\"mergedName\":\"BlobTransactions\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/fileservices-Transaction-Transactions\",\"mergedName\":\"FileTransactions\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Storage activity metrics].microsoft.storage/storageaccounts/blobservices-Transaction-Ingress\",\"mergedName\":\"UploadIngressBytes\",\"fromId\":\"e52fab43-8c8a-40b5-b05a-178c6b51cb90\"},{\"originalName\":\"[Added column]\",\"mergedName\":\"MonthlyTransactions\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"BlobTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"BlobTransactions\"}},{\"criteriaContext\":{\"leftOperand\":\"FileTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"FileTransactions\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"([\\\"BlobTransactions\\\"]+[\\\"FileTransactions\\\"])*30/7\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"MonthlyUploadedGB\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"UploadIngressBytes\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"UploadIngressBytes\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"[\\\"UploadIngressBytes\\\"]*30/7/1073741824\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"ModeledCapGB\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"expression\",\"resultVal\":\"{ModeledScanningCapGB}\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"ModeledMonthlyMalwareScanningGB\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"MonthlyUploadedGB\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedGB\"}},{\"criteriaContext\":{\"leftOperand\":\"ModeledCapGB\",\"operator\":\"<\",\"rightValType\":\"static\",\"rightVal\":\"0\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedGB\"}},{\"criteriaContext\":{\"leftOperand\":\"MonthlyUploadedGB\",\"operator\":\"<=\",\"rightValType\":\"column\",\"rightVal\":\"ModeledCapGB\",\"resultValType\":\"column\",\"resultVal\":\"MonthlyUploadedGB\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"column\",\"resultVal\":\"ModeledCapGB\"}}]},{\"originalName\":\"[Added column]\",\"mergedName\":\"MetricsStatus\",\"fromId\":null,\"isNewItem\":true,\"newItemData\":[{\"criteriaContext\":{\"leftOperand\":\"BlobTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"static\",\"resultVal\":\"Incomplete: known values only\"}},{\"criteriaContext\":{\"leftOperand\":\"FileTransactions\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"static\",\"resultVal\":\"Incomplete: known values only\"}},{\"criteriaContext\":{\"leftOperand\":\"UploadIngressBytes\",\"operator\":\"is Empty\",\"rightValType\":\"column\",\"resultValType\":\"static\",\"resultVal\":\"Incomplete: known values only\"}},{\"criteriaContext\":{\"operator\":\"Default\",\"rightValType\":\"column\",\"resultValType\":\"static\",\"resultVal\":\"Available metrics\"}}]}]}",
              "size": 3,
