          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"GCP\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderCspmGcp\"\n| mv-expand logResourceSet = iff(coalesce(array_length(offering.ciem.gcpAuditLogIngestion.resourceSets), 0) > 0, offering.ciem.gcpAuditLogIngestion.resourceSets, dynamic([null])) limit 2000\n| project id,\n    vmScanners = case(tolower(tostring(offering.vmScanners.enabled)) == \"true\", \"true\", tolower(tostring(offering.vmScanners.enabled)) == \"false\", \"false\", \"unknown\"),\n    dataSensitivityDiscovery = case(tolower(tostring(offering.dataSensitivityDiscovery.enabled)) == \"true\", \"true\", tolower(tostring(offering.dataSensitivityDiscovery.enabled)) == \"false\", \"false\", \"unknown\"),\n    ciem = case(tolower(tostring(offering.ciem.enabled)) == \"true\", \"true\", tolower(tostring(offering.ciem.enabled)) == \"false\", \"false\", \"unknown\"),\n    gcpAuditLogIngestion = case(tolower(tostring(offering.ciemDiscovery.enableAuditLogIngestion)) == \"true\", \"true\", tolower(tostring(offering.ciemDiscovery.enableAuditLogIngestion)) == \"false\", \"false\", \"unknown\"),\n    gcpLoggingProvisioning = case(tolower(tostring(offering.ciem.gcpAuditLogIngestion.provisioningType)) == \"autoprovisioning\", \"Automatic provisioning\", tolower(tostring(offering.ciem.gcpAuditLogIngestion.provisioningType)) == \"manualprovisioning\", \"Manual provisioning\", tolower(tostring(offering.ciem.gcpAuditLogIngestion.provisioningType)) == \"bringyourown\", \"Bring your own\", \"Not reported\"),\n    pubSubSubscriptionName = iff(isnotempty(tostring(logResourceSet.pubSubSubscriptionName)), tostring(logResourceSet.pubSubSubscriptionName), \"Not reported\"),\n    mdcContainersAgentlessDiscoveryK8s = case(tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdcContainersImageAssessment = case(tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"false\", \"false\", \"unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for GCP connectors with Defender CSPM enabled",
              "noDataMessage": "No GCP connector found with Defender CSPM enabled.",
              "queryType": 1,
