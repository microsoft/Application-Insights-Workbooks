          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\"\n| where name !in~ (\"SqlServers\", \"SqlServerVirtualMachines\", \"OpenSourceRelationalDatabases\", \"CosmosDbs\") or id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/\", name)\n| summarize databasePlans = make_bag(iif(name in~ (\"SqlServers\", \"SqlServerVirtualMachines\", \"OpenSourceRelationalDatabases\", \"CosmosDbs\"), pack(tolower(name), tostring(properties.pricingTier)), dynamic({}))) by subscriptionId\n| project subscriptionId,\n    AzureSqlDatabases = case(tostring(databasePlans.sqlservers) =~ \"Standard\", \"enabled\", tostring(databasePlans.sqlservers) =~ \"Free\", \"disabled\", \"unknown\"),\n    SqlServersOnMachines = case(tostring(databasePlans.sqlservervirtualmachines) =~ \"Standard\", \"enabled\", tostring(databasePlans.sqlservervirtualmachines) =~ \"Free\", \"disabled\", \"unknown\"),\n    OpenSourceRelationalDatabases = case(tostring(databasePlans.opensourcerelationaldatabases) =~ \"Standard\", \"enabled\", tostring(databasePlans.opensourcerelationaldatabases) =~ \"Free\", \"disabled\", \"unknown\"),\n    AzureCosmosDB = case(tostring(databasePlans.cosmosdbs) =~ \"Standard\", \"enabled\", tostring(databasePlans.cosmosdbs) =~ \"Free\", \"disabled\", \"unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for Defender for Databases",
              "noDataMessage": "No pricing data reported for the selected subscriptions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true,
                      "customColumnWidthSetting": "50ch"
                    }
                  },
                  {
                    "columnMatch": "AzureSqlDatabases",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "customColumnWidthSetting": "24ch"
                    }
                  },
                  {
                    "columnMatch": "SqlServersOnMachines",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "customColumnWidthSetting": "26ch"
                    }
                  },
                  {
                    "columnMatch": "OpenSourceRelationalDatabases",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "customColumnWidthSetting": "36ch"
                    }
                  },
                  {
                    "columnMatch": "AzureCosmosDB",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "customColumnWidthSetting": "20ch"
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription Name"
                  },
                  {
                    "columnId": "AzureSqlDatabases",
                    "label": "Azure SQL Databases"
                  },
                  {
                    "columnId": "SqlServersOnMachines",
                    "label": "SQL servers on machines"
                  },
                  {
                    "columnId": "OpenSourceRelationalDatabases",
                    "label": "Open-source relational databases"
                  },
                  {
                    "columnId": "AzureCosmosDB",
                    "label": "Azure Cosmos DB"
                  }
                ]
              },
              "sortBy": []
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Databases"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "queryAzureDetailedDatabases"
          },
          {
            "type": 1,
            "content": {
              "json": "### SQL servers on machines\n\nUse the subscription selector to narrow the inventory. A zero count means no matching SQL VM or Arc SQL instance inventory was reported in the selected scope; check onboarding and permissions if resources are expected. The Arc extension overview shows host-level SQL Server, Defender for SQL, and AMA extension states alongside Arc health and SQL inventory. The Arc SQL instance details below show the reported Defender protection state. Extension states are diagnostics and should be interpreted for the deployment architecture; missing AMA alone is not a failure."
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Databases"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "sqlMachinesHeading"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "a76c4984-0d4d-4882-93bb-676042dca620",
                  "version": "KqlParameterItem/1.0",
                  "name": "SqlSubscriptions",
                  "label": "SQL server subscriptions",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "value": [
                    "value::all"
                  ],
                  "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project value = subscriptionId, label = name\n| order by label asc",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "includeAll": true,
                    "selectAllValue": "*",
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Databases"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "sqlMachineSubscriptions"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\n| where type =~ \"microsoft.resources/subscriptions\"\n| project subscriptionId, id, type, name, properties\n| union (\n    resources\n    | where type in~ (\"microsoft.sqlvirtualmachine/sqlvirtualmachines\", \"microsoft.compute/virtualmachines/extensions\", \"microsoft.azurearcdata/sqlserverinstances\")\n    | project subscriptionId, id, type, name, properties\n)\n| where \"*\" in~ ({SqlSubscriptions}) or subscriptionId in~ ({SqlSubscriptions})\n| extend ResourceType = tolower(type), ResourceId = tolower(id)\n| extend HostResourceId = case(\n    ResourceType == \"microsoft.sqlvirtualmachine/sqlvirtualmachines\",\n        coalesce(tolower(tostring(properties.virtualMachineResourceId)), replace_string(ResourceId, \"microsoft.sqlvirtualmachine/sqlvirtualmachines\", \"microsoft.compute/virtualmachines\")),\n    ResourceType == \"microsoft.compute/virtualmachines/extensions\", tostring(split(ResourceId, \"/extensions/\")[0]),\n    ResourceId)\n| summarize\n    SQLVMRegistrations = countif(ResourceType == \"microsoft.sqlvirtualmachine/sqlvirtualmachines\"),\n    DefenderSucceeded = countif(ResourceType == \"microsoft.compute/virtualmachines/extensions\" and tostring(properties.publisher) =~ \"Microsoft.Azure.AzureDefenderForSQL\" and tostring(properties.provisioningState) =~ \"Succeeded\"),\n    AMASucceeded = countif(ResourceType == \"microsoft.compute/virtualmachines/extensions\" and tostring(properties.publisher) =~ \"Microsoft.Azure.Monitor\" and tostring(properties.provisioningState) =~ \"Succeeded\"),\n    ArcInstances = countif(ResourceType == \"microsoft.azurearcdata/sqlserverinstances\"),\n    ArcProtected = countif(ResourceType == \"microsoft.azurearcdata/sqlserverinstances\" and tostring(properties.azureDefenderStatus) =~ \"Protected\"),\n    ArcNeedsAttention = countif(ResourceType == \"microsoft.azurearcdata/sqlserverinstances\" and tostring(properties.azureDefenderStatus) =~ \"Unprotected\"),\n    ArcStatusNotReported = countif(ResourceType == \"microsoft.azurearcdata/sqlserverinstances\" and tolower(tostring(properties.azureDefenderStatus)) !in (\"protected\", \"unprotected\")),\n    SubscriptionNames = make_set_if(name, ResourceType == \"microsoft.resources/subscriptions\", 1)\n    by subscriptionId, HostResourceId\n| extend ExpectedDCRAId = strcat(HostResourceId, \"/providers/microsoft.insights/datacollectionruleassociations/microsoftdefenderforsql-rulesassociation\")\n| join kind=leftouter (\n    insightsresources\n    | where type =~ \"microsoft.insights/datacollectionruleassociations\"\n    | where name =~ \"MicrosoftDefenderForSQL-RulesAssociation\"\n    | project DCRAId = tolower(id)\n) on $left.ExpectedDCRAId == $right.DCRAId\n| summarize\n    SubscriptionNames = make_set_if(tostring(SubscriptionNames[0]), isnotempty(tostring(SubscriptionNames[0])), 1),\n    SQLVMHosts = countif(SQLVMRegistrations > 0),\n    DefenderSqlExtensionSucceeded = countif(SQLVMRegistrations > 0 and DefenderSucceeded > 0),\n    AMAExtensionSucceeded = countif(SQLVMRegistrations > 0 and AMASucceeded > 0),\n    SQLDCRA = countif(SQLVMRegistrations > 0 and isnotempty(DCRAId)),\n    ArcSQLInstances = sum(ArcInstances),\n    ArcProtected = sum(ArcProtected),\n    ArcNeedsAttention = sum(ArcNeedsAttention),\n    ArcStatusNotReported = sum(ArcStatusNotReported)\n    by subscriptionId\n| project SubscriptionName = tostring(SubscriptionNames[0]), subscriptionId, SQLVMHosts, DefenderSqlExtensionSucceeded, AMAExtensionSucceeded, SQLDCRA, ArcSQLInstances, ArcProtected, ArcNeedsAttention, ArcStatusNotReported\n| order by SubscriptionName asc",
              "size": 3,
              "showAnalytics": true,
              "title": "{$rowCount} SQL server subscriptions",
              "noDataMessage": "No subscriptions found in the selected scope. Check the subscription selection and permissions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "SubscriptionName",
                    "label": "Subscription"
                  },
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "SQLVMHosts",
                    "label": "SQL VM hosts"
                  },
                  {
                    "columnId": "DefenderSqlExtensionSucceeded",
                    "label": "VMs with Defender SQL extension succeeded"
                  },
                  {
                    "columnId": "AMAExtensionSucceeded",
                    "label": "VMs with AMA succeeded (legacy diagnostic)"
                  },
                  {
                    "columnId": "SQLDCRA",
                    "label": "SQL DCR associations (legacy diagnostic)"
                  },
                  {
                    "columnId": "ArcSQLInstances",
                    "label": "Arc SQL instances"
                  },
                  {
                    "columnId": "ArcProtected",
                    "label": "Arc protected"
                  },
                  {
                    "columnId": "ArcNeedsAttention",
                    "label": "Arc unprotected"
                  },
                  {
                    "columnId": "ArcStatusNotReported",
                    "label": "Arc status unknown / not reported"
                  }
                ]
              },
              "sortBy": []
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Databases"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "queryAzureSqlMachinesSummary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type in~ (\"microsoft.sqlvirtualmachine/sqlvirtualmachines\", \"microsoft.compute/virtualmachines\", \"microsoft.compute/virtualmachines/extensions\")\n| where \"*\" in~ ({SqlSubscriptions}) or subscriptionId in~ ({SqlSubscriptions})\n| extend ResourceType = tolower(type), ResourceId = tolower(id), Publisher = tolower(tostring(properties.publisher))\n| extend Kind = case(\n    ResourceType == \"microsoft.sqlvirtualmachine/sqlvirtualmachines\", \"sqlVm\",\n    ResourceType == \"microsoft.compute/virtualmachines\", \"vm\",\n    ResourceType == \"microsoft.compute/virtualmachines/extensions\" and Publisher == \"microsoft.azure.azuredefenderforsql\", \"defender\",\n    ResourceType == \"microsoft.compute/virtualmachines/extensions\" and Publisher == \"microsoft.azure.monitor\", \"ama\",\n    \"\")\n| where isnotempty(Kind)\n| extend HostResourceId = case(\n    Kind == \"sqlVm\", coalesce(tolower(tostring(properties.virtualMachineResourceId)), replace_string(ResourceId, \"microsoft.sqlvirtualmachine/sqlvirtualmachines\", \"microsoft.compute/virtualmachines\")),\n    Kind in (\"defender\", \"ama\"), tostring(split(ResourceId, \"/extensions/\")[0]),\n    ResourceId)\n| extend InventoryPart = pack(Kind, pack(\"id\", ResourceId, \"name\", name, \"location\", location, \"resourceGroup\", resourceGroup, \"properties\", properties))\n| summarize Inventory = make_bag(InventoryPart) by subscriptionId, HostResourceId\n| where isnotempty(tostring(Inventory.sqlVm.id))\n| extend SQLVMResourceId = tostring(Inventory.sqlVm.id),\n    HostName = coalesce(tostring(Inventory.vm.name), tostring(Inventory.sqlVm.name)),\n    location = coalesce(tostring(Inventory.vm.location), tostring(Inventory.sqlVm.location)),\n    resourceGroup = coalesce(tostring(Inventory.vm.resourceGroup), tostring(Inventory.sqlVm.resourceGroup)),\n    OSType = tostring(Inventory.vm.properties.storageProfile.osDisk.osType),\n    HostStatus = coalesce(tostring(Inventory.vm.properties.extended.instanceView.powerState.displayStatus), \"Not reported\"),\n    DefenderSqlStatus = iff(isempty(tostring(Inventory.defender.id)), \"Not installed\", coalesce(tostring(Inventory.defender.properties.provisioningState), \"Not reported\")),\n    DefenderSqlVersion = tostring(Inventory.defender.properties.typeHandlerVersion),\n    AMAStatus = coalesce(tostring(Inventory.ama.properties.provisioningState), \"Not reported\"),\n    AMAVersion = tostring(Inventory.ama.properties.typeHandlerVersion),\n    ExpectedDCRAId = strcat(HostResourceId, \"/providers/microsoft.insights/datacollectionruleassociations/microsoftdefenderforsql-rulesassociation\")\n| join kind=leftouter (\n    insightsresources\n    | where type =~ \"microsoft.insights/datacollectionruleassociations\"\n    | where name =~ \"MicrosoftDefenderForSQL-RulesAssociation\"\n    | project DCRAId = tolower(id)\n) on $left.ExpectedDCRAId == $right.DCRAId\n| extend DCRAStatus = iff(isempty(DCRAId), \"Not reported\", \"Present\")\n| extend NextAction = case(HostStatus =~ \"Not reported\", \"Check VM state and inventory access\",\n    HostStatus !~ \"VM running\", \"Review VM state\",\n    DefenderSqlStatus !~ \"Succeeded\", \"Review Defender SQL extension installation\",\n    AMAStatus =~ \"Failed\", \"Review AMA failure if the legacy agent path is in use\",\n    \"Review extension status\")\n| where HostStatus !~ \"VM running\" or DefenderSqlStatus !~ \"Succeeded\" or AMAStatus =~ \"Failed\"\n| project subscriptionId, HostName, SQLVMResourceId, HostResourceId, location, resourceGroup, OSType,\n    HostStatus, DefenderSqlStatus, DefenderSqlVersion, AMAStatus, AMAVersion, DCRAStatus, NextAction\n| order by subscriptionId asc, HostName asc",
              "size": 3,
              "showAnalytics": true,
              "title": "{$rowCount} SQL VM hosts needing attention",
              "noDataMessage": "No SQL VM hosts needing attention were found. The table is also empty when no SQL VM hosts are registered. Missing AMA or DCRA alone is not treated as a failure.",
