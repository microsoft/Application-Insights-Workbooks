          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type in~ (\"microsoft.azurearcdata/sqlserverinstances\", \"microsoft.hybridcompute/machines\", \"microsoft.hybridcompute/machines/extensions\")\n| where \"*\" in~ ({SqlSubscriptions}) or subscriptionId in~ ({SqlSubscriptions})\n| extend ResourceType = tolower(type), ResourceId = tolower(id),\n    Publisher = tolower(tostring(properties.publisher)), ExtensionType = tolower(tostring(properties.type))\n| extend Kind = case(\n    ResourceType == \"microsoft.azurearcdata/sqlserverinstances\", \"instance\",\n    ResourceType == \"microsoft.hybridcompute/machines\", \"machine\",\n    ResourceType == \"microsoft.hybridcompute/machines/extensions\" and Publisher == \"microsoft.azuredata\" and ExtensionType == \"windowsagent.sqlserver\", \"sqlServer\",\n    ResourceType == \"microsoft.hybridcompute/machines/extensions\" and Publisher == \"microsoft.azure.azuredefenderforsql\", \"defender\",\n    ResourceType == \"microsoft.hybridcompute/machines/extensions\" and Publisher == \"microsoft.azure.monitor\", \"ama\",\n    \"\")\n| where isnotempty(Kind)\n| extend HostResourceId = case(\n    Kind == \"instance\", tolower(tostring(properties.containerResourceId)),\n    Kind in (\"sqlServer\", \"defender\", \"ama\"), tostring(split(ResourceId, \"/extensions/\")[0]),\n    ResourceId),\n    SQLInstanceName = coalesce(tostring(properties.instanceName), name)\n| where isnotempty(HostResourceId)\n| extend InventoryPart = iff(Kind == \"instance\", dynamic({}), pack(Kind, pack(\"name\", name, \"location\", location, \"resourceGroup\", resourceGroup, \"properties\", properties)))\n| summarize Inventory = make_bag(InventoryPart),\n    SQLInstanceCount = countif(Kind == \"instance\"),\n    SQLInstanceNames = make_set_if(SQLInstanceName, Kind == \"instance\", 20)\n    by subscriptionId, HostResourceId\n| where SQLInstanceCount > 0 or isnotempty(tostring(Inventory.sqlServer.name))\n| extend HostName = coalesce(tostring(Inventory.machine.name), tostring(split(HostResourceId, \"/\")[-1])),\n    location = tostring(Inventory.machine.location), resourceGroup = tostring(Inventory.machine.resourceGroup),\n    SQLInstances = iff(array_length(SQLInstanceNames) > 0, strcat_array(SQLInstanceNames, \", \"), \"Not reported\"),\n    ArcConnectionStatus = coalesce(tostring(Inventory.machine.properties.status), \"Not reported\"),\n    HostProvisioningState = tostring(Inventory.machine.properties.provisioningState),\n    ArcAgentVersion = tostring(Inventory.machine.properties.agentVersion),\n    ArcLastStatusChange = todatetime(Inventory.machine.properties.lastStatusChange),\n    HostOS = tostring(Inventory.machine.properties.osName), HostOSSKU = tostring(Inventory.machine.properties.osSku),\n    SQLServerExtensionStatus = coalesce(tostring(Inventory.sqlServer.properties.provisioningState), \"Not reported\"),\n    SQLServerExtensionVersion = tostring(Inventory.sqlServer.properties.typeHandlerVersion),\n    DefenderSqlExtensionStatus = coalesce(tostring(Inventory.defender.properties.provisioningState), \"Not reported\"),\n    DefenderSqlExtensionVersion = tostring(Inventory.defender.properties.typeHandlerVersion),\n    AMAExtensionStatus = coalesce(tostring(Inventory.ama.properties.provisioningState), \"Not reported\"),\n    AMAExtensionVersion = tostring(Inventory.ama.properties.typeHandlerVersion)\n| extend NextStep = case(ArcConnectionStatus in~ (\"Disconnected\", \"Unknown\", \"Not reported\"), \"Check Arc connection and inventory\",\n    SQLServerExtensionStatus =~ \"Failed\", \"Review SQL Server Arc extension\",\n    SQLServerExtensionStatus =~ \"Not reported\", \"Verify SQL Server Arc extension and inventory\",\n    DefenderSqlExtensionStatus =~ \"Failed\", \"Review Defender for SQL extension\",\n    DefenderSqlExtensionStatus =~ \"Not reported\", \"Verify Defender for SQL protection status and applicable architecture\",\n    AMAExtensionStatus =~ \"Failed\", \"Review AMA only if required by the deployment architecture\",\n    \"No failed extension state reported; confirm prerequisites for the deployment architecture\")\n| join kind=leftouter (\n    resourcecontainers\n    | where type =~ \"microsoft.resources/subscriptions\"\n    | project subscriptionId, SubscriptionName = name\n) on subscriptionId\n| project SubscriptionName, subscriptionId, HostName, HostResourceId, location, resourceGroup,\n    SQLInstances, SQLInstanceCount, ArcConnectionStatus, HostProvisioningState, ArcAgentVersion,\n    HostOS, HostOSSKU, SQLServerExtensionStatus, SQLServerExtensionVersion,\n    DefenderSqlExtensionStatus, DefenderSqlExtensionVersion,\n    AMAExtensionStatus, AMAExtensionVersion, ArcLastStatusChange, NextStep\n| order by subscriptionId asc, HostName asc",
              "size": 3,
