          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"GCP\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderForDatabasesGcp\"\n| project subscriptionId, id,\n    arcAutoProvisioning = case(tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\")\n| join kind=leftouter (\n    securityresources\n    | where type =~ \"microsoft.security/pricings\"\n    | where name =~ \"SqlServerVirtualMachines\"\n    | where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/SqlServerVirtualMachines\")\n    | project subscriptionId,\n        sqlServersOnMachines = case(tolower(tostring(properties.pricingTier)) == \"standard\", \"true\", tolower(tostring(properties.pricingTier)) == \"free\", \"false\", \"unknown\")\n) on subscriptionId\n| project id,\n    arcAutoProvisioning = arcAutoProvisioning,\n    sqlServersOnMachines = sqlServersOnMachines",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for GCP connectors with Defender for Databases enabled",
              "noDataMessage": "No GCP connector found with Defender for Databases enabled.",
              "queryType": 1,
