          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"AWS\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderForDatabasesAws\"\n| project id,\n    rds = case(tolower(tostring(offering.rds.enabled)) == \"true\", \"true\", tolower(tostring(offering.rds.enabled)) == \"false\", \"false\", \"unknown\"),\n    arcAutoProvisioning = case(tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\"),\n    databasesDspm = case(tolower(tostring(offering.databasesDspm.enabled)) == \"true\", \"true\", tolower(tostring(offering.databasesDspm.enabled)) == \"false\", \"false\", \"unknown\")",
