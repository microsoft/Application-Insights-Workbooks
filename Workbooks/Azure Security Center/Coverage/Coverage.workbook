          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\" and name =~ \"Api\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/Api\")\n| extend pricingTier = tostring(properties.pricingTier), configuredPlan = trim(\" \", tostring(properties.subPlan))\n| project subscriptionId,\n    ApiStatus = case(pricingTier =~ \"Standard\", \"enabled\", pricingTier =~ \"Free\", \"disabled\", \"unknown\"),\n    ConfiguredPlan = case(pricingTier =~ \"Free\", \"Not applicable\", isempty(configuredPlan), \"Not reported\", configuredPlan)",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for Defender for APIs",
              "noDataMessage": "No Defender for APIs pricing data reported for the selected subscriptions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true,
                      "customColumnWidthSetting": "50ch"
                    }
                  },
                  {
                    "columnMatch": "ApiStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "customColumnWidthSetting": "20ch"
                    }
                  },
                  {
                    "columnMatch": "ConfiguredPlan",
                    "formatter": 0,
                    "formatOptions": {
