          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"GCP\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderForServersGcp\"\n| project id,\n    vmScanners = iff(tolower(tostring(offering.subPlan.type)) == \"p1\" and isempty(tostring(offering.vmScanners.enabled)), \"notapplicable\", case(tolower(tostring(offering.vmScanners.enabled)) == \"true\", \"true\", tolower(tostring(offering.vmScanners.enabled)) == \"false\", \"false\", \"unknown\")),\n    arcAutoProvisioning = case(tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdeAutoProvisioning = case(tolower(tostring(offering.mdeAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdeAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\"),\n    vaAutoProvisioning = case(tolower(tostring(offering.vaAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.vaAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\")",
              "size": 3,
