          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"AWS\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderCspmAws\"\n| extend legacyServerless = tolower(tostring(offering.mdcServerlessPostureAgentless.enabled)),\n    currentServerless = tolower(tostring(offering.agentlessServerlessPosture.enabled))\n| project id,\n    vmScanners = case(tolower(tostring(offering.vmScanners.enabled)) == \"true\", \"true\", tolower(tostring(offering.vmScanners.enabled)) == \"false\", \"false\", \"unknown\"),\n    dataSensitivityDiscovery = case(tolower(tostring(offering.dataSensitivityDiscovery.enabled)) == \"true\", \"true\", tolower(tostring(offering.dataSensitivityDiscovery.enabled)) == \"false\", \"false\", \"unknown\"),\n    ciem = case(tolower(tostring(offering.ciem.enabled)) == \"true\", \"true\", tolower(tostring(offering.ciem.enabled)) == \"false\", \"false\", \"unknown\"),\n    cloudTrailProvisioning = case(tolower(tostring(offering.ciem.cloudTrailAuditLogIngestion.provisioningType)) == \"autoprovisioning\", \"Automatic provisioning\", tolower(tostring(offering.ciem.cloudTrailAuditLogIngestion.provisioningType)) == \"manualprovisioning\", \"Manual provisioning\", tolower(tostring(offering.ciem.cloudTrailAuditLogIngestion.provisioningType)) == \"bringyourown\", \"Bring your own\", \"Not reported\"),\n    mdcContainersAgentlessDiscoveryK8s = case(tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersAgentlessDiscoveryK8s.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdcContainersImageAssessment = case(tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdcContainersImageAssessment.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdcServerlessPostureAgentless = case(isnotempty(legacyServerless) and isnotempty(currentServerless) and legacyServerless != currentServerless, \"unknown\", coalesce(legacyServerless, currentServerless) == \"true\", \"true\", coalesce(legacyServerless, currentServerless) == \"false\", \"false\", \"unknown\"),\n    serverlessContainers = case(tolower(tostring(offering.serverlessContainers.enabled)) == \"true\", \"true\", tolower(tostring(offering.serverlessContainers.enabled)) == \"false\", \"false\", \"unknown\"),\n    databasesDspm = case(tolower(tostring(offering.databasesDspm.enabled)) == \"true\", \"true\", tolower(tostring(offering.databasesDspm.enabled)) == \"false\", \"false\", \"unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for AWS connectors with Defender CSPM enabled",
              "noDataMessage": "No AWS connector found with Defender CSPM enabled.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
