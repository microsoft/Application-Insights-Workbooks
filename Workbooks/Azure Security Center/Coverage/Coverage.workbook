          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\" and name =~ \"StorageAccounts\"\n| where tostring(properties.pricingTier) =~ \"Standard\" and tostring(properties.subPlan) =~ \"DefenderForStorageV2\"\n| mv-expand extensionSettings = iif(array_length(properties.extensions) > 0, properties.extensions, dynamic([{}]))\n| extend planSet = iif(isnotempty(tostring(extensionSettings.name)), pack(tostring(extensionSettings.name), extensionSettings), dynamic({}))\n| summarize extensions = make_bag(planSet) by subscriptionId\n| extend cap = tostring(extensions.OnUploadMalwareScanning.additionalExtensionProperties.CapGBPerMonthPerStorageAccount)\n| project subscriptionId,\n    OnUploadMalwareScanning = case(tolower(tostring(extensions.OnUploadMalwareScanning.isEnabled)) == \"true\", \"True\", tolower(tostring(extensions.OnUploadMalwareScanning.isEnabled)) == \"false\", \"False\", \"Unknown\"),\n    MalwareScanningCapGB = case(cap == \"-1\", \"Unlimited\", isnotnull(tolong(cap)) and tolong(cap) >= 0, cap, \"Not reported\"),\n    SensitiveDataDiscovery = case(tolower(tostring(extensions.SensitiveDataDiscovery.isEnabled)) == \"true\", \"True\", tolower(tostring(extensions.SensitiveDataDiscovery.isEnabled)) == \"false\", \"False\", \"Unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for Defender for Storage (eligible subscriptions)",
              "noDataMessage": "No eligible subscription found for Defender for Storage detailed coverage.",
