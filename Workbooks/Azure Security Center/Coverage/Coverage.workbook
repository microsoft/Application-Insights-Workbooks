          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "parameters": [
                {
                  "id": "b7ffba22-c70b-4717-82f5-f78cf185de61",
                  "version": "KqlParameterItem/1.0",
                  "name": "Storage",
                  "label": "Storage accounts for activity monitoring",
                  "type": 5,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "value": [
                    "value::all"
                  ],
                  "query": "where type =~ 'microsoft.storage/storageaccounts'\n| order by name asc\n| project value = id",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "includeAll": true,
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                },
                {
                  "id": "645c2a61-8dcb-435d-abf4-611da3e75a0a",
                  "version": "KqlParameterItem/1.0",
                  "name": "ModeledScanningCapGB",
                  "label": "Activity model cap (GB/month/account; -1 = unlimited)",
                  "type": 1,
                  "isRequired": true,
                  "value": "-1",
                  "description": "Scenario input, not a discovered cap. Use the cap in the detailed table for the account(s) being modeled.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "match": true,
                        "regExp": "^(?:-1|0|[1-9][0-9]{0,8})$",
                        "message": "Enter -1 (unlimited) or a nonnegative whole number."
                      }
                    ]
                  }
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Storage"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "storageActivityParameters"
          },
          {
            "type": 1,
            "content": {
              "json": "**Activity monitoring (model, not measured malware scans):** The table below projects a 7-day sample of Blob and File service transactions and Blob upload ingress to 30 days. Modeled scanning is the lesser of projected Blob upload GB and the **Activity model cap**; -1 is unlimited. The model cap is a scenario input, not automatically populated from the subscription-level cap above, and storage-account overrides can differ. Select only accounts with the same cap when comparing a capped scenario. Missing service metrics are **Incomplete**, not zero; accounts with no metric rows may be omitted. This view does not prove that malware scanning is enabled or that all uploads are scanned."
            },
            "conditionalVisibilities": [
              {
                "parameterName": "planName",
                "comparison": "isEqualTo",
                "value": "Storage"
              },
              {
                "parameterName": "detailedCoverage",
                "comparison": "isEqualTo",
                "value": "Yes"
              }
            ],
            "name": "storageActivityHelp"
          },
