    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Defender for Cloud coverage by JFrog Artifactory connectors"
            },
            "name": "headingJFrog"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"JFrog\" or tostring(properties.environmentData.environmentType) =~ \"JFrogArtifactory\"\n| extend ScanIntervalHours = toint(properties.environmentData.scanInterval), Offerings = properties.offerings\n| extend OfferingsToExpand = iff(array_length(Offerings) > 0, Offerings, dynamic([{}]))\n| mv-expand offering = OfferingsToExpand\n| extend OfferingType = tolower(tostring(offering.offeringType)),\n    AssessmentValue = tolower(tostring(offering.mdcContainersImageAssessment.enabled))\n| summarize\n    FoundationalPresent = countif(OfferingType == \"cspmmonitorjfrog\"),\n    CSPMPresent = countif(OfferingType == \"defendercspmjfrog\"),\n    ContainersPresent = countif(OfferingType == \"defenderforcontainersjfrog\"),\n    UnexpectedOfferings = countif(OfferingType !in (\"cspmmonitorjfrog\", \"defendercspmjfrog\", \"defenderforcontainersjfrog\")),\n    AssessmentEnabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"true\"),\n    AssessmentDisabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"false\"),\n    AssessmentUnreported = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue !in (\"true\", \"false\"))\n    by id, name, subscriptionId, resourceGroup, location, ScanIntervalHours\n| extend FoundationalCSPM = case(FoundationalPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    DefenderCSPM = case(CSPMPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    Containers = case(ContainersPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\")\n| extend CSPMImageAssessment = case(DefenderCSPM == \"Disabled\", \"Not applicable\",\n    AssessmentEnabled > 0 and AssessmentDisabled == 0 and AssessmentUnreported == 0, \"Enabled\",\n    AssessmentDisabled > 0 and AssessmentEnabled == 0 and AssessmentUnreported == 0, \"Disabled\",\n    \"Not reported\"),\n    ScanInterval = case(isnull(ScanIntervalHours) or ScanIntervalHours < 1 or ScanIntervalHours > 24,\n        \"Not reported\", strcat(tostring(ScanIntervalHours), \" hours\"))\n| summarize Connectors = count(),\n    UnreportedConnectors = countif(FoundationalCSPM == \"Not reported\" or DefenderCSPM == \"Not reported\" or Containers == \"Not reported\"),\n    FoundationalEnabled = countif(FoundationalCSPM == \"Enabled\"),\n    FoundationalReported = countif(FoundationalCSPM != \"Not reported\"),\n    CSPMEnabled = countif(DefenderCSPM == \"Enabled\"),\n    CSPMReported = countif(DefenderCSPM != \"Not reported\"),\n    ContainersEnabled = countif(Containers == \"Enabled\"),\n    ContainersReported = countif(Containers != \"Not reported\")\n| where Connectors > 0\n| project FoundationalCoverage = iff(FoundationalReported > 0, 100.0 * todouble(FoundationalEnabled) / todouble(FoundationalReported), real(null)),\n    CSPMCoverage = iff(CSPMReported > 0, 100.0 * todouble(CSPMEnabled) / todouble(CSPMReported), real(null)),\n    ContainersCoverage = iff(ContainersReported > 0, 100.0 * todouble(ContainersEnabled) / todouble(ContainersReported), real(null)),\n    Connectors, UnreportedConnectors",
              "size": 3,
              "title": "Relative coverage across JFrog connectors (reported plans only)",
              "noDataMessage": "No JFrog connectors found in your selected subscriptions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "FoundationalCoverage",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "max": 100,
                      "palette": "yellow"
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "CSPMCoverage",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "max": 100,
                      "palette": "yellow"
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "ContainersCoverage",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "max": 100,
                      "palette": "yellow"
                    },
                    "numberFormat": {
                      "unit": 1,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "FoundationalCoverage",
                    "label": "Foundational CSPM"
                  },
                  {
                    "columnId": "CSPMCoverage",
                    "label": "Defender CSPM"
                  },
                  {
                    "columnId": "ContainersCoverage",
                    "label": "Containers"
                  },
                  {
                    "columnId": "Connectors",
                    "label": "Connectors"
                  },
                  {
                    "columnId": "UnreportedConnectors",
                    "label": "Connectors with unreported plans"
                  }
                ]
              }
            },
            "conditionalVisibility": {
              "parameterName": "relativeCoverage",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "queryJFrogRelative"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"JFrog\" or tostring(properties.environmentData.environmentType) =~ \"JFrogArtifactory\"\n| extend ScanIntervalHours = toint(properties.environmentData.scanInterval), Offerings = properties.offerings\n| extend OfferingsToExpand = iff(array_length(Offerings) > 0, Offerings, dynamic([{}]))\n| mv-expand offering = OfferingsToExpand\n| extend OfferingType = tolower(tostring(offering.offeringType)),\n    AssessmentValue = tolower(tostring(offering.mdcContainersImageAssessment.enabled))\n| summarize\n    FoundationalPresent = countif(OfferingType == \"cspmmonitorjfrog\"),\n    CSPMPresent = countif(OfferingType == \"defendercspmjfrog\"),\n    ContainersPresent = countif(OfferingType == \"defenderforcontainersjfrog\"),\n    UnexpectedOfferings = countif(OfferingType !in (\"cspmmonitorjfrog\", \"defendercspmjfrog\", \"defenderforcontainersjfrog\")),\n    AssessmentEnabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"true\"),\n    AssessmentDisabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"false\"),\n    AssessmentUnreported = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue !in (\"true\", \"false\"))\n    by id, name, subscriptionId, resourceGroup, location, ScanIntervalHours\n| extend FoundationalCSPM = case(FoundationalPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    DefenderCSPM = case(CSPMPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    Containers = case(ContainersPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\")\n| extend CSPMImageAssessment = case(DefenderCSPM == \"Disabled\", \"Not applicable\",\n    AssessmentEnabled > 0 and AssessmentDisabled == 0 and AssessmentUnreported == 0, \"Enabled\",\n    AssessmentDisabled > 0 and AssessmentEnabled == 0 and AssessmentUnreported == 0, \"Disabled\",\n    \"Not reported\"),\n    ScanInterval = case(isnull(ScanIntervalHours) or ScanIntervalHours < 1 or ScanIntervalHours > 24,\n        \"Not reported\", strcat(tostring(ScanIntervalHours), \" hours\"))\n| project ConnectorName = name, ConnectorId = id, subscriptionId, FoundationalCSPM, DefenderCSPM, Containers\n| order by ConnectorName asc",
              "size": 3,
              "title": "Absolute coverage across JFrog connectors",
              "noDataMessage": "No JFrog connectors found in your selected subscriptions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ConnectorId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "FoundationalCSPM",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Not applicable",
                          "representation": "gray",
                          "text": "Not applicable"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "DefenderCSPM",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Not applicable",
                          "representation": "gray",
                          "text": "Not applicable"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Containers",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Not applicable",
                          "representation": "gray",
                          "text": "Not applicable"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "ConnectorName",
                    "label": "Connector"
                  },
                  {
                    "columnId": "ConnectorId",
                    "label": "Connector resource"
                  },
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "FoundationalCSPM",
                    "label": "Foundational CSPM"
                  },
                  {
                    "columnId": "DefenderCSPM",
                    "label": "Defender CSPM"
                  },
                  {
                    "columnId": "Containers",
                    "label": "Containers"
                  }
                ]
              },
              "showAnalytics": true
            },
            "conditionalVisibility": {
              "parameterName": "absoluteCoverage",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "queryJFrog"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"JFrog\" or tostring(properties.environmentData.environmentType) =~ \"JFrogArtifactory\"\n| extend ScanIntervalHours = toint(properties.environmentData.scanInterval), Offerings = properties.offerings\n| extend OfferingsToExpand = iff(array_length(Offerings) > 0, Offerings, dynamic([{}]))\n| mv-expand offering = OfferingsToExpand\n| extend OfferingType = tolower(tostring(offering.offeringType)),\n    AssessmentValue = tolower(tostring(offering.mdcContainersImageAssessment.enabled))\n| summarize\n    FoundationalPresent = countif(OfferingType == \"cspmmonitorjfrog\"),\n    CSPMPresent = countif(OfferingType == \"defendercspmjfrog\"),\n    ContainersPresent = countif(OfferingType == \"defenderforcontainersjfrog\"),\n    UnexpectedOfferings = countif(OfferingType !in (\"cspmmonitorjfrog\", \"defendercspmjfrog\", \"defenderforcontainersjfrog\")),\n    AssessmentEnabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"true\"),\n    AssessmentDisabled = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue == \"false\"),\n    AssessmentUnreported = countif(OfferingType == \"defendercspmjfrog\" and AssessmentValue !in (\"true\", \"false\"))\n    by id, name, subscriptionId, resourceGroup, location, ScanIntervalHours\n| extend FoundationalCSPM = case(FoundationalPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    DefenderCSPM = case(CSPMPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\"),\n    Containers = case(ContainersPresent > 0, \"Enabled\", UnexpectedOfferings > 0, \"Not reported\", \"Disabled\")\n| extend CSPMImageAssessment = case(DefenderCSPM == \"Disabled\", \"Not applicable\",\n    AssessmentEnabled > 0 and AssessmentDisabled == 0 and AssessmentUnreported == 0, \"Enabled\",\n    AssessmentDisabled > 0 and AssessmentEnabled == 0 and AssessmentUnreported == 0, \"Disabled\",\n    \"Not reported\"),\n    ScanInterval = case(isnull(ScanIntervalHours) or ScanIntervalHours < 1 or ScanIntervalHours > 24,\n        \"Not reported\", strcat(tostring(ScanIntervalHours), \" hours\"))\n| project ConnectorName = name, ConnectorId = id, subscriptionId, resourceGroup, location, ScanInterval, CSPMImageAssessment\n| order by ConnectorName asc",
              "size": 3,
              "title": "Detailed coverage for JFrog connectors",
              "noDataMessage": "No JFrog connectors found in your selected subscriptions.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ConnectorId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "CSPMImageAssessment",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disabled",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Not applicable",
                          "representation": "gray",
                          "text": "Not applicable"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "ConnectorName",
                    "label": "Connector"
                  },
                  {
                    "columnId": "ConnectorId",
                    "label": "Connector resource"
                  },
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "resourceGroup",
                    "label": "Resource group"
                  },
                  {
                    "columnId": "location",
                    "label": "Location"
                  },
                  {
                    "columnId": "ScanInterval",
                    "label": "Scan interval"
                  },
                  {
                    "columnId": "CSPMImageAssessment",
                    "label": "Defender CSPM image assessment"
                  }
                ]
              },
              "showAnalytics": true
            },
            "conditionalVisibility": {
              "parameterName": "detailedCoverage",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "queryJFrogDetailed"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "environment",
        "comparison": "isEqualTo",
        "value": "JFrog"
      },
      "name": "JFrog"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
