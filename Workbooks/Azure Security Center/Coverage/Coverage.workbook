            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.security/securityconnectors\"\n| where tostring(properties.environmentName) =~ \"AWS\"\n| mv-expand offering = properties.offerings\n| where tostring(offering.offeringType) =~ \"DefenderForServersAws\"\n| extend vmScannerState = case(tolower(tostring(offering.vmScanners.enabled)) == \"true\", \"true\", tolower(tostring(offering.vmScanners.enabled)) == \"false\", \"false\", \"unknown\"),\n    arcState = case(tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.arcAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\"),\n    mdeState = case(tolower(tostring(offering.mdeAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.mdeAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\"),\n    vaState = case(tolower(tostring(offering.vaAutoProvisioning.enabled)) == \"true\", \"true\", tolower(tostring(offering.vaAutoProvisioning.enabled)) == \"false\", \"false\", \"unknown\")\n| project id,\n    vmScanners = iff(tolower(tostring(offering.subPlan.type)) == \"p1\" and isempty(tostring(offering.vmScanners.enabled)), \"notapplicable\", vmScannerState),\n    arcAutoProvisioning = arcState,\n    arcAdditionalExtensions = case(\n        mdeState == \"true\" and vaState == \"true\", \"2/2 enabled\",\n        mdeState == \"false\" and vaState == \"false\", \"0/2 enabled\",\n        mdeState in (\"true\", \"false\") and vaState in (\"true\", \"false\"), strcat(tostring(iff(mdeState == \"true\", 1, 0) + iff(vaState == \"true\", 1, 0)), \"/2 enabled\"),\n        mdeState == \"true\" or vaState == \"true\", strcat(tostring(iff(mdeState == \"true\", 1, 0) + iff(vaState == \"true\", 1, 0)), \"/2 enabled; 1 not reported\"),\n        mdeState == \"false\" or vaState == \"false\", strcat(tostring(iff(mdeState == \"true\", 1, 0) + iff(vaState == \"true\", 1, 0)), \"/2 enabled; 1 not reported\"),\n        \"Not reported\"),\n    mdeAutoProvisioning = mdeState,\n    vaAutoProvisioning = vaState",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for AWS connectors with Defender for Servers enabled",
              "noDataMessage": "No AWS connector found with Defender for Servers enabled.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "vmScanners",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "id",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "true",
                          "representation": "yellow",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "false",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "notapplicable",
                          "representation": "gray",
                          "text": "Not applicable (Plan 1 only)"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "AwsAccountSettingsBlade",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
                            "name": "connectorId",
                            "source": "column",
                            "value": "id"
                          }
