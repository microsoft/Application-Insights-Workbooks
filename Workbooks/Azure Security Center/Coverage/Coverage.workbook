          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let arcHosts = resources\n| where type =~ \"microsoft.hybridcompute/machines\"\n| where \"*\" in~ ({SqlSubscriptions}) or subscriptionId in~ ({SqlSubscriptions})\n| project HostResourceId = tolower(id), HostName = name,\n    ArcConnectionStatus = tostring(properties.status),\n    HostOS = tostring(properties.osName), HostAgentVersion = tostring(properties.agentVersion);\nresources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where \"*\" in~ ({SqlSubscriptions}) or subscriptionId in~ ({SqlSubscriptions})\n| extend SQLInstanceResourceId = tolower(id),\n    SQLInstance = iff(isnotempty(tostring(properties.instanceName)), tostring(properties.instanceName), name),\n    HostResourceId = tolower(tostring(properties.containerResourceId)),\n    SQLVersion = tostring(properties.version),\n    SQLCurrentVersion = tostring(properties.currentVersion),\n    SQLPatchLevel = tostring(properties.patchLevel),\n    SQLHostType = tostring(properties.hostType),\n    SQLEdition = tostring(properties.edition),\n    SQLCores = tostring(properties.cores),\n    SQLvCore = tostring(properties.vCore),\n    SQLLicenseType = tostring(properties.licenseType),\n    SQLInstanceStatus = tostring(properties.status),\n    ProtectionStatusRaw = tostring(properties.azureDefenderStatus),\n    ProtectionStatusUpdated = todatetime(properties.azureDefenderStatusLastUpdated)\n| extend ProtectionStatus = case(ProtectionStatusRaw =~ \"Protected\", \"Protected\",\n    ProtectionStatusRaw =~ \"Unprotected\", \"Unprotected\",\n    ProtectionStatusRaw =~ \"Unknown\" or isempty(ProtectionStatusRaw), \"Unknown / not reported\",\n    ProtectionStatusRaw),\n    SQLInstanceStatus = iff(isempty(SQLInstanceStatus), \"Not reported\", SQLInstanceStatus)\n| join kind=leftouter arcHosts on HostResourceId\n| extend ArcConnectionStatus = iff(isempty(ArcConnectionStatus), \"Not reported\", ArcConnectionStatus)\n| extend NextAction = case(ProtectionStatus == \"Unprotected\", \"Review Defender for SQL protection status\",\n    ProtectionStatus == \"Unknown / not reported\", \"Verify current protection status in Defender for Cloud\",\n    SQLInstanceStatus in~ (\"Disconnected\", \"Unknown\", \"Not reported\"), \"Check Arc SQL inventory connectivity\",\n    ArcConnectionStatus !~ \"Connected\", \"Review Azure Arc host connection\",\n    \"Review reported status\")\n| where ProtectionStatus != \"Protected\" or SQLInstanceStatus in~ (\"Disconnected\", \"Unknown\", \"Not reported\") or ArcConnectionStatus !~ \"Connected\"\n| join kind=leftouter (\n    resourcecontainers\n    | where type =~ \"microsoft.resources/subscriptions\"\n    | project subscriptionId, SubscriptionName = name\n) on subscriptionId\n| project SubscriptionName, subscriptionId, SQLInstance, SQLInstanceResourceId, HostName, HostResourceId,\n    location, resourceGroup, SQLVersion, SQLCurrentVersion, SQLPatchLevel, SQLHostType,\n    SQLEdition, SQLCores, SQLvCore, SQLLicenseType,\n    SQLInstanceStatus, ProtectionStatus, ProtectionStatusUpdated,\n    ArcConnectionStatus, HostOS, HostAgentVersion, NextAction\n| order by subscriptionId asc, HostName asc, SQLInstance asc",
