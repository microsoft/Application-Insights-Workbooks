          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\n| where type =~ \"microsoft.security/pricings\" and name =~ \"VirtualMachines\"\n| where id =~ strcat(\"/subscriptions/\", subscriptionId, \"/providers/Microsoft.Security/pricings/VirtualMachines\")\n| where tostring(properties.pricingTier) =~ \"Standard\"\n| mv-expand extensionSettings = iff(array_length(properties.extensions) > 0, properties.extensions, dynamic([{}]))\n| extend planSet = iff(isnotempty(tostring(extensionSettings.name)), pack(tostring(extensionSettings.name), tostring(extensionSettings.isEnabled)), dynamic({}))\n| summarize extensions = make_bag(planSet), subPlan = take_any(tostring(properties.subPlan)) by subscriptionId\n| project subscriptionId,\n    AgentlessVmScanning = case(tolower(tostring(extensions.AgentlessVmScanning)) == \"true\", \"true\", tolower(tostring(extensions.AgentlessVmScanning)) == \"false\", \"false\", subPlan =~ \"P1\" and isempty(tostring(extensions.AgentlessVmScanning)), \"notincluded\", \"unknown\"),\n    FileIntegrityMonitoring = case(tolower(tostring(extensions.FileIntegrityMonitoring)) == \"true\", \"true\", tolower(tostring(extensions.FileIntegrityMonitoring)) == \"false\", \"false\", subPlan =~ \"P1\" and isempty(tostring(extensions.FileIntegrityMonitoring)), \"notincluded\", \"unknown\")",
              "size": 3,
              "showAnalytics": true,
              "title": "Detailed coverage for subscriptions with Defender for Servers enabled",
              "noDataMessage": "No subscription found with Defender for Servers enabled.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true,
                      "customColumnWidthSetting": "50ch"
                    }
                  },
                  {
                    "columnMatch": "^(AgentlessVmScanning|FileIntegrityMonitoring)$",
                    "formatter": 18,
                    "formatOptions": {
                      "linkColumn": "subscriptionId",
                      "linkTarget": "OpenBlade",
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "true",
                          "representation": "lightBlue",
                          "text": "Enabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "false",
                          "representation": "redBright",
                          "text": "Disabled"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "notincluded",
                          "representation": "gray",
                          "text": "Not included in Servers P1"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "Not reported"
                        }
                      ],
                      "bladeOpenContext": {
                        "bladeName": "DataCollectionBladeV2",
                        "extensionName": "Microsoft_Azure_Security",
                        "bladeParameters": [
                          {
                            "name": "subscriptionId",
                            "source": "column",
                            "value": "subscriptionId"
                          },
                          {
                            "name": "defendersPlan",
                            "source": "static",
                            "value": "Servers"
                          }
                        ]
                      },
                      "customColumnWidthSetting": "38.5ch"
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription Name"
                  },
                  {
                    "columnId": "AgentlessVmScanning",
                    "label": "Agentless scanning for machines"
                  },
                  {
                    "columnId": "FileIntegrityMonitoring",
                    "label": "File Integrity Monitoring"
                  }
                ]
              },
              "sortBy": []
