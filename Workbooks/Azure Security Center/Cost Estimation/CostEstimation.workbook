          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "6311af34-336c-4202-a6fe-a28cebe0a175",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureServerlessProtectionAverage",
                  "label": "Azure apps/functions per subscription (optional forecast)",
                  "type": 1,
                  "value": "",
                  "description": "Leave blank to use available inventory, or retain an explicit unpriced status when telemetry is unavailable. A supplied monthly-average quantity replaces discovery separately for every selected subscription; it is not a cloud-wide aggregate. Use 0 only for confirmed absence. AWS scopes with the same connector hierarchy identifier are deduplicated for serverless costs. Values must be nonnegative and below 1,000,000,000,000.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]+)?)$",
                        "match": true,
                        "message": "Enter a nonnegative quantity below 1,000,000,000,000, or leave blank for discovery."
                      }
                    ]
                  }
                }
              ],
              "style": "above"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "serverlessProtection",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "serverlessAzureSelected",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "Serverless Azure protection forecast"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "ce8deb4a-9514-4c8c-ad6f-89da90d11a99",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureServerlessContainersAverage",
                  "label": "Azure running containers per subscription (optional forecast)",
                  "type": 1,
                  "value": "",
                  "description": "Leave blank to use available inventory, or retain an explicit unpriced status when telemetry is unavailable. A supplied monthly-average quantity replaces discovery separately for every selected subscription; it is not a cloud-wide aggregate. Use 0 only for confirmed absence. AWS scopes with the same connector hierarchy identifier are deduplicated for serverless costs. Values must be nonnegative and below 1,000,000,000,000.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]+)?)$",
                        "match": true,
                        "message": "Enter a nonnegative quantity below 1,000,000,000,000, or leave blank for discovery."
                      }
                    ]
                  }
                }
              ],
              "style": "above"
            },
            "conditionalVisibilities": [
