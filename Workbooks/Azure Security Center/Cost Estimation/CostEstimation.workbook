                      }
                    }
                  ],
                  "id": "2aa918ac-ba12-41ca-b99e-3e41a25e3e71"
                },
                {
                  "version": "KqlParameterItem/1.0",
                  "name": "GCPP1P2Tenant",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
