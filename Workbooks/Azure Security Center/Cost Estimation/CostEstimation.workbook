          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "813e35c8-6b26-41c1-a4e0-9333b22d242a",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessProtection",
                  "label": "Serverless protection",
                  "type": 10,
                  "isRequired": true,
                  "value": "0",
                  "description": "Include automatically discovered Azure Function App/Web App inventory in Microsoft Cloud Security Posture Management and known totals. Discovery is a current-resource full-month projection. AWS Lambda inventory is unavailable in this feed and remains unpriced. This switch does not enable cloud protection plans.",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"0\",\"label\":\"Exclude\",\"selected\":true},{\"value\":\"1\",\"label\":\"Include in estimate\"}]"
                },
                {
                  "id": "e3051776-b047-42a9-998d-ac15d33169b7",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessContainers",
                  "label": "Serverless containers",
                  "type": 10,
                  "isRequired": true,
                  "value": "0",
                  "description": "Include automatically discovered running ACI containers in Microsoft Cloud Security Posture Management and known totals at two running containers per billable unit. ACA replicas and ECS/Fargate runtime quantities are not inferred and remain unpriced. This switch does not configure cloud plans or Registry access.",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"0\",\"label\":\"Exclude\",\"selected\":true},{\"value\":\"1\",\"label\":\"Include in estimate\"}]"
                }
              ],
              "style": "above"
            },
            "conditionalVisibility": {
              "parameterName": "istenantlevel",
              "comparison": "isEqualTo",
              "value": "0"
            },
            "name": "CSPM serverless controls"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "122d7997-605d-418e-b758-6a1cf361101f",
                  "version": "KqlParameterItem/1.0",
                  "name": "discountVal",
                  "label": "Discount %",
                  "type": 1,
                  "description": "Optional manual planning discount on retail prices. Defaults to 0%; negotiated rates vary by plan and billing agreement, so no tenant-wide or subscription-wide percentage is inferred. Enter a known whole-number percentage from 0 to 100. Clearing this field also uses 0%.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|[0-9]|([1-9][0-9])|100)$",
                        "match": true,
                        "message": "Value not between 0 and 100"
                      }
                    ]
                  },
                  "value": "0"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibility": {
              "parameterName": "istenantlevel",
              "comparison": "isEqualTo",
              "value": "0"
            },
            "name": "discount"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "5236e5ec-4b21-4a96-85dc-5a269df08498",
                  "version": "KqlParameterItem/1.0",
                  "name": "discountToMultiplyVal",
                  "type": 1,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "is Empty",
                        "rightValType": "static",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "0",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "100",
                        "resultValType": "static",
                        "resultVal": "0.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "isNotNull",
                        "rightValType": "static",
                        "resultValType": "expression",
                        "resultVal": "(100-{discountVal})/100.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    }
                  ]
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "istenantlevel",
                "comparison": "isEqualTo",
                "value": "0"
              },
              {
                "parameterName": "x",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "discountToMultiply"
          },
          {
            "type": 1,
            "content": {
              "json": "{azurePlans}\r\n\r\n{awsPlans}\r\n\r\n{gcpPlans}\r\n\r\n"
