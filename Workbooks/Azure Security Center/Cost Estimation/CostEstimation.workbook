          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "exportParameters": false,
              "items": [
                {
                  "type": 1,
                  "name": "Serverless inventory and known-total guidance",
                  "content": {
                    "style": "info",
                    "json": "**Included in CSPM and known totals.** Azure apps/functions and available running ACI containers are discovered automatically. Inventory is a full-month projection, not a measured monthly average or proof that Defender coverage is enabled. ACA replica counts and AWS Lambda/ECS runtime quantities are unavailable in this feed and are not guessed. Selected inputs without a reliable quantity stay unpriced; known totals are not a complete bill. Snapshot: **{serverlessInventory:$.capturedAt}**. Refresh the workbook to refresh discovery. Resource details show up to 1,000 rows; the scope-cost snapshot aggregates the matching inventory before that display limit."
                  }
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\" and tolower(\"{azureIsDcspm}\") == \"true\"\r\n| project Cloud = \"Azure\", ScopeId = tolower(subscriptionId), ScopeName = name, ResourceId = strcat(\"/subscriptions/\", subscriptionId)\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\" and tolower(\"{awsIsDcspm}\") == \"true\"\r\n| project Cloud = \"AWS\", ScopeId = tolower(id), ScopeName = name, ResourceId = id\r\n)\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend SLData = SLRoot.d[ScopeId]\r\n| where Cloud == \"Azure\" or not(coalesce(tolong(SLRoot._ok) == 1 and array_length(SLData) == 5 and tolong(SLData[4]) == 0, false))\r\n| extend Parts = dynamic([\"protection\", \"containers\"])\r\n| mv-expand Parts\r\n| extend Component = tostring(Parts)\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend EntryValid = tolong(SLRoot._ok) == 1 and gettype(SLRoot.d) == \"dictionary\" and iff(Cloud == \"Azure\", isnull(SLData) or array_length(SLData) == 5, isnotnull(SLData) and array_length(SLData) == 5 and tolong(SLData[4]) in (0,1))\r\n| extend AutoQuantity = iff(isnull(SLData), 0.0, iff(Component == \"protection\", todouble(SLData[0]), todouble(SLData[1]))), AutoMissing = iff(isnull(SLData), 0, iff(Component == \"protection\", tolong(SLData[2]), tolong(SLData[3])))\r\n| extend AutoValid = EntryValid and isfinite(AutoQuantity) and AutoQuantity >= 0.0 and isnotnull(AutoMissing) and AutoMissing >= 0\r\n| extend KnownQuantity = iff(Cloud == \"Azure\" and AutoValid, AutoQuantity, 0.0)\r\n| extend UnpricedInputs = iff(Cloud == \"Azure\" and AutoValid, AutoMissing, 1)\r\n| extend Basis = iff(Cloud == \"AWS\" and not(EntryValid), \"Connector identity snapshot unavailable\", iff(Cloud == \"Azure\", \"Current inventory projection\", \"AWS telemetry unavailable\"))\r\n| extend MonthlyRate = todouble({retailPricing:$.monthly.cspm}) / iff(Component == \"protection\", 8.0, 2.0) * {discountToMultiplyVal}\r\n| extend KnownMonthlyCost = KnownQuantity * MonthlyRate\r\n| summarize KnownQuantity = sum(KnownQuantity), KnownMonthlyCost = sum(KnownMonthlyCost), UnpricedInputs = sum(UnpricedInputs) by Cloud, Component\r\n| extend BillableUnits = KnownQuantity / iff(Component == \"protection\", 8.0, 2.0)\r\n| extend ResourceKind = iff(Component == \"protection\", iff(Cloud == \"AWS\", \"Lambda functions\", \"apps/functions\"), \"running containers\")\r\n| extend Component = iff(Component == \"protection\", \"Serverless protection\", \"Serverless containers\")\r\n| project Cloud, Component, KnownQuantity, BillableUnits, KnownMonthlyCost = iff(UnpricedInputs > 0 and KnownQuantity == 0.0, real(null), KnownMonthlyCost), ResourceKind",
                    "size": 0,
                    "title": "Serverless CSPM portion (included in known totals)",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "crossComponentResources": [
                      "value::tenant"
                    ],
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 4,
                      "filter": false,
                      "formatters": [
                        {
                          "columnMatch": "KnownQuantity",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Blank",
                                "text": "{0} ([\"ResourceKind\"])"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "ResourceKind",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "KnownMonthlyCost",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "is Empty",
                                "representation": "Blank",
                                "text": "Not estimated"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Blank",
                                "text": "{0}"
                              }
                            ]
                          },
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "USD",
                              "style": "currency",
                              "minimumFractionDigits": 2,
                              "maximumFractionDigits": 2
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Cloud",
                          "label": "Cloud"
                        },
                        {
                          "columnId": "Component",
                          "label": "Component"
                        },
                        {
                          "columnId": "KnownQuantity",
                          "label": "Resource quantity"
                        },
                        {
                          "columnId": "BillableUnits",
                          "label": "Billable quantity"
                        },
                        {
                          "columnId": "KnownMonthlyCost",
                          "label": "Monthly cost (USD)"
                        }
                      ]
                    },
                    "noDataMessage": "No selected serverless scopes were found in the readable inventory.",
                    "sortBy": []
                  },
                  "name": "Serverless CSPM summary"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "style": "above",
                    "parameters": [
                      {
                        "id": "b8e3f644-cd25-4054-a29f-7c75cc925086",
                        "version": "KqlParameterItem/1.0",
                        "name": "showServerlessResourceDetails",
                        "label": "Resource details",
                        "type": 10,
                        "isRequired": true,
                        "value": "0",
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "jsonData": "[{\"value\":\"0\",\"label\":\"Hide\",\"selected\":true},{\"value\":\"1\",\"label\":\"Show\"}]"
                      }
                    ]
                  },
                  "name": "Serverless resource detail options"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resources\r\n| where tolower(\"{azureIsDcspm}\") == \"true\" and (tolong(\"{serverlessProtection}\") == 1 or tolong(\"{serverlessContainers}\") == 1)\r\n| where type in~ (\"microsoft.web/sites\", \"microsoft.app/containerapps\", \"microsoft.containerinstance/containergroups\")\r\n| extend ResourceType = tolower(type), ScopeId = tolower(subscriptionId), ResourceId = id, ResourceName = name, ResourceKind = tolower(iff(isnotempty(kind), kind, tostring(properties.kind)))\r\n| extend Component = iff(ResourceType == \"microsoft.web/sites\", \"protection\", \"containers\")\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend IsSite = ResourceType == \"microsoft.web/sites\", IsACI = ResourceType == \"microsoft.containerinstance/containergroups\"\r\n| extend SiteRecognized = IsSite and (ResourceKind has \"functionapp\" or ResourceKind has \"app\") and ResourceKind !has \"workflowapp\"\r\n| extend InventoryContainers = iff(IsACI and isnotnull(properties.containers) and array_length(properties.containers) > 0, properties.containers, dynamic([{}]))\r\n| mv-expand InventoryContainer = InventoryContainers limit 2000\r\n| extend ContainerState = tolower(tostring(InventoryContainer.properties.instanceView.currentState.state))\r\n| extend ResourceState = iff(IsSite, tostring(properties.state), iff(IsACI, ContainerState, tostring(properties.runningStatus)))\r\n| extend KnownQuantity = case(SiteRecognized, 1.0, IsACI and ContainerState == \"running\", 1.0, 0.0)\r\n| extend UnpricedInputs = case(IsSite and not(SiteRecognized), 1, IsACI and isempty(ContainerState), 1, ResourceType == \"microsoft.app/containerapps\", 1, 0)\r\n| extend Workload = case(SiteRecognized and ResourceKind has \"functionapp\", \"Azure Function App\", SiteRecognized, \"Azure Web App\", IsSite, \"Unclassified App Service site\", IsACI, \"ACI container\", \"Azure Container App\")\r\n| extend ResourceName = iff(IsACI and isnotempty(tostring(InventoryContainer.name)), strcat(ResourceName, \" / \", tostring(InventoryContainer.name)), ResourceName)\r\n| project Cloud = \"Azure\", ScopeId, ResourceId, ResourceName, ResourceType, ResourceState, Component, Workload, KnownQuantity, UnpricedInputs\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend ScopeName = ScopeId\r\n| join kind=leftouter (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| project ScopeId = tolower(subscriptionId), SubscriptionName = name\r\n) on ScopeId\r\n| extend ScopeName = iff(isnotempty(SubscriptionName), SubscriptionName, ScopeName)\r\n| extend Quantity = iff(UnpricedInputs > 0, real(null), KnownQuantity), Basis = \"Current resource inventory\"\r\n| extend Status = case(UnpricedInputs > 0 and ResourceType == \"microsoft.app/containerapps\", \"Runtime replica count unavailable; not estimated\", UnpricedInputs > 0, \"Runtime/type information unavailable; not estimated\", \"Inventory snapshot; not a measured monthly average\")\r\n| project Cloud, ScopeName, ResourceName, Workload, ResourceType, ResourceState, Component, Quantity, Basis, Status, ResourceId\r\n| union (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\" and tolower(\"{azureIsDcspm}\") == \"true\"\r\n| project Cloud = \"Azure\", ScopeId = tolower(subscriptionId), ScopeName = name, ResourceId = strcat(\"/subscriptions/\", subscriptionId)\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\" and tolower(\"{awsIsDcspm}\") == \"true\"\r\n| project Cloud = \"AWS\", ScopeId = tolower(id), ScopeName = name, ResourceId = id\r\n)\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend SLData = SLRoot.d[ScopeId]\r\n| where Cloud == \"Azure\" or not(coalesce(tolong(SLRoot._ok) == 1 and array_length(SLData) == 5 and tolong(SLData[4]) == 0, false))\r\n| extend Parts = dynamic([\"protection\", \"containers\"])\r\n| mv-expand Parts\r\n| extend Component = tostring(Parts)\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend EntryValid = tolong(SLRoot._ok) == 1 and gettype(SLRoot.d) == \"dictionary\" and iff(Cloud == \"Azure\", isnull(SLData) or array_length(SLData) == 5, isnotnull(SLData) and array_length(SLData) == 5 and tolong(SLData[4]) in (0,1))\r\n| extend AutoQuantity = iff(isnull(SLData), 0.0, iff(Component == \"protection\", todouble(SLData[0]), todouble(SLData[1]))), AutoMissing = iff(isnull(SLData), 0, iff(Component == \"protection\", tolong(SLData[2]), tolong(SLData[3])))\r\n| extend AutoValid = EntryValid and isfinite(AutoQuantity) and AutoQuantity >= 0.0 and isnotnull(AutoMissing) and AutoMissing >= 0\r\n| extend KnownQuantity = iff(Cloud == \"Azure\" and AutoValid, AutoQuantity, 0.0)\r\n| extend UnpricedInputs = iff(Cloud == \"Azure\" and AutoValid, AutoMissing, 1)\r\n| extend Basis = iff(Cloud == \"AWS\" and not(EntryValid), \"Connector identity snapshot unavailable\", iff(Cloud == \"Azure\", \"Current inventory projection\", \"AWS telemetry unavailable\"))\r\n| extend ResourcesPerUnit = iff(Component == \"protection\", 8.0, 2.0)\r\n| extend BillableUnits = KnownQuantity / ResourcesPerUnit, KnownMonthlyCost = KnownQuantity / ResourcesPerUnit * todouble({retailPricing:$.monthly.cspm}) * {discountToMultiplyVal}\r\n| where Cloud == \"AWS\"\r\n| extend ResourceName = \"Runtime/inventory quantity unavailable\", ResourceType = \"AWS connector\", ResourceState = \"\"\r\n| extend Workload = iff(Component == \"containers\", \"Running containers\", \"Lambda functions\")\r\n| extend Quantity = real(null), Status = \"Telemetry unavailable; not estimated\"\r\n| project Cloud, ScopeName, ResourceName, Workload, ResourceType, ResourceState, Component, Quantity, Basis, Status, ResourceId\r\n)\r\n| extend Component = iff(Component == \"protection\", \"Serverless protection\", \"Serverless containers\")\r\n| order by Cloud asc, ScopeName asc, Component asc, ResourceName asc",
                    "size": 0,
                    "title": "Discovered resources and unavailable inventory",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "crossComponentResources": [
                      "value::tenant"
                    ],
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 1000,
                      "filter": true,
                      "formatters": [
                        {
                          "columnMatch": "ResourceId",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "ResourceType",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "Quantity",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "is Empty",
                                "representation": "Blank",
                                "text": "Unavailable"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Blank",
                                "text": "{0}"
                              }
                            ]
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Cloud",
                          "label": "Cloud"
                        },
                        {
                          "columnId": "ScopeName",
                          "label": "Subscription / connector"
                        },
                        {
                          "columnId": "ResourceName",
                          "label": "Resource"
                        },
                        {
                          "columnId": "Workload",
                          "label": "Workload"
                        },
                        {
                          "columnId": "ResourceType",
                          "label": "Resource type"
                        },
                        {
                          "columnId": "ResourceState",
                          "label": "State"
                        },
                        {
                          "columnId": "Component",
                          "label": "Component"
                        },
                        {
                          "columnId": "Quantity",
                          "label": "Resource quantity"
                        },
                        {
                          "columnId": "Basis",
                          "label": "Data source"
                        },
                        {
                          "columnId": "Status",
                          "label": "Status"
                        }
                      ]
                    },
                    "noDataMessage": "No matching discovered resources. Automatic zero means no matching Azure resources in the readable snapshot, not a measured monthly average.",
                    "sortBy": []
                  },
                  "name": "Serverless CSPM resource estimates",
                  "conditionalVisibility": {
                    "parameterName": "showServerlessResourceDetails",
                    "comparison": "isEqualTo",
                    "value": "1"
                  }
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "serverlessComponentsIncluded",
              "comparison": "isEqualTo",
              "value": "1"
            },
            "name": "Optional serverless CSPM estimates"
          },
          {
            "type": 12,
            "name": "Defender for API estimate",
            "conditionalVisibilities": [
              {
                "parameterName": "istenantlevel",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "includeDefenderApis",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "AzureAPISubPlans",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "Defender for APIs usage and billing guidance",
                  "content": {
                    "json": "## Defender for API\r\n\r\n**Usage source:** [Microsoft Learn: select a plan using historical API traffic](https://learn.microsoft.com/azure/defender-for-cloud/defender-for-apis-deploy#select-the-optimal-plan-based-on-historical-azure-api-management-api-traffic-usage). The table reads Azure Monitor **API Management service standard metrics > Requests > Sum**, over the **last 30 days**, for every discovered API Management service in the selected readable scope, grouped by subscription. This is a rolling traffic baseline, not calendar-month billing or only traffic from APIs onboarded to Defender. Missing metrics or permission errors are not confirmed zero usage; check every service before treating a subscription sum as complete. Reader access including `Microsoft.Insights/metrics/read` is required. No diagnostic-settings changes are needed. Discovery for the usage picker is limited to 1,000 services; verify larger estates separately.\r\n\r\n**Pricing:** one manually selected entitlement plan per subscription with an API Management service, charged once in the Azure and overall totals when both this switch and the APIs plan are selected. The cost table below repeats that included amount for inspection; it is not an additional charge. Lower traffic does not prorate the fee or automatically switch plans. Entitlements apply to monitored traffic across the entire subscription and reset each billing month. **The overall estimate includes base fees only.** The planning comparison below shows estimated overage requests, overage charges, and base-plus-overage costs separately; it never adds those scenario charges to overall totals. The usage table does not establish protection coverage. Excluding this estimate does not disable Defender for APIs.\r\n\r\n[Supported Requests metric](https://learn.microsoft.com/azure/azure-monitor/reference/supported-metrics/microsoft-apimanagement-service-metrics#category-gateway-requests) | [Official plan and billing guidance](https://learn.microsoft.com/azure/defender-for-cloud/defender-for-apis-deploy#enable-the-defender-for-apis-plan) | [Current retail prices]({retailPricing:$.source})\r\n\r\n**Recommended plan based on usage:** after checking every service for missing metrics, copy one subscription subtotal from the live table into **Subscription requests (last 30 days)** below. Leave it blank when usage is unavailable; zero means confirmed zero traffic, not missing data. Compare one complete subscription at a time; do not enter a single-service count unless it is the subscription total. The comparison evaluates all five plans and recommends the lowest estimated base-plus-overage cost (the lower plan wins ties). This is a user-entered planning scenario, not an automatically measured billing forecast or proof of protected traffic. The dropdown changes the selected scenario plan. **Apply plan to overall estimate** updates the base fee for all included subscriptions, without changing your cloud protection plan.\r\n\r\nThe reference fees and per-call overage rates below are before manual discount; the scenario comparison applies the chosen discount once to both. Overage rates were verified **{retailPricing:$.apiPlanning.verifiedDate}** against the official pricing page. No rounding to whole request blocks is applied.\r\n\r\n| Plan | Requests/month entitlement per subscription | Overage rate (USD/request) | Monthly cost (USD) |\r\n| --- | ---: | ---: | ---: |\r\n| 1 | 1,000,000 | {retailPricing:$.apiPlanning.overagePerCall.p1} | {retailPricing:$.monthly.apisP1} |\r\n| 2 | 5,000,000 | {retailPricing:$.apiPlanning.overagePerCall.p2} | {retailPricing:$.monthly.apisP2} |\r\n| 3 | 50,000,000 | {retailPricing:$.apiPlanning.overagePerCall.p3} | {retailPricing:$.monthly.apisP3} |\r\n| 4 | 100,000,000 | {retailPricing:$.apiPlanning.overagePerCall.p4} | {retailPricing:$.monthly.apisP4} |\r\n| 5 | 1,000,000,000 | {retailPricing:$.apiPlanning.overagePerCall.p5} | {retailPricing:$.monthly.apisP5} |"
                  }
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "2efe1fae-03d6-4f78-ba3f-7b18ea2d63ca",
                        "version": "KqlParameterItem/1.0",
                        "name": "azureAPIPlanValTenantWhatIf",
                        "label": "Defender for API - selected plan (what-if)",
                        "type": 2,
                        "description": "Compare a different plan below. Select Apply plan to overall estimate to update the base fees in the Azure and grand totals. This does not change your cloud plan.",
                        "isRequired": true,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "jsonData": "[\r\n { \"value\": 200, \"label\": \"Microsoft Defender for APIs Plan 1\", \"selected\": true},\r\n { \"value\": 700, \"label\": \"Microsoft Defender for APIs Plan 2\"},\r\n  { \"value\": 5000, \"label\": \"Microsoft Defender for APIs Plan 3\"},\r\n   { \"value\": 7000, \"label\": \"Microsoft Defender for APIs Plan 4\"},\r\n    { \"value\": 50000, \"label\": \"Microsoft Defender for APIs Plan 5\"}\r\n\r\n\r\n]",
                        "timeContext": {
                          "durationMs": 86400000
                        },
                        "value": "200"
                      }
                    ],
                    "style": "above",
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces"
                  },
                  "conditionalVisibilities": [
                    {
                      "parameterName": "AzureAPISubPlans",
                      "comparison": "isEqualTo",
                      "value": "1"
                    },
                    {
                      "parameterName": "istenantlevel",
                      "comparison": "isEqualTo",
                      "value": "1"
                    },
                    {
                      "parameterName": "includeDefenderApis",
                      "comparison": "isEqualTo",
                      "value": "1"
                    }
                  ],
                  "name": "azureapiplanstenant"
                },
                {
                  "type": 11,
                  "name": "Apply Defender for API plan",
                  "content": {
                    "version": "LinkItem/1.0",
