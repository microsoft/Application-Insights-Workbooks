                {
                  "id": "79c1e578-5b19-42d9-a65e-175e5316d366",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessAzureSelected",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
