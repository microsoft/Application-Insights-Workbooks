                {
                  "id": "b95e2442-d989-4ea6-8395-37af46af7a2a",
                  "version": "KqlParameterItem/1.0",
                  "name": "apiManagementServices",
                  "type": 5,
                  "multiSelect": true,
                  "isHiddenWhenLocked": true,
                  "quote": "",
                  "delimiter": ",",
                  "query": "resources\r\n| where type =~ \"microsoft.apimanagement/service\"\r\n| where tolong(\"{includeDefenderApis}\") == 1 and tolong(\"{AzureAPISubPlans}\") == 1\r\n| project value = id, label = name",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "label": "API Management usage resources"
                }
              ]
