                        "linkLabel": "Apply plan to overall estimate",
                        "subTarget": "{azureAPIPlanValTenantWhatIf}",
                        "style": "link"
                      }
                    ]
                  }
                },
                {
                  "type": 10,
                  "content": {
                    "chartId": "workbookfb017a7a-4fde-456b-956e-3d4e9716812b",
                    "version": "MetricsItem/2.0",
                    "size": 0,
                    "chartType": 0,
