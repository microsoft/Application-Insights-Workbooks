              "parameters": [
                {
                  "id": "79889727-b06e-4901-88ed-132853ef8f29",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessCspmSelected",
                  "label": "Microsoft Defender CSPM selected for Azure or AWS",
