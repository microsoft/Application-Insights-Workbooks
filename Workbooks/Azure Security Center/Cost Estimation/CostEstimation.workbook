          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type == \"microsoft.security/assessments\"\r\n    | where name in (pack_array('fead4128-7325-4b82-beda-3fd42de36920','0b168d89-4e52-45c9-bd6a-24f904abcc2e','bfa7d2aa-f362-11eb-9a03-0242ac130003'))\r\n    | extend resourceDetails = properties['resourceDetails']\r\n    | extend resourceSource = tolower(tostring(resourceDetails['Source']))\r\n    | where resourceSource == \"aws\"\r\n    | extend selectedPlans = tolower('{awsPlans}')\r\n    | extend resourceType = tolower(tostring(resourceDetails['ResourceType']))\r\n    | where selectedPlans has resourceType\r\n    | extend selectedSecurityConnectors = tolower('{AWSSecurityConnectors}')\r\n    | extend resourceId = tolower(tostring(resourceDetails['ResourceId']))\r\n    | extend securityConnectorId = tolower(tostring(split(resourceId,\"/securityentitydata/\")[0]))\r\n    | where isnotempty(securityConnectorId)\r\n    | where selectedSecurityConnectors has securityConnectorId\r\n    | distinct resourceId, resourceType, securityConnectorId\r\n    | extend computeCount = iff(resourceType == \"microsoft.security/securityconnectors/ec2instance\", 1 , 0)\r\n    | extend storageCount = iff(resourceType == \"microsoft.security/securityconnectors/s3bucket\", 1 , 0)\r\n    | extend dbCount = iff(resourceType == \"microsoft.security/securityconnectors/rdsdb\", 1 , 0)\r\n    | extend serversCount = computeCount\r\n    | extend dcspmCount = computeCount + storageCount + dbCount\r\n    | summarize TotalServersInSecurityConnector = sum(serversCount), TotalDcspmInSecurityConnector = sum(dcspmCount) by securityConnectorId\r\n    | where TotalServersInSecurityConnector > 0 or TotalDcspmInSecurityConnector > 0\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\"\r\n| where tolower(\"{awsIsDcspm}\") == \"true\" and (tolong(\"{serverlessProtection}\") == 1 or tolong(\"{serverlessContainers}\") == 1)\r\n| where tolower('{AWSSecurityConnectors}') has tolower(id)\r\n| project securityConnectorId = tolower(id), TotalServersInSecurityConnector = 0, TotalDcspmInSecurityConnector = 0\r\n)\r\n| summarize TotalServersInSecurityConnector = sum(TotalServersInSecurityConnector), TotalDcspmInSecurityConnector = sum(TotalDcspmInSecurityConnector) by securityConnectorId\r\n    | extend ServersPricingP1 = todouble({retailPricing:$.monthly.serversP1}), ServersPricingP2 = todouble({retailPricing:$.monthly.serversP2}), DcspmPricing = todouble({retailPricing:$.monthly.cspm})\r\n    | extend ServersEstimatedPrice = iff(tolower('{awsIsServersP1}') == \"true\", ServersPricingP1 * TotalServersInSecurityConnector * {discountToMultiplyVal}, iff(tolower('{awsIsServersP2}') == \"true\", ServersPricingP2 * TotalServersInSecurityConnector * {discountToMultiplyVal}, 0.0)),\r\n             DcspmEstimatedPrice = iff(tolower('{awsIsDcspm}') == \"true\", DcspmPricing * TotalDcspmInSecurityConnector * {discountToMultiplyVal}, 0.0)\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend SLMapReady = tolong(SLRoot._ok) == 1 and gettype(SLRoot.d) == \"dictionary\"\r\n| extend SLData = SLRoot.d[tolower(tostring(securityConnectorId))]\r\n| extend SLEntryValid = isnotnull(SLData) and array_length(SLData) == 5\r\n| extend SLMappingReady = SLMapReady and SLEntryValid and tolong(SLData[4]) in (0,1)\r\n| extend SLCanonical = SLMappingReady and tolong(SLData[4]) == 1\r\n| extend SLPAuto = iff(isnull(SLData), 0.0, todouble(SLData[0])), SLCAuto = iff(isnull(SLData), 0.0, todouble(SLData[1]))\r\n| extend SLPUnknown = iff(isnull(SLData), 0, tolong(SLData[2])), SLCUnknown = iff(isnull(SLData), 0, tolong(SLData[3]))\r\n| extend SLPAutoValid = SLMappingReady and isfinite(SLPAuto) and SLPAuto >= 0.0 and isnotnull(SLPUnknown) and SLPUnknown >= 0, SLCAutoValid = SLMappingReady and isfinite(SLCAuto) and SLCAuto >= 0.0 and isnotnull(SLCUnknown) and SLCUnknown >= 0\r\n| extend SLProtectionSelected = tolower(\"{awsIsDcspm}\") == \"true\" and tolong(\"{serverlessProtection}\") == 1, SLContainersSelected = tolower(\"{awsIsDcspm}\") == \"true\" and tolong(\"{serverlessContainers}\") == 1\r\n| extend SLPKnown = 0.0, SLCKnown = 0.0\r\n| extend SLPMissing = iff(SLProtectionSelected and (not(SLMappingReady) or SLCanonical), 1, 0), SLCMissing = iff(SLContainersSelected and (not(SLMappingReady) or SLCanonical), 1, 0)\r\n| extend SLPSource = \"AWS Lambda inventory not supplied by this feed\", SLCSource = \"ECS/Fargate runtime quantity unavailable\"\r\n| extend ServerlessKnownCost = (SLPKnown / 8.0 + SLCKnown / 2.0) * todouble({retailPricing:$.monthly.cspm}) * {discountToMultiplyVal}, ServerlessUnpricedInputs = SLPMissing + SLCMissing\r\n| extend CspmBillableUnits = iff(tolower(\"{awsIsDcspm}\") == \"true\", coalesce(todouble(TotalDcspmInSecurityConnector), 0.0) + SLPKnown / 8.0 + SLCKnown / 2.0, 0.0)\r\n| extend DcspmEstimatedPrice = coalesce(todouble(DcspmEstimatedPrice), 0.0) + ServerlessKnownCost\r\n| project-away SLRoot, SLMapReady, SLData, SLEntryValid, SLMappingReady, SLCanonical, SLPAuto, SLCAuto, SLPUnknown, SLCUnknown, SLPAutoValid, SLCAutoValid, SLProtectionSelected, SLContainersSelected, SLPKnown, SLCKnown, SLPMissing, SLCMissing, SLPSource, SLCSource\r\n    | project DefenderCSPM = DcspmEstimatedPrice, Servers = ServersEstimatedPrice, ServerlessUnpricedInputs\r\n    | extend GrandTotal = DefenderCSPM + Servers\r\n    | extend Cloud = \"AWS\"\r\n    | summarize aws_sum_DefenderCSPM = sum(DefenderCSPM), aws_sum_Servers = sum(Servers), aws_sum_GrandTotal = sum(GrandTotal), aws_sum_ServerlessUnpricedInputs = sum(ServerlessUnpricedInputs) by Cloud\r\n| project Cloud,\r\n    ['Unpriced serverless inputs'] = tolong(aws_sum_ServerlessUnpricedInputs),\r\n    ['Defender CSPM'] = todouble(aws_sum_DefenderCSPM),\r\n    ['Defender for ARM'] = real(null),\r\n    ['Defender for API'] = real(null),\r\n    ['Defender for Key Vault'] = real(null),\r\n    ['Servers'] = todouble(aws_sum_Servers),\r\n    ['App Services'] = real(null),\r\n    ['SQL Databases'] = real(null),\r\n    ['OSS DBs'] = real(null),\r\n    ['Storage'] = real(null),\r\n    ['Containers'] = real(null),\r\n    ['Grand total'] = todouble(aws_sum_GrandTotal),\r\n    ['Cloud Environment'] = 'All'\r\n| where isnotempty('{awsPlans}')",
              "size": 1,
