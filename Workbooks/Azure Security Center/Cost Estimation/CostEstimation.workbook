          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "exportParameters": false,
              "items": [
                {
                  "type": 1,
                  "name": "Serverless inventory and known-total guidance",
                  "content": {
                    "style": "info",
                    "json": "**Included in CSPM and known totals.** Azure apps/functions and available running ACI containers are discovered automatically. Inventory is a full-month projection, not a measured monthly average or proof that Defender coverage is enabled. ACA replica counts and AWS Lambda/ECS runtime quantities are not guessed; use the optional numeric forecasts when needed. Each forecast applies separately to every selected Azure subscription or distinct AWS connector scope. Blank is automatic/unknown, not zero. Selected inputs without a reliable quantity stay unpriced and are counted in the visible estimate status. Snapshot: **{serverlessInventory:$.capturedAt}**. Refresh the workbook to refresh discovery. Resource details show up to 1,000 rows; the scope-cost snapshot aggregates the matching inventory before that display limit."
                  }
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\" and tolower(\"{azureIsDcspm}\") == \"true\"\r\n| project Cloud = \"Azure\", ScopeId = tolower(subscriptionId), ScopeName = name, ResourceId = strcat(\"/subscriptions/\", subscriptionId)\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\" and tolower(\"{awsIsDcspm}\") == \"true\"\r\n| project Cloud = \"AWS\", ScopeId = tolower(id), ScopeName = name, ResourceId = id\r\n)\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend SLData = SLRoot.d[ScopeId]\r\n| where Cloud == \"Azure\" or not(coalesce(tolong(SLRoot._ok) == 1 and array_length(SLData) == 5 and tolong(SLData[4]) == 0, false))\r\n| extend Parts = dynamic([\"protection\", \"containers\"])\r\n| mv-expand Parts\r\n| extend Component = tostring(Parts)\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend OverrideText = case(Cloud == \"Azure\" and Component == \"protection\", \"{azureServerlessProtectionAverage:escapejson}\", Cloud == \"Azure\", \"{azureServerlessContainersAverage:escapejson}\", Component == \"protection\", \"{awsServerlessProtectionAverage:escapejson}\", \"{awsServerlessContainersAverage:escapejson}\")\r\n| extend Override = todouble(OverrideText), Provided = isnotempty(OverrideText)\r\n| extend OverrideValid = isfinite(Override) and Override >= 0.0 and Override < 1000000000000.0 and OverrideText matches regex @\"^(0|[1-9][0-9]*)(\\.[0-9]+)?$\"\r\n| extend EntryValid = tolong(SLRoot._ok) == 1 and gettype(SLRoot.d) == \"dictionary\" and iff(Cloud == \"Azure\", isnull(SLData) or array_length(SLData) == 5, isnotnull(SLData) and array_length(SLData) == 5 and tolong(SLData[4]) in (0,1))\r\n| extend AutoQuantity = iff(isnull(SLData), 0.0, iff(Component == \"protection\", todouble(SLData[0]), todouble(SLData[1]))), AutoMissing = iff(isnull(SLData), 0, iff(Component == \"protection\", tolong(SLData[2]), tolong(SLData[3])))\r\n| extend AutoValid = EntryValid and isfinite(AutoQuantity) and AutoQuantity >= 0.0 and isnotnull(AutoMissing) and AutoMissing >= 0\r\n| extend KnownQuantity = iff(Cloud == \"AWS\" and not(EntryValid), 0.0, iff(Provided, iff(OverrideValid, Override, 0.0), iff(Cloud == \"Azure\" and AutoValid, AutoQuantity, 0.0)))\r\n| extend UnpricedInputs = iff(Cloud == \"AWS\" and not(EntryValid), 1, iff(Provided, iff(OverrideValid, 0, 1), iff(Cloud == \"Azure\" and AutoValid, AutoMissing, 1)))\r\n| extend Basis = iff(Cloud == \"AWS\" and not(EntryValid), \"Connector identity snapshot unavailable\", iff(Provided, iff(OverrideValid, \"Per-scope monthly-average forecast\", \"Invalid forecast override\"), iff(Cloud == \"Azure\", \"Current inventory projection\", \"Forecast needed: AWS telemetry unavailable\")))\r\n| extend ResourcesPerUnit = iff(Component == \"protection\", 8.0, 2.0)\r\n| extend BillableUnits = KnownQuantity / ResourcesPerUnit, KnownMonthlyCost = KnownQuantity / ResourcesPerUnit * todouble({retailPricing:$.monthly.cspm}) * {discountToMultiplyVal}\r\n| summarize KnownQuantity = sum(KnownQuantity), BillableUnits = sum(BillableUnits), KnownMonthlyCost = sum(KnownMonthlyCost), UnpricedInputs = sum(UnpricedInputs) by Cloud, Component\r\n| extend Component = iff(Component == \"protection\", \"Serverless protection\", \"Serverless containers\")\r\n| extend Status = iff(UnpricedInputs == 0, \"Known inputs priced; included in totals\", strcat(\"Partial: \", UnpricedInputs, \" unpriced inputs; enter forecasts below\"))\r\n| project Cloud, Component, KnownQuantity, BillableUnits, KnownMonthlyCost = iff(UnpricedInputs > 0 and KnownQuantity == 0.0, real(null), KnownMonthlyCost), Status",
                    "size": 0,
                    "title": "Serverless CSPM portion (included in known totals)",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "crossComponentResources": [
                      "value::tenant"
                    ],
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 4,
                      "filter": false,
                      "formatters": [
                        {
                          "columnMatch": "KnownMonthlyCost",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "is Empty",
                                "representation": "Blank",
                                "text": "Not estimated"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Blank",
                                "text": "{0}"
                              }
                            ]
                          },
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "USD",
                              "style": "currency",
                              "minimumFractionDigits": 2,
                              "maximumFractionDigits": 2
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Cloud",
                          "label": "Cloud"
                        },
                        {
                          "columnId": "Component",
                          "label": "Component"
                        },
                        {
                          "columnId": "KnownQuantity",
                          "label": "Known quantity / forecast"
                        },
                        {
                          "columnId": "BillableUnits",
                          "label": "Known billable units"
                        },
                        {
                          "columnId": "KnownMonthlyCost",
                          "label": "Included monthly cost (USD)"
                        },
                        {
                          "columnId": "Status",
                          "label": "Estimate status"
                        }
                      ]
                    },
                    "noDataMessage": "No selected serverless scopes were found in the readable inventory.",
                    "sortBy": []
                  },
                  "name": "Serverless CSPM summary"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "style": "above",
                    "parameters": [
                      {
                        "id": "b8e3f644-cd25-4054-a29f-7c75cc925086",
                        "version": "KqlParameterItem/1.0",
                        "name": "showServerlessResourceDetails",
                        "label": "Resource details",
                        "type": 10,
                        "isRequired": true,
                        "value": "0",
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "jsonData": "[{\"value\":\"0\",\"label\":\"Hide\",\"selected\":true},{\"value\":\"1\",\"label\":\"Show\"}]"
                      }
                    ]
                  },
                  "name": "Serverless resource detail options"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resources\r\n| where tolower(\"{azureIsDcspm}\") == \"true\" and (tolong(\"{serverlessProtection}\") == 1 or tolong(\"{serverlessContainers}\") == 1)\r\n| where type in~ (\"microsoft.web/sites\", \"microsoft.app/containerapps\", \"microsoft.containerinstance/containergroups\")\r\n| extend ResourceType = tolower(type), ScopeId = tolower(subscriptionId), ResourceId = id, ResourceName = name, ResourceKind = tolower(iff(isnotempty(kind), kind, tostring(properties.kind)))\r\n| extend Component = iff(ResourceType == \"microsoft.web/sites\", \"protection\", \"containers\")\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend IsSite = ResourceType == \"microsoft.web/sites\", IsACI = ResourceType == \"microsoft.containerinstance/containergroups\"\r\n| extend SiteRecognized = IsSite and (ResourceKind has \"functionapp\" or ResourceKind has \"app\") and ResourceKind !has \"workflowapp\"\r\n| extend InventoryContainers = iff(IsACI and isnotnull(properties.containers) and array_length(properties.containers) > 0, properties.containers, dynamic([{}]))\r\n| mv-expand InventoryContainer = InventoryContainers limit 2000\r\n| extend ContainerState = tolower(tostring(InventoryContainer.properties.instanceView.currentState.state))\r\n| extend ResourceState = iff(IsSite, tostring(properties.state), iff(IsACI, ContainerState, tostring(properties.runningStatus)))\r\n| extend KnownQuantity = case(SiteRecognized, 1.0, IsACI and ContainerState == \"running\", 1.0, 0.0)\r\n| extend UnpricedInputs = case(IsSite and not(SiteRecognized), 1, IsACI and isempty(ContainerState), 1, ResourceType == \"microsoft.app/containerapps\", 1, 0)\r\n| extend Workload = case(SiteRecognized and ResourceKind has \"functionapp\", \"Azure Function App\", SiteRecognized, \"Azure Web App\", IsSite, \"Unclassified App Service site\", IsACI, \"ACI container\", \"Azure Container App\")\r\n| extend ResourceName = iff(IsACI and isnotempty(tostring(InventoryContainer.name)), strcat(ResourceName, \" / \", tostring(InventoryContainer.name)), ResourceName)\r\n| project Cloud = \"Azure\", ScopeId, ResourceId, ResourceName, ResourceType, ResourceState, Component, Workload, KnownQuantity, UnpricedInputs\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\"), OverrideText = iff(Component == \"protection\", \"{azureServerlessProtectionAverage:escapejson}\", \"{azureServerlessContainersAverage:escapejson}\")\r\n| where isempty(OverrideText)\r\n| extend ScopeName = ScopeId\r\n| join kind=leftouter (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| project ScopeId = tolower(subscriptionId), SubscriptionName = name\r\n) on ScopeId\r\n| extend ScopeName = iff(isnotempty(SubscriptionName), SubscriptionName, ScopeName)\r\n| extend Quantity = iff(UnpricedInputs > 0, real(null), KnownQuantity), Basis = \"Current resource inventory\"\r\n| extend Status = case(UnpricedInputs > 0 and ResourceType == \"microsoft.app/containerapps\", \"Runtime replica count unavailable; use the per-subscription forecast\", UnpricedInputs > 0, \"Runtime/type information unavailable; use a forecast\", \"Inventory snapshot; not a measured monthly average\")\r\n| project Cloud, ScopeName, ResourceName, Workload, ResourceType, ResourceState, Component, Quantity, Basis, Status, ResourceId\r\n| union (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\" and tolower(\"{azureIsDcspm}\") == \"true\"\r\n| project Cloud = \"Azure\", ScopeId = tolower(subscriptionId), ScopeName = name, ResourceId = strcat(\"/subscriptions/\", subscriptionId)\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\" and tolower(\"{awsIsDcspm}\") == \"true\"\r\n| project Cloud = \"AWS\", ScopeId = tolower(id), ScopeName = name, ResourceId = id\r\n)\r\n| extend SLRoot = parse_json(\"{serverlessInventory:escapejson}\")\r\n| extend SLData = SLRoot.d[ScopeId]\r\n| where Cloud == \"Azure\" or not(coalesce(tolong(SLRoot._ok) == 1 and array_length(SLData) == 5 and tolong(SLData[4]) == 0, false))\r\n| extend Parts = dynamic([\"protection\", \"containers\"])\r\n| mv-expand Parts\r\n| extend Component = tostring(Parts)\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend OverrideText = case(Cloud == \"Azure\" and Component == \"protection\", \"{azureServerlessProtectionAverage:escapejson}\", Cloud == \"Azure\", \"{azureServerlessContainersAverage:escapejson}\", Component == \"protection\", \"{awsServerlessProtectionAverage:escapejson}\", \"{awsServerlessContainersAverage:escapejson}\")\r\n| extend Override = todouble(OverrideText), Provided = isnotempty(OverrideText)\r\n| extend OverrideValid = isfinite(Override) and Override >= 0.0 and Override < 1000000000000.0 and OverrideText matches regex @\"^(0|[1-9][0-9]*)(\\.[0-9]+)?$\"\r\n| extend EntryValid = tolong(SLRoot._ok) == 1 and gettype(SLRoot.d) == \"dictionary\" and iff(Cloud == \"Azure\", isnull(SLData) or array_length(SLData) == 5, isnotnull(SLData) and array_length(SLData) == 5 and tolong(SLData[4]) in (0,1))\r\n| extend AutoQuantity = iff(isnull(SLData), 0.0, iff(Component == \"protection\", todouble(SLData[0]), todouble(SLData[1]))), AutoMissing = iff(isnull(SLData), 0, iff(Component == \"protection\", tolong(SLData[2]), tolong(SLData[3])))\r\n| extend AutoValid = EntryValid and isfinite(AutoQuantity) and AutoQuantity >= 0.0 and isnotnull(AutoMissing) and AutoMissing >= 0\r\n| extend KnownQuantity = iff(Cloud == \"AWS\" and not(EntryValid), 0.0, iff(Provided, iff(OverrideValid, Override, 0.0), iff(Cloud == \"Azure\" and AutoValid, AutoQuantity, 0.0)))\r\n| extend UnpricedInputs = iff(Cloud == \"AWS\" and not(EntryValid), 1, iff(Provided, iff(OverrideValid, 0, 1), iff(Cloud == \"Azure\" and AutoValid, AutoMissing, 1)))\r\n| extend Basis = iff(Cloud == \"AWS\" and not(EntryValid), \"Connector identity snapshot unavailable\", iff(Provided, iff(OverrideValid, \"Per-scope monthly-average forecast\", \"Invalid forecast override\"), iff(Cloud == \"Azure\", \"Current inventory projection\", \"Forecast needed: AWS telemetry unavailable\")))\r\n| extend ResourcesPerUnit = iff(Component == \"protection\", 8.0, 2.0)\r\n| extend BillableUnits = KnownQuantity / ResourcesPerUnit, KnownMonthlyCost = KnownQuantity / ResourcesPerUnit * todouble({retailPricing:$.monthly.cspm}) * {discountToMultiplyVal}\r\n| where Provided or Cloud == \"AWS\"\r\n| extend ResourceName = iff(Provided, \"Per-scope forecast override\", \"Runtime/inventory quantity unavailable\"), ResourceType = iff(Cloud == \"Azure\", \"Azure subscription forecast\", \"AWS connector forecast\"), ResourceState = \"\"\r\n| extend Workload = iff(Component == \"containers\", \"Running containers forecast\", iff(Cloud == \"Azure\", \"Apps/functions forecast\", \"Lambda functions forecast\"))\r\n| extend Quantity = iff(UnpricedInputs > 0, real(null), KnownQuantity), Status = iff(UnpricedInputs == 0, \"Forecast replaces inventory for this scope; included in totals\", \"Refresh the snapshot, enter a valid per-scope average, or exclude\")\r\n| project Cloud, ScopeName, ResourceName, Workload, ResourceType, ResourceState, Component, Quantity, Basis, Status, ResourceId\r\n)\r\n| extend Component = iff(Component == \"protection\", \"Serverless protection\", \"Serverless containers\")\r\n| order by Cloud asc, ScopeName asc, Component asc, ResourceName asc",
                    "size": 0,
                    "title": "Discovered resources and per-scope forecast inputs",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "crossComponentResources": [
                      "value::tenant"
                    ],
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 1000,
                      "filter": true,
                      "formatters": [
                        {
                          "columnMatch": "ResourceId",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "ResourceType",
                          "formatter": 5
                        },
                        {
                          "columnMatch": "Quantity",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "is Empty",
                                "representation": "Blank",
                                "text": "Unavailable"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Blank",
                                "text": "{0}"
                              }
                            ]
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Cloud",
                          "label": "Cloud"
                        },
                        {
                          "columnId": "ScopeName",
                          "label": "Subscription / connector"
                        },
                        {
                          "columnId": "ResourceName",
                          "label": "Resource / forecast"
                        },
                        {
                          "columnId": "Workload",
                          "label": "Workload"
                        },
                        {
                          "columnId": "ResourceType",
                          "label": "Resource type"
                        },
                        {
                          "columnId": "ResourceState",
                          "label": "State"
                        },
                        {
                          "columnId": "Component",
                          "label": "Component"
                        },
                        {
                          "columnId": "Quantity",
                          "label": "Known quantity / average"
                        },
                        {
                          "columnId": "Basis",
                          "label": "Data source"
                        },
                        {
                          "columnId": "Status",
                          "label": "Status"
                        }
                      ]
                    },
                    "noDataMessage": "No matching discovered resources or forecast overrides. Automatic zero means no matching Azure resources in the readable snapshot, not a measured monthly average.",
                    "sortBy": []
                  },
                  "name": "Serverless CSPM resource estimates",
                  "conditionalVisibility": {
                    "parameterName": "showServerlessResourceDetails",
                    "comparison": "isEqualTo",
                    "value": "1"
                  }
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "serverlessComponentsIncluded",
              "comparison": "isEqualTo",
              "value": "1"
            },
            "name": "Optional serverless CSPM estimates"
          }
        ]
      },
      "name": "tenantGroup"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
