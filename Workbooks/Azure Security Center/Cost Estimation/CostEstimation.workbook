                        "resultVal": "1"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "static",
                        "resultVal": "0"
                      }
                    }
                  ]
                },
                {
                  "id": "12b87a59-8745-47f8-aa0c-d56e7bb0428d",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessAzureSelected",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "azureIsDcspm",
                        "operator": "==",
