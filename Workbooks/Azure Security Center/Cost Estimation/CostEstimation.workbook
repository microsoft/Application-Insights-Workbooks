            "name": "parameters - 8 - Copy"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "07d3c894-c589-49cd-aabc-26e6deec02ce",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureServersPlanValTenant",
                  "label": "Azure - Microsoft Defender for Servers",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n { \"value\": 5, \"label\": \"Microsoft Defender for Servers Plan 1\", \"selected\": true},\r\n { \"value\": 15, \"label\": \"Microsoft Defender for Servers Plan 2\"}\r\n]",
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "description": "Choose Microsoft Defender for Servers Plan 1 or Plan 2. The selector keeps stable plan identifiers; the monthly USD price comes from the verified retailPricing snapshot, not from the identifier value."
                },
                {
                  "id": "2fa87d63-01dc-46da-a349-3a7d367f654b",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureServersMonthlyPriceTenant",
