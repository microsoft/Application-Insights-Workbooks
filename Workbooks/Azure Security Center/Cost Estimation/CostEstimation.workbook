              },
              {
                "parameterName": "serverlessAzureSelected",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "Serverless Azure containers forecast"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "2ded188a-7b0e-410e-a9a9-47c0261b5d9a",
                  "version": "KqlParameterItem/1.0",
                  "name": "awsServerlessProtectionAverage",
                  "label": "AWS Lambda functions per AWS scope (optional forecast)",
                  "type": 1,
                  "value": "",
                  "description": "Leave blank to use available inventory, or retain an explicit unpriced status when telemetry is unavailable. A supplied monthly-average quantity replaces discovery separately for every selected distinct AWS connector scope; it is not a cloud-wide aggregate. Use 0 only for confirmed absence. AWS scopes with the same connector hierarchy identifier are deduplicated for serverless costs. Values must be nonnegative and below 1,000,000,000,000.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]+)?)$",
                        "match": true,
                        "message": "Enter a nonnegative quantity below 1,000,000,000,000, or leave blank for discovery."
                      }
                    ]
                  }
                }
              ],
              "style": "above"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "serverlessProtection",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "serverlessAwsSelected",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "Serverless AWS protection forecast"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "acae902c-2f2f-4f8a-aa39-f35c20703821",
                  "version": "KqlParameterItem/1.0",
                  "name": "awsServerlessContainersAverage",
                  "label": "AWS running containers per AWS scope (optional forecast)",
                  "type": 1,
                  "value": "",
                  "description": "Leave blank to use available inventory, or retain an explicit unpriced status when telemetry is unavailable. A supplied monthly-average quantity replaces discovery separately for every selected distinct AWS connector scope; it is not a cloud-wide aggregate. Use 0 only for confirmed absence. AWS scopes with the same connector hierarchy identifier are deduplicated for serverless costs. Values must be nonnegative and below 1,000,000,000,000.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]+)?)$",
                        "match": true,
                        "message": "Enter a nonnegative quantity below 1,000,000,000,000, or leave blank for discovery."
                      }
                    ]
                  }
                }
              ],
              "style": "above"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "serverlessContainers",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "serverlessAwsSelected",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "Serverless AWS containers forecast"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "parameters": [
                {
                  "id": "30438732-a27d-4ef1-ac6c-97dcfc326c6d",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessInventory",
                  "type": 1,
                  "isRequired": true,
                  "isHiddenWhenLocked": true,
                  "query": "resources\r\n| where tolower(\"{azureIsDcspm}\") == \"true\" and (tolong(\"{serverlessProtection}\") == 1 or tolong(\"{serverlessContainers}\") == 1)\r\n| where type in~ (\"microsoft.web/sites\", \"microsoft.app/containerapps\", \"microsoft.containerinstance/containergroups\")\r\n| extend ResourceType = tolower(type), ScopeId = tolower(subscriptionId), ResourceId = id, ResourceName = name, ResourceKind = tolower(iff(isnotempty(kind), kind, tostring(properties.kind)))\r\n| extend Component = iff(ResourceType == \"microsoft.web/sites\", \"protection\", \"containers\")\r\n| where (Component == \"protection\" and tolong(\"{serverlessProtection}\") == 1) or (Component == \"containers\" and tolong(\"{serverlessContainers}\") == 1)\r\n| extend IsSite = ResourceType == \"microsoft.web/sites\", IsACI = ResourceType == \"microsoft.containerinstance/containergroups\"\r\n| extend SiteRecognized = IsSite and (ResourceKind has \"functionapp\" or ResourceKind has \"app\") and ResourceKind !has \"workflowapp\"\r\n| extend InventoryContainers = iff(IsACI and isnotnull(properties.containers) and array_length(properties.containers) > 0, properties.containers, dynamic([{}]))\r\n| mv-expand InventoryContainer = InventoryContainers limit 2000\r\n| extend ContainerState = tolower(tostring(InventoryContainer.properties.instanceView.currentState.state))\r\n| extend ResourceState = iff(IsSite, tostring(properties.state), iff(IsACI, ContainerState, tostring(properties.runningStatus)))\r\n| extend KnownQuantity = case(SiteRecognized, 1.0, IsACI and ContainerState == \"running\", 1.0, 0.0)\r\n| extend UnpricedInputs = case(IsSite and not(SiteRecognized), 1, IsACI and isempty(ContainerState), 1, ResourceType == \"microsoft.app/containerapps\", 1, 0)\r\n| extend Workload = case(SiteRecognized and ResourceKind has \"functionapp\", \"Azure Function App\", SiteRecognized, \"Azure Web App\", IsSite, \"Unclassified App Service site\", IsACI, \"ACI container\", \"Azure Container App\")\r\n| extend ResourceName = iff(IsACI and isnotempty(tostring(InventoryContainer.name)), strcat(ResourceName, \" / \", tostring(InventoryContainer.name)), ResourceName)\r\n| project Cloud = \"Azure\", ScopeId, ResourceId, ResourceName, ResourceType, ResourceState, Component, Workload, KnownQuantity, UnpricedInputs\r\n| extend ScopeKey = ScopeId\r\n| union (\r\nresources\r\n| where type =~ \"microsoft.security/securityconnectors\" and tostring(properties.environmentName) =~ \"aws\"\r\n| where tolower(\"{awsIsDcspm}\") == \"true\" and (tolong(\"{serverlessProtection}\") == 1 or tolong(\"{serverlessContainers}\") == 1)\r\n| where tolower('{AWSSecurityConnectors}') has tolower(id)\r\n| extend ScopeId = tolower(id), ScopeKey = tolower(iff(isnotempty(tostring(properties.hierarchyIdentifier)), tostring(properties.hierarchyIdentifier), id))\r\n| project Cloud = \"AWS\", ScopeId, ScopeKey, Component = \"scope\", KnownQuantity = 0.0, UnpricedInputs = 0\r\n)\r\n| summarize Protection = sumif(KnownQuantity, Component == \"protection\"), Containers = sumif(KnownQuantity, Component == \"containers\"), ProtectionMissing = sumif(UnpricedInputs, Component == \"protection\"), ContainersMissing = sumif(UnpricedInputs, Component == \"containers\"), ScopeIds = make_set(ScopeId), CanonicalId = min(ScopeId) by Cloud, ScopeKey\r\n| extend ScopeIds = array_concat(pack_array(CanonicalId), ScopeIds)\r\n| mv-expand ScopeId = ScopeIds limit 2000\r\n| extend ScopeId = tostring(ScopeId)\r\n| extend Entry = bag_pack(ScopeId, pack_array(Protection, Containers, ProtectionMissing, ContainersMissing, iff(ScopeId == CanonicalId, 1, 0)))\r\n| summarize Data = make_bag(Entry)\r\n| project value = tostring(bag_pack(\"_ok\", 1, \"capturedAt\", tostring(now()), \"d\", Data))",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "description": "Automatically queried Resource Graph snapshot, not user-entered JSON. Compact scope arrays contain app/function inventory, known running ACI containers, unpriced protection/container inputs, and a canonical AWS-scope marker. ACA replica counts and AWS Lambda/ECS runtime inventory are not fabricated. Resource inventory is a full-month projection, not an observed monthly average."
                }
              ]
            },
            "name": "Serverless inventory snapshot"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\r\n        | extend selectedPlans = tolower('{azurePlans}')\r\n        | extend type = tolower(type) \r\n        | where selectedPlans has type \r\n    | extend managedClustersCount = iff(type == \"microsoft.containerservice/managedclusters\" and isnotempty(sku) and tolower(sku.tier) != \"consumption\", toint(properties.numberOfWorkers), 0)\r\n    | where tostring(properties.powerState.code) =~ 'Running'\r\n    | mv-expand properties.agentPoolProfiles\r\n    | extend sku = tostring(properties_agentPoolProfiles.vmSize)\r\n    | parse kind=regex sku with '(.*?)_([A-Za-z]*)' coresInSku: int '([A-Za-z]*)_(.*?)'\r\n    | project subscriptionId, resourceGroup, managedClustersCount = toint(properties_agentPoolProfiles['count']) * coresInSku//, sku\r\n    | summarize sum(managedClustersCount) by subscriptionId, resourceGroup//, tostring(tags[\"provider\"])\r\n    | extend sum_appServiceCount = 0, sum_serversCount = 0, sum_storageAccountCount = 0, sum_ossDatabaseCount = 0, sum_cosmosDbCount = 0, sum_sqlServersCount = 0, sum_containerRegistryCount = 0\r\n    | where sum_managedClustersCount > 0\r\n    | extend Dummy = 1 \r\n| join  kind=inner \r\n    ( \r\n    resources\r\n        | extend selectedPlans = tolower('{azurePlans}')\r\n        | extend type = tolower(type) \r\n        | where selectedPlans has type \r\n    | extend managedClustersCount = iff(type == \"microsoft.containerservice/managedclusters\" and isnotempty(sku) and tolower(sku.tier) != \"consumption\", toint(properties.numberOfWorkers), 0)\r\n    | where tostring(properties.powerState.code) =~ 'Running'\r\n    | mv-expand properties.agentPoolProfiles\r\n    | extend sku = tostring(properties_agentPoolProfiles.vmSize)\r\n    | parse kind=regex sku with '(.*?)_([A-Za-z]*)' coresInSku: int '([A-Za-z]*)_(.*?)'\r\n    | project subscriptionId, resourceGroup, managedClustersCountTotal = toint(properties_agentPoolProfiles['count']) * coresInSku, sku\r\n    | summarize sum(managedClustersCountTotal) by subscriptionId\r\n    | extend sum_appServiceCountTotal = 0, sum_serversCountTotal = 0, sum_storageAccountCountTotal = 0, sum_ossDatabaseCountTotal = 0, sum_cosmosDbCountTotal = 0, sum_sqlServersCountTotal = 0, sum_containerRegistryTotal = 0\r\n    | where sum_managedClustersCountTotal > 0\r\n    | extend Dummy = 1\r\n    ) on  subscriptionId\r\n| union \r\n(\r\n    resources\r\n        | extend selectedPlans = tolower('{azurePlans}')\r\n        | extend serverAndContainersEnabled = selectedPlans has \"microsoft.compute/virtualmachines\" and selectedPlans has \"microsoft.containerservice/managedclusters\"\r\n        | extend type = tolower(type) \r\n        | where selectedPlans has type \r\n        | extend appServiceCount = iff(type == \"microsoft.web/serverfarms\" and isnotempty(sku) and tolower(sku.tier) != \"consumption\", toint(properties.numberOfWorkers), 0)\r\n        | extend vmCount = iff(type in (\"microsoft.compute/virtualmachines\",\"microsoft.hybridcompute/machines\", \"microsoft.classiccompute/virtualmachines\") and (not(serverAndContainersEnabled) or name !startswith(\"aks-\")), 1 , 0)\r\n        | extend vmCountForCspm = iff(type in (\"microsoft.compute/virtualmachines\",\"microsoft.classiccompute/virtualmachines\"), 1 , 0)\r\n        | extend vmssCount = iff(type == \"microsoft.compute/virtualmachinescalesets\" and (not(serverAndContainersEnabled) or name !startswith(\"aks-\")) and sku != \"\" and sku.capacity != \"\", toint(sku.capacity), 0)\r\n        | extend vmssCountForCspm = iff(type == \"microsoft.compute/virtualmachinescalesets\" and sku != \"\" and sku.capacity != \"\", toint(sku.capacity), 0)\r\n        | extend serversCount = vmCount + vmssCount\r\n        | extend storageAccountCount = iff(type == \"microsoft.storage/storageaccounts\", 1 , 0)\r\n        | extend ossDatabaseCount = iff(type in(\"microsoft.dbforpostgresql/servers\", \"microsoft.dbformysql/servers\", \"microsoft.dbformariadb/servers\", \"microsoft.dbfor