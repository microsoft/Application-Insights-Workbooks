                    "comparison": "isNotEqualTo"
                  }
                },
                {
                  "type": 3,
                  "name": "Defender for APIs subscription costs",
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "Defender for API - included subscription base fees",
                    "query": "resources\r\n| where type =~ \"microsoft.apimanagement/service\"\r\n| where tolong(\"{includeDefenderApis}\") == 1 and tolong(\"{AzureAPISubPlans}\") == 1\r\n| summarize ApiManagementServices = count() by Subscription = tolower(subscriptionId)\r\n| join kind=leftouter (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| project Subscription = tolower(subscriptionId), SubscriptionName = name\r\n) on Subscription\r\n| extend SubscriptionName = iff(isnotempty(SubscriptionName), SubscriptionName, Subscription)\r\n| extend Plan = case(tostring(\"{azureAPIPlanVal}\") == \"200\", \"Plan 1\", tostring(\"{azureAPIPlanVal}\") == \"700\", \"Plan 2\", tostring(\"{azureAPIPlanVal}\") == \"5000\", \"Plan 3\", tostring(\"{azureAPIPlanVal}\") == \"7000\", \"Plan 4\", tostring(\"{azureAPIPlanVal}\") == \"50000\", \"Plan 5\", \"Unresolved plan\"), Entitlement = \"{apiPlanEntitlement} requests/month\", MonthlyCost = todouble(\"{azureAPIMonthlyPrice}\") * {discountToMultiplyVal}\r\n| project SubscriptionName, ApiManagementServices, Plan, Entitlement, MonthlyCost",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscriptions}"
                    ],
                    "size": 0,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "MonthlyCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "aggregation": "Sum"
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "SubscriptionName",
                          "label": "Subscription"
                        },
                        {
                          "columnId": "ApiManagementServices",
                          "label": "API Management services"
                        },
                        {
                          "columnId": "Plan",
                          "label": "Selected plan"
                        },
                        {
                          "columnId": "Entitlement",
                          "label": "Requests/month entitlement"
                        },
                        {
                          "columnId": "MonthlyCost",
                          "label": "Monthly cost (USD)"
                        }
                      ]
                    },
                    "noDataMessage": "No API Management services discovered in the selected readable scope. Missing inventory or metrics is not proof of zero usage."
                  }
                },
                {
                  "type": 9,
                  "name": "Defender for API planning usage",
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "style": "above",
                    "parameters": [
                      {
                        "id": "4bdc4baa-f404-4ec0-904c-d55a5727e489",
                        "version": "KqlParameterItem/1.0",
                        "name": "apiPlanningRequests",
                        "label": "Subscription requests (last 30 days)",
                        "type": 1,
                        "value": "",
                        "isRequired": false,
                        "description": "Copy one complete subscription subtotal from the live table above, as whole digits without commas. Leave blank for unavailable usage. Confirm all APIM service metrics are present. Used only in the planning comparison; not added to overall totals."
                      }
                    ]
                  }
                },
                {
                  "type": 3,
                  "name": "Defender for API plan comparison",
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "Defender for API - recommended plan and estimated charges (entered usage)",
                    "query": "resourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| summarize Anchor = count()\r\n| extend RequestsText = \"{apiPlanningRequests:escapejson}\"\r\n| extend Requests = todouble(RequestsText)\r\n| where RequestsText matches regex @\"^[0-9]+$\" and isnotnull(Requests) and Requests >= 0.0 and Requests <= 9007199254740991.0\r\n| extend Cost1 = (todouble({retailPricing:$.monthly.apisP1}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p1}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p1})) * {discountToMultiplyVal}, Cost2 = (todouble({retailPricing:$.monthly.apisP2}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p2}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p2})) * {discountToMultiplyVal}, Cost3 = (todouble({retailPricing:$.monthly.apisP3}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p3}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p3})) * {discountToMultiplyVal}, Cost4 = (todouble({retailPricing:$.monthly.apisP4}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p4}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p4})) * {discountToMultiplyVal}, Cost5 = (todouble({retailPricing:$.monthly.apisP5}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p5}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p5})) * {discountToMultiplyVal}\r\n| extend MinimumCost = min_of(Cost1, Cost2, Cost3, Cost4, Cost5)\r\n| extend RecommendedPlan = case(Cost1 == MinimumCost, \"Plan 1\", Cost2 == MinimumCost, \"Plan 2\", Cost3 == MinimumCost, \"Plan 3\", Cost4 == MinimumCost, \"Plan 4\", \"Plan 5\")\r\n| extend Plans = dynamic([{\"Plan\":\"Plan 1\",\"Selector\":\"200\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p1},\"BaseFee\":{retailPricing:$.monthly.apisP1},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p1}},{\"Plan\":\"Plan 2\",\"Selector\":\"700\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p2},\"BaseFee\":{retailPricing:$.monthly.apisP2},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p2}},{\"Plan\":\"Plan 3\",\"Selector\":\"5000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p3},\"BaseFee\":{retailPricing:$.monthly.apisP3},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p3}},{\"Plan\":\"Plan 4\",\"Selector\":\"7000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p4},\"BaseFee\":{retailPricing:$.monthly.apisP4},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p4}},{\"Plan\":\"Plan 5\",\"Selector\":\"50000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p5},\"BaseFee\":{retailPricing:$.monthly.apisP5},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p5}}])\r\n| mv-expand PlanData = Plans\r\n| extend Plan = tostring(PlanData.Plan), Selector = tostring(PlanData.Selector), Entitlement = tolong(PlanData.Entitlement), BaseFee = todouble(PlanData.BaseFee), OverageRate = todouble(PlanData.OverageRate)\r\n| extend OverageRequests = max_of(Requests - Entitlement, 0.0)\r\n| extend BaseCost = BaseFee * {discountToMultiplyVal}, OverageCost = OverageRequests * OverageRate * {discountToMultiplyVal}\r\n| extend MonthlyCost = BaseCost + OverageCost, Selected = iff(Selector == \"{azureAPIPlanValWhatIf}\", \"Selected\", \"\")\r\n| extend Recommendation = iff(Plan == RecommendedPlan, \"Recommended\", \"\")\r\n| project Requests, Plan, Selected, Recommendation, Entitlement, OverageRate, BaseCost, OverageRequests, OverageCost, MonthlyCost\r\n| order by MonthlyCost asc, Entitlement asc",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscriptions}"
                    ],
                    "size": 0,
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "BaseCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "28ch"
                          }
                        },
                        {
                          "columnMatch": "OverageCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "38ch"
                          }
                        },
                        {
                          "columnMatch": "MonthlyCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "28ch"
                          }
                        },
                        {
                          "columnMatch": "OverageRate",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "minimumFractionDigits": 5,
                              "maximumFractionDigits": 5
                            }
                          }
                        },
                        {
                          "columnMatch": "Requests",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        },
                        {
                          "columnMatch": "Entitlement",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        },
                        {
                          "columnMatch": "OverageRequests",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Requests",
                          "label": "Requests (30 days, entered)"
                        },
                        {
                          "columnId": "Plan",
                          "label": "Plan"
                        },
                        {
                          "columnId": "Selected",
                          "label": "What-if selection"
                        },
                        {
                          "columnId": "Recommendation",
                          "label": "Recommended plan"
                        },
                        {
                          "columnId": "Entitlement",
                          "label": "Requests/month entitlement"
                        },
                        {
                          "columnId": "OverageRate",
                          "label": "Overage rate (USD/request)"
                        },
                        {
                          "columnId": "BaseCost",
                          "label": "Base charge (USD)"
                        },
                        {
                          "columnId": "OverageRequests",
                          "label": "Estimated overage requests"
                        },
                        {
                          "columnId": "OverageCost",
                          "label": "Estimated overage charge (USD)"
                        },
                        {
                          "columnId": "MonthlyCost",
                          "label": "Monthly cost (USD)"
                        }
                      ]
                    },
                    "noDataMessage": "Enter a complete subscription request total as whole digits (no commas). Blank, negative, fractional, or invalid usage has no recommendation; missing metrics are not zero."
                  }
                }
              ]
            }
          }
        ]
      },
      "name": "subscriptionGroup"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "7e75b4e4-c8c8-4800-98da-edef70c49ccb",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureTenantPlans",
                  "label": "Azure - Microsoft Defender for Cloud plans",
                  "type": 2,
                  "description": "Please select one or several Azure plans to allow the workbook to calculate Defender for Cloud cost.",
                  "multiSelect": true,
                  "quote": "",
                  "delimiter": ",",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n{ \"value\": \"microsoft.compute/virtualmachines, microsoft.compute/virtualmachinescalesets, microsoft.hybridcompute/machines, microsoft.classiccompute/virtualmachines\", \"label\": \"Microsoft Defender for Servers\"},\r\n { \"value\": \"microsoft.web/serverfarms\", \"label\": \"Microsoft Defender for App Service\"},\r\n { \"value\": \"microsoft.sql/servers, microsoft.sql/managedinstances\", \"label\": \"Microsoft Defender for SQL on Azure-connected databases\"},\r\n {\"value\": \"microsoft.dbforpostgresql/servers, microsoft.dbforpostgresql/flexibleservers, microsoft.dbformysql/servers, microsoft.dbformysql/flexibleservers, microsoft.dbformariadb/servers\", \"label\": \"Microsoft Defender for MySQL / Microsoft Defender for PostgreSQL\"},\r\n { \"value\": \"microsoft.containerservice/managedclusters\", \"label\": \"Microsoft Defender for Containers\"},\r\n { \"value\": \"microsoft.storage/storageaccounts - storageenabled\", \"label\": \"Microsoft Defender for Storage\"},\r\n { \"value\": \"microsoft.compute/virtualmachines, microsoft.classiccompute/virtualmachines, microsoft.compute/virtualmachinescalesets, microsoft.sql/servers, microsoft.hybridcompute/machines, microsoft.dbforpostgresql/servers, microsoft.dbformysql/servers, microsoft.dbforpostgresql/flexibleservers, microsoft.dbformysql/flexibleservers, microsoft.sql/managedinstances, microsoft.dbformariadb/servers, Microsoft.synapse/workspaces, microsoft.storage/storageaccounts\", \"label\": \"Microsoft Defender CSPM\"},\r\n {\"value\": \"microsoft.resources/subscriptions\", \"label\": \"Microsoft Defender for Resource Manager\"},\r\n {\"value\": \"microsoft.keyvault/vaults\", \"label\": \"Microsoft Defender for Key Vault\"},\r\n {\"value\": \"microsoft.apimanagement/service\", \"label\": \"Microsoft Defender for APIs\"}\r\n]",
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "value": [
                    "value::all"
                  ]
                },
                {
                  "version": "KqlParameterItem/1.0",
                  "name": "awsTenantPlans",
                  "label": "AWS - Microsoft Defender for Cloud plans",
                  "type": 2,
                  "description": "Please select one or several AWS plans to allow the workbook to calculate Defender for Cloud cost.",
                  "multiSelect": true,
                  "quote": "",
                  "delimiter": ",",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n{ \"value\": \"Microsoft.Security/securityConnectors/EC2instance\", \"label\": \"Microsoft Defender for Servers\"},\r\n  { \"value\": \"Microsoft.Security/securityConnectors/EC2instance, Microsoft.Security/securityConnectors/S3Bucket, Microsoft.Security/securityConnectors/RDSdb\", \"label\": \"Microsoft Defender CSPM\"}\r\n]",
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "value": [
                    "value::all"
                  ],
                  "id": "9d6c24c8-eadf-4db7-bb4d-0fcee9fb99ee"
                },
                {
                  "id": "eb8783f4-3610-4da2-8410-0f8847175a12",
                  "version": "KqlParameterItem/1.0",
                  "name": "gcpTenantPlans",
                  "label": "GCP - Microsoft Defender for Cloud plans",
                  "type": 2,
                  "description": "Please select one or several GCP plans to allow the workbook to calculate Defender for Cloud cost.",
                  "multiSelect": true,
                  "quote": "",
                  "delimiter": ",",
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n    { \"value\": \"microsoft.security/securityconnectors/computeinstances\", \"label\": \"Microsoft Defender for Servers\"},\r\n  { \"value\": \"microsoft.security/securityconnectors/computeinstances, microsoft.security/securityconnectors/storagebuckets, microsoft.security/securityconnectors/sqladmininstances\", \"label\": \"Microsoft Defender CSPM\"}\r\n]\r\n",
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "value": [
                    "value::all"
                  ]
                },
                {
                  "id": "56dd02c1-e73c-4fc4-a480-1d93165297f8",
                  "version": "KqlParameterItem/1.0",
                  "name": "tenantInfo",
                  "label": "Additional information",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n { \"value\": 1, \"label\": \"On\", \"selected\": true},\r\n { \"value\": 0, \"label\": \"Off\"}\r\n]"
                },
                {
                  "id": "70a8a248-e441-4601-a0cc-2484930eda44",
                  "version": "KqlParameterItem/1.0",
                  "name": "tenantInfoRes",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "expression",
                        "resultVal": "{tenantInfo}"
                      }
                    }
                  ]
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibility": {
              "parameterName": "istenantlevel",
              "comparison": "isEqualTo",
              "value": "1"
            },
            "name": "Plan Picker"
          },
          {
            "type": 1,
            "content": {
              "json": "* ###### The costs displayed are estimated and might be different from the actual costs seen in the invoice.  \r\n\r\n* ###### The estimated costs displayed are monthly estimated costs per subscription and/or AWS account and/or GCP project based on currently active resources.\r\n\r\n* ###### To estimate the costs for a subscription and/or AWS account and/or GCP project, you need Azure RBAC Reader access to each included subscription. Microsoft Entra Global Administrator does not automatically grant Azure subscription access; only resources in your readable scope can be estimated. \r\n\r\n* ###### This workbook displays the cost for Defender for Storage in Azure based on a per-storage account calculation, but accounts with an exceptionally high transaction volume incur an overage charge that won’t be seen in this workbook. For more information on Defender for Storage cost estimation calculations, please visit our [GitHub page](https://github.com/Azure/Microsoft-Defender-for-Cloud/tree/main/Workbooks/Microsoft%20Defender%20for%20Storage%20Price%20Estimation).\r\n\r\n* ###### Defender for Cosmos DB plan in Azure currently can’t be estimated, we are working to include it in the future.\r\n\r\n* ###### The cost estimation is based on the retail prices of Defender plans; Learn more about [Defender plans’ retail price](https://azure.microsoft.com/pricing/details/defender-for-cloud/).\r\n\r\n* ###### Microsoft Defender CSPM protects across all your multicloud workloads, with base billing for Servers, Databases and Storages at ${retailPricing:$.monthly.cspm}/billable resource/month. Please visit [Defender CSPM documentation page](https://learn.microsoft.com/en-us/azure/defender-for-cloud/concept-cloud-security-posture-management) for more information.\r\n\r\n* ###### **Serverless protection:** Include shows the total known app/function quantity. Monthly cost is quantity multiplied by the per-app/function monthly rate (${retailPricing:$.monthly.cspm} / 8), with the selected discount applied once, and is included in scope, cloud, and overall known totals. Azure app inventory is discovered automatically. AWS Lambda inventory is unavailable in this feed and remains unpriced.\r\n\r\n* ###### **Serverless containers:** Include shows the total known running-container quantity. Monthly cost is quantity multiplied by the per-container monthly rate (${retailPricing:$.monthly.cspm} / 2), with the selected discount applied once, and is included in scope, cloud, and overall known totals. Available ACI runtime states are read automatically; ACA/ECS replica quantities are not guessed. Unavailable quantities stay unpriced, not treated as a complete zero.\r\n\r\n* ###### Defender CSPM plan in GCP cost estimation counts all storage buckets, although in reality only buckets from class ‘standard’ will be charged. In addition, the charge for this plan will apply only for buckets from the following regions: \r\n###### europe-west1, us-east1, us-west1, us-central1, us-east4, asia-south1, northamerica-northeast1.\r\n\r\n* ###### Defender CSPM plan in GCP cost estimation may not count all Google Instance Group instances, although they are going to be charged as well.\r\n\r\n* ###### Defender for APIs uses one selected entitlement plan per subscription. The full selected monthly base fee is estimated once for each included subscription, before the manual discount; API Management service count, API count, and lower traffic do not prorate it or blend multiple plans. Traffic above the selected entitlement incurs separate overages, not an automatic plan upgrade. The Defender for APIs section below retrieves the last 30 days of APIM Requests for plan review. This rolling total includes all APIM traffic, not only Defender-monitored calls, and is not calendar-month billing. Overages are excluded from overall totals; the lower planning comparison shows estimated charges separately, so the displayed base fee is not a complete bill when an entitlement is exceeded. [Plan and overage guidance](https://learn.microsoft.com/en-us/azure/defender-for-cloud/defender-for-apis-deploy#enable-the-defender-for-apis-plan). For traffic-based estimation, see the [Defender APIs Cost Estimator](https://github.com/Azure/Microsoft-Defender-for-Cloud/tree/main/Powershell%20scripts/Defender%20APIs%20Cost%20Estimator).\r\n\r\n* ###### AWS account and GCP project rows are keyed by Azure security-connector resource IDs, not native AWS account numbers or GCP project IDs. The subscription segment identifies the Azure hosting scope.\r\n\r\n* ###### Exported count columns are quantities, not costs. `ContainersInRg` is Kubernetes VM vCores, not serverless containers. Original count fields remain base-inventory counts; `CspmBillableUnits` includes known selected serverless units. Resource snapshots are full-month projections, not measured monthly averages. CSPM retains its own count under the existing AKS exclusion logic.\r\n\r\n* ###### Resource quantity shows whole-resource discovery counts. Equivalent billable quantity applies the pricing ratios: eight apps/functions or two running containers equal one billable resource. It can be fractional without representing a fractional physical resource; it is not rounded up. Monthly cost is equivalent billable quantity multiplied by the CSPM monthly rate, with the selected discount applied once. A partial estimate elsewhere means some inputs are unavailable.",
              "style": "info"
            },
            "customWidth": "50",
            "conditionalVisibilities": [
              {
                "parameterName": "istenantlevel",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "tenantInfoRes",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "text - 6 - Copy"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
