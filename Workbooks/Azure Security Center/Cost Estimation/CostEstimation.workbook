                    "columnId": "SqlServersEstimatedPrice",
                    "label": "Microsoft Defender for SQL on Azure-connected databases"
                  },
                  {
                    "columnId": "OpenSourceRelationalDatabasesEstimatedPrice",
                    "label": "Microsoft Defender for MySQL / Microsoft Defender for PostgreSQL"
                  },
                  {
                    "columnId": "StorageAccountsEstimatedPrice",
                    "label": "Microsoft Defender for Storage"
                  },
                  {
                    "columnId": "ContainersEstimatedPrice",
                    "label": "Microsoft Defender for Containers"
