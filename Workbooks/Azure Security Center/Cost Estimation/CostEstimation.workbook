          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "88e0729a-c83e-43a8-959b-8f347326da42",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureAPIPlanValTenant",
                  "label": "Azure - Microsoft Defender for APIs",
                  "type": 2,
                  "description": "Defaults to Plan 1. Manually choose one entitlement plan: Plan 1/2/3/4/5 include up to 1 million/5 million/50 million/100 million/1 billion API calls per subscription/month. For each subscription included in the APIs estimate, the full selected monthly base fee applies once before Discount %. Lower traffic or fewer APIs do not prorate the fee, blend plans, or automatically change the selected plan. Usage above its entitlement incurs separate overages, which this workbook does not estimate because it does not retrieve monthly API traffic. Decimal USD precision is not a fractional plan. Stable selector identifiers resolve one full monthly fee from the verified pricing snapshot.",
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n { \"value\": 200, \"label\": \"Microsoft Defender for APIs Plan 1\", \"selected\": true},\r\n { \"value\": 700, \"label\": \"Microsoft Defender for APIs Plan 2\"},\r\n  { \"value\": 5000, \"label\": \"Microsoft Defender for APIs Plan 3\"},\r\n   { \"value\": 7000, \"label\": \"Microsoft Defender for APIs Plan 4\"},\r\n    { \"value\": 50000, \"label\": \"Microsoft Defender for APIs Plan 5\"}\r\n\r\n\r\n]",
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "value": "200"
                },
                {
                  "id": "e1951e50-8b5a-4b67-8ee8-27fd737e719f",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureAPIMonthlyPriceTenant",
                  "label": "azureAPIMonthlyPriceTenant",
                  "type": 1,
                  "isRequired": true,
                  "isHiddenWhenLocked": true,
                  "description": "Resolves exactly one selected API plan to its full monthly USD base fee. There is no usage proration or interpolation between plans. Currency precision and the manual discount do not represent partial entitlement buckets. A missing or invalid mapping leaves this required parameter unresolved rather than estimating zero.",
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "azureAPIPlanValTenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "200",
                        "resultValType": "static",
                        "resultVal": "{retailPricing:$.monthly.apisP1}"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "azureAPIPlanValTenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "700",
                        "resultValType": "static",
                        "resultVal": "{retailPricing:$.monthly.apisP2}"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "azureAPIPlanValTenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "5000",
                        "resultValType": "static",
                        "resultVal": "{retailPricing:$.monthly.apisP3}"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "azureAPIPlanValTenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "7000",
                        "resultValType": "static",
                        "resultVal": "{retailPricing:$.monthly.apisP4}"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "azureAPIPlanValTenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "50000",
                        "resultValType": "static",
                        "resultVal": "{retailPricing:$.monthly.apisP5}"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "static",
                        "resultVal": ""
                      }
                    }
                  ]
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "AzureAPISubPlans",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "istenantlevel",
                "comparison": "isEqualTo",
                "value": "1"
              }
            ],
            "name": "azureapiplanstenant"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "64c47fa1-a0f1-4215-a0ee-eb31d8b16957",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessProtection",
                  "label": "Serverless protection",
                  "type": 10,
                  "isRequired": true,
                  "value": "0",
                  "description": "Include known Azure Function App/Web App inventory and optional AWS Lambda forecasts in Microsoft Defender CSPM and known-total estimates. Azure discovery is a current-resource full-month projection; optional numeric averages replace it per selected scope. AWS quantities without reliable inventory require a forecast and otherwise stay explicitly unpriced. This switch does not enable Defender CSPM or Serverless protection in Azure/AWS.",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"0\",\"label\":\"Exclude\",\"selected\":true},{\"value\":\"1\",\"label\":\"Include in estimate\"}]"
                },
                {
                  "id": "0c5e49ac-2131-4d8a-bc9a-3ef68762379d",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessContainers",
                  "label": "Serverless containers",
                  "type": 10,
                  "isRequired": true,
                  "value": "0",
                  "description": "Include known running ACI containers and per-scope runtime forecasts in Microsoft Defender CSPM and known totals at two running containers per billable unit. ACA replicas and ECS/Fargate runtime quantities are not inferred from app counts, configured min/max replicas, tasks, or VM vCores. Missing quantities remain unpriced until a numeric forecast is supplied. This switch does not configure cloud plans or Registry access.",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"0\",\"label\":\"Exclude\",\"selected\":true},{\"value\":\"1\",\"label\":\"Include in estimate\"}]"
                }
              ],
              "style": "above"
            },
            "conditionalVisibility": {
              "parameterName": "istenantlevel",
              "comparison": "isEqualTo",
              "value": "1"
            },
            "name": "CSPM serverless controls"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "f22bdfd2-d810-4e16-8373-c18681beb1a1",
                  "version": "KqlParameterItem/1.0",
                  "name": "discountVal",
                  "label": "Discount %",
                  "type": 1,
                  "description": "Optional manual planning discount on retail prices. Defaults to 0%; negotiated rates vary by plan and billing agreement, so no tenant-wide or subscription-wide percentage is inferred. Enter a known whole-number percentage from 0 to 100. Clearing this field also uses 0%.",
                  "typeSettings": {
                    "paramValidationRules": [
                      {
                        "regExp": "^(|[0-9]|([1-9][0-9])|100)$",
                        "match": true,
                        "message": "Value not between 0 and 100"
                      }
                    ]
                  },
                  "value": "0"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibility": {
              "parameterName": "istenantlevel",
              "comparison": "isEqualTo",
              "value": "1"
            },
            "name": "discounttenant"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "da6b30ac-399e-4746-84fd-819ad297f8f4",
                  "version": "KqlParameterItem/1.0",
                  "name": "discountToMultiplyVal",
                  "type": 1,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "is Empty",
                        "rightValType": "static",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "0",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "100",
                        "resultValType": "static",
                        "resultVal": "0.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "discountVal",
                        "operator": "isNotNull",
                        "rightValType": "param",
                        "resultValType": "expression",
                        "resultVal": "(100-{discountVal})/100.0"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "static",
                        "resultVal": "1.0"
                      }
                    }
                  ]
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "conditionalVisibilities": [
              {
                "parameterName": "istenantlevel",
                "comparison": "isEqualTo",
                "value": "1"
              },
              {
                "parameterName": "x",
                "comparison": "isNotEqualTo"
              }
            ],
            "name": "discounttomultiplytenant"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "8722131e-5864-4b1b-bfc5-13bdf685ae71",
                  "version": "KqlParameterItem/1.0",
                  "name": "azureIsServersP1",
                  "type": 1,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "AzureP1P2tenant",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "1",
                        "resultValType": "expression",
                        "resultVal": "{azureServersPlanValTenant} == 5"
                      }
                    },
                    {
