                        {
                          "columnId": "microsoft.apimanagement/service-Gateway Requests-Requests Timeline",
                          "label": "Requests Timeline"
                        },
                        {
                          "columnId": "Name",
                          "label": "API Management service"
                        }
                      ]
                    },
                    "showExportToExcel": true,
                    "resourceParameter": "apiManagementServices"
                  },
                  "name": "Defender for APIs request usage - tenant",
                  "styleSettings": {
                    "showBorder": true
                  },
                  "conditionalVisibility": {
                    "parameterName": "apiManagementServices",
                    "comparison": "isNotEqualTo"
                  }
                },
                {
                  "type": 3,
                  "name": "Defender for APIs subscription costs",
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "Defender for API - included subscription base fees",
                    "query": "resources\r\n| where type =~ \"microsoft.apimanagement/service\"\r\n| where tolong(\"{includeDefenderApis}\") == 1 and tolong(\"{AzureAPISubPlans}\") == 1\r\n| summarize ApiManagementServices = count() by Subscription = tolower(subscriptionId)\r\n| join kind=leftouter (\r\nresourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| project Subscription = tolower(subscriptionId), SubscriptionName = name\r\n) on Subscription\r\n| extend SubscriptionName = iff(isnotempty(SubscriptionName), SubscriptionName, Subscription)\r\n| extend Plan = case(tostring(\"{azureAPIPlanValTenant}\") == \"200\", \"Plan 1\", tostring(\"{azureAPIPlanValTenant}\") == \"700\", \"Plan 2\", tostring(\"{azureAPIPlanValTenant}\") == \"5000\", \"Plan 3\", tostring(\"{azureAPIPlanValTenant}\") == \"7000\", \"Plan 4\", tostring(\"{azureAPIPlanValTenant}\") == \"50000\", \"Plan 5\", \"Unresolved plan\"), Entitlement = \"{apiPlanEntitlement} requests/month\", MonthlyCost = todouble(\"{azureAPIMonthlyPriceTenant}\") * {discountToMultiplyVal}\r\n| project SubscriptionName, ApiManagementServices, Plan, Entitlement, MonthlyCost",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "size": 0,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "MonthlyCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "aggregation": "Sum"
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "SubscriptionName",
                          "label": "Subscription"
                        },
                        {
                          "columnId": "ApiManagementServices",
                          "label": "API Management services"
                        },
                        {
                          "columnId": "Plan",
                          "label": "Selected plan"
                        },
                        {
                          "columnId": "Entitlement",
                          "label": "Requests/month entitlement"
                        },
                        {
                          "columnId": "MonthlyCost",
                          "label": "Monthly cost (USD)"
                        }
                      ]
                    },
                    "noDataMessage": "No API Management services discovered in the selected readable scope. Missing inventory or metrics is not proof of zero usage."
                  }
                },
                {
                  "type": 9,
                  "name": "Defender for API planning usage",
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "style": "above",
                    "parameters": [
                      {
                        "id": "f8018d74-7619-4d50-97e2-b6f9bc0d5b91",
                        "version": "KqlParameterItem/1.0",
                        "name": "apiPlanningRequests",
                        "label": "Subscription requests (last 30 days)",
                        "type": 1,
                        "value": "",
                        "isRequired": false,
                        "description": "Copy one complete subscription subtotal from the live table above, as whole digits without commas. Leave blank for unavailable usage. Confirm all APIM service metrics are present. Used only in the planning comparison; not added to overall totals."
                      }
                    ]
                  }
                },
                {
                  "type": 3,
                  "name": "Defender for API plan comparison",
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "Defender for API - recommended plan and estimated charges (entered usage)",
                    "query": "resourcecontainers\r\n| where type =~ \"microsoft.resources/subscriptions\"\r\n| summarize Anchor = count()\r\n| extend RequestsText = \"{apiPlanningRequests:escapejson}\"\r\n| extend Requests = todouble(RequestsText)\r\n| where RequestsText matches regex @\"^[0-9]+$\" and isnotnull(Requests) and Requests >= 0.0 and Requests <= 9007199254740991.0\r\n| extend Cost1 = (todouble({retailPricing:$.monthly.apisP1}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p1}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p1})) * {discountToMultiplyVal}, Cost2 = (todouble({retailPricing:$.monthly.apisP2}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p2}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p2})) * {discountToMultiplyVal}, Cost3 = (todouble({retailPricing:$.monthly.apisP3}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p3}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p3})) * {discountToMultiplyVal}, Cost4 = (todouble({retailPricing:$.monthly.apisP4}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p4}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p4})) * {discountToMultiplyVal}, Cost5 = (todouble({retailPricing:$.monthly.apisP5}) + max_of(Requests - tolong({retailPricing:$.apiPlanning.entitlements.p5}), 0.0) * todouble({retailPricing:$.apiPlanning.overagePerCall.p5})) * {discountToMultiplyVal}\r\n| extend MinimumCost = min_of(Cost1, Cost2, Cost3, Cost4, Cost5)\r\n| extend RecommendedPlan = case(Cost1 == MinimumCost, \"Plan 1\", Cost2 == MinimumCost, \"Plan 2\", Cost3 == MinimumCost, \"Plan 3\", Cost4 == MinimumCost, \"Plan 4\", \"Plan 5\")\r\n| extend Plans = dynamic([{\"Plan\":\"Plan 1\",\"Selector\":\"200\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p1},\"BaseFee\":{retailPricing:$.monthly.apisP1},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p1}},{\"Plan\":\"Plan 2\",\"Selector\":\"700\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p2},\"BaseFee\":{retailPricing:$.monthly.apisP2},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p2}},{\"Plan\":\"Plan 3\",\"Selector\":\"5000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p3},\"BaseFee\":{retailPricing:$.monthly.apisP3},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p3}},{\"Plan\":\"Plan 4\",\"Selector\":\"7000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p4},\"BaseFee\":{retailPricing:$.monthly.apisP4},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p4}},{\"Plan\":\"Plan 5\",\"Selector\":\"50000\",\"Entitlement\":{retailPricing:$.apiPlanning.entitlements.p5},\"BaseFee\":{retailPricing:$.monthly.apisP5},\"OverageRate\":{retailPricing:$.apiPlanning.overagePerCall.p5}}])\r\n| mv-expand PlanData = Plans\r\n| extend Plan = tostring(PlanData.Plan), Selector = tostring(PlanData.Selector), Entitlement = tolong(PlanData.Entitlement), BaseFee = todouble(PlanData.BaseFee), OverageRate = todouble(PlanData.OverageRate)\r\n| extend OverageRequests = max_of(Requests - Entitlement, 0.0)\r\n| extend BaseCost = BaseFee * {discountToMultiplyVal}, OverageCost = OverageRequests * OverageRate * {discountToMultiplyVal}\r\n| extend MonthlyCost = BaseCost + OverageCost, Selected = iff(Selector == \"{azureAPIPlanValTenantWhatIf}\", \"Selected\", \"\")\r\n| extend Recommendation = iff(Plan == RecommendedPlan, \"Recommended\", \"\")\r\n| project Requests, Plan, Selected, Recommendation, Entitlement, OverageRate, BaseCost, OverageRequests, OverageCost, MonthlyCost\r\n| order by MonthlyCost asc, Entitlement asc",
                    "queryType": 1,
                    "resourceType": "microsoft.resources/tenants",
                    "size": 0,
                    "visualization": "table",
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "BaseCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "28ch"
                          }
                        },
                        {
                          "columnMatch": "OverageCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "38ch"
                          }
                        },
                        {
                          "columnMatch": "MonthlyCost",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "currency": "usd",
                              "style": "currency",
                              "maximumFractionDigits": 2
                            }
                          },
                          "formatOptions": {
                            "customColumnWidthSetting": "28ch"
                          }
                        },
                        {
                          "columnMatch": "OverageRate",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "minimumFractionDigits": 5,
                              "maximumFractionDigits": 5
                            }
                          }
                        },
                        {
                          "columnMatch": "Requests",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        },
                        {
                          "columnMatch": "Entitlement",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        },
                        {
                          "columnMatch": "OverageRequests",
                          "formatter": 0,
                          "numberFormat": {
                            "unit": 0,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 0,
                              "useGrouping": true
                            }
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Requests",
                          "label": "Requests (30 days, entered)"
                        },
                        {
                          "columnId": "Plan",
                          "label": "Plan"
                        },
                        {
                          "columnId": "Selected",
                          "label": "What-if selection"
                        },
                        {
                          "columnId": "Recommendation",
                          "label": "Recommended plan"
                        },
                        {
                          "columnId": "Entitlement",
                          "label": "Requests/month entitlement"
                        },
                        {
                          "columnId": "OverageRate",
                          "label": "Overage rate (USD/request)"
                        },
                        {
                          "columnId": "BaseCost",
                          "label": "Base charge (USD)"
                        },
                        {
                          "columnId": "OverageRequests",
                          "label": "Estimated overage requests"
                        },
                        {
                          "columnId": "OverageCost",
                          "label": "Estimated overage charge (USD)"
                        },
                        {
                          "columnId": "MonthlyCost",
                          "label": "Monthly cost (USD)"
                        }
                      ]
                    },
                    "noDataMessage": "Enter a complete subscription request total as whole digits (no commas). Blank, negative, fractional, or invalid usage has no recommendation; missing metrics are not zero."
                  }
                }
              ]
            }
          }
        ]
      },
      "name": "tenantGroup"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
