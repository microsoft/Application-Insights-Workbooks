tor * {discountToMultiplyVal}, iff(tolower('{gcpIsServersP2}') == \"true\", ServersPricingP2 * TotalServersInSecurityConnector * {discountToMultiplyVal}, 0.0)),\r\n\tDcspmEstimatedPrice = iff(tolower('{gcpIsDcspm}') == \"true\", DcspmPricing * TotalDcspmInSecurityConnector * {discountToMultiplyVal}, 0.0)\r\n    | project SecurityConnectorId = securityConnectorId, TotalServersInSecurityConnector, TotalDcspmInSecurityConnector, ServersEstimatedPrice, DcspmEstimatedPrice\r\n| extend CspmBillableUnits = iff(tolower(\"{gcpIsDcspm}\") == \"true\", todouble(TotalDcspmInSecurityConnector), 0.0), ServerlessKnownCost = 0.0, ServerlessUnpricedInputs = 0",
