                  "type": 1,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "azurePlans",
                        "operator": "contains",
                        "rightValType": "static",
                        "rightVal": "microsoft.sql/servers, microsoft.sql/managedinstances",
                        "resultValType": "expression",
                        "resultVal": "true"
                      }
                    },
                    {
                      "criteriaContext": {
