              "parameters": [
                {
                  "id": "a5856053-865c-4e16-9423-9914190f7f20",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessCspmSelected",
                  "label": "Microsoft Defender CSPM selected for Azure or AWS",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "azureIsDcspm",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "true",
                        "resultValType": "static",
                        "resultVal": "1"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "awsIsDcspm",
                        "operator": "==",
                        "rightValType": "static",
                        "rightVal": "true",
                        "resultValType": "static",
                        "resultVal": "1"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
                        "resultValType": "static",
                        "resultVal": "0"
                      }
                    }
                  ]
                },
                {
                  "id": "89d0805f-e366-4f3f-97c3-8de6502dde39",
                  "version": "KqlParameterItem/1.0",
                  "name": "serverlessComponentsIncluded",
                  "label": "A Microsoft Defender CSPM serverless component is included",
                  "type": 1,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
