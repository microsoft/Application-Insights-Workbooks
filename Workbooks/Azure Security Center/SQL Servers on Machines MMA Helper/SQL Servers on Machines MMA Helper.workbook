{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# SQL Servers on Machines MMA Helper"
      },
      "name": "Workbook-Header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "b859a03f-2283-43dd-8536-42714bbfced6",
            "version": "KqlParameterItem/1.0",
            "name": "Subscription",
            "label": "Subscription(s)",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "includeAll": true,
              "showDefault": false
            },
            "value": [
              "value::all"
            ]
          }
        ],
        "style": "pills"
      },
      "name": "Parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "* Microsoft Defender for Cloud's Defender for SQL Server on Machines plan provides database security to protect SQL Server instances hosted on Azure, Amazon Web Services (AWS), Google Cloud Platform (GCP), and on-premises machines. With **the retirement of the Microsoft Monitoring Agent (MMA) on August 1, 2024**, the Defender for SQL Server on Machines plan requires that you [meet prerequisites](https://learn.microsoft.com/en-us/azure/defender-for-cloud/defender-for-sql-usage) and [deploy Azure Arc](https://review.learn.microsoft.com/azure/azure-arc/servers/quick-enable-hybrid-vm) on all non-Azure SQL Server instances.\r\n* Use this workbook to identify SQL servers on machines that are still reporting through the retired Microsoft Monitoring Agent (MMA).",
        "style": "info"
      },
      "name": "workbook-info"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "# Subscription(s) Overview"
            },
            "name": "Overview-explain-text"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type == \"microsoft.resources/subscriptions\"\r\n| extend text = \"Subscriptions selected\"\r\n| summarize count() by text",
              "size": 4,
              "noDataMessage": "No subscriptions were selected",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "text",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "count_",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "maximumSignificantDigits": 3,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "full"
              }
            },
            "customWidth": "25",
            "name": "subscruptioncount"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type =~ \"microsoft.security/assessments\"\r\n    | extend scanner = (// AssessmentsQueryBuilder.columnDefinitions.scanner\r\n            (tostring(\r\n        coalesce(bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0], bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0],\r\n        properties.additionalData.scanner, properties.additionalData.scanner, \r\n        properties.additionalData.Scanner, properties.additionalData.Scanner, \r\n        properties.additionalData.SecretScannerName, properties.additionalData.SecretScannerName,\r\n        properties.additionalData.ToolName, properties.additionalData.ToolName,\r\n        properties.additionalData.ScannerName, properties.additionalData.ScannerName,\r\n        \"N/A\"))))\r\n                    | where scanner in~ (\"SQL Vulnerability Assessment\")\r\n    | extend source = (// AssessmentsQueryBuilder.columnDefinitions.source\r\n            (trim(' ', tolower(coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source))))))\r\n    | extend resourceId = (// AssessmentsQueryBuilder.columnDefinitions.resourceId\r\n            (tolower(trim(\" \", tostring(case(source =~ \"azure\", coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newAwsAssessmentIndicator\r\n        (source =~ \"aws\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newGcpAssessmentIndicator\r\n        (source =~ \"gcp\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        source =~ \"aws\", properties.resourceDetails.AzureResourceId,\r\n        source =~ \"gcp\", properties.resourceDetails.AzureResourceId,\r\n        split(id, \"/providers/Microsoft.Security/assessments/\")[0]\r\n        ))))))\r\n    | where resourceId contains \"microsoft.operationalinsights\"\r\n    | extend workspaceId = tostring(properties.resourceDetails.WorkspaceId) \r\n    | extend machineName = tostring(properties.resourceDetails.MachineName) \r\n    | extend machineUuid = tostring(properties.resourceDetails.VMUUID)\r\n    | summarize subcount=dcount(subscriptionId)\r\n| extend text = \"Subscriptions with relevant LA workspaces\"",
              "size": 4,
              "noDataMessage": "No subscriptions with relevant LA workspaces detected​ in the selected scope",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "text",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "subcount",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": true,
                "size": "full"
              }
            },
            "customWidth": "25",
            "name": "subcount"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type =~ \"microsoft.security/assessments\"\r\n    | extend scanner = (// AssessmentsQueryBuilder.columnDefinitions.scanner\r\n            (tostring(\r\n        coalesce(bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0], bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0],\r\n        properties.additionalData.scanner, properties.additionalData.scanner, \r\n        properties.additionalData.Scanner, properties.additionalData.Scanner, \r\n        properties.additionalData.SecretScannerName, properties.additionalData.SecretScannerName,\r\n        properties.additionalData.ToolName, properties.additionalData.ToolName,\r\n        properties.additionalData.ScannerName, properties.additionalData.ScannerName,\r\n        \"N/A\"))))\r\n                    | where scanner in~ (\"SQL Vulnerability Assessment\")\r\n    | extend source = (// AssessmentsQueryBuilder.columnDefinitions.source\r\n            (trim(' ', tolower(coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source))))))\r\n    | extend resourceId = (// AssessmentsQueryBuilder.columnDefinitions.resourceId\r\n            (tolower(trim(\" \", tostring(case(source =~ \"azure\", coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newAwsAssessmentIndicator\r\n        (source =~ \"aws\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newGcpAssessmentIndicator\r\n        (source =~ \"gcp\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        source =~ \"aws\", properties.resourceDetails.AzureResourceId,\r\n        source =~ \"gcp\", properties.resourceDetails.AzureResourceId,\r\n        split(id, \"/providers/Microsoft.Security/assessments/\")[0]\r\n        ))))))\r\n    | where resourceId contains \"microsoft.operationalinsights\"\r\n    | extend workspaceId = tostring(properties.resourceDetails.WorkspaceId) \r\n    | extend machineName = tostring(properties.resourceDetails.MachineName) \r\n    | extend machineUuid = tostring(properties.resourceDetails.VMUUID)\r\n    | summarize wkscount=dcount(workspaceId)\r\n| extend text = \"LA workspaces\"",
              "size": 4,
              "noDataMessage": "No relevant workspaces detected in the selected scope",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "text",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "wkscount",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "maximumSignificantDigits": 3,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "full"
              }
            },
            "customWidth": "25",
            "name": "wkscount"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type =~ \"microsoft.security/assessments\"\r\n    | extend scanner = (// AssessmentsQueryBuilder.columnDefinitions.scanner\r\n            (tostring(\r\n        coalesce(bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0], bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0],\r\n        properties.additionalData.scanner, properties.additionalData.scanner, \r\n        properties.additionalData.Scanner, properties.additionalData.Scanner, \r\n        properties.additionalData.SecretScannerName, properties.additionalData.SecretScannerName,\r\n        properties.additionalData.ToolName, properties.additionalData.ToolName,\r\n        properties.additionalData.ScannerName, properties.additionalData.ScannerName,\r\n        \"N/A\"))))\r\n                    | where scanner in~ (\"SQL Vulnerability Assessment\")\r\n    | extend source = (// AssessmentsQueryBuilder.columnDefinitions.source\r\n            (trim(' ', tolower(coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source))))))\r\n    | extend resourceId = (// AssessmentsQueryBuilder.columnDefinitions.resourceId\r\n            (tolower(trim(\" \", tostring(case(source =~ \"azure\", coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newAwsAssessmentIndicator\r\n        (source =~ \"aws\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newGcpAssessmentIndicator\r\n        (source =~ \"gcp\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        source =~ \"aws\", properties.resourceDetails.AzureResourceId,\r\n        source =~ \"gcp\", properties.resourceDetails.AzureResourceId,\r\n        split(id, \"/providers/Microsoft.Security/assessments/\")[0]\r\n        ))))))\r\n    | where resourceId contains \"microsoft.operationalinsights\"\r\n    | extend workspaceId = tostring(properties.resourceDetails.WorkspaceId) \r\n    | extend machineName = tostring(properties.resourceDetails.MachineName) \r\n    | extend machineUuid = tostring(properties.resourceDetails.VMUUID)\r\n    | summarize mcount=dcount(subscriptionId)\r\n| extend text = \"MMA reporting machines​\"",
              "size": 4,
              "noDataMessage": "No machines using MMA detected in the selected scope",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "text",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "mcount",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "maximumSignificantDigits": 3,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true,
                "size": "full"
              }
            },
            "customWidth": "25",
            "name": "mcount"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type =~ \"microsoft.security/assessments\"\r\n    | extend scanner = (// AssessmentsQueryBuilder.columnDefinitions.scanner\r\n            (tostring(\r\n        coalesce(bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0], bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0],\r\n        properties.additionalData.scanner, properties.additionalData.scanner, \r\n        properties.additionalData.Scanner, properties.additionalData.Scanner, \r\n        properties.additionalData.SecretScannerName, properties.additionalData.SecretScannerName,\r\n        properties.additionalData.ToolName, properties.additionalData.ToolName,\r\n        properties.additionalData.ScannerName, properties.additionalData.ScannerName,\r\n        \"N/A\"))))\r\n                    | where scanner in~ (\"SQL Vulnerability Assessment\")\r\n    | extend source = (// AssessmentsQueryBuilder.columnDefinitions.source\r\n            (trim(' ', tolower(coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source))))))\r\n    | extend resourceId = (// AssessmentsQueryBuilder.columnDefinitions.resourceId\r\n            (tolower(trim(\" \", tostring(case(source =~ \"azure\", coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newAwsAssessmentIndicator\r\n        (source =~ \"aws\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newGcpAssessmentIndicator\r\n        (source =~ \"gcp\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        source =~ \"aws\", properties.resourceDetails.AzureResourceId,\r\n        source =~ \"gcp\", properties.resourceDetails.AzureResourceId,\r\n        split(id, \"/providers/Microsoft.Security/assessments/\")[0]\r\n        ))))))\r\n    | where resourceId contains \"microsoft.operationalinsights\"\r\n    | extend workspaceId = tostring(properties.resourceDetails.WorkspaceId) \r\n    | extend machineName = tostring(properties.resourceDetails.MachineName) \r\n    | extend machineUuid = tostring(properties.resourceDetails.VMUUID)\r\n    | extend machine=strcat(machineName,\"_\",machineUuid)\r\n    | join kind=leftouter (\r\n    ResourceContainers\r\n    | where type =~ 'microsoft.resources/subscriptions'\r\n    | project subscriptionId, subscriptionName = id\r\n    ) on subscriptionId\r\n    | summarize [\"Workspaces#\"]=dcount(workspaceId), [\"Machines#\"]=dcount(machine) by subscriptionName, subscriptionId",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "title": "Subscription Summary",
              "showExportToExcel": true,
              "showRefreshButton": true
            },
            "name": "subsummary"
          },
          {
            "type": 1,
            "content": {
              "json": "1. Use the view below to identify the relevant machines, broken down by workspace and subscription.\r\n\r\n2. Machines listed here will need to be [registered to Arc](https://review.learn.microsoft.com/azure/azure-arc/servers/quick-enable-hybrid-vm) in order to continue Defender for SQL on machines protection.\r\n\r\n3. If you register the machines to a subscription different from the one your LA workspace is in, you'll need to make sure the Defender for SQL on machines plan is enabled on that subscription.\r\n\r\n4. After registering the machines, [verify their protection status](https://learn.microsoft.com/azure/defender-for-cloud/verify-machine-protection).",
              "style": "info",
              "title": "Instructions"
            },
            "name": "MigrationStatus-text"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "securityresources\r\n    | where type =~ \"microsoft.security/assessments\"\r\n    | extend scanner = (// AssessmentsQueryBuilder.columnDefinitions.scanner\r\n            (tostring(\r\n        coalesce(bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0], bag_keys(parse_json(tostring(properties.additionalData.ScannersDetails)))[0],\r\n        properties.additionalData.scanner, properties.additionalData.scanner, \r\n        properties.additionalData.Scanner, properties.additionalData.Scanner, \r\n        properties.additionalData.SecretScannerName, properties.additionalData.SecretScannerName,\r\n        properties.additionalData.ToolName, properties.additionalData.ToolName,\r\n        properties.additionalData.ScannerName, properties.additionalData.ScannerName,\r\n        \"N/A\"))))\r\n                    | where scanner in~ (\"SQL Vulnerability Assessment\")\r\n    | extend source = (// AssessmentsQueryBuilder.columnDefinitions.source\r\n            (trim(' ', tolower(coalesce(tostring(properties.resourceDetails.Source), tostring(properties.resourceDetails.source))))))\r\n    | extend resourceId = (// AssessmentsQueryBuilder.columnDefinitions.resourceId\r\n            (tolower(trim(\" \", tostring(case(source =~ \"azure\", coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newAwsAssessmentIndicator\r\n        (source =~ \"aws\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        (// AssessmentsQueryBuilder.predicates.newGcpAssessmentIndicator\r\n        (source =~ \"gcp\" and isnotempty(tostring(properties.resourceDetails.ConnectorId)))), coalesce(properties.resourceDetails.Id, properties.resourceDetails.id),\r\n        source =~ \"aws\", properties.resourceDetails.AzureResourceId,\r\n        source =~ \"gcp\", properties.resourceDetails.AzureResourceId,\r\n        split(id, \"/providers/Microsoft.Security/assessments/\")[0]\r\n        ))))))\r\n    | where resourceId contains \"microsoft.operationalinsights\"\r\n    | extend workspaceId = tostring(properties.resourceDetails.WorkspaceId) \r\n    | extend machineName = tostring(properties.resourceDetails.MachineName) \r\n    | extend machineUuid = tostring(properties.resourceDetails.VMUUID)\r\n    | extend machine=strcat(machineName,\"_\",machineUuid)\r\n    | join kind=leftouter (\r\n        ResourceContainers\r\n        | where type =~ 'microsoft.resources/subscriptions'\r\n        | project subscriptionId, subscriptionName = id\r\n    ) on subscriptionId\r\n    | distinct subscriptionName, subscriptionId, workspaceId, machineName, machineUuid",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "title": "Inventory Details",
              "showExportToExcel": true,
              "showRefreshButton": true
            },
            "name": "inventorydetails"
          }
        ]
      },
      "name": "Overview Group"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "fallbackResourceIds": [
    "Azure Security Center"
  ]
}